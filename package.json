{
  "name": "endfield-rpg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && tsc --noEmit && vitest run",
    "build": "node scripts/check-assets.mjs && tsc --noEmit && vite build",
    "test:e2e": "sh scripts/run-browser-test.sh e2e",
    "test:e2e:inside": "npm run build && playwright test --project built --project ui",
    "test:ui": "sh scripts/run-browser-test.sh ui",
    "test:ui:inside": "PLAYWRIGHT_UI=1 playwright test --project ui",
    "test:editor": "sh scripts/run-browser-test.sh editor",
    "test:editor:inside": "PLAYWRIGHT_EDITOR=1 playwright test --project settings"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.27.1",
    "@babylonjs/loaders": "^9.27.1"
  }
}
