{
  "description": "Repository lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$(git rev-parse --show-toplevel)\" pull --ff-only",
            "timeout": 60,
            "statusMessage": "Pulling the latest repository changes"
          }
        ]
      }
    ]
  }
}
