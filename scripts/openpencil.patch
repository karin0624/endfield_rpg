+import type { Fill, SceneNode } from '@open-pencil/scene-graph'
+
+import type { DesignDocument, DesignElement, DesignNode, DesignStyleDeclaration } from '../types'
+import { cssColor } from './css'
+
+/** Encoded-image dimensions supplied by the engine, without resampling the original bytes. */
+export type ImageSizeResolver = (hash: string) => { width: number; height: number } | undefined
+
+function element(
+  tagName: string,
+  attrs: Record<string, string> = {},
+  children: DesignNode[] = [],
+  inlineStyle?: DesignStyleDeclaration
+): DesignElement {
+  return { type: 'element', tagName, attrs, children, inlineStyle }
+}
+
+function clone(node: DesignNode): DesignNode {
+  return node.type === 'text'
+    ? { ...node }
+    : {
+        ...node,
+        attrs: { ...node.attrs },
+        inlineStyle: { ...node.inlineStyle },
+        children: node.children.map(clone)
+      }
+}
+
+function cropImage(
+  projected: DesignElement,
+  node: SceneNode,
+  fill: Fill,
+  imageSize: ImageSizeResolver
+) {
+  if (fill.imageScaleMode !== 'CROP' || !fill.imageTransform) return
+  const { m00: a, m01: c, m02: e, m10: b, m11: d, m12: f } = fill.imageTransform
+  const style = (projected.inlineStyle ??= {})
+  if (a === 1 && d === 1 && b === 0 && c === 0 && e === 0 && f === 0) {
+    style['object-fit'] = 'fill'
+    return
+  }
+  const size = fill.imageHash && imageSize(fill.imageHash)
+  if (!size) throw new Error(`Cannot export image crop without image dimensions: ${node.id}`)
+  const { width: iw, height: ih } = size
+  const href = projected.attrs.src
+  projected.tagName = 'svg'
+  delete projected.attrs.src
+  delete style['object-fit']
+  delete style['aspect-ratio']
+  Object.assign(projected.attrs, {
+    xmlns: 'http://www.w3.org/2000/svg',
+    width: String(node.width),
+    height: String(node.height),
+    preserveAspectRatio: 'none'
+  })
+  if (b === 0 && c === 0 && a > 0 && d > 0) {
+    projected.attrs.viewBox = `0 0 ${iw * a} ${ih * d}`
+    projected.children = [
+      element('image', {
+        href,
+        x: String(-iw * e),
+        y: String(-ih * f),
+        width: String(iw),
+        height: String(ih),
+        preserveAspectRatio: 'none'
+      })
+    ]
+  } else {
+    const det = a * d - b * c
+    if (det === 0) throw new Error(`Singular image crop transform: ${node.id}`)
+    const matrix = [
+      (node.width * d) / det / iw,
+      (-node.height * b) / det / iw,
+      (-node.width * c) / det / ih,
+      (node.height * a) / det / ih,
+      (node.width * (c * f - d * e)) / det,
+      (node.height * (b * e - a * f)) / det
+    ]
+    projected.attrs.viewBox = `0 0 ${node.width} ${node.height}`
+    projected.children = [
+      element('image', {
+        href,
+        width: String(iw),
+        height: String(ih),
+        transform: `matrix(${matrix.join(' ')})`,
+        preserveAspectRatio: 'none'
+      })
+    ]
+  }
+}
+
+/** Keep consecutive native vector masks as SVG clipping geometry, not painted layers. */
+function clipChildren(projected: DesignElement, node: SceneNode) {
+  const children = projected.children
