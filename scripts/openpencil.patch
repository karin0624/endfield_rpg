index 0000000000000000000000000000000000000000..10df362b07137e8fc307e42812290e11ebc0bf33
--- /dev/null
+++ b/packages/core/tests/io/formats/html/fixed-background.test.ts
@@ -0,0 +1,125 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { toUint8Array } from 'js-base64'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { recordInstanceOverride, type Fill, type SceneNode } from '@open-pencil/scene-graph'
+
+import { htmlFormat } from '#core/io/formats'
+
+const opaque = toUint8Array(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4AWOQNPIGAAD+AJesP/7fAAAAAElFTkSuQmCC'
+)
+const translucent = toUint8Array(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR4AWOQNPJuAAACFQEXDg59awAAAABJRU5ErkJggg=='
+)
+const alternate = toUint8Array(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4AWPwNpIEAAFiAJc4srMZAAAAAElFTkSuQmCC'
+)
+
+beforeAll(initCodec)
+
+function fixture(bytes: Uint8Array = opaque) {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const screen = api.createFrame()
+  screen.name = 'Native screen'
+  screen.resize(320, 180)
+  screen.fills = []
+  screen.clipsContent = true
+  const main = api.createComponent()
+  main.name = 'Background artwork'
+  main.resize(320, 180)
+  const image = api.createImage(bytes)
+  const fill: Fill & ImagePaint = {
+    type: 'IMAGE',
+    color: { r: 0, g: 0, b: 0, a: 1 },
+    imageHash: image.hash,
+    scaleMode: 'FILL',
+    imageScaleMode: 'FILL',
+    opacity: 1,
+    visible: true
+  }
+  main.fills = [fill]
+  graph.updateNode(main.id, { scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME' })
+  const background = main.createInstance()
+  background.name = 'Normally placed background'
+  background.constraints = { horizontal: 'STRETCH', vertical: 'STRETCH' }
+  screen.appendChild(background)
+  const foreground = api.createRectangle()
+  foreground.name = 'Retained foreground'
+  foreground.resize(20, 20)
+  screen.appendChild(foreground)
+  return { graph, api, screen, main, background, foreground, fill }
+}
+
+async function page(graph: SceneGraph, rootId: string) {
+  const exported = await htmlFormat.exportContent?.(
+    { graph, target: { scope: 'node', nodeId: rootId } },
+    { html: 'standalone', assets: 'external' }
+  )
+  if (!exported || typeof exported.data !== 'string') throw new Error('Missing public HTML export')
+  return {
+    html: exported.data,
+    css:
+      exported.assets
+        ?.map((asset) => (typeof asset.content === 'string' ? asset.content : ''))
+        .join('') ?? '',
+    images: exported.assets
+      ?.filter((asset) => asset.path.endsWith('.png'))
+      .map((asset) => asset.content)
+  }
+}
+
+function named(graph: SceneGraph, name: string): SceneNode {
+  const node = [...graph.getAllNodes()].find((current) => current.name === name)
+  if (!node) throw new Error(`Missing saved ${name}`)
+  return node
+}
+
+test('normal FIG backgrounds preserve public placement, resizing and exact image bytes across cold saves', async () => {
+  const original = fixture()
+  let graph = original.graph
+  for (let pass = 0; pass < 2; pass++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const before = structuredClone([...graph.nodes])
+    const root = named(graph, original.screen.name)
+    const background = named(graph, original.background.name)
+    const foreground = named(graph, original.foreground.name)
+    const result = await page(graph, root.id)
+    expect(result.css).toContain('background-attachment: fixed')
+    expect(result.html).toContain(`data-open-pencil-node-id="${foreground.id}"`)
+    expect(result.html).not.toContain(`data-open-pencil-node-id="${background.id}"`)
+    expect(result.images).toEqual([opaque])
+    expect([...graph.nodes]).toEqual(before)
+    const api = new FigmaAPI(graph)
+    api.wrapNode(root.id).resize(480, 270)
+    api.wrapNode(background.id).resize(480, 270)
+  }
+})
+
+test.each(['translucent pixels', 'image override', 'scrolling image'])(
+  '%s is not folded into a fixed viewport background after normal FIG reopen',
+  async (kind) => {
+    const made = fixture(kind === 'translucent pixels' ? translucent : opaque)
+    if (kind === 'image override') {
+      const replacement: Fill & ImagePaint = {
+        ...made.fill,
+        imageHash: made.api.createImage(alternate).hash
+      }
+      made.background.fills = [replacement]
+    }
+    if (kind === 'scrolling image') {
+      made.graph.updateNode(made.background.id, { scrollBehavior: 'SCROLLS' })
+      recordInstanceOverride(made.graph, made.background.id, ['scrollBehavior'])
+    }
+    const graph = await parseFigFile((await exportFigFile(made.graph)).slice().buffer, {
+      populate: 'all'
+    })
+    const result = await page(graph, named(graph, made.screen.name).id)
+    expect(result.css).not.toContain('background-attachment: fixed')
+    expect(result.html).toContain(
+      `data-open-pencil-node-id="${named(graph, made.background.name).id}"`
+    )
+  }
+)
diff --git a/packages/core/tests/io/formats/html/native-grayscale.test.ts b/packages/core/tests/io/formats/html/native-grayscale.test.ts
