+import { expect, test } from 'bun:test'
+
+import { colorToCSS, parseColor } from '@open-pencil/scene-graph/color'
+
+test('full-precision CSS colors roundtrip fractional channels and faint paint alpha', () => {
+  const color = { r: 0.25, g: 0.5, b: 0.75, a: 9 / 255 }
+  expect(parseColor(colorToCSS(color, { precision: 'full' }))).toEqual(color)
+  expect(parseColor(colorToCSS({ ...color, a: 1 }, { precision: 'full' }))).toEqual({
+    ...color,
+    a: 1
+  })
+})
diff --git a/packages/vue/tests/controls/component-props/inheritance.test.ts b/packages/vue/tests/controls/component-props/inheritance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..542c285893a69ab42d7b5ed502ce6f0d0b18f061
--- /dev/null
+++ b/packages/vue/tests/controls/component-props/inheritance.test.ts
@@ -0,0 +1,126 @@
+import { expect, test } from 'bun:test'
+
+import { createSSRApp, effectScope, reactive } from 'vue'
+
+import { createEditor, createDefaultEditorState } from '@open-pencil/core/editor'
+import { SceneGraph, componentPropertyDefinitions } from '@open-pencil/scene-graph'
+
+import { useComponentPropertyAuthoring } from '#vue/controls/component-props/authoring'
+import { useSlotAuthoring } from '#vue/controls/slots/authoring'
+import { useSlotProperties } from '#vue/controls/slots/instance'
+import { EDITOR_KEY } from '#vue/editor/context'
+
+function fixture() {
+  const graph = new SceneGraph()
+  const editor = createEditor({
+    graph,
+    state: reactive(createDefaultEditorState(graph.getPages()[0].id))
+  })
+  const set = graph.createNode('COMPONENT_SET', editor.state.currentPageId, {
+    componentPropertyDefinitions: [
+      { id: 'root', name: 'HP', type: 'TEXT', defaultValue: '30' },
+      {
+        id: 'slot',
+        name: 'Content',
+        type: 'SLOT',
+        defaultValue: '',
+        description: 'Parent',
+        slotSettings: {
+          minChildren: 1,
+          allowPreferredValuesOnly: false,
+          displayEmptyByDefault: false,
+          stretchChildOnInsert: false
+        }
+      }
+    ]
+  })
+  const component = graph.createNode('COMPONENT', set.id, {
+    componentPropertyDefinitions: [
+      { id: 'local', parentPropDefId: 'root', name: 'HP', type: 'TEXT', defaultValue: '0' },
+      {
+        id: 'local-slot',
+        parentPropDefId: 'slot',
+        name: 'Old name',
+        type: 'SLOT',
+        defaultValue: '',
+        inheritedFields: [
+          'name',
+          'type',
+          'defaultValue',
+          'description',
+          'slotSettings',
+          'preferredValues'
+        ]
+      }
+    ]
+  })
+  const text = graph.createNode('TEXT', component.id, {
+    text: '0',
+    componentPropertyReferences: [{ propertyId: 'local', field: 'TEXT' }]
+  })
+  const frame = graph.createNode('FRAME', component.id, {
+    componentPropertyReferences: [{ propertyId: 'local-slot', field: 'SLOT_CONTENT' }]
+  })
+  const instance = graph.createInstance(component.id, editor.state.currentPageId)
+  if (!instance) throw new Error('Missing instance')
+  const app = createSSRApp({}),
+    scope = effectScope()
+  app.provide(EDITOR_KEY, editor)
+  function control<T>(fn: () => T): T {
+    const result = app.runWithContext(() => scope.run(fn))
+    if (!result) throw new Error('Missing control')
+    return result
+  }
+  return { editor, graph, set, component, text, frame, instance, control, stop: () => scope.stop() }
+}
+
+test('authoring GUI projects one public row and resolves local binding IDs', () => {
+  const f = fixture()
+  f.editor.select([f.text.id])
+  const authoring = f.control(useComponentPropertyAuthoring)
+  expect(authoring.definitions.value.map((d) => d.id)).toEqual(['root'])
+  expect(authoring.propertyIds.value.TEXT).toBe('root')
+  expect(authoring.rows.value.map((row) => row.id)).toEqual(['root'])
+  f.stop()
+})
+
+test('SLOT GUI resolves public controls while ownership remains on the local ID', () => {
+  const f = fixture()
+  f.editor.select([f.instance.id])
+  const slots = f.control(useSlotProperties)
+  expect(slots.slots.value).toHaveLength(1)
+  expect(slots.slots.value[0]).toMatchObject({ id: 'slot', name: 'Content', modified: false })
+  const frame = f.graph.getChildren(f.instance.id)[0]
+  // The actual frame follows the text layer in the component.
+  const slotFrame = f.graph.getChildren(f.instance.id).find((n) => n.type === 'FRAME')
+  if (!slotFrame) throw new Error(`Missing slot frame after ${frame.id}`)
+  slots.clear(slotFrame.id)
+  f.editor.select([f.instance.id])
+  expect(slots.slots.value[0].modified).toBe(true)
+  f.stop()
+})
+
+test('SLOT GUI writes explicit inherited metadata and keeps undo and shared rename', () => {
+  const f = fixture()
+  f.editor.select([f.frame.id])
+  const slots = f.control(useSlotAuthoring)
+  expect(slots.slots.value[0]).toMatchObject({
+    id: 'local-slot',
+    name: 'Content',
+    description: 'Parent',
+    minChildren: 1
+  })
+  slots.describe('local-slot', '')
+  slots.setLimits('local-slot', { maxChildren: 2 })
+  let effective = componentPropertyDefinitions(f.graph, f.component).find((d) => d.id === 'slot')
+  expect(effective?.description).toBe('')
+  expect(effective?.slotSettings).toMatchObject({ minChildren: 1, maxChildren: 2 })
+  f.editor.undo.undo()
+  effective = componentPropertyDefinitions(f.graph, f.component).find((d) => d.id === 'slot')
+  expect(effective?.slotSettings?.maxChildren).toBeUndefined()
+  slots.rename('local-slot', 'Children')
+  expect(
+    componentPropertyDefinitions(f.graph, f.component).find((d) => d.id === 'slot')?.name
+  ).toBe('Children')
+  f.stop()
+})
