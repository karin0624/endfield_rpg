+    let graph = source
+    for (let pass = 0; pass < 2; pass++) {
+      const saved = await reopen(graph)
+      graph = saved.graph
+      const current = new FigmaAPI(graph).wrapNode(named(graph, 'state=start').id)
+      expect(() => current.reactions).toThrow('unsupported prototype reaction')
+      const wire = parseFigBuffer(saved.bytes.slice().buffer).nodeChanges.find(
+        (node) => node.name === 'state=start'
