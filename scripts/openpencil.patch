+import { expect, test } from 'bun:test'
+
+import { uint8ArrayToArrayBuffer } from '#core-tests/helpers/fig/fixtures'
+import { asInstanceNode, createAPI } from '#core-tests/helpers/figma-api'
+
+import { FigmaAPI, exportFigFile, parseFigFile } from '@open-pencil/core'
+
+function property(node: InstanceNode, name: string) {
+  const key = Object.keys(node.componentProperties).find((key) => key.startsWith(`${name}#`))
+  if (!key) throw new Error(`Missing component property ${name}`)
+  return { key, value: node.componentProperties[key]?.value }
+}
+
+function exposedInput(instance: InstanceNode): InstanceNode {
+  const nested = instance.exposedInstances[0]
+  if (!nested) throw new Error('Missing exposed input instance')
+  return nested
+}
+
+function setup() {
+  const api = createAPI()
+  const input = api.createComponent()
+  input.name = 'Input'
+  const label = api.createText()
+  label.characters = 'Default label'
+  label.name = 'value'
+  input.appendChild(label)
+  const labelProperty = input.addComponentProperty('selectedLabel', 'TEXT', label.characters)
+  label.componentPropertyReferences = { characters: labelProperty }
+  const ring = api.createRectangle()
+  ring.name = 'focus-ring'
+  ring.visible = false
+  input.appendChild(ring)
+  const focusProperty = input.addComponentProperty('focusVisible', 'BOOLEAN', false)
+  ring.componentPropertyReferences = { visible: focusProperty }
+
+  const owner = api.createComponent()
+  owner.name = 'Dialog'
+  const source = input.createInstance()
+  source.name = 'item-target'
+  owner.appendChild(source)
+  source.isExposedInstance = true
+  source.setProperties({ [labelProperty]: 'Dialog default' })
+  const instance = owner.createInstance()
+  instance.name = 'Usage'
+  return { api, instance, source, owner, input, labelProperty, focusProperty }
+}
+
+function expectValues(instance: InstanceNode, label: string, focus: boolean) {
+  const nested = exposedInput(instance)
+  expect(property(nested, 'selectedLabel').value).toBe(label)
+  expect(property(nested, 'focusVisible').value).toBe(focus)
+  const text = nested.children.find((child) => child.type === 'TEXT' && child.name === 'value')
+  expect(text?.type === 'TEXT' ? text.characters : undefined).toBe(label)
+  expect(nested.children.find((child) => child.name === 'focus-ring')?.visible).toBe(focus)
+}
+
+function syncComponents(api: FigmaAPI) {
+  const components = [...api.graph.getAllNodes()].filter((node) => node.type === 'COMPONENT')
+  for (const node of components) api.graph.syncInstances(node.id)
+}
+
+async function reopen(api: FigmaAPI) {
+  const bytes = await exportFigFile(api.graph)
+  const graph = await parseFigFile(uint8ArrayToArrayBuffer(bytes), { populate: 'all' })
+  const reopened = new FigmaAPI(graph)
+  const usage = [...graph.getAllNodes()].find(
+    (node) => node.type === 'INSTANCE' && node.name === 'Usage'
+  )
+  if (!usage) throw new Error('Missing reopened usage instance')
+  return { api: reopened, instance: asInstanceNode(reopened.wrapNode(usage.id)) }
+}
+
+test('nested text and boolean properties survive normal fig save, reopen, and later edits', async () => {
+  const { api, instance, source } = setup()
+  const nested = exposedInput(instance)
+  nested.setProperties({
+    [property(nested, 'selectedLabel').key]: 'Edited target',
+    [property(nested, 'focusVisible').key]: true
+  })
+  expectValues(instance, 'Edited target', true)
+  syncComponents(api)
+  expectValues(instance, 'Edited target', true)
+  expect(property(source, 'selectedLabel').value).toBe('Dialog default')
+
+  const first = await reopen(api)
+  expectValues(first.instance, 'Edited target', true)
+  syncComponents(first.api)
+  expectValues(first.instance, 'Edited target', true)
+  const restored = exposedInput(first.instance)
+  restored.setProperties({
+    [property(restored, 'selectedLabel').key]: 'Edited after reopen',
+    [property(restored, 'focusVisible').key]: false
+  })
+  expectValues(first.instance, 'Edited after reopen', false)
+  syncComponents(first.api)
+  expectValues(first.instance, 'Edited after reopen', false)
+  const second = await reopen(first.api)
+  expectValues(second.instance, 'Edited after reopen', false)
+})
