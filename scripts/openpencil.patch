+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph, type Fill } from '@open-pencil/scene-graph'
+
+async function crop(transform: NonNullable<Fill['imageTransform']>, width = 40, height = 45) {
+  const graph = new SceneGraph()
+  graph.images.set('original', new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10]))
+  const image = graph.createNode('RECTANGLE', graph.getPages()[0].id, {
+    width,
+    height,
+    fills: [
+      {
+        type: 'IMAGE',
+        imageHash: 'original',
+        imageScaleMode: 'CROP',
+        imageTransform: transform,
+        color: { r: 0, g: 0, b: 0, a: 1 },
+        opacity: 1,
+        visible: true
+      }
+    ]
+  })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, image.id), {
+    html: 'standalone',
+    imageSize: () => ({ width: 400, height: 500 })
+  })
+  return bundle.files[0].content
+}
+
+test('native cover-equivalent CROP retains the original IMG and authored position', async () => {
+  const html = await crop({ m00: 1, m01: 0, m02: 0, m10: 0, m11: 0.9, m12: 0.025 })
+  expect(html).toContain('<img ')
+  expect(html).toContain('object-fit: cover')
+  expect(html).toContain('object-position: 50% 25.000000000000007%')
