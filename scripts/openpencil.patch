+++ b/packages/core/tests/io/formats/fig/roundtrip/text/line-height-units.test.ts
@@ -0,0 +1,138 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import {
+  exportFigFile,
+  FigmaAPI,
+  fontManager,
+  initCodec,
+  parseFigFile,
+  SceneGraph
+} from '@open-pencil/core'
+import { getSharedStyles, lineHeightInPixels } from '@open-pencil/scene-graph'
+
+import { htmlFormat } from '#core/io'
+
+beforeAll(async () => {
+  await initCodec()
+  const font = await fontManager.fetchBundledFont('/Inter-Regular.ttf')
+  if (!font) throw new Error('Missing bundled Inter')
+  fontManager.markLoaded('Inter', 'Regular', font)
+})
+
+test('explicit relative, pixel and AUTO line heights survive ordinary FIG saves and font edits', async () => {
+  let graph = new SceneGraph()
+  let api = new FigmaAPI(graph)
+  const label = api.createText()
+  label.name = 'Editable relative leading'
+  label.characters = 'Base and runs'
+  label.fontSize = 16
+  label.lineHeight = { unit: 'PERCENT', value: 140 }
+  label.setRangeLineHeight(0, 4, { unit: 'PIXELS', value: 28.5 })
+  label.setRangeLineHeight(5, 8, { unit: 'AUTO' })
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const raw = [...graph.getAllNodes()].find((node) => node.name === label.name)
+    if (!raw) throw new Error('Missing reopened text')
+    api = new FigmaAPI(graph)
+    const text = api.getNodeById(raw.id)
+    if (!text || text.type !== 'TEXT') throw new Error('Missing public reopened text')
+    expect(raw.lineHeightUnit).toBe('PERCENT')
+    expect(raw.lineHeight).toBeCloseTo(140, 4)
+    expect(text.getRangeLineHeight(0, 4)).toEqual({ unit: 'PIXELS', value: 28.5 })
+    expect(text.getRangeLineHeight(5, 8)).toEqual({ unit: 'AUTO' })
+    expect(text.getRangeLineHeight(9, 13)).toMatchObject({ unit: 'PIXELS' })
+    text.fontSize = round === 0 ? 20 : 24
+    expect(raw.lineHeight).toBeCloseTo(140, 4)
+    expect(lineHeightInPixels(raw)).toBeCloseTo((round === 0 ? 20 : 24) * 1.4, 5)
+    const exportHTML = htmlFormat.exportContent
+    if (!exportHTML) throw new Error('Missing public HTML adapter')
+    const result = await exportHTML(
+      { graph, target: { scope: 'node', nodeId: raw.id }, fileName: 'text.html' },
+      { html: 'standalone' }
+    )
+    const relativeCSS = String(result.data).match(/line-height: ([\d.]+)(?:;|")/)
+    expect(Number(relativeCSS?.[1])).toBeCloseTo(1.4, 5)
+    expect(result.data).toContain('line-height: 28.5px')
+    expect(result.data).toContain('line-height: normal')
+  }
+})
+
+test('PERCENT 100 remains explicit while AUTO remains automatic', async () => {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  for (const [name, height] of [
+    ['Relative', { unit: 'PERCENT', value: 100 }],
+    ['Automatic', { unit: 'AUTO' }]
+  ] as const) {
+    const label = api.createText()
+    label.name = name
+    label.characters = 'Label'
+    label.lineHeight = height
+  }
+  const reopened = await parseFigFile((await exportFigFile(graph)).slice().buffer, {
+    populate: 'all'
+  })
+  const relative = [...reopened.getAllNodes()].find((node) => node.name === 'Relative')
+  const automatic = [...reopened.getAllNodes()].find((node) => node.name === 'Automatic')
+  expect(relative?.lineHeight).toBe(100)
+  expect(relative?.lineHeightUnit).toBe('PERCENT')
+  expect(automatic?.lineHeight).toBeNull()
+})
+
+test('relative shared styles and component text remain relative after instance synchronization and saves', async () => {
+  let graph = new SceneGraph()
+  let api = new FigmaAPI(graph)
+  const style = graph.createNode('TEXT', graph.getPages()[0].id, {
+    name: 'Shared relative leading',
+    sharedStyleType: 'TEXT',
+    internalOnly: true,
+    fontSize: 16,
+    lineHeight: 160,
+    lineHeightUnit: 'PERCENT'
+  })
+  style.source.id = 'style:0f9e8d7c6b5a'
+  graph.createNode('TEXT', graph.getPages()[0].id, {
+    name: 'Style sample',
+    text: 'Shared caption',
+    textStyleId: style.source.id
+  })
+  const component = api.createComponent()
+  component.name = 'Editable card'
+  const label = api.createText()
+  component.appendChild(label)
+  label.name = 'Card caption'
+  label.characters = 'An editable caption'
+  label.textStyleId = style.source.id
+  const occurrence = component.createInstance()
+  occurrence.name = 'Placed card'
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    api = new FigmaAPI(graph)
+    const shared = getSharedStyles(graph, 'text').find((entry) => entry.name === style.name)
+    if (!shared) throw new Error('Missing reopened shared style')
+    expect(graph.getNode(shared.nodeId)).toMatchObject({ lineHeightUnit: 'PERCENT' })
+    expect(graph.getNode(shared.nodeId)?.lineHeight).toBeCloseTo(160, 4)
+    const main = [...graph.getAllNodes()].find((node) => node.name === component.name)
+    const placed = [...graph.getAllNodes()].find((node) => node.name === occurrence.name)
+    if (!main || !placed) throw new Error('Missing reopened components')
+    const caption = graph.getChildren(main.id).find((node) => node.name === label.name)
+    const instanceCaption = graph.getChildren(placed.id).find((node) => node.name === label.name)
+    if (!caption || !instanceCaption) throw new Error('Missing reopened captions')
+    expect(caption.lineHeightUnit).toBe('PERCENT')
+    expect(instanceCaption.lineHeightUnit).toBe('PERCENT')
+    expect(caption.lineHeight).toBeCloseTo(round === 0 ? 160 : 175, 4)
+    expect(instanceCaption.lineHeight).toBeCloseTo(caption.lineHeight ?? 0, 4)
+    if (round === 0) {
+      expect(caption.textStyleId).toBe(shared.id)
+      expect(instanceCaption.textStyleId).toBe(shared.id)
+    }
+    const text = api.getNodeById(caption.id)
+    if (!text || text.type !== 'TEXT') throw new Error('Missing public caption')
+    text.lineHeight = { unit: 'PERCENT', value: 175 }
+    text.fontSize = 24
+    graph.syncInstances(main.id)
+    expect(caption.lineHeight).toBe(175)
+    expect(instanceCaption.lineHeight).toBe(175)
+    expect(lineHeightInPixels(instanceCaption)).toBe(42)
+  }
+})
diff --git a/packages/core/tests/io/formats/html/animation.test.ts b/packages/core/tests/io/formats/html/animation.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e4b901de5da8290b8500276492bb766fe6d114b5
--- /dev/null
+++ b/packages/core/tests/io/formats/html/animation.test.ts
@@ -0,0 +1,399 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { asInstanceNode } from '#core-tests/helpers/figma-api'
+
+import { exportFigFile, fontManager, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { FigmaAPI, type FigmaReaction } from '@open-pencil/core/figma-api'
+
+import { htmlFormat } from '#core/io'
+import { preparePrototypeAnimations } from '#core/io/formats/html/prototype/animations'
+
+beforeAll(async () => {
+  await initCodec()
+  const font = await fontManager.fetchBundledFont('/Inter-Regular.ttf')
+  if (!font) throw new Error('Missing bundled Inter')
+  fontManager.markLoaded('Inter', 'Regular', font)
+})
+
+const timed = (destinationId: string, instant = false): FigmaReaction => ({
+  trigger: { type: 'AFTER_TIMEOUT', timeout: instant ? 0.5 : 0 },
+  actions: [
+    {
+      type: 'NODE',
+      navigation: 'CHANGE_TO',
+      destinationId,
+      transition: instant
+        ? null
+        : { type: 'SMART_ANIMATE', duration: 0.12, easing: { type: 'EASE_OUT' } }
+    }
+  ]
+})
+
+function setup() {
+  const graph = new SceneGraph(),
+    api = new FigmaAPI(graph)
+  const states = ['start', 'end'].map((name, index) => {
+    const main = api.createComponent()
+    main.name = `state=${name}`
+    main.resize(180, 70)
+    main.fills = []
+    const cue = api.createFrame()
+    cue.name = 'Cue'
+    cue.resize(148, 38)
+    main.appendChild(cue)
+    cue.y = index === 0 ? 12 : 0
+    cue.opacity = index === 0 ? 0 : 1
+    const text = api.createText()
+    text.name = 'Caption'
+    text.characters = 'Editable native value'
+    cue.appendChild(text)
+    return { main, cue, text }
+  })
+  const set = api.combineAsVariants(
+    states.map((state) => state.main),
+    api.currentPage
+  )
+  set.name = 'Native timed component'
+  const property = set.addComponentProperty('label', 'TEXT', 'Editable native value')
+  for (const { text } of states) text.componentPropertyReferences = { characters: property }
+  return { graph, api, states, set, property }
+}
+
+function named(graph: SceneGraph, name: string) {
+  const nodes = [...graph.getAllNodes()].filter(
+    (node) => node.name === name && node.type !== 'INSTANCE'
+  )
+  if (!nodes.length) {
+    const placed = [...graph.getAllNodes()].filter((node) => node.name === name)
+    if (placed.length === 1 && placed[0]) return placed[0]
+  }
+  if (nodes.length !== 1 || !nodes[0]) throw new Error(`Expected one native ${name}`)
+  return nodes[0]
+}
+
+async function reopen(graph: SceneGraph) {
+  return parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+}
+
+async function html(graph: SceneGraph, id: string) {
+  const exporter = htmlFormat.exportContent
+  if (!exporter) throw new Error('Missing public HTML exporter')
+  return exporter(
+    { graph, target: { scope: 'node', nodeId: id } },
+    { html: 'standalone', fonts: 'assets' }
+  )
+}
+
+test.each(['COMPONENT', 'INSTANCE'] as const)(
+  '%s normal FIG exports preserve native text, endpoints and source state',
+  async (kind) => {
+    const initial = setup()
+    const start = initial.states[0],
+      end = initial.states[1]
+    if (!start || !end) throw new Error('Missing native states')
+    await start.main.setReactionsAsync([timed(end.main.id)])
+    const placed = start.main.createInstance()
+    placed.name = 'Placed timed component'
+    placed.setProperties({ [initial.property]: 'A public instance edit' })
+    let graph = initial.graph
+    for (let pass = 0; pass < 2; pass++) {
+      graph = await reopen(graph)
+      const root = named(graph, kind === 'INSTANCE' ? placed.name : start.main.name)
