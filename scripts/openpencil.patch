@@ -0,0 +1,71 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+
+import { htmlFormat } from '#core/io'
+
+beforeAll(async () => {
+  await initCodec()
+  const api = new FigmaAPI(new SceneGraph())
+  await api.loadFontAsync({ family: 'Liberation Serif', style: 'Regular' })
+  await api.loadFontAsync({ family: 'WenQuanYi Zen Hei', style: 'Regular' })
+})
+
+test('native FIG fallback formatting stays editable while standalone keeps explicit paragraph leading', async () => {
+  const graph = new SceneGraph()
+  const component = graph.createNode('COMPONENT', graph.getPages()[0].id, {
+    name: 'Fallback heading'
+  })
+  graph.createNode('TEXT', component.id, {
+    name: 'Fallback caption',
+    text: '文字',
+    fontFamily: 'Liberation Serif',
+    fontWeight: 400,
+    fontSize: 32,
+    lineHeight: 140,
+    lineHeightUnit: 'PERCENT',
+    styleRuns: [
+      { start: 0, length: 2, style: { fontFamily: 'WenQuanYi Zen Hei', fontWeight: 400 } }
+    ]
+  })
+  const fresh = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+  const text = [...fresh.getAllNodes()].find((node) => node.name === 'Fallback caption')
+  if (!text) throw new Error('Missing reopened caption')
+  const run = text.styleRuns[0]?.style
+  expect(text.lineHeightUnit).toBe('PERCENT')
+  expect(run?.fontFamily).toBe('WenQuanYi Zen Hei')
+  expect(run?.lineHeight).toBeUndefined()
+  const exporter = htmlFormat.exportContent
+  if (!exporter) throw new Error('Missing public HTML exporter')
+  const main = [...fresh.getAllNodes()].find((node) => node.name === component.name)
+  if (!main) throw new Error('Missing reopened main component')
+  const instance = fresh.createInstance(main.id, fresh.getPages()[0].id)
+  if (!instance) throw new Error('Missing native instance')
+  for (const target of [text, instance]) {
+    const context = {
+      graph: fresh,
+      target: { scope: 'node' as const, nodeId: target.id },
+      fileName: 'caption.html'
+    }
+    const native = await exporter(context, { html: 'standalone' })
+    expect(native.data).toContain('font-family: WenQuanYi Zen Hei; line-height: 0')
+    const fragment = await exporter(context, { html: 'fragment' })
+    expect(fragment.data).not.toContain('line-height: 0')
+  }
+  expect(text.styleRuns[0]?.style).toEqual(run)
+  const copied = fresh.getChildren(instance.id).find((node) => node.type === 'TEXT')
+  if (!copied) throw new Error('Missing instance caption')
+  const editable = new FigmaAPI(fresh).getNodeById(copied.id)
+  if (!editable || editable.type !== 'TEXT') throw new Error('Missing editable instance caption')
+  editable.characters = '別の文章'
+  const edited = await exporter(
+    { graph: fresh, target: { scope: 'node', nodeId: instance.id }, fileName: 'edited.html' },
+    { html: 'standalone' }
+  )
+  expect(edited.data).toContain('別の文章')
+  expect(edited.data).toContain('font-family: WenQuanYi Zen Hei; line-height: 0')
+  const saved = await parseFigFile((await exportFigFile(fresh)).slice().buffer, { populate: 'all' })
+  const reopened = [...saved.getAllNodes()].find((node) => node.text === '別の文章')
+  expect(reopened?.styleRuns[0]?.style.fontFamily).toBe('WenQuanYi Zen Hei')
+  expect(reopened?.lineHeightUnit).toBe('PERCENT')
+})
