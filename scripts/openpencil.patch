+    const document = nativeStandaloneDocument(sceneNodeToDesignDocument(graph, root.id), () => ({
+      width: 1,
+      height: 1,
+      opaque: true
+    }))
+    const projected = document.children[0]
+    if (projected?.type !== 'element') throw new Error('Missing standalone frame')
