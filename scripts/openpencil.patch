+  expect(child.width).toBe(312.5)
+  expect(child.height).toBe(48)
+  expect(child.derivedLayout).toBeNull()
+  expect(child.derivedTextGlyphs).toBeNull()
+})
+
+test('a full-range font continues to cover replacement text through properties and characters', () => {
+  const { api, instance, property, child } = setup()
+  const style = { fontFamily: 'WenQuanYi Zen Hei', fontWeight: 400 }
