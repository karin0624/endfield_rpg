+          attrs: {
+            ...shape.attrs,
+            transform: `translate(${native.x} ${native.y})${shape.attrs.transform ? ` ${shape.attrs.transform}` : ''}`
+          }
+        }))
+    })
+    const definitions = element('defs', {}, [
+      element('clipPath', { id, clipPathUnits: 'userSpaceOnUse' }, shapes)
+    ])
+    if (
+      content.every(
+        (item): item is DesignElement => item.type === 'element' && item.tagName === 'svg'
+      )
+    ) {
+      const svgContent = content.map((item) => {
