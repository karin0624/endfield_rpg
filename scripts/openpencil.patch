+      expect(reopenedIcon.childIds.length).toBeGreaterThan(0)
+      const editable = new FigmaAPI(graph).getNodeById(label.id)
+      if (!editable || editable.type !== 'TEXT') throw new Error('Missing public editable text')
+      editable.characters = 'Changed native label'
