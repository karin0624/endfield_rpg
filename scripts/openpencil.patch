--- /dev/null
+++ b/packages/core/tests/canvas/skew.test.ts
@@ -0,0 +1,79 @@
+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+import { colorToFill } from '@open-pencil/scene-graph/color'
+
+import { SkiaRenderer } from '#core/canvas/renderer'
+import { getCanvasKit } from '#core/canvaskit'
+import { FigmaAPI } from '#core/figma-api'
+import { exportFigFile } from '#core/io/formats/fig/export'
+import { parseFigFile } from '#core/io/formats/fig/read'
+
+import { expectDefined } from '../helpers/assert'
+
+test('the GUI scene draws a saved skew as the documented unit-axis matrix after editing', async () => {
+  const ck = await getCanvasKit()
+  const surface = expectDefined(ck.MakeSurface(180, 100))
+  const reference = expectDefined(ck.MakeSurface(180, 100))
+  const renderer = new SkiaRenderer(ck, surface)
+  let graph = new SceneGraph()
+  let api = new FigmaAPI(graph)
+  const rectangle = api.createRectangle()
+  rectangle.name = 'Skew artwork'
+  rectangle.resize(100, 50)
+  rectangle.relativeTransform = [
+    [1, 0.6, 10],
+    [0, 0.8, 20]
+  ]
+  const initialPaint = colorToFill('#ff0000')
+  rectangle.fills = [initialPaint]
+  try {
+    for (const green of [false, true]) {
+      const current = [...graph.getAllNodes()].find(
+        (candidate) => candidate.name === rectangle.name
+      )
+      if (!current) throw new Error('Missing native artwork')
+      api.wrapNode(current.id).fills = [
+        {
+          type: 'SOLID',
+          color: { r: green ? 0 : 1, g: green ? 1 : 0, b: 0, a: 1 },
+          visible: true,
+          opacity: 1
+        }
+      ]
+      const bytes = await exportFigFile(graph)
+      graph = await parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate: 'all' })
+      api = new FigmaAPI(graph)
+      const node = [...graph.getAllNodes()].find((candidate) => candidate.name === rectangle.name)
+      if (!node) throw new Error('Missing native artwork')
+      const actual = surface.getCanvas(),
+        expected = reference.getCanvas()
+      actual.clear(ck.TRANSPARENT)
+      expected.clear(ck.TRANSPARENT)
+      renderer.renderSceneToCanvas(actual, graph, graph.getPages()[0].id)
+      const paint = new ck.Paint()
+      paint.setAntiAlias(true)
+      paint.setColor(green ? ck.GREEN : ck.RED)
+      expected.save()
+      expected.concat([1, 0.6, 10, 0, 0.8, 20, 0, 0, 1])
+      expected.drawRect(ck.XYWHRect(0, 0, 100, 50), paint)
+      expected.restore()
+      paint.delete()
+      const format = {
+        width: 180,
+        height: 100,
+        alphaType: ck.AlphaType.Unpremul,
+        colorType: ck.ColorType.RGBA_8888,
+        colorSpace: ck.ColorSpace.SRGB
+      }
+      const pixels = expectDefined(actual.readPixels(0, 0, format))
+      const referencePixels = expectDefined(expected.readPixels(0, 0, format))
+      expect(pixels.byteLength).toBe(180 * 100 * 4)
+      expect(pixels.some((value, index) => index % 4 === 3 && value > 0)).toBe(true)
+      expect(pixels).toEqual(referencePixels)
+    }
+  } finally {
+    renderer.destroy()
+    reference.delete()
+  }
+})
