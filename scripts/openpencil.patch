+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+
+import { htmlFormat } from '#core/io'
+
+beforeAll(initCodec)
+
+const fill = {
+  type: 'SOLID' as const,
+  color: { r: 1, g: 1, b: 1, a: 1 },
+  opacity: 1,
+  visible: true
+}
+
+test.each([
+  { name: 'visible nested clock', clip: false, state: 'active', literal: true },
+  { name: 'clock below a clipped frame', clip: true, state: 'active', literal: true },
+  { name: 'hidden clock occurrence', clip: true, state: 'hidden', literal: false },
+  { name: 'clock below a hidden ancestor', clip: true, state: 'hidden-ancestor', literal: false },
+  { name: 'static nested component', clip: true, state: 'static', literal: false },
+  { name: 'clock in another control', clip: true, state: 'unrelated', literal: false }
+])('normal FIG $name preserves the native focus paint order', async ({ clip, state, literal }) => {
+  let graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const root = graph.createNode('FRAME', api.currentPage.id, {
+    name: 'Native controls',
+    width: 320,
+    height: 80,
+    fills: []
+  })
+  const owner = graph.createNode('FRAME', root.id, {
+    name: 'Focused surface',
+    width: 160,
+    height: 80,
+    fills: [fill],
+    cornerRadius: 8,
+    layoutMode: 'VERTICAL',
+    primaryAxisSizing: 'HUG',
+    counterAxisSizing: 'FIXED'
+  })
+  graph.createNode('TEXT', owner.id, {
+    name: 'Editable label',
+    text: 'Original value',
+    width: 120,
+    height: 24
+  })
+  const viewport = graph.createNode('FRAME', state === 'unrelated' ? root.id : owner.id, {
+    name: 'Value viewport',
+    x: 4,
+    y: 4,
+    width: 20,
+    height: 20,
+    fills: [],
+    clipsContent: clip,
+    visible: state !== 'hidden-ancestor'
+  })
+  const mains = [1, 0].map((opacity, index) => {
+    const main = api.createComponent()
+    main.name = `visible=${index === 0}`
+    main.resize(1, 20)
+    main.fills = []
+    graph.createNode('RECTANGLE', main.id, {
+      name: 'Caret',
+      width: 1,
+      height: 20,
+      fills: [fill],
+      opacity
+    })
+    return main
+  })
+  api.combineAsVariants(mains, api.currentPage)
+  if (state !== 'static')
+    for (const [index, main] of mains.entries()) {
+      await api.wrapNode(main.id).setReactionsAsync([
+        {
+          trigger: { type: 'AFTER_TIMEOUT', timeout: 0.5 },
+          actions: [
+            {
+              type: 'NODE',
+              navigation: 'CHANGE_TO',
+              destinationId: mains[1 - index].id,
+              transition: null
+            }
+          ]
+        }
+      ])
+    }
+  const caret = graph.createInstance(mains[0].id, viewport.id, { name: 'Insertion caret' })
+  if (!caret) throw new Error('Missing native caret occurrence')
+  api.wrapNode(caret.id).visible = state !== 'hidden'
+  const group = graph.createNode('FRAME', owner.id, {
+    name: 'Final focus layer',
+    width: 160,
+    height: 80,
+    fills: [],
+    layoutPositioning: 'ABSOLUTE',
+    horizontalConstraint: 'STRETCH',
+    verticalConstraint: 'STRETCH'
+  })
+  graph.createNode('RECTANGLE', group.id, {
+    name: 'Focus indicator',
+    x: -2,
+    y: -2,
+    width: 164,
+    height: 84,
+    cornerRadius: 10,
+    fills: [],
+    strokes: [{ ...fill, weight: 2, align: 'OUTSIDE' }],
+    strokeWeight: 2,
+    strokeAlign: 'OUTSIDE',
+    horizontalConstraint: 'STRETCH',
+    verticalConstraint: 'STRETCH'
+  })
+
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const nodes = [...graph.getAllNodes()]
+    const named = (name: string) => {
+      const matches = nodes.filter((node) => node.name === name)
+      expect(matches).toHaveLength(1)
+      const node = matches[0]
+      if (!node) throw new Error(`Missing native ${name}`)
+      return node
+    }
+    const focus = named('Focus indicator')
+    const finalLayer = named('Final focus layer')
+    const exporter = htmlFormat.exportContent
+    if (!exporter) throw new Error('Missing public HTML exporter')
+    const exported = await exporter(
+      { graph, target: { scope: 'node', nodeId: named('Native controls').id } },
+      { html: 'standalone' }
+    )
+    const html = String(exported.data)
+    expect(html.includes(`data-open-pencil-node-id="${focus.id}"`)).toBe(literal)
+    expect(html.includes(`data-open-pencil-node-id="${finalLayer.id}"`)).toBe(literal)
+    expect(html).toContain('Original value')
+    expect(html.includes('outline-offset: 2px')).toBe(!literal)
+    expect(focus.x).toBe(-2)
+    expect(focus.width).toBe(164)
+    expect(focus.strokes[0].align).toBe('OUTSIDE')
+  }
+})
diff --git a/packages/core/tests/io/formats/html/prototype.test.ts b/packages/core/tests/io/formats/html/prototype.test.ts
