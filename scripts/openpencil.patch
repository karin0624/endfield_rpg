+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph, type Effect } from '@open-pencil/scene-graph'
+
+const shadow: Effect = {
+  type: 'DROP_SHADOW',
+  offset: { x: 0, y: 5 },
+  radius: 30,
+  spread: 0,
+  color: { r: 0, g: 0, b: 0, a: 0.4 },
+  visible: true
+}
+
+test('native layer blends preserve the isolated parent and the editable overlay opacity', async () => {
+  const graph = new SceneGraph()
+  const group = graph.createNode('COMPONENT', graph.getPages()[0].id, {
+    width: 100,
+    height: 100,
+    blendMode: 'NORMAL',
+    opacity: 0.65,
+    fills: []
+  })
+  const overlay = graph.createNode('RECTANGLE', group.id, {
+    width: 100,
+    height: 100,
+    blendMode: 'SATURATION',
+    opacity: 0.7
+  })
+  const render = () =>
+    exportHTMLBundle(sceneNodeToDesignDocument(graph, group.id), { html: 'standalone' })
+  const first = (await render()).files[0].content
+  expect(first).toContain('isolation: isolate')
+  expect(first).toContain('mix-blend-mode: saturation')
+  expect(first).toContain('opacity: 0.7')
+  expect(first).toContain('opacity: 0.65')
+  graph.updateNode(overlay.id, { blendMode: 'COLOR' })
+  expect((await render()).files[0].content).toContain('mix-blend-mode: color')
+})
+
+test('image shadows follow original image alpha at the native blur radius', async () => {
+  const graph = new SceneGraph()
+  graph.images.set('original', new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10]))
+  const image = graph.createNode('RECTANGLE', graph.getPages()[0].id, {
+    width: 40,
+    height: 60,
+    effects: [shadow],
+    fills: [
+      {
+        type: 'IMAGE',
+        imageHash: 'original',
+        imageScaleMode: 'FIT',
+        color: { r: 0, g: 0, b: 0, a: 1 },
+        opacity: 1,
+        visible: true
+      }
+    ]
+  })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, image.id), {
+    html: 'standalone'
+  })
+  const html = bundle.files[0].content
+  expect(html).toContain('<img ')
+  expect(html).toContain('object-fit: contain')
+  expect(html).toContain('filter: drop-shadow(0px 5px 15px rgba(0, 0, 0, 0.4))')
+  expect(html).not.toContain('box-shadow:')
+  expect(html).toContain('data:image/png;base64,iVBORw0KGgo=')
+})
+
+test('paintless container shadows use the children alpha while opaque rectangles stay boxes', async () => {
+  const graph = new SceneGraph()
+  const group = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 100,
+    height: 100,
+    effects: [shadow],
+    fills: []
+  })
+  graph.createNode('ELLIPSE', group.id, { width: 20, height: 20 })
+  const opaque = graph.createNode('RECTANGLE', group.id, {
+    x: 40,
+    width: 20,
+    height: 20,
+    effects: [shadow],
+    fills: [{ type: 'SOLID', color: { r: 1, g: 1, b: 1, a: 1 }, opacity: 1, visible: true }]
+  })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, group.id), {
+    html: 'standalone'
+  })
+  expect(bundle.files[0].content).toContain('filter: drop-shadow(0px 5px 15px rgba(0, 0, 0, 0.4))')
+  expect(bundle.files[0].content).toContain('box-shadow: 0px 5px 30px 0px rgba(0, 0, 0, 0.4)')
+  expect(graph.getNode(opaque.id)?.effects[0]).toEqual(shadow)
+})
+
+test('alpha-shaped shadow spread is reported rather than silently dropped', async () => {
+  const graph = new SceneGraph()
+  const group = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 100,
+    height: 100,
+    effects: [{ ...shadow, spread: 2 }],
+    fills: []
+  })
+  graph.createNode('ELLIPSE', group.id, { width: 20, height: 20 })
+  await expect(
+    exportHTMLBundle(sceneNodeToDesignDocument(graph, group.id), { html: 'standalone' })
+  ).rejects.toThrow('alpha-shaped shadows do not support spread')
+})
+
+test('native blur radii become CSS standard deviations only in standalone output', async () => {
+  const graph = new SceneGraph()
+  const frame = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 100,
+    height: 100,
+    effects: [
+      { ...shadow, type: 'LAYER_BLUR', radius: 5 },
+      { ...shadow, type: 'BACKGROUND_BLUR', radius: 12 }
