+import { expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { renderNodesToSVG } from '#core/io/formats/svg/export'
+import { createSVGNodes } from '#core/io/formats/svg/import'
+
+test('imported SVG gradient strokes keep their editable paint and export as gradients', () => {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  const imported = createSVGNodes(
+    graph,
+    page.id,
+    `<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><defs><linearGradient id="metal"><stop stop-color="#ffffff" stop-opacity=".25"/><stop offset="1" stop-color="#000000"/></linearGradient></defs><path d="M10 10H90V90H10Z" fill="none" stroke="url(#metal)" stroke-width="1.234567" stroke-opacity=".6"/></svg>`
+  )
+  const frame = expectDefined(imported, 'imported SVG')
+  const vector = expectDefined(
+    graph.getChildren(frame.id).find((node) => node.type === 'VECTOR'),
+    'imported vector'
+  )
+  expect(vector.strokes[0]).toMatchObject({
+    type: 'GRADIENT_LINEAR',
+    weight: 1.234567,
+    opacity: 0.6,
+    gradientStops: [
+      { position: 0, color: { r: 1, g: 1, b: 1, a: 0.25 } },
+      { position: 1, color: { r: 0, g: 0, b: 0, a: 1 } }
+    ]
+  })
+  const svg = renderNodesToSVG(graph, page.id, [frame.id])
+  expect(svg).toContain('<linearGradient')
+  expect(svg).toContain('stroke="url(#')
+  expect(svg).toContain('stroke-width="1.234567"')
+  expect(svg).toContain('stroke-opacity="0.6"')
+  expect(svg).toContain('stop-opacity="0.25"')
+})
diff --git a/packages/core/tests/io/formats/svg/masks.test.ts b/packages/core/tests/io/formats/svg/masks.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a4c61d270d5104305b20a69c52f2a6c447bbb2aa
--- /dev/null
+++ b/packages/core/tests/io/formats/svg/masks.test.ts
@@ -0,0 +1,263 @@
+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+import type { MaskType, SceneNode } from '@open-pencil/scene-graph'
+
+import { FigmaAPI } from '#core/figma-api'
+import { svgFormat } from '#core/io/formats'
+import { exportFigFile } from '#core/io/formats/fig/export'
+import { parseFigFile } from '#core/io/formats/fig/read'
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { parseSVGDocument } from '#core/io/formats/svg/document'
+
+const solid = (red: number, green: number, blue: number, opacity = 1) => ({
+  type: 'SOLID' as const,
+  color: { r: red, g: green, b: blue, a: 1 },
+  opacity,
+  visible: true
+})
+
+function fixture(type: MaskType) {
+  const graph = new SceneGraph()
+  const frame = graph.createNode('FRAME', graph.getPages()[0].id, {
+    name: 'Artwork',
+    width: 100,
+    height: 60,
+    fills: [],
+    exportSettings: [{ format: 'svg', scale: 1 }]
+  })
+  const mask = graph.createNode('RECTANGLE', frame.id, {
+    name: 'Coverage',
+    x: 5,
+    y: 7,
+    width: 40,
+    height: 24,
+    isMask: true,
+    maskType: type,
+    fills: [solid(1, 1, 1, type === 'VECTOR' ? 0 : 0.5)]
+  })
+  const content = graph.createNode('RECTANGLE', frame.id, {
+    name: 'Content',
+    width: 80,
+    height: 50,
+    fills: [solid(1, 0, 0)]
+  })
+  return { graph, frame, mask, content }
+}
+
+async function reopen(graph: SceneGraph) {
+  const bytes = await exportFigFile(graph)
+  return parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate: 'all' })
+}
+
+function named(graph: SceneGraph, name: string): SceneNode {
+  const node = [...graph.getAllNodes()].find((node) => node.name === name)
+  if (!node) throw new Error(`Missing native node: ${name}`)
+  return node
+}
+
+async function exportedSVG(graph: SceneGraph) {
+  if (!svgFormat.exportContent) throw new Error('Public SVG export is unavailable')
+  const result = await svgFormat.exportContent(
+    {
+      graph,
+      target: { scope: 'node', nodeId: named(graph, 'Artwork').id },
+      fileName: 'art.svg'
+    },
+    { precision: null, xmlDeclaration: false }
+  )
+  if (typeof result.data !== 'string') throw new Error('SVG export must return editable XML')
+  const document = parseSVGDocument(result.data)
+  if (!document) throw new Error('Invalid exported SVG')
+  return { text: result.data, document }
+}
+
+for (const type of ['VECTOR', 'ALPHA', 'LUMINANCE'] as const) {
+  test(`normal FIG reopening keeps ${type} coverage in public SVG and ordinary HTML exports`, async () => {
+    const source = fixture(type)
+    const graph = await reopen(source.graph)
+    const mask = named(graph, 'Coverage')
+    expect(mask.isMask).toBe(true)
+    expect(mask.maskType).toBe(type)
+    const { text, document } = await exportedSVG(graph)
+    const clips = [...document.getElementsByTagName('clipPath')]
+    const masks = [...document.getElementsByTagName('mask')]
+    if (type === 'VECTOR') {
+      expect(clips.length).toBeGreaterThan(0)
+      expect(text).toContain('clip-path="url(#')
+      expect(clips[0].getElementsByTagName('rect')[0].getAttribute('transform')).toBe(
+        'translate(5, 7)'
+      )
+    } else {
+      expect(masks.some((node) => node.getAttribute('mask-type') === 'alpha')).toBe(true)
+      expect(text).toContain('mask="url(#')
+      if (type === 'LUMINANCE')
+        expect(masks.some((node) => node.getAttribute('mask-type') === 'luminance')).toBe(true)
+    }
+    const artifact = await renderNodesToHTML(graph, [named(graph, 'Artwork').id], {
+      html: 'standalone',
+      assets: 'external'
+    })
+    expect(artifact.html).toContain('<svg ')
+    expect(artifact.assets.some((asset) => asset.path.endsWith('.svg'))).toBe(false)
+    expect(artifact.html).not.toContain('data:image/png')
+    expect(graph.images.size).toBe(0)
+    expect(named(graph, 'Coverage').type).toBe('RECTANGLE')
+    const api = new FigmaAPI(graph)
+    api.wrapNode(mask.id).visible = false
+    const edited = await reopen(graph)
+    const unmasked = await exportedSVG(edited)
+    expect(unmasked.text).not.toContain('mask="url(#')
+    expect(unmasked.text).not.toContain('clip-path="url(#')
+    expect(unmasked.text).toContain('fill="#FF0000"')
+  })
+}
+
+test('consecutive and repeated masks cover only their following siblings, including transformed outlines', async () => {
+  const { graph, frame, mask } = fixture('VECTOR')
+  graph.updateNode(mask.id, { rotation: 90 })
+  graph.createNode('ELLIPSE', frame.id, {
+    name: 'Second coverage',
+    x: 50,
+    width: 20,
+    height: 20,
+    isMask: true,
+    maskType: 'ALPHA',
+    fills: [solid(1, 1, 1, 0.5)]
+  })
+  graph.createNode('RECTANGLE', frame.id, {
+    name: 'Second content',
+    width: 100,
+    height: 60,
+    fills: [solid(0, 0, 1)]
+  })
+  graph.createNode('RECTANGLE', frame.id, {
+    name: 'Additional coverage',
+    x: 15,
+    y: 7,
+    width: 20,
+    height: 24,
+    isMask: true,
+    maskType: 'ALPHA',
+    fills: [solid(1, 1, 1, 0.5)]
+  })
+  const lonely = graph.createNode('RECTANGLE', frame.id, {
+    name: 'Consecutive coverage',
+    x: 25,
+    y: 7,
+    width: 20,
+    height: 24,
+    isMask: true,
+    maskType: 'ALPHA',
+    fills: [solid(1, 1, 1, 0.5)]
+  })
+  graph.createNode('RECTANGLE', frame.id, {
+    name: 'Union content',
+    width: 100,
+    height: 60,
+    fills: [solid(0, 1, 0)]
+  })
+  graph.createNode('RECTANGLE', frame.id, {
+    name: 'Unused mask',
+    isMask: true,
+    maskType: 'LUMINANCE',
+    fills: [solid(1, 1, 1)]
+  })
+  const fresh = await reopen(graph)
+  const { text } = await exportedSVG(fresh)
+  expect(text).toContain('rotate(90, 20, 12)')
+  expect(text).toContain('fill="#FF0000"')
+  expect(text).toContain('fill="#0000FF"')
+  expect(text).toContain('fill="#00FF00"')
+  expect(text).not.toContain('mask-type="luminance"')
+  expect(named(fresh, lonely.name).isMask).toBe(true)
+})
+
+test('soft vector masks preserve layer opacity and masks outside their owner keep their native region', async () => {
+  const { graph, mask } = fixture('VECTOR')
+  graph.updateNode(mask.id, { opacity: 0.5, x: -12 })
+  const fresh = await reopen(graph)
+  const { document, text } = await exportedSVG(fresh)
+  const maskNode = document.getElementsByTagName('mask')[0]
+  expect(maskNode.getAttribute('mask-type')).toBe('alpha')
+  expect(maskNode.getAttribute('maskUnits')).toBe('objectBoundingBox')
+  expect(text).toContain('translate(-12, 7)')
+  expect(text).toContain('opacity="0.5"')
+  expect(text).not.toContain('rgba(255, 255, 255, 0)')
+})
+
+for (const type of ['ALPHA', 'LUMINANCE'] as const) {
+  test(`${type} masks keep local coverage under transformed ancestors after native editing`, async () => {
+    const { graph, frame, mask } = fixture(type)
+    const api = new FigmaAPI(graph)
+    const ancestor = api.createFrame()
+    ancestor.name = 'Transformed owner'
+    ancestor.resize(400, 300)
+    ancestor.relativeTransform = [
+      [0.8, -0.6, 180],
+      [0.6, 0.8, -90]
+    ]
+    ancestor.appendChild(api.wrapNode(frame.id))
+    api.wrapNode(frame.id).relativeTransform = [
+      [1, 0.6, 30],
+      [0, 0.8, 40]
+    ]
+    for (const editedX of [5, -12]) {
+      api.wrapNode(mask.id).x = editedX
+      const fresh = await reopen(graph)
+      const { document } = await exportedSVG(fresh)
+      const masks = [...document.getElementsByTagName('mask')]
+      expect(masks.length).toBeGreaterThan(0)
+      for (const node of masks) {
+        expect(node.getAttribute('maskUnits')).toBe('objectBoundingBox')
+        expect(node.hasAttribute('x')).toBe(false)
+        expect(node.hasAttribute('width')).toBe(false)
+      }
+    }
+  })
+}
+
+test('large stroke outsets retain explicit local mask bounds under transformed ancestors', async () => {
+  const { graph, frame, content } = fixture('ALPHA')
+  graph.updateNode(content.id, {
+    strokes: [{ ...solid(0, 0, 1), weight: 40, align: 'CENTER' }],
+    strokeWeight: 40,
+    strokeAlign: 'CENTER'
+  })
+  new FigmaAPI(graph).wrapNode(frame.id).relativeTransform = [
+    [1, 0.6, 30],
+    [0, 0.8, 40]
+  ]
+  const fresh = await reopen(graph)
+  const { document } = await exportedSVG(fresh)
+  for (const mask of document.getElementsByTagName('mask')) {
+    expect(mask.getAttribute('maskUnits')).toBe('userSpaceOnUse')
+    expect(Number(mask.getAttribute('x'))).toBeLessThanOrEqual(-20)
+    expect(Number(mask.getAttribute('y'))).toBeLessThanOrEqual(-20)
+    expect(Number(mask.getAttribute('width'))).toBeGreaterThanOrEqual(120)
+    expect(Number(mask.getAttribute('height'))).toBeGreaterThanOrEqual(90)
+  }
+})
+
