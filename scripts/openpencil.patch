@@ -0,0 +1,74 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { parseFigBuffer } from '@open-pencil/fig'
+
+beforeAll(initCodec)
+
+test('native export rows survive ordinary FIG saves and public setting and text edits', async () => {
+  let graph = new SceneGraph()
+  let api = new FigmaAPI(graph)
+  const made = api.createFrame()
+  made.name = 'Exportable editable UI'
+  const text = api.createText()
+  made.appendChild(text)
+  text.name = 'Native copy'
+  text.characters = 'Original'
+  expect(made.exportSettings).toEqual([])
+  made.exportSettings = [
+    { format: 'PNG', constraint: { type: 'SCALE', value: 2 } },
+    { format: 'JPG', constraint: { type: 'SCALE', value: 3 } },
+    { format: 'SVG' },
+    { format: 'PDF' }
+  ]
+  const expected = [...made.exportSettings]
+  for (let round = 0; round < 2; round++) {
+    const bytes = await exportFigFile(graph)
+    const raw = parseFigBuffer(bytes.slice().buffer).nodeChanges.find(
+      (node) => node.name === made.name
+    )
+    expect(raw?.exportSettings).toEqual(
+      (round === 0 ? ['PNG', 'JPEG', 'SVG', 'PDF'] : ['SVG']).map((imageType, index) => ({
+        imageType,
+        constraint: { type: 'CONTENT_SCALE', value: round === 0 && index < 2 ? index + 2 : 1 }
+      }))
+    )
+    expect(raw?.pluginData?.some((entry) => entry.key === 'exportSettings')).not.toBe(true)
+    graph = await parseFigFile(bytes.slice().buffer, { populate: 'all' })
+    api = new FigmaAPI(graph)
+    const frame = api.currentPage.findOne((node) => node.name === made.name)
+    const copy = frame?.findOne((node) => node.name === text.name)
+    if (!frame || !copy) throw new Error('Missing editable export target')
+    expect(frame.exportSettings).toEqual(round === 0 ? expected : [{ format: 'SVG' }])
+    expect(copy.characters).toBe(round === 0 ? 'Original' : 'Saved edit')
+    frame.exportSettings = [{ format: 'SVG' }]
+    copy.characters = 'Saved edit'
+  }
+  const cleared = api.currentPage.findOne((node) => node.name === made.name)
+  if (!cleared) throw new Error('Missing saved export target')
+  cleared.exportSettings = []
+  graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+  expect([...graph.getAllNodes()].find((node) => node.name === made.name)?.exportSettings).toEqual(
+    []
+  )
+})
+
+test('export rows copy values and reject unimplemented options without losing existing settings', () => {
+  const api = new FigmaAPI(new SceneGraph())
+  const frame = api.createFrame()
+  const input: ExportSettingsImage[] = [{ format: 'PNG', constraint: { type: 'SCALE', value: 2 } }]
+  frame.exportSettings = input
+  input.length = 0
+  expect(frame.exportSettings).toEqual([{ format: 'PNG', constraint: { type: 'SCALE', value: 2 } }])
+  const before = structuredClone(frame.exportSettings)
+  expect(() => {
+    frame.exportSettings = [{ format: 'PNG', constraint: { type: 'WIDTH', value: 200 } }]
+  }).toThrow('Unsupported export settings')
+  expect(() => {
+    frame.exportSettings = [{ format: 'SVG', svgOutlineText: true }]
+  }).toThrow('Unsupported export settings')
+  expect(() => {
+    frame.exportSettings = [{ format: 'PNG', constraint: { type: 'SCALE', value: 0 } }]
+  }).toThrow('Unsupported export settings')
+  expect(frame.exportSettings).toEqual(before)
+})
