+import { afterEach, expect, test } from 'bun:test'
+
+import { asTextNode, createAPI } from '#core-tests/helpers/figma-api'
+
+import { setTextMeasurer } from '@open-pencil/core'
+
+afterEach(() => setTextMeasurer(null))
+
+function setup() {
+  const api = createAPI()
+  const component = api.createComponent()
+  const label = api.createText()
+  label.characters = 'ENDFIELD RPG'
+  label.fontName = { family: 'Liberation Serif', style: 'Regular' }
+  component.appendChild(label)
+  const property = component.addComponentProperty('Label', 'TEXT', label.characters)
+  label.componentPropertyReferences = { characters: property }
+  const instance = component.createInstance()
+  const labelInstance = instance.children[0]
+  if (!labelInstance) throw new Error('Missing instance text child')
+  const child = api.graph.getNode(labelInstance.id)
+  if (!child) throw new Error('Missing instance text node')
+  const glyphs = [{ commandsBlob: new Uint8Array([0]), x: 0, y: 30, fontSize: 32 }]
+  api.graph.updateNode(child.id, {
+    fontFamily: 'Liberation Serif',
+    fontSize: 32,
+    width: 245.875,
+    height: 44.8,
+    textAutoResize: 'WIDTH_AND_HEIGHT',
+    derivedLayout: { width: 245.875, height: 44.8 },
+    derivedTextGlyphs: glyphs
+  })
+  return { api, instance, property, child, glyphs }
+}
+
+test('assigning the current text property preserves authored bounds and glyphs', () => {
+  const { instance, property, child, glyphs } = setup()
+  let measurements = 0
+  setTextMeasurer(() => {
+    measurements++
+    return { width: 231, height: 38 }
+  })
+
+  instance.setProperties({ [property]: 'ENDFIELD RPG' })
+  instance.setProperties({ [property]: 'ENDFIELD RPG' })
+
+  expect(measurements).toBe(0)
+  expect(child.width).toBe(245.875)
+  expect(child.height).toBe(44.8)
+  expect(child.derivedLayout).toEqual({ width: 245.875, height: 44.8 })
+  expect(child.derivedTextGlyphs).toBe(glyphs)
+  expect(instance.componentProperties[property]?.value).toBe('ENDFIELD RPG')
+})
+
+test('changing a text property remeasures its new content and clears old glyphs', () => {
+  const { instance, property, child } = setup()
+  const measured: string[] = []
+  setTextMeasurer((node) => {
+    measured.push(node.text)
+    return { width: 312.5, height: 48 }
+  })
+
+  instance.setProperties({ [property]: 'A different title' })
+
