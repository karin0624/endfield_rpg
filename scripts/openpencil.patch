index 0000000000000000000000000000000000000000..1866ce20a632171bf232bdad444213e27ad1769a
--- /dev/null
+++ b/packages/core/src/io/formats/html/native-grayscale.ts
@@ -0,0 +1,147 @@
+import {
+  sceneNodeToDesignDocument,
+  type DesignElement,
+  type VectorElementRenderer
+} from '@open-pencil/dom-css/export'
+import {
+  reconcileVariableBindings,
+  resolvedPaintBindings,
+  type SceneGraph,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+import { extractExportGraph } from '#core/io/subgraph'
+
+import { vectorElement, vectorGroupElement } from './vectors'
+
+function plain(node: SceneNode): boolean {
+  return (
+    node.visible &&
+    node.opacity === 1 &&
+    node.rotation === 0 &&
+    node.skew === 0 &&
+    node.layoutMode === 'NONE' &&
+    node.cornerRadius === 0 &&
+    !node.independentCorners &&
+    !node.effects.some((effect) => effect.visible) &&
+    !node.strokes.some((stroke) => stroke.visible) &&
+    (node.blendMode === 'NORMAL' || node.blendMode === 'PASS_THROUGH')
+  )
+}
+
+function covers(node: SceneNode, owner: SceneNode): boolean {
+  return node.x === 0 && node.y === 0 && node.width === owner.width && node.height === owner.height
+}
+
+function opaqueRectangle(node: SceneNode, owner: SceneNode, channel?: 0 | 1): boolean {
+  if (
+    node.type !== 'RECTANGLE' ||
+    node.isMask ||
+    node.childIds.length ||
+    !plain(node) ||
+    !covers(node, owner)
+  )
+    return false
+  const fills = node.fills.filter((fill) => fill.visible)
+  if (fills.some((fill) => fill.blendMode && fill.blendMode !== 'NORMAL')) return false
+  if (channel === undefined)
+    return fills.some((fill) => fill.type === 'SOLID' && fill.opacity === 1 && fill.color.a === 1)
+  if (fills.length !== 1) return false
+  const fill = fills[0]
+  return (
+    fill.type === 'SOLID' &&
+    fill.opacity === 1 &&
+    fill.color.a === 1 &&
+    fill.color.r === channel &&
+    fill.color.g === channel &&
+    fill.color.b === channel
+  )
+}
+
+function opaqueMask(graph: SceneGraph, mask: SceneNode, owner: SceneNode): boolean {
+  if (
+    mask.type !== 'FRAME' ||
+    !mask.isMask ||
+    mask.maskType !== 'LUMINANCE' ||
+    !plain(mask) ||
+    !covers(mask, owner) ||
+    mask.fills.some((fill) => fill.visible)
+  )
+    return false
+  const background = graph.getChildren(mask.id).find((child) => child.visible)
+  return !!background && !background.isMask && opaqueRectangle(background, mask)
+}
+
+function composition(graph: SceneGraph, owner: SceneNode) {
+  if (!plain(owner)) return null
+  const children = graph.getChildren(owner.id).filter((child) => child.visible)
+  if (children.length !== 3) return null
+  const [black, mask, white] = children
+  if (
+    !opaqueRectangle(black, owner, 0) ||
+    !opaqueRectangle(white, owner, 1) ||
+    !opaqueMask(graph, mask, owner)
+  )
+    return null
+  return { black, mask, white }
+}
+
+/**
+ * White through an opaque luminance mask over black is its grayscale color.
+ * Keep the original HTML paint stack and apply that equivalent color matrix
+ * once, instead of rounding its color through an intermediate alpha surface.
+ * The saved document continues to contain ordinary masks and editable paints.
+ */
+function opaqueLuminanceElement(
+  graph: SceneGraph,
+  node: SceneNode,
+  render: VectorElementRenderer
+): DesignElement | null {
+  if (
+    graph.documentColorSpace !== 'srgb' ||
+    node.type !== 'FRAME' ||
+    node.isMask ||
+    node.fills.some((fill) => fill.visible)
+  )
+    return null
+  const children = graph.getChildren(node.id).filter((child) => child.visible)
+  if (children.length !== 3 || !children[1].isMask || children[1].maskType !== 'LUMINANCE')
+    return null
+  const copy = extractExportGraph(graph, { scope: 'node', nodeId: node.id }).graph
+  reconcileVariableBindings(copy, { subtrees: [node.id] })
+  for (const child of copy.getAllNodes())
+    copy.updateNode(child.id, resolvedPaintBindings(copy, child))
+  const local = copy.getNode(node.id)
+  const parts = local && composition(copy, local)
+  if (!local || !parts) return null
+  copy.deleteNode(parts.black.id)
+  copy.deleteNode(parts.white.id)
+  copy.updateNode(parts.mask.id, { isMask: false })
+  const drawing = render(copy, local)
+  if (!drawing) return null
+  return {
+    ...drawing,
+    inlineStyle: { ...drawing.inlineStyle, overflow: 'hidden', filter: 'grayscale(1)' }
+  }
+}
+
+export function luminanceVectorGroupElement(
+  graph: SceneGraph,
+  node: SceneNode,
+  vectorGroup: VectorElementRenderer
+): DesignElement | null {
+  return opaqueLuminanceElement(graph, node, (copy, local) => {
+    const design = sceneNodeToDesignDocument(copy, local.id, {
+      vectorElement,
+      vectorGroup,
+      tokens: false,
+      imageFrameFills: 'background'
+    })
+    const drawing = design.children.at(0)
+    return drawing?.type === 'element' ? drawing : null
+  })
+}
+
+export const nativeVectorGroupElement: VectorElementRenderer = (graph, node) =>
+  luminanceVectorGroupElement(graph, node, nativeVectorGroupElement) ??
+  vectorGroupElement(graph, node)
