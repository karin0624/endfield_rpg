--- /dev/null
+++ b/packages/scene-graph/src/text/replacement-runs.ts
@@ -0,0 +1,12 @@
+import type { SceneNode, StyleRun } from '../types'
+
+/** A style covering all characters continues to cover all of a replacement string. */
+export function styleRunsForReplacement(
+  node: Pick<SceneNode, 'text' | 'styleRuns'>,
+  text: string
+): StyleRun[] {
+  if (text === node.text) return node.styleRuns
+  return node.styleRuns.map((run) =>
+    run.start === 0 && run.length === node.text.length ? { ...run, length: text.length } : run
+  )
+}
