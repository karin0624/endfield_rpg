@@ -0,0 +1,89 @@
+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { svgFormat } from '#core/io/formats'
+import { renderNodesToSVG } from '#core/io/formats/svg/export'
+import { IORegistry } from '#core/io/registry'
+
+const fill = {
+  type: 'SOLID' as const,
+  color: { r: 1, g: 0, b: 0, a: 1 },
+  opacity: 1,
+  visible: true
+}
+
+test('public SVG export can retain native geometry precision, including primitive shapes and edits', async () => {
+  const exportContent = svgFormat.exportContent
+  if (!exportContent) throw new Error('SVG export is unavailable')
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  const frame = graph.createNode('FRAME', page.id, { width: 100.125, height: 60.234375, fills: [] })
+  const rectangle = graph.createNode('RECTANGLE', frame.id, {
+    x: 0.123456,
+    y: 0.654321,
+    width: 12.345678,
+    height: 9.876543,
+    cornerRadius: 0.345678,
+    fills: [fill],
+    opacity: 0.123456
+  })
+  graph.createNode('ELLIPSE', frame.id, {
+    x: 20.123456,
+    y: 0.654321,
+    width: 8.246912,
+    height: 6.246912,
+    fills: [fill]
+  })
+  graph.createNode('LINE', frame.id, {
+    x: 40.123456,
+    y: 20.123456,
+    width: 7.234567,
+    height: 1.234567,
+    fills: [],
+    strokes: [{ ...fill, weight: 1.234567, align: 'CENTER' }]
+  })
+  const request = {
+    graph,
+    target: { scope: 'node' as const, nodeId: frame.id },
+    fileName: 'art.svg'
+  }
+  const result = await exportContent(request, { precision: null, xmlDeclaration: false })
+  expect(result.data).toContain('width="100.125" height="60.234375"')
+  expect(result.data).toContain('translate(0.123456, 0.654321)')
+  expect(result.data).toContain('width="12.345678" height="9.876543" rx="0.345678"')
+  expect(result.data).toContain('opacity="0.123456"')
+  expect(result.data).toContain('<ellipse cx="4.123456" cy="3.123456" rx="4.123456" ry="3.123456"')
+  expect(result.data).toContain('x2="7.234567" y2="1.234567"')
+  const compact = renderNodesToSVG(graph, page.id, [frame.id], { xmlDeclaration: false })
+  expect(compact).toContain('translate(0.12, 0.65)')
+  expect(compact).toContain('width="12.35" height="9.88"')
+  graph.updateNode(rectangle.id, { width: 13.234567 })
+  const edited = await exportContent(request, { precision: null })
+  expect(edited.data).toContain('width="13.234567"')
+  expect(graph.getNode(rectangle.id)?.width).toBe(13.234567)
+})
+
+test('public SVG viewport fitting passes through the IO registry without changing the default', async () => {
+  const graph = new SceneGraph()
+  const node = graph.createNode('RECTANGLE', graph.getPages()[0].id, {
+    width: 80.125,
+    height: 20.25,
+    fills: [fill]
+  })
+  const io = new IORegistry([svgFormat])
+  const request = { graph, target: { scope: 'node' as const, nodeId: node.id } }
+  const original = await io.exportContent('svg', request)
+  expect(original.data).not.toContain('preserveAspectRatio=')
+  for (const preserveAspectRatio of ['none', 'xMaxYMin slice', 'xMidYMid meet'] as const) {
+    const result = await io.exportContent('svg', request, {
+      precision: null,
+      xmlDeclaration: false,
+      preserveAspectRatio
+    })
+    expect(result.data).toContain(`preserveAspectRatio="${preserveAspectRatio}"`)
+    expect(result.data).toContain('viewBox="0 0 80.125 20.25"')
+    expect(result.data).not.toContain('<?xml')
+  }
+  expect((await io.exportContent('svg', request)).data).toBe(original.data)
+})
