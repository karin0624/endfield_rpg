index 0000000000000000000000000000000000000000..37cbdc20e1f9cbbb2bbc0859201c84b22b8f99c3
--- /dev/null
+++ b/packages/core/src/io/formats/html/vector-scale.ts
@@ -0,0 +1,50 @@
+import type { DesignElement, VectorElementRenderer } from '@open-pencil/dom-css/export'
+import { rescaleNodeTree, type SceneGraph, type SceneNode } from '@open-pencil/scene-graph'
+
+import { extractExportGraph } from '#core/io/subgraph'
+
+/** A uniform Scale-tool instance, restored to its component's native coordinate basis. */
+export function scaledVectorBasis(graph: SceneGraph, node: SceneNode) {
+  if (node.type !== 'INSTANCE') return null
+  const main = graph.getMainComponent(node.id)
+  if (!main || main.width <= 0 || main.height <= 0) return null
+  const scale = node.width / main.width
+  const stored = node.componentScale / main.componentScale
+  if (
+    !Number.isFinite(scale) ||
+    scale <= 0 ||
+    scale === 1 ||
+    scale !== node.height / main.height ||
+    (stored !== scale && stored !== Math.fround(scale))
+  )
+    return null
+
+  // The canonical subgraph copy carries the main and the instance's overrides. Sync after
+  // changing coordinates keeps inherited geometry exact and retains authored overrides.
+  const copy = extractExportGraph(graph, { scope: 'node', nodeId: node.id }).graph
+  const local = copy.getNode(node.id)
+  if (!local) return null
+  rescaleNodeTree(copy, local.id, 1 / scale)
+  copy.updateNode(local.id, { componentScale: main.componentScale })
+  copy.syncInstance(local.id)
+  return { graph: copy, node: local, scale }
+}
+
+/**
+ * Scale-tool vector instances retain their component's SVG coordinate system and
+ * expose the instance's actual display dimensions as the viewport.
+ */
+export function scaledVectorInstance(
+  graph: SceneGraph,
+  node: SceneNode,
+  render: VectorElementRenderer
+): DesignElement | null {
+  const basis = scaledVectorBasis(graph, node)
+  if (!basis) return null
+  const { node: local } = basis
+  const drawing = render(basis.graph, local)
+  if (!drawing) return null
+  drawing.attrs.width = String(node.width)
+  drawing.attrs.height = String(node.height)
+  return drawing
+}
diff --git a/packages/core/src/io/formats/svg/masks.ts b/packages/core/src/io/formats/svg/masks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..13d9c41edd830ebf29769b0b43325e658e0fbbe2
--- /dev/null
+++ b/packages/core/src/io/formats/svg/masks.ts
@@ -0,0 +1,210 @@
+import type { SceneNode } from '@open-pencil/scene-graph'
+import { getWorldMatrix } from '@open-pencil/scene-graph/coordinate'
+import { computeDescendantVisualBounds } from '@open-pencil/scene-graph/geometry'
+
+import { createMaskDef, nextDefId } from './defs'
+import type { SVGExportContext } from './defs'
+import { svg } from './node'
+import type { SVGNode } from './node'
+import { round } from './paths'
+
+interface MaskRenderers {
+  paint: (node: SceneNode, ctx: SVGExportContext, mask?: boolean) => SVGNode | null
+  geometry: (node: SceneNode, ctx: SVGExportContext) => SVGNode[]
+  transform: (node: SceneNode, precision?: number | null) => string | undefined
+}
+
+export function maskPaint(node: SceneNode): SceneNode {
+  return {
+    ...node,
+    blendMode: 'PASS_THROUGH',
+    effects: node.effects.filter(
+      (effect) => effect.type === 'LAYER_BLUR' || effect.type === 'FOREGROUND_BLUR'
+    ),
+    fills:
+      node.maskType === 'VECTOR'
+        ? node.fills.map((fill) => ({ ...fill, opacity: 1, color: { ...fill.color, a: 1 } }))
+        : node.fills
+  }
+}
+
+function localMaskCoordinates(owner: SceneNode, ctx: SVGExportContext) {
+  // SVG userSpaceOnUse is the owner's local space, including when its ancestors
+  // rotate, reflect or skew. A world-space AABB cannot be translated into it.
+  const localOwner = {
+    ...owner,
+    parentId: null,
+    x: 0,
+    y: 0,
+    rotation: 0,
+    skew: 0,
+    flipX: false,
+    flipY: false
+  }
+  const getNode = (id: string) => (id === owner.id ? localOwner : ctx.graph.getNode(id))
+  const matrix = (id: string) => {
+    const node = getNode(id)
+    if (!node) throw new Error(`Missing mask content: ${id}`)
+    return getWorldMatrix(node, { getNode })
+  }
+  return {
+    getNode,
+    matrix,
+    position: (id: string) => {
+      const world = matrix(id)
+      return { x: world[2], y: world[5] }
+    }
+  }
+}
+
+function maskRegion(nodes: SceneNode[], owner: SceneNode, ctx: SVGExportContext) {
+  const local = localMaskCoordinates(owner, ctx)
+  const bounds = computeDescendantVisualBounds(
+    nodes.map((node) => node.id),
+    local.getNode,
+    local.position,
+    local.matrix
+  )
+  return bounds
+    ? {
+        x: bounds.minX,
+        y: bounds.minY,
+        width: bounds.maxX - bounds.minX,
+        height: bounds.maxY - bounds.minY
+      }
+    : { x: 0, y: 0, width: owner.width, height: owner.height }
+}
+
+function fitsDefaultMaskRegion(content: SceneNode[], owner: SceneNode, ctx: SVGExportContext) {
+  const local = localMaskCoordinates(owner, ctx)
+  const drawables: string[] = []
+  const textNodes: string[] = []
+  const visit = (node: SceneNode) => {
+    if (!node.visible || node.isMask) return
+    if (node.type === 'TEXT') textNodes.push(node.id)
+    if (
+      node.type !== 'GROUP' &&
+      (node.fills.some((fill) => fill.visible) ||
+        node.strokes.some((stroke) => stroke.visible) ||
+        node.fillGeometry.some((geometry) => geometry.fills?.some((fill) => fill.visible)))
+    )
+      drawables.push(node.id)
+    for (const child of ctx.graph.getChildren(node.id)) visit(child)
+  }
+  content.forEach(visit)
+  // SVG text's object bounds are glyph bounds, rather than its native layout box.
+  if (textNodes.length > 0 || drawables.length === 0) return false
+  const geometry = computeDescendantVisualBounds(
+    drawables,
+    (id) => {
+      const node = local.getNode(id)
+      return node ? { ...node, childIds: [], effects: [], strokes: [], strokeWeight: 0 } : undefined
+    },
+    local.position,
+    local.matrix
+  )
+  if (!geometry) return false
+  const width = geometry.maxX - geometry.minX
+  const height = geometry.maxY - geometry.minY
+  if (width <= 0 || height <= 0) return false
+  const visual = maskRegion(content, owner, ctx)
+  // SVG's default object-bounding-box region is -10%, -10%, 120%, 120%.
+  // Retain explicit native bounds whenever strokes or effects exceed it.
+  return (
+    visual.x >= geometry.minX - width * 0.1 &&
+    visual.y >= geometry.minY - height * 0.1 &&
+    visual.x + visual.width <= geometry.maxX + width * 0.1 &&
+    visual.y + visual.height <= geometry.maxY + height * 0.1
+  )
+}
+
+function isGeometricMask(node: SceneNode): boolean {
+  return (
+    node.maskType === 'VECTOR' &&
+    node.childIds.length === 0 &&
+    node.opacity === 1 &&
+    !node.effects.some((effect) => effect.visible) &&
+    !node.strokes.some((stroke) => stroke.visible) &&
+    node.fills.some((fill) => fill.visible) &&
+    node.fills.every((fill) => !fill.visible || fill.type === 'SOLID') &&
+    !(node.type === 'VECTOR' && node.fillGeometry.some((path) => path.fills?.length))
+  )
+}
+
+function renderMaskGroup(
+  masks: SceneNode[],
+  content: SceneNode[],
+  owner: SceneNode,
+  ctx: SVGExportContext,
+  renderers: MaskRenderers
+): SVGNode | null {
+  const rendered = content.map((node) => renderers.paint(node, ctx)).filter((node) => node !== null)
+  if (rendered.length === 0) return null
+  if (masks.every(isGeometricMask)) {
+    const id = nextDefId(ctx, 'mask-clip')
+    const geometry = masks.flatMap((node) => {
+      const transform = renderers.transform(node, ctx.precision)
+      return renderers.geometry(node, ctx).map((shape) => {
+        const attrs = { ...shape.attrs }
+        if (attrs['fill-rule']) attrs['clip-rule'] = attrs['fill-rule']
+        if (transform) attrs.transform = transform
+        return { ...shape, attrs }
+      })
+    })
+    ctx.defs.push(svg('clipPath', { id, clipPathUnits: 'userSpaceOnUse' }, ...geometry))
+    return svg('g', { 'clip-path': `url(#${id})` }, ...rendered)
+  }
+
+  const rawRegion = maskRegion([...masks, ...content], owner, ctx)
+  const region = {
+    x: round(rawRegion.x, ctx.precision),
+    y: round(rawRegion.y, ctx.precision),
+    width: round(rawRegion.width, ctx.precision),
+    height: round(rawRegion.height, ctx.precision)
+  }
+  const definitionRegion = fitsDefaultMaskRegion(content, owner, ctx) ? undefined : region
+  const coverage = masks
+    .map((node) => {
+      const painted = renderers.paint(node, ctx, true)
+      if (!painted) return null
+      if (node.maskType !== 'LUMINANCE') return painted
+      // Figma luminance coverage includes the painted alpha twice, as the canvas does.
+      const alpha = createMaskDef(ctx, 'alpha', definitionRegion, [painted])
+      const luminance = createMaskDef(ctx, 'luminance', definitionRegion, [painted])
+      return svg(
+        'g',
+        { mask: `url(#${luminance})` },
+        svg('g', { mask: `url(#${alpha})` }, svg('rect', { ...region, fill: '#FFFFFF' }))
+      )
+    })
+    .filter((node) => node !== null)
+  const id = createMaskDef(ctx, 'alpha', definitionRegion, coverage)
+  return svg('g', { mask: `url(#${id})` }, ...rendered)
+}
+
+export function renderMaskedChildren(
+  owner: SceneNode,
+  ctx: SVGExportContext,
+  renderers: MaskRenderers
+): SVGNode[] {
+  const nodes = ctx.graph.getChildren(owner.id)
+  const rendered: SVGNode[] = []
+  for (let index = 0; index < nodes.length;) {
+    const first = nodes[index]
+    if (!first.visible || !first.isMask) {
+      const drawn = renderers.paint(first, ctx)
+      if (drawn) rendered.push(drawn)
+      index++
+      continue
+    }
+    const masks: SceneNode[] = []
+    while (index < nodes.length && nodes[index].visible && nodes[index].isMask)
+      masks.push(nodes[index++])
+    const content: SceneNode[] = []
+    while (index < nodes.length && (!nodes[index].visible || !nodes[index].isMask))
+      content.push(nodes[index++])
+    const drawn = renderMaskGroup(masks, content, owner, ctx, renderers)
+    if (drawn) rendered.push(drawn)
+  }
+  return rendered
+}
diff --git a/packages/core/src/io/formats/svg/transforms.ts b/packages/core/src/io/formats/svg/transforms.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5c45f90236e2005e356ecbd0e50e99e7886532f8
--- /dev/null
+++ b/packages/core/src/io/formats/svg/transforms.ts
@@ -0,0 +1,54 @@
+import {
+  getNodeLocalMatrix,
+  getWorldMatrix,
+  type SceneGraph,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+import { round } from './paths'
+
+export function buildTransformAttr(node: SceneNode, precision?: number | null): string | undefined {
+  if (node.skew) {
+    // Figma's transform wire and CanvasKit's matrix inputs are float32. Keep
+    // SVG's double-precision matrix parser from introducing another transform.
+    const matrix = getNodeLocalMatrix(node).map(Math.fround)
+    return `matrix(${[matrix[0], matrix[3], matrix[1], matrix[4], matrix[2], matrix[5]].map((value) => round(value, precision)).join(' ')})`
+  }
+  const transforms: string[] = []
+  if (node.x !== 0 || node.y !== 0)
+    transforms.push(`translate(${round(node.x, precision)}, ${round(node.y, precision)})`)
+  if (node.rotation !== 0) {
+    transforms.push(
+      `rotate(${round(node.rotation, precision)}, ${round(node.width / 2, precision)}, ${round(node.height / 2, precision)})`
+    )
+  }
+  if (node.flipX || node.flipY) {
+    const tx = node.flipX ? node.width : 0
+    const ty = node.flipY ? node.height : 0
+    const sx = node.flipX ? -1 : 1
+    const sy = node.flipY ? -1 : 1
+    transforms.push(
+      `translate(${round(tx, precision)}, ${round(ty, precision)}) scale(${sx}, ${sy})`
+    )
+  }
+  return transforms.length > 0 ? transforms.join(' ') : undefined
+}
+
+export function selectionSkewTransform(
+  node: SceneNode,
+  graph: SceneGraph,
+  x: number,
+  y: number,
+  precision?: number | null
+): string | undefined {
+  let transformed = false
+  for (
+    let ancestor: SceneNode | undefined = node;
+    ancestor;
+    ancestor = ancestor.parentId ? graph.getNode(ancestor.parentId) : undefined
+  )
+    transformed ||= ancestor.skew !== 0
+  if (!transformed) return undefined
+  const matrix = getWorldMatrix(node, graph).map(Math.fround)
+  return `matrix(${[matrix[0], matrix[3], matrix[1], matrix[4], matrix[2] - x, matrix[5] - y].map((value) => round(value, precision)).join(' ')})`
+}
diff --git a/packages/core/src/io/formats/svg/translations.ts b/packages/core/src/io/formats/svg/translations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0482c01048867d1d6058b28593b48f7098861461
--- /dev/null
+++ b/packages/core/src/io/formats/svg/translations.ts
@@ -0,0 +1,62 @@
+import svgpath from 'svgpath'
+
+import type { Vector } from '@open-pencil/scene-graph/primitives'
+
+import type { SVGNode } from './node'
+
+function translation(node: SVGNode): Vector | null {
+  if (!Object.hasOwn(node.attrs, 'transform')) return { x: 0, y: 0 }
+  const transform = node.attrs.transform
+  if (typeof transform !== 'string') return null
+  const match = /^translate\(\s*([^,\s]+)[,\s]+([^,\s]+)\s*\)$/.exec(transform)
+  if (!match) return null
+  const x = Number(match[1])
+  const y = Number(match[2])
+  return Number.isFinite(x) && Number.isFinite(y) ? { x, y } : null
+}
+
+function pathGeometryOnly(node: SVGNode): boolean {
+  if (node.tag !== 'g' && node.tag !== 'path') return false
+  if (!translation(node)) return false
+  // Referenced paints, clipping and filters keep their original local spaces.
+  if (Object.values(node.attrs).some((value) => String(value).includes('url('))) return false
+  if (node.tag === 'path') return typeof node.attrs.d === 'string' && node.children.length === 0
+  return (
+    node.children.length > 0 &&
+    node.children.every((child) => typeof child !== 'string' && pathGeometryOnly(child))
+  )
+}
+
+function fold(node: SVGNode, x: number, y: number, precision: number | null): SVGNode {
+  const offset = translation(node)
+  if (!offset) return node
+  x += offset.x
+  y += offset.y
+  const attrs = { ...node.attrs }
+  delete attrs.transform
+  if (node.tag === 'path') {
+    let path = svgpath(String(attrs.d)).translate(x, y)
+    if (precision !== null) path = path.round(precision)
+    attrs.d = path.toString()
+    return { ...node, attrs }
+  }
+  return {
+    ...node,
+    attrs,
+    children: node.children.map((child) =>
+      typeof child === 'string' ? child : fold(child, x, y, precision)
+    )
+  }
+}
+
+/** Keep translated path groups in one coordinate space without changing paints or topology. */
+export function foldSVGPathTranslations(node: SVGNode, precision: number | null = 2): SVGNode {
+  if (node.tag === 'defs') return node
+  if (pathGeometryOnly(node)) return fold(node, 0, 0, precision)
+  return {
+    ...node,
+    children: node.children.map((child) =>
+      typeof child === 'string' ? child : foldSVGPathTranslations(child, precision)
+    )
+  }
+}
diff --git a/packages/core/tests/canvas/gradient-degenerate.test.ts b/packages/core/tests/canvas/gradient-degenerate.test.ts
