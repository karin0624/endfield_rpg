@@ -0,0 +1,124 @@
+import { describe, expect, test } from 'bun:test'
+
+import { uint8ArrayToArrayBuffer } from '#core-tests/helpers/fig/fixtures'
+
+import { FigmaAPI, SceneGraph, exportFigFile, parseFigFile } from '@open-pencil/core'
+
+function fixture() {
+  const api = new FigmaAPI(new SceneGraph())
+  const frame = api.createFrame()
+  frame.name = 'Border layout'
+  frame.layoutMode = 'VERTICAL'
+  frame.primaryAxisSizingMode = 'AUTO'
+  frame.counterAxisSizingMode = 'AUTO'
+  frame.paddingLeft = 7
+  frame.paddingRight = 11
+  frame.paddingTop = 3
+  frame.paddingBottom = 5
+  Reflect.set(frame, 'strokes', [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }])
+  frame.strokeWeight = 2
+  const child = api.createRectangle()
+  child.name = 'Content'
+  child.resize(20, 30)
+  frame.appendChild(child)
+  return { api, frame, child }
+}
+
+describe('strokes included in auto layout', () => {
+  // Figma specifies border-box layout; the insets follow native stroke geometry:
+  // full INSIDE width, half CENTER width, and no OUTSIDE width.
+  for (const [align, width, height, x, y] of [
+    ['INSIDE', 42, 42, 9, 5],
+    ['CENTER', 40, 40, 8, 4],
+    ['OUTSIDE', 38, 38, 7, 3]
+  ] as const) {
+    test(`${align} strokes contribute their inner width only when included`, () => {
+      const { frame, child } = fixture()
+      frame.strokeAlign = align
+      expect([frame.width, frame.height, child.x, child.y]).toEqual([38, 38, 7, 3])
+      frame.strokesIncludedInLayout = true
+      expect([frame.width, frame.height, child.x, child.y]).toEqual([width, height, x, y])
+      frame.strokesIncludedInLayout = false
+      expect([frame.width, frame.height, child.x, child.y]).toEqual([38, 38, 7, 3])
+    })
+  }
+
+  test('individual edge widths displace content on their own edges', () => {
+    const { frame, child } = fixture()
+    frame.strokesIncludedInLayout = true
+    frame.strokeTopWeight = 2
+    frame.strokeRightWeight = 3
+    frame.strokeBottomWeight = 4
+    frame.strokeLeftWeight = 5
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([46, 44, 12, 5])
+    frame.strokeAlign = 'CENTER'
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([42, 41, 9.5, 4])
+  })
+
+  test('a fixed border box keeps its size and gives a filling child the remaining space', () => {
+    const { frame, child } = fixture()
+    frame.resize(100, 80)
+    child.layoutSizingHorizontal = 'FILL'
+    expect([frame.width, frame.height, child.width, child.x, child.y]).toEqual([100, 80, 82, 7, 3])
+    frame.strokesIncludedInLayout = true
+    expect([frame.width, frame.height, child.width, child.x, child.y]).toEqual([100, 80, 78, 9, 5])
+  })
+
+  test('hidden strokes reserve no space, while transparent visible strokes do', () => {
+    const { frame, child } = fixture()
+    frame.strokesIncludedInLayout = true
+    Reflect.set(frame, 'strokes', [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 }, visible: false }])
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([38, 38, 7, 3])
+    Reflect.set(frame, 'strokes', [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 }, opacity: 0 }])
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([42, 42, 9, 5])
+    frame.strokes = []
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([38, 38, 7, 3])
+  })
+
+  test('nested hugging frames include their own borders once', () => {
+    const { api, frame, child } = fixture()
+    frame.strokesIncludedInLayout = true
+    const outer = api.createFrame()
+    outer.layoutMode = 'HORIZONTAL'
+    outer.primaryAxisSizingMode = 'AUTO'
+    outer.counterAxisSizingMode = 'AUTO'
+    Reflect.set(outer, 'strokes', [{ type: 'SOLID', color: { r: 0, g: 0, b: 0 } }])
+    outer.strokeWeight = 3
+    outer.strokesIncludedInLayout = true
+    outer.appendChild(frame)
+    expect([outer.width, outer.height, frame.x, frame.y]).toEqual([48, 48, 3, 3])
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([42, 42, 9, 5])
+  })
+
+  test('normal save and reopen retain border layout for later public edits', async () => {
+    const { api, frame, child } = fixture()
+    frame.strokesIncludedInLayout = true
+    expect([frame.width, frame.height, child.x, child.y]).toEqual([42, 42, 9, 5])
+    const bytes = await exportFigFile(api.graph)
+    const graph = await parseFigFile(uint8ArrayToArrayBuffer(bytes), { populate: 'all' })
+    const reopened = new FigmaAPI(graph)
+    const restored = reopened.currentPage.findOne((node) => node.name === 'Border layout')
+    const content = reopened.currentPage.findOne((node) => node.name === 'Content')
+    if (!restored || !content) throw new Error('Saved frame and child must exist')
+    expect([restored.width, restored.height, content.x, content.y]).toEqual([42, 42, 9, 5])
+    restored.strokeWeight = 4
+    expect([restored.width, restored.height, content.x, content.y]).toEqual([46, 46, 11, 7])
+    content.resize(40, 50)
+    expect([restored.width, restored.height, content.x, content.y]).toEqual([66, 66, 11, 7])
+    const editedBytes = await exportFigFile(graph)
+    const editedGraph = await parseFigFile(uint8ArrayToArrayBuffer(editedBytes), {
+      populate: 'all'
+    })
+    const edited = new FigmaAPI(editedGraph)
+    const editedFrame = edited.currentPage.findOne((node) => node.name === 'Border layout')
+    const editedContent = edited.currentPage.findOne((node) => node.name === 'Content')
+    if (!editedFrame || !editedContent) throw new Error('Edited frame and child must exist')
+    expect([editedFrame.width, editedFrame.height, editedContent.x, editedContent.y]).toEqual([
+      66, 66, 11, 7
+    ])
+    editedFrame.strokesIncludedInLayout = false
+    expect([editedFrame.width, editedFrame.height, editedContent.x, editedContent.y]).toEqual([
+      58, 58, 7, 3
+    ])
+  })
+})
