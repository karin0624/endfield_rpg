@@ -0,0 +1,489 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { solidFill, solidStroke } from '#core-tests/helpers/figma-api'
+import { decode } from 'js-base64'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import type { PrototypeAnimation } from '@open-pencil/dom-css/export'
+import type { Color, SceneNode } from '@open-pencil/scene-graph'
+
+import { htmlFormat, svgFormat } from '#core/io/formats'
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { svgAssetElement } from '#core/io/formats/html/svg-assets'
+
+beforeAll(initCodec)
+
+function fixture() {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const main = api.createComponent()
+  main.name = 'Artwork.svg'
+  main.resize(100, 40)
+  main.fills = []
+  main.exportSettings = [{ format: 'SVG' }]
+  const imported = api.createNodeFromSvg(
+    '<svg width="100" height="40"><path d="M2 2L98 3L95 38L4 36Z" fill="#ffaa00"/></svg>'
+  )
+  for (const child of imported.children) {
+    child.constraints = { horizontal: 'SCALE', vertical: 'SCALE' }
+    main.appendChild(child)
+  }
+  imported.remove()
+  const placed = main.createInstance()
+  placed.name = 'Normally resized artwork'
+  placed.resize(143.75, 27.625)
+  placed.x = 31.125
+  placed.y = 12.5
+  return { graph, api, main, placed }
+}
+
+function node(graph: SceneGraph, name: string): SceneNode {
+  const found = [...graph.getAllNodes()].find((value) => value.name === name)
+  if (!found) throw new Error(`Missing native ${name}`)
+  return found
+}
+
+function drawing(graph: SceneGraph, target: SceneNode): string {
+  const image = svgAssetElement(graph, target)
+  if (image?.tagName !== 'img') throw new Error('Missing SVG export artifact')
+  const prefix = 'data:image/svg+xml;base64,'
+  expect(image.attrs.src.startsWith(prefix)).toBe(true)
+  return decode(image.attrs.src.slice(prefix.length))
+}
+
+function nestedFixture(depth: number, edit?: (made: ReturnType<typeof fixture>) => void) {
+  const made = fixture()
+  edit?.(made)
+  let layer = made.placed
+  const path = [layer.name]
+  for (let index = 0; index < depth; index++) {
+    const wrapper = made.api.createComponent()
+    wrapper.name = `Container ${index}`
+    wrapper.resize(300, 100)
+    wrapper.fills = []
+    wrapper.appendChild(layer)
+    layer = wrapper.createInstance()
+    layer.name = `Container occurrence ${index}`
+    path.unshift(layer.name)
+  }
+  return { ...made, path }
+}
+
+function occurrence(graph: SceneGraph, path: string[]): SceneNode {
+  let current = node(graph, path[0])
+  for (const name of path.slice(1)) {
+    const child = graph.getChildren(current.id).find((value) => value.name === name)
+    if (!child) throw new Error(`Missing nested native ${name}`)
+    current = child
+  }
+  return current
+}
