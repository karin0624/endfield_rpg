+import { beforeAll, expect, test } from 'bun:test'
+
+import { toUint8Array } from 'js-base64'
+
+import { FigmaAPI, SceneGraph, exportFigFile, initCodec, parseFigFile } from '@open-pencil/core'
+import type { Fill } from '@open-pencil/scene-graph'
+
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { renderNodesToSVG } from '#core/io/formats/svg/export'
+
+beforeAll(initCodec)
+
+const image = toUint8Array(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/WioAAAAASUVORK5CYII='
+)
+const solid = (r: number, g: number, b: number): Fill => ({
+  type: 'SOLID',
+  color: { r, g, b, a: 1 },
+  opacity: 1,
+  visible: true
+})
+
+function fixture(maskType: 'ALPHA' | 'LUMINANCE') {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const imageHash = api.createImage(image).hash
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    name: 'Composition',
+    width: 100,
+    height: 40,
+    fills: [],
+    clipsContent: false
+  })
+  const mask = graph.createNode('FRAME', root.id, {
+    name: 'Editable paint mask',
+    width: 100,
+    height: 40,
+    fills: [],
+    clipsContent: false,
+    isMask: true,
+    maskType
+  })
+  graph.createNode('RECTANGLE', mask.id, {
+    name: 'Editable ink',
+    width: 100,
+    height: 40,
+    fills: [solid(1, 0, 0)]
+  })
+  graph.createNode('FRAME', mask.id, {
+    name: 'Original texture',
+    width: 100,
+    height: 40,
+    fills: [
+      {
+        ...solid(0, 0, 0),
+        type: 'IMAGE',
+        imageHash,
+        imageScaleMode: 'TILE',
+        imageTransform: { m00: 10, m01: 0, m02: -0.25, m10: 0, m11: 5, m12: -0.5 }
+      }
+    ]
+  })
+  graph.createNode('RECTANGLE', root.id, {
+    width: 100,
+    height: 40,
+    fills: [solid(1, 1, 1)]
+  })
+  return { graph, root, mask, imageHash }
+}
+
+function named(graph: SceneGraph, name: string) {
+  const node = [...graph.nodes.values()].find((n) => n.name === name)
+  if (!node) throw new Error(`Missing native node: ${name}`)
+  return node
+}
+
+test.each(['ALPHA', 'LUMINANCE'] as const)(
+  'native %s frame masks retain original texture, paint edits and tile geometry after save',
+  async (maskType) => {
+    const { graph: initial, imageHash } = fixture(maskType)
+    let graph = initial
+    for (let cycle = 0; cycle < 2; cycle++) {
+      graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+      const root = named(graph, 'Composition')
+      const mask = named(graph, 'Editable paint mask')
+      const ink = named(graph, 'Editable ink')
+      expect(mask.maskType).toBe(maskType)
+      expect(graph.images.get(imageHash)).toEqual(image)
+      new FigmaAPI(graph).wrapNode(ink.id).fills = [solid(0, 0, 1)]
+      const { html } = await renderNodesToHTML(graph, [root.id], { html: 'standalone' })
+      expect(html).toContain(`mask-type="${maskType.toLowerCase()}"`)
+      expect(html).toContain('fill="#0000FF"')
+      expect(html).toContain('patternTransform="matrix(10 0 0 8 2.5 4)"')
+      expect(html).toContain('data:image/png;base64,')
+    }
+  }
+)
+
+test('a mask with editable text fails explicitly instead of flattening it into an image', async () => {
+  const { graph, root, mask } = fixture('LUMINANCE')
+  graph.createNode('TEXT', mask.id, { text: 'Editable mask text' })
+  await expect(renderNodesToHTML(graph, [root.id], { html: 'standalone' })).rejects.toThrow(
+    'HTML export requires an unrotated SVG paint mask'
+  )
+})
+
+test('ordinary image containers keep HTML background projection and singular SVG tiles fail', async () => {
+  const { graph, mask } = fixture('ALPHA')
+  const texture = named(graph, 'Original texture')
+  const { html } = await renderNodesToHTML(graph, [texture.id], { html: 'standalone' })
+  expect(html).toContain('background-repeat: repeat')
+  expect(html).not.toContain('<mask')
+  const fill = texture.fills[0]
+  graph.updateNode(texture.id, {
+    fills: [{ ...fill, imageTransform: { m00: 0, m01: 0, m02: 0, m10: 0, m11: 0, m12: 0 } }]
+  })
+  expect(() => renderNodesToSVG(graph, mask.id, [texture.id])).toThrow(
+    'Singular native TILE image transform'
+  )
+})
+
+test('SVG tiles retain the full native affine image transform', () => {
+  const { graph, mask } = fixture('ALPHA')
+  const texture = named(graph, 'Original texture')
+  graph.updateNode(texture.id, {
+    fills: [
+      {
+        ...texture.fills[0],
+        imageTransform: { m00: 0, m01: 2, m02: 0.25, m10: -4, m11: 0, m12: -0.5 }
+      }
+    ]
+  })
+  expect(renderNodesToSVG(graph, mask.id, [texture.id], { precision: null })).toContain(
+    'patternTransform="matrix(0 20 -25 0 -12.5 -5)"'
+  )
+})
