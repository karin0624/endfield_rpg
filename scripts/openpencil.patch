@@ -0,0 +1,112 @@
+import { describe, expect, test } from 'bun:test'
+
+import { exportFigFile, parseFigFile } from '@open-pencil/core'
+import { FigmaAPI } from '@open-pencil/core/figma-api'
+import type { FigmaTransform } from '@open-pencil/core/figma-api/types'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+// Figma's documented relativeTransform has unit axes and permits non-orthogonal axes:
+// https://developers.figma.com/docs/plugins/api/properties/nodes-relativetransform/
+const transform: FigmaTransform = [
+  [1, 0.6, 10],
+  [0, 0.8, 20]
+]
+const close = (actual: FigmaTransform, expected: FigmaTransform, precision = 6) => {
+  for (let row = 0; row < 2; row++)
+    for (let column = 0; column < 3; column++)
+      expect(actual[row][column]).toBeCloseTo(expected[row][column], precision)
+}
+
+describe('unit-axis skew', () => {
+  test('relativeTransform preserves skew, its dimensions and its four world corners', () => {
+    const figma = new FigmaAPI(new SceneGraph())
+    const rectangle = figma.createRectangle()
+    rectangle.resize(100, 50)
+    rectangle.relativeTransform = transform
+    close(rectangle.relativeTransform, transform)
+    expect([rectangle.width, rectangle.height]).toEqual([100, 50])
+    const bounds = rectangle.absoluteBoundingBox
+    expect(bounds?.x).toBeCloseTo(10, 8)
+    expect(bounds?.y).toBeCloseTo(20, 8)
+    expect(bounds?.width).toBeCloseTo(130, 8)
+    expect(bounds?.height).toBeCloseTo(40, 8)
+  })
+
+  test('position, resize and rotation edits retain the skew and unit axes', () => {
+    const figma = new FigmaAPI(new SceneGraph())
+    const rectangle = figma.createRectangle()
+    rectangle.relativeTransform = transform
+    rectangle.x = 31
+    rectangle.y = 47
+    rectangle.resize(200, 70)
+    close(rectangle.relativeTransform, [
+      [1, 0.6, 31],
+      [0, 0.8, 47]
+    ])
+    rectangle.rotation = 30
+    const cos = Math.sqrt(3) / 2
+    close(rectangle.relativeTransform, [
+      [cos, 0.6 * cos + 0.4, 31],
+      [-0.5, 0.8 * cos - 0.3, 47]
+    ])
+    expect(
+      Math.hypot(rectangle.relativeTransform[0][0], rectangle.relativeTransform[1][0])
+    ).toBeCloseTo(1, 10)
+    expect(
+      Math.hypot(rectangle.relativeTransform[0][1], rectangle.relativeTransform[1][1])
+    ).toBeCloseTo(1, 10)
+    expect([rectangle.width, rectangle.height]).toEqual([200, 70])
+  })
+
+  test('matrix scale does not become a second source of node dimensions', () => {
+    const figma = new FigmaAPI(new SceneGraph())
+    const rectangle = figma.createRectangle()
+    rectangle.resize(100, 50)
+    rectangle.relativeTransform = [
+      [2, 1.8, 10],
+      [0, 2.4, 20]
+    ]
+    close(rectangle.relativeTransform, transform)
+    expect([rectangle.width, rectangle.height]).toEqual([100, 50])
+  })
+
+  test('a component child follows native skew through normal FIG reads and subsequent edits', async () => {
+    let graph = new SceneGraph()
+    let figma = new FigmaAPI(graph)
+    const component = figma.createComponent()
+    component.name = 'Skew component'
+    component.resize(200, 200)
+    const rectangle = figma.createRectangle()
+    rectangle.name = 'Skew artwork'
+    rectangle.resize(100, 50)
+    component.appendChild(rectangle)
+    rectangle.relativeTransform = transform
+    rectangle.strokeWeight = 2
+    component.createInstance().name = 'Skew instance'
+    for (let cycle = 0; cycle < 3; cycle++) {
+      const bytes = await exportFigFile(graph)
+      graph = await parseFigFile(bytes.buffer as ArrayBuffer, { populate: 'all' })
+      figma = new FigmaAPI(graph)
+      for (const name of ['Skew component', 'Skew instance']) {
+        const node = [...graph.getAllNodes()].find((candidate) => candidate.name === name)
+        if (!node) throw new Error(`Missing ${name}`)
+        const child = figma.wrapNode(node.childIds[0])
+        close(child.relativeTransform, transform, 5)
+        expect([child.width, child.height, child.strokeWeight]).toEqual([100, 50, 2])
+      }
+      const main = [...graph.getAllNodes()].find((candidate) => candidate.name === 'Skew component')
+      if (!main) throw new Error('Missing component')
+      const child = figma.wrapNode(main.childIds[0])
+      child.x = 10
+      child.fills = [
+        {
+          type: 'SOLID',
+          color: { r: 0.1 * cycle, g: 0.3, b: 0.5, a: 1 },
+          opacity: 1,
+          visible: true
+        }
+      ]
+      graph.syncInstances(main.id)
+    }
+  })
+})
