+import { layoutSizingInParent, type SceneGraph, type SceneNode } from '@open-pencil/scene-graph'
+
+import type { DesignElement, DesignNode, DesignStyleDeclaration } from '#dom-css/types'
+import { hugs } from '../projection'
+
+export function usesContentLayout(
+  owner: SceneNode | undefined,
+  source: SceneNode,
+  _graph?: SceneGraph
+): boolean {
+  return Boolean(
+    owner && owner.layoutMode !== 'NONE' && source.layoutPositioning !== 'ABSOLUTE'
+  )
+}
+
+function paints(item: DesignNode): boolean {
+  if (item.type === 'text') return item.text.length > 0
+  const node = item.sourceSceneNode
+  if (node?.opacity === 0) return false
+  return Boolean(
+    item.tagName === 'svg' ||
+    item.tagName === 'img' ||
+    node?.fills.some(
+      (paint) => paint.visible && paint.opacity > 0 && (paint.type !== 'SOLID' || paint.color.a > 0)
+    ) ||
+    node?.strokes.some((paint) => paint.visible && paint.opacity > 0) ||
+    node?.effects.some((effect) => effect.visible) ||
+    item.children.some(paints)
+  )
+}
+
+/** A flow containing block retains absolute descendants and native sibling paint order. */
+export function needsFlowContainingBlock(
+  node: DesignElement,
+  parent?: DesignElement,
+  graph?: SceneGraph
+): boolean {
+  return (
+    node.children.some(
+      (child) =>
+        child.type === 'element' &&
+        child.sourceSceneNode &&
+        !usesContentLayout(node.sourceSceneNode, child.sourceSceneNode, graph)
+    ) ||
+    Boolean(
+      parent?.children.some(
+        (sibling) =>
+          sibling !== node &&
+          sibling.type === 'element' &&
+          sibling.sourceSceneNode?.layoutPositioning === 'ABSOLUTE' &&
+          paints(sibling)
+      )
+    )
+  )
+}
+
+/** Live Fill follows native auto layout; absolute descendants retain their authored size. */
+export function nativeSize(style: DesignStyleDeclaration, node: SceneNode, graph: SceneGraph) {
+  const parent = node.parentId ? graph.getNode(node.parentId) : undefined
+  for (const axis of ['width', 'height'] as const) {
+    const primary = parent?.layoutMode === (axis === 'width' ? 'HORIZONTAL' : 'VERTICAL')
+    if (
+      parent &&
+      usesContentLayout(parent, node, graph) &&
+      layoutSizingInParent(parent, node, axis === 'width' ? 'HORIZONTAL' : 'VERTICAL') === 'FILL'
+    ) {
+      if (axis === 'width') delete style.width
+      else delete style.height
+      if (primary) style['flex-basis'] = '0px'
+    } else if (node.type === 'TEXT' && axis === 'height' && hugs(node, axis)) {
+      delete style.height
+    } else if (hugs(node, axis)) {
+      style[axis] = 'max-content'
+    } else {
+      style[axis] ??= `${node[axis]}px`
+    }
+  }
+}
diff --git a/packages/dom-css/src/export/native/outline.ts b/packages/dom-css/src/export/native/outline.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0fdfd86404fb960251662166125d0ff2c01fb619
--- /dev/null
+++ b/packages/dom-css/src/export/native/outline.ts
@@ -0,0 +1,209 @@
+import type { DesignDocument, DesignElement } from '#dom-css/types'
+
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+import { cssColor } from '../css'
+
+function unmodified(node: SceneNode): boolean {
+  return (
+    node.visible &&
+    node.opacity === 1 &&
+    node.rotation === 0 &&
+    node.cornerSmoothing === 0 &&
+    !node.isMask &&
+    (node.blendMode === 'PASS_THROUGH' || node.blendMode === 'NORMAL')
+  )
+}
+
+function paints(node: SceneNode): boolean {
+  return node.fills.some(
+    (paint) => paint.visible && paint.opacity > 0 && (paint.type !== 'SOLID' || paint.color.a > 0)
+  )
+}
+
+function neutral(node: SceneNode): boolean {
+  return (
+    unmodified(node) &&
+    node.blendMode === 'PASS_THROUGH' &&
+    !paints(node) &&
+    !node.strokes.some((stroke) => stroke.visible && stroke.opacity > 0) &&
+    !node.effects.some((effect) => effect.visible) &&
+    !node.clipsContent &&
+    node.overflowDirection === 'NONE' &&
+    node.exportSettings.length === 0
+  )
+}
+
+function outlineRectangle(node: SceneNode): boolean {
+  const strokes = node.strokes.filter((stroke) => stroke.visible)
+  const stroke = strokes.at(0)
+  return (
+    stroke !== undefined &&
+    node.childIds.length === 0 &&
+    strokes.length === 1 &&
+    stroke.type === 'SOLID' &&
+    stroke.opacity === 1 &&
+    stroke.color.a === 1 &&
+    (!stroke.blendMode || stroke.blendMode === 'NORMAL') &&
+    stroke.weight > 0 &&
+    stroke.align === 'OUTSIDE' &&
+    node.strokeAlign === 'OUTSIDE' &&
+    !node.independentStrokeWeights &&
+    node.dashPattern.length === 0 &&
+    !stroke.dashPattern?.length
+  )
+}
+
+function outlineNode(
+  node: SceneNode,
+  graph: SceneGraph,
+  width: number,
+  height: number
+): SceneNode | undefined {
+  if (
+    !unmodified(node) ||
+    paints(node) ||
+    node.effects.some((effect) => effect.visible) ||
+    node.horizontalConstraint !== 'STRETCH' ||
+    node.verticalConstraint !== 'STRETCH'
+  )
+    return undefined
+  if (node.type === 'RECTANGLE') return outlineRectangle(node) ? node : undefined
+  if (
+    (node.type !== 'FRAME' && node.type !== 'GROUP') ||
+    !neutral(node) ||
+    node.x !== 0 ||
+    node.y !== 0 ||
+    node.width !== width ||
+    node.height !== height
+  )
+    return undefined
+  const children = graph
+    .getChildren(node.id)
+    .filter((child) => child.visible && !child.internalOnly)
+  return children.length === 1 ? outlineNode(children[0], graph, width, height) : undefined
+}
+
+function surface(element: DesignElement, outline?: DesignElement): SceneNode | undefined {
+  const node = element.sourceSceneNode
+  const content = outline ? element.children.filter((child) => child !== outline) : []
+  const textOnly =
+    content.length > 0 &&
+    content.every((child) => child.type === 'element' && child.sourceSceneNode?.type === 'TEXT')
+  return node &&
+    ['FRAME', 'COMPONENT', 'INSTANCE'].includes(node.type) &&
+    unmodified(node) &&
+    (paints(node) || textOnly) &&
+    !element.inlineStyle?.filter &&
+    !element.inlineStyle?.outline
+    ? node
+    : undefined
+}
+
+function radii(node: SceneNode): number[] {
+  return node.independentCorners
+    ? [node.topLeftRadius, node.topRightRadius, node.bottomRightRadius, node.bottomLeftRadius]
+    : [node.cornerRadius, node.cornerRadius, node.cornerRadius, node.cornerRadius]
+}
+
+function enclosed(node: SceneNode, graph: SceneGraph, omitted: string): boolean {
+  if (node.clipsContent) return true
+  return graph.getChildren(node.id).every((child) => {
+    if (!child.visible || child.internalOnly || child.id === omitted) return true
+    return (
+      child.rotation === 0 &&
+      child.x >= 0 &&
+      child.y >= 0 &&
+      child.x + child.width <= node.width &&
+      child.y + child.height <= node.height &&
+      !child.effects.some((effect) => effect.visible) &&
+      !child.strokes.some(
+        (stroke) => stroke.visible && stroke.opacity > 0 && stroke.align !== 'INSIDE'
+      ) &&
+      enclosed(child, graph, omitted)
+    )
+  })
+}
+
+function outlineOwner(
+  projected: DesignElement,
+  excluded: DesignElement
+): DesignElement | undefined {
+  if (surface(projected, excluded)) return projected
+  const parent = projected.sourceSceneNode
+  if (!parent || !neutral(parent)) return undefined
+  const others = projected.children.filter((child) => child !== excluded)
+  if (others.length !== 1 || others[0].type !== 'element') return undefined
+  const owner = others[0]
+  const node = surface(owner)
+  return node?.x === 0 &&
+    node.y === 0 &&
+    node.width === parent.width &&
+    node.height === parent.height
+    ? owner
+    : undefined
+}
+
+function matchesOutline(rectangle: SceneNode, owner: SceneNode, offset: number): boolean {
+  const corners = radii(owner)
+  return (
+    offset >= 0 &&
+    rectangle.y === -offset &&
+    rectangle.width === owner.width + 2 * offset &&
+    rectangle.height === owner.height + 2 * offset &&
+    radii(rectangle).every(
+      (radius, index) => radius === (corners[index] === 0 ? 0 : corners[index] + offset)
+    )
+  )
+}
+
+function animatedContent(document: DesignDocument, owner: SceneNode): boolean {
+  const graph = document.sourceGraph
+  if (!graph) return false
+  return !!document.prototypeAnimations?.some((program) => {
+    let node = graph.getNode(program.ownerId)
+    while (node) {
+      if (!node.visible || node.internalOnly) return false
+      if (node.id === owner.id) return true
+      node = node.parentId ? graph.getNode(node.parentId) : undefined
+    }
+    return false
+  })
+}
+
+/** A stretching, otherwise empty outline is the coextensive surface's CSS outline. */
+export function nativeSurfaceOutline(projected: DesignElement, document: DesignDocument) {
+  const graph = document.sourceGraph
+  const parent = projected.sourceSceneNode
+  if (!graph || !parent) return
+  const candidates = projected.children.flatMap((child) => {
+    if (child.type !== 'element' || !child.sourceSceneNode) return []
+    const outline = outlineNode(child.sourceSceneNode, graph, parent.width, parent.height)
+    return outline ? [{ element: child, outline, rootId: child.sourceSceneNode.id }] : []
+  })
+  if (candidates.length !== 1) return
+  const candidate = candidates[0]
+  const owner = outlineOwner(projected, candidate.element)
+  const node = owner?.sourceSceneNode
+  // A compiled timed component has an independently animated paint surface.
+  // Keep the later outline layer's paint order, including across clipped frames.
+  if (
+    !owner ||
+    !node ||
+    animatedContent(document, node) ||
+    !enclosed(node, graph, candidate.rootId)
+  )
+    return
+  const rectangle = candidate.outline
+  const offset = -rectangle.x
+  if (!matchesOutline(rectangle, node, offset)) return
+  const stroke = rectangle.strokes.find((paint) => paint.visible)
+  if (!stroke) return
+  const variable = document.tokens?.names.get(rectangle.boundVariables['strokes/0/color'])
+  const color = variable ? `var(--${variable})` : cssColor(stroke.color)
+  Object.assign((owner.inlineStyle ??= {}), {
+    outline: `${stroke.weight}px solid ${color}`,
+    'outline-offset': `${offset}px`
+  })
+  projected.children = projected.children.filter((child) => child !== candidate.element)
+}
diff --git a/packages/dom-css/src/export/native/scroll.ts b/packages/dom-css/src/export/native/scroll.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7566301f435b69cb44d1728b18e8659497372386
--- /dev/null
+++ b/packages/dom-css/src/export/native/scroll.ts
@@ -0,0 +1,86 @@
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+import type { DesignElement, DesignStyleDeclaration } from '#dom-css/types'
+import { hugs } from '../projection'
+
+const CONTENT_STYLE =
+  /^(display|flex-direction|flex-wrap|justify-content|align-items|align-content|gap|row-gap|column-gap|padding(?:-.+)?|grid-.+|overflow(?:-.+)?)$/
+
+function borderSize(node: SceneNode, axis: 'width' | 'height'): number {
+  if (node.strokeAlign !== 'INSIDE') return 0
+  const stroke = node.strokes.find((paint) => paint.visible)
+  if (!stroke) return 0
+  if (!node.independentStrokeWeights) return stroke.weight * 2
+  return axis === 'width'
+    ? node.borderLeftWeight + node.borderRightWeight
+    : node.borderTopWeight + node.borderBottomWeight
+}
+
+function contentSize(node: SceneNode, style: DesignStyleDeclaration): DesignStyleDeclaration {
+  const size: DesignStyleDeclaration = { position: 'relative' }
+  for (const axis of ['width', 'height'] as const) {
+    size[axis] = hugs(node, axis) ? 'max-content' : '100%'
+    if (!hugs(node, axis)) continue
+    const border = borderSize(node, axis)
+    for (const limit of ['min', 'max']) {
+      const property = `${limit}-${axis}`
+      const value = style[property]
+      if (value) size[property] = border ? `calc(${value} - ${border}px)` : value
+    }
+  }
+  return size
+}
+
+/**
+ * The frame supplies fixed descendants' containing block outside the actual scroller.
+ * Their original DOM order is retained: a positioned scroller does not create a fixed
+ * containing block, so those descendants stay anchored to the outer native frame.
+ */
+export function nativeScrollFrame(element: DesignElement): void {
+  const node = element.sourceSceneNode
+  if (!node || node.overflowDirection === 'NONE') return
+  const hasFixedChild = element.children.some(
+    (child) =>
+      child.type === 'element' &&
+      child.sourceSceneNode?.scrollBehavior === 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME'
+  )
+  if (!hasFixedChild) return
+  const style = element.inlineStyle ?? {}
+  const content: DesignElement = {
+    type: 'element',
+    tagName: 'div',
+    attrs: { 'data-open-pencil-scroll-content': 'true' },
+    inlineStyle: {
+      ...Object.fromEntries(
+        Object.entries(style).filter(([property]) => CONTENT_STYLE.test(property))
+      ),
+      ...contentSize(node, style)
+    },
+    children: element.children
+  }
+  element.inlineStyle = {
+    ...Object.fromEntries(
+      Object.entries(style).filter(([property]) => !CONTENT_STYLE.test(property))
+    ),
+    overflow: node.clipsContent ? 'hidden' : 'visible'
+  }
+  element.children = [content]
+}
+
+export function nativeScrollingContent(
+  style: DesignStyleDeclaration,
+  node: SceneNode,
+  graph: SceneGraph
+) {
+  if (
+    node.scrollBehavior === 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME' ||
+    !['FRAME', 'GROUP', 'COMPONENT', 'INSTANCE'].includes(node.type)
+  )
+    return
+  const owner = node.parentId ? graph.getNode(node.parentId) : undefined
+  if (owner?.overflowDirection !== 'HORIZONTAL' && owner?.overflowDirection !== 'BOTH') return
+  if (node.x >= 0 && node.x + node.width <= owner.width) return
+  // Native horizontal prototype content pans independently of its viewport.
+  // Give overflowing content its own scrolling layer without changing its transform.
+  style['will-change'] = 'transform'
+}
diff --git a/packages/dom-css/src/export/native/text.ts b/packages/dom-css/src/export/native/text.ts
new file mode 100644
index 0000000000000000000000000000000000000000..88546843c35be3436870fa799f72332b00521ecf
--- /dev/null
+++ b/packages/dom-css/src/export/native/text.ts
@@ -0,0 +1,30 @@
+import type { DesignElement } from '#dom-css/types'
+
+import type { SceneNode } from '@open-pencil/scene-graph'
+
+export function nativeText(projected: DesignElement, node: SceneNode): void {
+  if (node.type !== 'TEXT') return
+  const style = (projected.inlineStyle ??= {})
+  // An empty text line retains its typography and baseline in native layout.
+  if (node.text === '' && node.height > 0)
+    projected.children = [{ type: 'element', tagName: 'br', attrs: {}, children: [] }]
+  if (node.fontFeatures.length)
+    style['font-feature-settings'] = node.fontFeatures
+      .map((feature) => `"${feature.tag.toLowerCase()}" ${feature.enabled ? 1 : 0}`)
+      .join(', ')
+  if (node.textAlignVertical === 'TOP') return
+  Object.assign(style, {
+    display: 'flex',
+    'flex-direction': 'column',
+    'justify-content': node.textAlignVertical === 'CENTER' ? 'center' : 'flex-end'
+  })
+  projected.children = [
+    {
+      type: 'element',
+      tagName: 'span',
+      attrs: {},
+      children: projected.children,
+      inlineStyle: { display: 'block', width: '100%' }
+    }
+  ]
+}
diff --git a/packages/dom-css/src/export/prototype-animate.ts b/packages/dom-css/src/export/prototype-animate.ts
new file mode 100644
index 0000000000000000000000000000000000000000..90483ab57a3b62e459b71ae89c73487061f1b912
--- /dev/null
+++ b/packages/dom-css/src/export/prototype-animate.ts
@@ -0,0 +1,135 @@
+import { es } from '@open-pencil/emit'
+import type { SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+import type { DesignDocument, DesignElement, DesignNode, PrototypeAnimation } from '../types'
+
+/** Animated layers and their descendants must retain their individual native DOM ids. */
+export function isPrototypeAnimated(
+  graph: SceneGraph,
+  node: SceneNode,
+  animations: PrototypeAnimation[]
+): boolean {
+  const ids = new Set(
+    animations.flatMap((program) => [
+      program.ownerId,
+      program.sourceOwnerId,
+      ...program.layers.map((layer) => layer.nodeId)
+    ])
+  )
+  for (
+    let current: SceneNode | undefined = node;
+    current;
+    current = current.parentId ? graph.getNode(current.parentId) : undefined
+  )
+    if (ids.has(current.id)) return true
+  return false
+}
+
+/** The plan contains native state poses, never browser-measured or capture-only frames. */
+export function prototypeAnimationScript(document: DesignDocument): string {
+  const animations = document.prototypeAnimations ?? []
+  if (!animations.length) return ''
+  const nodes = new Map<string, DesignElement[]>()
+  const visit = (node: DesignNode) => {
+    if (node.type === 'text') return
+    if (node.sourceSceneNodeId) {
+      const matches = nodes.get(node.sourceSceneNodeId) ?? []
+      matches.push(node)
+      nodes.set(node.sourceSceneNodeId, matches)
+    }
+    node.children.forEach(visit)
+  }
+  document.children.forEach(visit)
+  const requireLayer = (id: string) => {
+    const matches = nodes.get(id)
+    if (matches?.length !== 1)
+      throw new Error(`Animated native layers must retain one HTML element: ${id}`)
+    matches[0].attrs['data-open-pencil-node-id'] = id
+    return matches[0]
+  }
+  for (const program of animations) {
+    const owner = requireLayer(program.ownerId)
+    for (const layer of program.layers) requireLayer(layer.nodeId)
+    owner.attrs['data-open-pencil-prototype-states'] = JSON.stringify(program.endpoints)
+    owner.attrs['data-open-pencil-prototype-segments'] = JSON.stringify(program.segments)
+  }
+  const code = es.printModule(es.fill(RUNTIME, { $config: es.json(animations) }))
+  return `<script type="module">${code.replace(/<\/(?=script)/gi, '<\\/')}</script>`
+}
+
+const RUNTIME = es.parseModule(`
+const programs = $config;
+async function assetsReady(owner) {
+  await document.fonts.ready;
+  const sources = new Set([...owner.querySelectorAll('svg image')].map(image => image.href.baseVal));
+  for (const element of [owner, ...owner.querySelectorAll('*')]) {
+    for (const match of getComputedStyle(element).backgroundImage.matchAll(/url\\((?:"([^"]*)"|'([^']*)'|([^)]*))\\)/g)) sources.add(match[1] ?? match[2] ?? match[3]);
+  }
+  await Promise.all([
+    ...[...owner.querySelectorAll('img')].map(image => image.decode()),
+    ...[...sources].map(async source => { const image = new Image(); image.src = source; await image.decode(); })
+  ]);
+}
+await Promise.all(programs.map(async program => {
+  const owner = document.querySelector('[data-open-pencil-node-id="' + CSS.escape(program.ownerId) + '"]');
+  if (!owner) throw new Error('Missing native prototype owner: ' + program.ownerId);
+  if (!owner.checkVisibility()) await new Promise(resolve => {
+    const observer = new MutationObserver(() => {
+      if (!owner.checkVisibility()) return;
+      observer.disconnect();
+      resolve();
+    });
+    observer.observe(document.body, {attributes: true, childList: true, subtree: true});
+  });
+  await assetsReady(owner);
+  const running = [];
+  function start(element, frames, options, id) {
+    const animation = element.animate(frames, options);
+    animation.id = id;
+    running.push(animation);
+  }
+  for (const layer of program.layers) {
+    const element = document.querySelector('[data-open-pencil-node-id="' + CSS.escape(layer.nodeId) + '"]');
+    if (!element || !owner.contains(element)) throw new Error('Missing native animated layer: ' + layer.nodeId);
+    const options = { duration: program.duration, iterations: program.periodic ? Infinity : 1, fill: 'both', easing: 'linear' };
+    const poses = layer.frames.map(frame => ({
+      offset: frame.at / program.duration,
+      easing: frame.easing,
+      opacity: frame.opacity,
+      transform: 'translate(' + (frame.x - layer.basis.x) + 'px, ' + (frame.y - layer.basis.y) + 'px) scale(' + frame.scale + ')'
+    }));
+    const id = 'open-pencil-prototype:' + program.ownerId + ':' + layer.nodeId;
+    if (layer.transform && layer.opacity && getComputedStyle(element).transform === 'none') {
+      start(element, poses, options, id);
+    } else {
+      if (layer.transform) start(element, poses.map(({offset, easing, transform}) => ({offset, easing, transform})), {...options, composite: 'add'}, id + ':transform');
+      if (layer.opacity) start(element, poses.map(({offset, easing, opacity}) => ({offset, easing, opacity})), options, id + ':opacity');
+    }
+  }
+  if (!running.length) throw new Error('Native prototype has no visual transition');
+  await Promise.all(running.map(animation => animation.ready));
+  const epoch = document.timeline.currentTime;
+  if (epoch === null) throw new Error('Native prototype requires an active document timeline');
+  for (const animation of running) animation.startTime = epoch;
+  owner.dataset.openPencilPrototypeAnimations = JSON.stringify(running.map(animation => animation.id));
+  owner.dataset.openPencilPrototypeStates = JSON.stringify(program.endpoints);
+  owner.dataset.openPencilPrototypeSegments = JSON.stringify(program.segments);
+  function observe() {
+    const clock = running[0].currentTime;
+    if (typeof clock !== 'number') throw new Error('Native prototype requires a finite animation clock');
+    const time = program.periodic ? ((clock % program.duration) + program.duration) % program.duration : Math.max(0, clock);
+    const completed = program.endpoints.findLast(endpoint => endpoint.at <= time);
+    if (completed) owner.dataset.openPencilPrototypeVariant = completed.variantId;
+    const segment = program.segments.find(segment => segment.start <= time && segment.end > time);
+    if (segment) {
+      owner.dataset.openPencilPrototypeTarget = segment.destinationId;
+      owner.dataset.openPencilPrototypeProgress = String((time - segment.start) / (segment.end - segment.start));
+    } else {
+      delete owner.dataset.openPencilPrototypeTarget;
+      delete owner.dataset.openPencilPrototypeProgress;
+    }
+    requestAnimationFrame(observe);
+  }
+  observe();
+}));
+`)
diff --git a/packages/dom-css/src/export/prototype.ts b/packages/dom-css/src/export/prototype.ts
new file mode 100644
index 0000000000000000000000000000000000000000..48785f71e863a48468bb4d76e922ee68541b6622
--- /dev/null
+++ b/packages/dom-css/src/export/prototype.ts
@@ -0,0 +1,383 @@
+import { es } from '@open-pencil/emit'
+import type {
+  PrototypeOverlayAction,
+  SceneGraph,
+  SceneNode,
+  Vector
+} from '@open-pencil/scene-graph'
+
+import type { DesignDocument, DesignElement, DesignNode, DesignStyleDeclaration } from '../types'
+import { cssColor } from './css'
+import { mergeClassNames } from './html'
+
+function walk(nodes: readonly DesignNode[], visit: (node: DesignElement) => void): void {
+  for (const node of nodes) {
+    if (node.type === 'text') continue
+    visit(node)
+    walk(node.children, visit)
+  }
+}
+
+/** Project referenced frames through the same vector, text, image, and token context. */
+export function projectPrototypeOverlays(
+  graph: SceneGraph,
+  children: readonly DesignNode[],
+  project: (node: SceneNode) => DesignNode | null
+): DesignElement[] {
+  const overlays = new Map<string, DesignElement>()
+  const queue = [...children]
+  for (const item of queue) {
+    walk([item], (node) => {
+      for (const reaction of node.sourceSceneNode?.reactions ?? []) {
+        for (const action of reaction.actions) {
+          if (action.navigation !== 'OVERLAY') continue
+          if (overlays.has(action.destinationId)) continue
+          const destination = graph.getNode(action.destinationId)
+          const projected = destination ? project(destination) : null
+          if (projected?.type !== 'element') continue
+          overlays.set(action.destinationId, projected)
+          queue.push(projected)
+        }
+      }
+    })
+  }
+  return [...overlays.values()]
+}
+
+/** A destination is a top-layer view, rather than a second copy in the starting canvas. */
+export function prototypeCanvasDocument(document: DesignDocument): DesignDocument {
+  if (!document.prototypeOverlays?.length) return document
+  const ids = new Set(document.prototypeOverlays.map((node) => node.sourceSceneNodeId))
+  const withoutDestinations = (nodes: DesignNode[]): DesignNode[] =>
+    nodes.flatMap<DesignNode>((node) => {
+      if (node.type === 'text') return [node]
+      if (ids.has(node.sourceSceneNodeId)) return []
+      return [{ ...node, children: withoutDestinations(node.children) }]
+    })
+  return { ...document, children: withoutDestinations(document.children) }
+}
+
+interface ClickAction {
+  destinationId: string
+  originId: string
+  position?: Vector
+}
+
+interface OverlayOptions {
+  id: string
+  position: SceneNode['overlayPositionType']
+  outsideClose: boolean
+  modal: boolean
+}
+
+interface PrototypeRuntime {
+  clicks: [string, ClickAction[]][]
+  overlays: OverlayOptions[]
+}
+
+function supportedAction(action: PrototypeOverlayAction, node: SceneNode): void {
+  if (
+    !action.destinationId ||
+    (action.overlayRelativePosition &&
+      ![action.overlayRelativePosition.x, action.overlayRelativePosition.y].every(Number.isFinite))
+  )
+    throw new Error(`HTML export does not support this prototype action: ${node.id}`)
+}
+
+function runtimeFor(document: DesignDocument): PrototypeRuntime {
+  const overlays = document.prototypeOverlays ?? []
+  const destinations = new Map(overlays.map((node) => [node.sourceSceneNodeId, node]))
+  const clicks: PrototypeRuntime['clicks'] = []
+  const motionOwners = new Set(document.prototypeAnimations?.map((program) => program.ownerId))
+  const compiledMotion = (source: SceneNode) => {
+    let node: SceneNode | undefined = source
+    while (node) {
+      if (motionOwners.has(node.id)) return true
+      node = document.sourceGraph?.getNode(node.parentId ?? '')
+    }
+    return false
+  }
+  for (const root of [...document.children, ...overlays]) {
+    if (root.type !== 'element') continue
+    walk([root], (element) => {
+      const node = element.sourceSceneNode
+      if (!node) return
+      if (node.reactions === null)
+        throw new Error(`HTML export does not support this imported prototype reaction: ${node.id}`)
+      const actions: ClickAction[] = []
+      for (const reaction of node.reactions) {
+        if (reaction.trigger.type === 'AFTER_TIMEOUT') {
+          if (reaction.actions.some((action) => action.navigation !== 'CHANGE_TO'))
+            throw new Error(`HTML export does not support this timed prototype action: ${node.id}`)
+          if (!compiledMotion(node))
+            throw new Error(
+              `Timed HTML prototypes require native engine animation preparation: ${node.id}`
+            )
+          continue
+        }
+        for (const action of reaction.actions) {
+          if (action.navigation !== 'OVERLAY')
+            throw new Error(`HTML export does not support this click prototype action: ${node.id}`)
+          supportedAction(action, node)
+          if (!destinations.has(action.destinationId))
+            throw new Error(`Missing visible HTML prototype destination: ${action.destinationId}`)
+          if (
+            destinations.get(action.destinationId)?.sourceSceneNode?.overlayPositionType ===
+              'MANUAL' &&
+            !action.overlayRelativePosition
+          )
+            throw new Error(`Manual HTML overlay requires a saved relative position: ${node.id}`)
+          if (!root.sourceSceneNodeId)
+            throw new Error(`HTML prototype trigger requires a native root: ${node.id}`)
+          actions.push({
+            destinationId: action.destinationId,
+            originId: root.sourceSceneNodeId,
+            position: action.overlayRelativePosition
+          })
+        }
+      }
+      if (actions.length) {
+        element.attrs['data-open-pencil-node-id'] = node.id
+        clicks.push([node.id, actions])
+      }
+    })
+    if (root.sourceSceneNodeId)
+      root.attrs['data-open-pencil-prototype-root'] = root.sourceSceneNodeId
+  }
+  return {
+    clicks,
+    overlays: overlays.map((element) => {
+      const node = element.sourceSceneNode
+      if (!node || !['FRAME', 'COMPONENT', 'INSTANCE'].includes(node.type))
+        throw new Error('HTML prototype destination must be a native frame')
+      return {
+        id: node.id,
+        position: node.overlayPositionType,
+        outsideClose: node.overlayBackgroundInteraction === 'CLOSE_ON_CLICK_OUTSIDE',
+        modal: node.overlayBackground.type === 'SOLID_COLOR'
+      }
+    })
+  }
+}
+
+function neutralFrame(source: SceneNode): boolean {
+  return !(
+    source.type !== 'FRAME' ||
+    source.layoutMode !== 'NONE' ||
+    source.fills.some((paint) => paint.visible) ||
+    source.strokes.some((paint) => paint.visible) ||
+    source.effects.some((effect) => effect.visible) ||
+    source.opacity !== 1 ||
+    !['NORMAL', 'PASS_THROUGH'].includes(source.blendMode) ||
+    source.rotation !== 0 ||
+    source.skew !== 0 ||
+    source.clipsContent ||
+    source.overflowDirection !== 'NONE'
+  )
+}
+
+function neutralInstanceContainer(node: DesignElement): DesignElement | undefined {
+  const source = node.sourceSceneNode
+  const child = node.children.at(0)
+  const instance = child?.type === 'element' ? child.sourceSceneNode : undefined
+  if (
+    !source ||
+    !neutralFrame(source) ||
+    node.children.length !== 1 ||
+    child?.type !== 'element' ||
+    instance?.type !== 'INSTANCE' ||
+    instance.x !== 0 ||
+    instance.y !== 0 ||
+    instance.horizontalConstraint !== 'MIN' ||
+    instance.verticalConstraint !== 'MIN' ||
+    instance.width !== source.width ||
+    instance.height !== source.height
+  )
+    return undefined
+  return child
+}
+
+function svgOverlayContainer(element: DesignElement): DesignElement {
+  if (element.tagName !== 'svg') return element
+  const entries = Object.entries(element.attrs)
+  const attrs = Object.fromEntries(entries.filter(([key]) => !key.startsWith('data-')))
+  const outerAttrs = Object.fromEntries(entries.filter(([key]) => key.startsWith('data-')))
+  return {
+    ...element,
+    tagName: 'div',
+    attrs: outerAttrs,
+    children: [
+      {
+        ...element,
+        attrs,
+        sourceSceneNodeId: undefined,
+        sourceSceneNode: undefined,
+        inlineStyle: { display: 'block', width: '100%', height: '100%', overflow: 'visible' }
+      }
+    ]
+  }
+}
+
+function overlayElement(root: DesignElement, config: OverlayOptions): DesignElement {
+  const child = neutralInstanceContainer(root)
+  const element = svgOverlayContainer(child ?? root)
+  const style: DesignStyleDeclaration = {
+    margin: '0',
+    padding: '0',
+    border: '0',
+    background: 'transparent',
+    color: 'inherit',
+    outline: 'none',
+    overflow: 'visible',
+    'max-width': 'none',
+    'max-height': 'none',
+    ...element.inlineStyle,
+    position: 'fixed',
+    left: '0',
+    top: '0'
+  }
+  delete style.right
+  delete style.bottom
+  delete style['margin-left']
+  delete style['margin-top']
+  const overlay: DesignElement = {
+    ...element,
+    tagName: config.modal ? 'dialog' : 'div',
+    attrs: {
+      ...element.attrs,
+      'data-open-pencil-overlay': config.id,
+      'data-open-pencil-prototype-root': config.id
+    },
+    inlineStyle: style
+  }
+  if (!config.modal)
+    Object.assign(overlay.attrs, { popover: 'manual', role: 'dialog', tabindex: '-1' })
+  if (!child) return overlay
+  // A neutral destination frame owns its one instance without adding a second paint surface.
+  return { ...root, inlineStyle: { display: 'contents' }, children: [overlay] }
+}
+
+/** Closed native destinations and their ordinary click program for a standalone document. */
+export function standalonePrototype(document: DesignDocument): {
+  document: DesignDocument
+  css: string
+  script: string
+} {
+  const runtime = runtimeFor(document)
+  if (!runtime.clicks.length) return { document, css: '', script: '' }
+  let css = '[data-open-pencil-overlay]:not([open]):not(:popover-open){display:none}'
+  const overlays = (document.prototypeOverlays ?? []).map((root, index) => {
+    const config = runtime.overlays[index]
+    const element = overlayElement(root, config)
+    const dialog =
+      element.children[0]?.type === 'element' && element.inlineStyle?.display === 'contents'
+        ? element.children[0]
+        : element
+    dialog.attrs.class = mergeClassNames(dialog.attrs.class, `op-prototype-${index}`) ?? ''
+    const background = root.sourceSceneNode?.overlayBackground
+    if (background?.type === 'SOLID_COLOR')
+      css += `.op-prototype-${index}::backdrop{background:${cssColor({ ...background.color, a: background.opacity })}}`
+    return element
+  })
+  const code = es.printModule(es.fill(RUNTIME, { $config: es.json(runtime) }))
+  return {
+    document: {
+      ...document,
+      prototypeOverlays: undefined,
+      children: [...document.children, ...overlays]
+    },
+    css,
+    script: `<script type="module">${code.replace(/<\/(?=script)/gi, '<\\/')}</script>`
+  }
+}
+
+const RUNTIME = es.parseModule(`
+const config = $config;
+const overlays = new Map([...document.querySelectorAll('[data-open-pencil-overlay]')].map(element => [element.dataset.openPencilOverlay, element]));
+const roots = new Map([...document.querySelectorAll('[data-open-pencil-prototype-root]')].map(element => [element.dataset.openPencilPrototypeRoot, element]));
+const options = new Map(config.overlays.map(value => [value.id, value]));
+const clicks = new Map(config.clicks);
+const opened = [];
+function dismiss(element) {
+  if (element instanceof HTMLDialogElement) element.close();
+  else element.hidePopover();
+  const index = opened.indexOf(element);
+  if (index !== -1) opened.splice(index, 1);
+}
+function position(element, action, option) {
+  const root = roots.get(action.originId);
+  if (!root) throw new Error('Missing HTML prototype origin: ' + action.originId);
+  const bounds = root.getBoundingClientRect();
+  const style = element.style;
+  style.margin = '0';
+  style.left = bounds.left + 'px';
+  style.top = bounds.top + 'px';
+  style.right = 'auto';
+  style.bottom = 'auto';
+  if (option.position === 'MANUAL') {
+    if (!action.position) throw new Error('Manual overlay requires a saved relative position');
+    style.left = bounds.left + action.position.x + 'px';
+    style.top = bounds.top + action.position.y + 'px';
+    return;
+  }
+  if (option.position === 'CENTER' || option.position.endsWith('_CENTER')) {
+    style.right = innerWidth - bounds.right + 'px';
+    style.marginLeft = 'auto';
+    style.marginRight = 'auto';
+  } else if (option.position.endsWith('_RIGHT')) {
+    style.left = 'auto';
+    style.right = innerWidth - bounds.right + 'px';
+  }
+  if (option.position === 'CENTER') {
+    style.bottom = innerHeight - bounds.bottom + 'px';
+    style.marginTop = 'auto';
+    style.marginBottom = 'auto';
+  } else if (option.position.startsWith('BOTTOM_')) {
+    style.top = 'auto';
+    style.bottom = innerHeight - bounds.bottom + 'px';
+  }
+}
+function activate(action) {
+  const element = overlays.get(action.destinationId);
+  const option = options.get(action.destinationId);
+  if (!element || !option) throw new Error('Missing HTML prototype overlay: ' + action.destinationId);
+  position(element, action, option);
+  if (element instanceof HTMLDialogElement) {
+    if (!element.open) element.showModal();
+  } else if (!element.matches(':popover-open')) element.showPopover();
+  if (!opened.includes(element)) opened.push(element);
+}
+for (const element of overlays.values()) {
+  element.addEventListener('close', () => {
+    const index = opened.indexOf(element);
+    if (index !== -1) opened.splice(index, 1);
+  });
+  element.addEventListener('click', event => {
+    if (event.target !== element || !options.get(element.dataset.openPencilOverlay).outsideClose) return;
+    const bounds = element.getBoundingClientRect();
+    if (event.clientX < bounds.left || event.clientX >= bounds.right || event.clientY < bounds.top || event.clientY >= bounds.bottom) dismiss(element);
+  });
+}
+document.addEventListener('click', event => {
+  if (!(event.target instanceof Element)) return;
+  let trigger = event.target.closest('[data-open-pencil-node-id]');
+  while (trigger) {
+    const actions = clicks.get(trigger.dataset.openPencilNodeId);
+    if (actions) {
+      if (trigger.matches(':disabled,[aria-disabled="true"]')) return;
+      for (const action of actions) activate(action);
+      return;
+    }
+    trigger = trigger.parentElement?.closest('[data-open-pencil-node-id]');
+  }
+  const element = opened.at(-1);
+  if (element && !(element instanceof HTMLDialogElement) && !element.contains(event.target) && options.get(element.dataset.openPencilOverlay).outsideClose) dismiss(element);
+});
+document.addEventListener('keydown', event => {
+  const element = opened.at(-1);
+  if (event.key === 'Escape' && element && !(element instanceof HTMLDialogElement)) {
+    event.preventDefault();
+    dismiss(element);
+  }
+});
+`)
diff --git a/packages/dom-css/src/export/vectors.ts b/packages/dom-css/src/export/vectors.ts
