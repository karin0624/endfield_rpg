+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, fontManager, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+
+import { htmlFormat } from '#core/io'
+
+beforeAll(async () => {
+  await initCodec()
+  const font = await fontManager.fetchBundledFont('/Inter-Regular.ttf')
+  if (!font) throw new Error('Missing bundled Inter')
+  fontManager.markLoaded('Inter', 'Regular', font)
+})
+
+test('ordinary FIG saves retain trailing Hug constraints and live edited text in public HTML exports', async () => {
+  let graph = new SceneGraph()
+  const frame = graph.createNode('FRAME', graph.getPages()[0].id, {
+    name: 'Canvas',
+    width: 400,
+    height: 300
+  })
+  graph.createNode('TEXT', frame.id, {
+    name: 'Editable trailing caption',
+    x: 220,
+    y: 200,
+    width: 120,
+    height: 24,
+    text: 'First caption',
+    fontFamily: 'Inter',
+    fontSize: 16,
+    lineHeight: 24,
+    textAutoResize: 'WIDTH_AND_HEIGHT',
+    horizontalConstraint: 'MAX',
+    verticalConstraint: 'MAX'
+  })
+  for (const value of [
+    'First caption',
+    'An edited caption with a much longer line\nAnd another line'
+  ]) {
+    const current = [...graph.getAllNodes()].find(
+      (node) => node.name === 'Editable trailing caption'
+    )
+    if (!current) throw new Error('Missing caption')
+    graph.updateNode(current.id, { text: value })
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const caption = [...graph.getAllNodes()].find(
+      (node) => node.name === 'Editable trailing caption'
+    )
+    const canvas = [...graph.getAllNodes()].find((node) => node.name === 'Canvas')
+    if (!caption || !canvas) throw new Error('Missing reopened native nodes')
+    expect(caption.horizontalConstraint).toBe('MAX')
+    expect(caption.verticalConstraint).toBe('MAX')
+    expect(caption.textAutoResize).toBe('WIDTH_AND_HEIGHT')
+    const exportHTML = htmlFormat.exportContent
+    if (!exportHTML) throw new Error('Missing public HTML adapter')
+    const result = await exportHTML(
+      { graph, target: { scope: 'node', nodeId: canvas.id }, fileName: 'canvas.html' },
+      { html: 'standalone' }
+    )
+    expect(result.data).toContain('left: calc(100% + -60px); top: calc(100% + -76px)')
+    expect(result.data).toContain('transform: translate(-100%, -100%)')
+    expect(result.data).toContain('width: max-content')
+    expect(result.data).toContain(value)
+    expect(caption.type).toBe('TEXT')
+  }
+})
