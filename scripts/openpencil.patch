+  expect(html).toContain('stroke-width="1.65"')
+  expect(assets.some((asset) => asset.path.endsWith('.svg'))).toBe(false)
+  expect(html).toBe(before.html)
+  expect(assets).toEqual(before.assets)
+})
+
+test('scaled SVG export settings and editable vectors survive two ordinary FIG saves', async () => {
+  const made = fixture()
+  made.copy.rescale(0.85)
+  made.copy.exportSettings = [{ format: 'SVG' }]
+  let graph = made.graph
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const instance = [...graph.getAllNodes()].find((node) => node.name === 'Scaled artwork')
+    if (!instance) throw new Error('Missing native instance')
+    const raw = structuredClone(instance)
+    const { html } = await renderNodesToHTML(graph, [instance.id], { html: 'standalone' })
+    expect(html).toContain('viewBox="0 0 100 100"')
+    expect(html).not.toContain('scale3d(')
+    expect(html).toContain(round === 0 ? 'stroke="#FF2200"' : 'stroke="#0033CC"')
+    expect(instance).toEqual(raw)
+    const viewport = graph.getChildren(instance.id)[0]
+    const vector = viewport && graph.getChildren(viewport.id)[0]
+    if (!vector) throw new Error('Missing native vector child')
+    const api = new FigmaAPI(graph)
+    const publicVector = api.getNodeById(vector.id)
+    const publicInstance = api.getNodeById(instance.id)
+    if (publicVector?.type !== 'VECTOR' || publicInstance?.type !== 'INSTANCE')
+      throw new Error('Missing public native vector')
+    expect(publicInstance.exportSettings).toEqual([{ format: 'SVG' }])
+    publicVector.strokes = [{ ...vector.strokes[0], color: parseColor('#0033cc') }]
+    publicInstance.exportSettings = [{ format: 'SVG' }]
+  }
+})
+
+test.each(['unscaled', 'nonuniform'] as const)(
+  'SVG presets do not change the ordinary viewport for %s instances',
+  async (kind) => {
+    const { graph, copy } = fixture()
+    if (kind === 'nonuniform') {
+      copy.rescale(0.85)
+      copy.resize(92, 85)
+    }
+    const before = await renderNodesToHTML(graph, [copy.id], {
+      html: 'standalone',
+      assets: 'external'
+    })
+    copy.exportSettings = [{ format: 'SVG' }]
+    const { html, assets } = await renderNodesToHTML(graph, [copy.id], {
+      html: 'standalone',
+      assets: 'external'
+    })
+    expect(html).not.toContain('scale3d(')
+    expect(html).toContain('<svg ')
+    expect(html).toBe(before.html)
+    expect(assets).toEqual(before.assets)
+    expect(html).toContain(`viewBox="0 0 ${kind === 'unscaled' ? '100 100' : '92 85'}"`)
+  }
+)
+
+test('a scaled instance SVG preset leaves mixed native UI editable', async () => {
+  const { graph, copy } = fixture(true)
+  copy.rescale(0.85)
+  const before = await renderNodesToHTML(graph, [copy.id], { html: 'standalone' })
+  copy.exportSettings = [{ format: 'SVG' }]
+  const after = await renderNodesToHTML(graph, [copy.id], { html: 'standalone' })
+  expect(after).toEqual(before)
+  expect(after.html).toContain('Editable text')
+  expect(after.html).not.toContain('data:image/svg')
+})
+
+test('a nested scaled drawing keeps its own component viewport inside a normal vector frame', async () => {
+  const { graph, copy } = fixture()
+  copy.rescale(0.85)
+  const api = new FigmaAPI(graph)
+  const frame = api.createFrame()
+  frame.resize(160, 160)
+  frame.fills = []
+  frame.appendChild(copy)
+  copy.x = 12.125
+  copy.y = 14.25
+  const { html } = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+  expect(html).toContain(`<div data-open-pencil-node-id="${frame.id}"`)
+  expect(html).toContain('viewBox="0 0 100 100"')
+  expect(html).toContain('width="85"')
+  expect(html).not.toContain('viewBox="0 0 160 160"')
+  expect(html).not.toContain('scale3d(')
+})
+
+test('a real timed vector transition retains its editable animation target and SVG basis', async () => {
+  const { graph: source, main: artwork } = fixture()
+  const api = new FigmaAPI(source)
+  const states = [0.75, 1.25].map((scale, index) => {
+    const main = api.createComponent()
+    main.name = `phase=${index}`
+    main.resize(160, 160)
+    main.fills = []
+    const cue = artwork.createInstance()
+    main.appendChild(cue)
+    cue.name = 'Drawing'
+    cue.rescale(scale)
+    cue.x = (160 - cue.width) / 2
+    cue.y = (160 - cue.height) / 2
+    cue.opacity = index === 0 ? 0 : 1
+    return main
+  })
+  const start = states[0],
+    end = states[1]
+  if (!start || !end) throw new Error('Missing public transition states')
+  api.combineAsVariants(states, api.currentPage)
+  await start.setReactionsAsync([
+    {
+      trigger: { type: 'AFTER_TIMEOUT', timeout: 0 },
+      actions: [
+        {
+          type: 'NODE',
+          navigation: 'CHANGE_TO',
+          destinationId: end.id,
+          transition: { type: 'SMART_ANIMATE', duration: 0.24, easing: { type: 'EASE_OUT' } }
+        }
+      ]
+    }
+  ])
+  let graph = source
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const entry = [...graph.getAllNodes()].find(
+      (node) => node.type === 'COMPONENT' && node.name === start.name
+    )
+    if (!entry) throw new Error('Missing saved prototype entry')
+    const plan = preparePrototypeAnimations(graph, [entry.id])
+    expect(
+      plan.animations[0]?.layers.map((layer) => layer.frames.map((frame) => frame.scale))
+    ).toEqual([[0.75, 1.25]])
+    const { html } = await renderNodesToHTML(graph, [entry.id], { html: 'standalone' })
+    expect(html).toContain('viewBox="0 0 100 100"')
+    expect(html).toContain('element.animate(')
+    expect(html).toContain('data-open-pencil-prototype-states=')
+    expect(html).not.toContain('scale3d(')
+  }
+})
