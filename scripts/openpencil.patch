+function named(graph: SceneGraph, name: string): SceneNode {
+  const node = [...graph.getAllNodes()].find((current) => current.name === name)
+  if (!node) throw new Error(`Missing ${name}`)
+  return node
+}
+
+function artifact(graph: SceneGraph, node: SceneNode): string {
+  const image = svgAssetElement(graph, node)
+  if (!image) throw new Error('Missing ordinary SVG artifact')
+  expect(image.tagName).toBe('img')
+  return decode(image.attrs.src.slice('data:image/svg+xml;base64,'.length))
