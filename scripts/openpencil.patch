+++ b/packages/core/tests/figma-api/create/instance-swap-constraints.test.ts
@@ -0,0 +1,109 @@
+import { expect, test } from 'bun:test'
+
+import { uint8ArrayToArrayBuffer } from '#core-tests/helpers/fig/fixtures'
+import { asInstanceNode, createAPI } from '#core-tests/helpers/figma-api'
+
+import { FigmaAPI, exportFigFile, parseFigFile } from '@open-pencil/core'
+import type { Rect } from '@open-pencil/scene-graph/primitives'
+
+const cases = [
+  {
+    name: 'scale',
+    constraints: { horizontal: 'SCALE', vertical: 'SCALE' },
+    initial: { x: 0, y: 0, width: 256, height: 384 },
+    expected: { x: 0, y: 0, width: 128, height: 192 }
+  },
+  {
+    name: 'center',
+    constraints: { horizontal: 'CENTER', vertical: 'CENTER' },
+    initial: { x: 96, y: 144, width: 64, height: 96 },
+    expected: { x: 32, y: 48, width: 64, height: 96 }
+  },
+  {
+    name: 'stretch',
+    constraints: { horizontal: 'STRETCH', vertical: 'STRETCH' },
+    initial: { x: 16, y: 24, width: 224, height: 336 },
+    expected: { x: 16, y: 24, width: 96, height: 144 }
+  },
+  {
+    name: 'scale into a component with another size',
+    constraints: { horizontal: 'SCALE', vertical: 'SCALE' },
+    initial: { x: 0, y: 0, width: 256, height: 384 },
+    expected: { x: 0, y: 0, width: 128, height: 192 },
+    replacementSize: { width: 512, height: 768 },
+    replacementInitial: { x: 0, y: 0, width: 512, height: 768 }
+  }
+] as const
+
+function rect(node: Rect) {
+  return { x: node.x, y: node.y, width: node.width, height: node.height }
+}
+
+function portrait(api: FigmaAPI, name: string, fixture: (typeof cases)[number]) {
+  const main = api.createComponent()
+  main.name = name
+  main.resize(256, 384)
+  const image = api.createRectangle()
+  image.name = 'Image'
+  image.resize(fixture.initial.width, fixture.initial.height)
+  image.x = fixture.initial.x
+  image.y = fixture.initial.y
+  image.constraints = fixture.constraints
+  main.appendChild(image)
+  return main
+}
+
+function expectPortrait(
+  instance: InstanceNode,
+  name: string,
+  expected: (typeof cases)[number]['expected']
+) {
+  const nested = instance.children.find((child) => child.type === 'INSTANCE')
+  expect(nested?.type).toBe('INSTANCE')
+  if (nested?.type !== 'INSTANCE') throw new Error('No portrait instance')
+  expect(rect(nested)).toEqual({ x: 0, y: 0, width: 128, height: 192 })
+  expect(nested.mainComponent?.name).toBe(name)
+  const artwork = nested.children[0]
+  if (!artwork) throw new Error('Missing portrait artwork')
+  expect(rect(artwork)).toEqual(expected)
+}
+
+for (const fixture of cases) {
+  test(`instance swap keeps resized ${fixture.name} child constraints after save`, async () => {
+    const api = createAPI()
+    const first = portrait(api, 'First', fixture)
+    const second = portrait(api, 'Second', fixture)
+    if ('replacementSize' in fixture)
+      second.resize(fixture.replacementSize.width, fixture.replacementSize.height)
+    const owner = api.createComponent()
+    owner.name = 'Candidate'
+    owner.resize(128, 192)
+    const slot = first.createInstance()
+    owner.appendChild(slot)
+    slot.resize(128, 192)
+    const property = owner.addComponentProperty('portrait', 'INSTANCE_SWAP', first.id)
+    slot.componentPropertyReferences = { mainComponent: property }
+    const usage = owner.createInstance()
+    usage.name = 'Usage'
+    expectPortrait(usage, 'First', fixture.expected)
+
+    usage.setProperties({ [property]: second.id })
+    expectPortrait(usage, 'Second', fixture.expected)
+    api.graph.syncInstances(owner.id)
+    expectPortrait(usage, 'Second', fixture.expected)
+    const replacementArtwork = second.children[0]
+    if (!replacementArtwork) throw new Error('Missing replacement artwork')
+    expect(rect(replacementArtwork)).toEqual(
+      'replacementInitial' in fixture ? fixture.replacementInitial : fixture.initial
+    )
+
+    const bytes = await exportFigFile(api.graph)
+    const graph = await parseFigFile(uint8ArrayToArrayBuffer(bytes), { populate: 'all' })
+    const reopened = new FigmaAPI(graph)
+    const node = [...graph.getAllNodes()].find(
+      (node) => node.type === 'INSTANCE' && node.name === 'Usage'
+    )
+    if (!node) throw new Error('Missing reopened usage instance')
+    expectPortrait(asInstanceNode(reopened.wrapNode(node.id)), 'Second', fixture.expected)
+  })
+}
