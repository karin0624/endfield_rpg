+      )
+    ).toBe(true)
+    expect(projected.inlineStyle?.['background-attachment']).toBeUndefined()
+  }
+)
+
+test.each([
+  [8, 5, '320px 200px', '0px -10px'],
+  [10, 5, '360px 180px', '-20px 0px'],
