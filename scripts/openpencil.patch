index 0000000000000000000000000000000000000000..36ab3ae462fb3dc3a30b3001db9de68233e42032
--- /dev/null
+++ b/packages/dom-css/tests/export/projection/gradients.test.ts
@@ -0,0 +1,118 @@
+import { describe, expect, test } from 'bun:test'
+
+import { sceneNodeToDesignDocument, type DesignElement } from '@open-pencil/dom-css/export'
+import { SceneGraph, type Fill } from '@open-pencil/scene-graph'
+import { colorToCSS } from '@open-pencil/scene-graph/color'
+
+const red = { r: 1, g: 0, b: 0, a: 1 }
+const blue = { r: 0, g: 0, b: 1, a: 1 }
+const solid = (color = red, opacity = 1): Fill => ({
+  type: 'SOLID',
+  color,
+  opacity,
+  visible: true
+})
+type LinearFill = Fill & Required<Pick<Fill, 'gradientStops' | 'gradientTransform'>>
+const linear = (
+  gradientTransform: NonNullable<Fill['gradientTransform']>,
+  opacity = 1
+): LinearFill => ({
+  type: 'GRADIENT_LINEAR',
+  color: red,
+  opacity,
+  visible: true,
+  gradientTransform,
+  gradientStops: [
+    { color: red, position: 0 },
+    { color: blue, position: 1 }
+  ]
+})
+const horizontal = { m00: 1, m01: 0, m02: 0, m10: 0, m11: 1, m12: 0 }
+
+function style(fills: Fill[]) {
+  const graph = new SceneGraph()
+  const node = graph.createNode('FRAME', graph.getPages()[0].id, { width: 200, height: 100, fills })
+  return (sceneNodeToDesignDocument(graph, node.id).children[0] as DesignElement).inlineStyle
+}
+
+describe('native linear gradient paints', () => {
+  test('projects horizontal and vertical native axes at their layer dimensions', () => {
+    expect(style([linear(horizontal)])?.['background-image']).toBe(
+      'linear-gradient(90deg, #FF0000 0%, #0000FF 100%)'
+    )
+    expect(
+      style([linear({ m00: 0, m01: 1, m02: 0, m10: -1, m11: 0, m12: 1 })])?.['background-image']
+    ).toBe('linear-gradient(180deg, #FF0000 0%, #0000FF 100%)')
+    expect(style([linear({ ...horizontal, m00: -1, m02: 1 })])?.['background-image']).toBe(
+      'linear-gradient(270deg, #FF0000 0%, #0000FF 100%)'
+    )
+  })
+
+  test('keeps translated stops and multiplies paint opacity with stop alpha', () => {
+    const fill = linear({ ...horizontal, m00: 2, m02: -0.5 }, 0.5)
+    fill.gradientStops[1].color = { ...blue, a: 0.5 }
+    expect(style([fill])?.['background-image']).toBe(
+      'linear-gradient(90deg, rgba(255, 0, 0, 0.5) 25%, rgba(0, 0, 255, 0.25) 75%)'
+    )
+  })
+
+  test('keeps bottom-to-top paint order and omits hidden paints', () => {
+    const hidden = { ...solid(), visible: false }
+    expect(style([solid(blue), linear(horizontal), hidden, solid(red, 0.25)])).toMatchObject({
+      'background-color': '#0000FF',
+      'background-image':
+        'linear-gradient(rgba(255, 0, 0, 0.25), rgba(255, 0, 0, 0.25)), linear-gradient(90deg, #FF0000 0%, #0000FF 100%)'
+    })
+  })
+
+  test('preserves subtle translucent stops instead of rounding their alpha', () => {
+    const fill = linear(horizontal)
+    const color = { r: 1, g: 1, b: 1, a: 9 / 255 }
+    fill.gradientStops[0].color = color
+    expect(style([fill])?.['background-image']).toContain(
+      `${colorToCSS(color, { precision: 'full' })} 0%`
+    )
+  })
+
+  test('native percentage stops stay proportional on fractional paint boxes', () => {
+    const graph = new SceneGraph()
+    const fill = linear(horizontal)
+    fill.gradientStops[1].position = Math.fround(0.78)
+    const node = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 1612.8125,
+      height: 47.03125,
+      fills: [fill]
+    })
+    const css = (sceneNodeToDesignDocument(graph, node.id).children[0] as DesignElement).inlineStyle
+    expect(css?.['background-image']).toContain(`${Math.fround(0.78) * 100}%`)
+    expect(css?.['background-image']).not.toContain('px')
+  })
+
+  test('exact float32 full-box angle preimages retain the original CSS direction', () => {
+    const graph = new SceneGraph()
+    const angle = (115 * Math.PI) / 180
+    const width = 182,
+      height = 46
+    const length = Math.abs(Math.sin(angle)) * width + Math.abs(Math.cos(angle)) * height
+    const m00 = (Math.sin(angle) * width) / length
+    const m01 = (-Math.cos(angle) * height) / length
+    const fill = linear({
+      m00: Math.fround(m00),
+      m01: Math.fround(m01),
+      m02: Math.fround(0.5 - (m00 + m01) / 2),
+      m10: Math.fround(-m01),
+      m11: Math.fround(m00),
+      m12: 0
+    })
+    const node = graph.createNode('FRAME', graph.getPages()[0].id, { width, height, fills: [fill] })
+    const css = (sceneNodeToDesignDocument(graph, node.id).children[0] as DesignElement).inlineStyle
+    expect(css?.['background-image']).toBe('linear-gradient(115deg, #FF0000 0%, #0000FF 100%)')
+    fill.gradientTransform.m02 = Math.fround(0.1)
+    graph.updateNode(node.id, { fills: [fill] })
+    expect(
+      (sceneNodeToDesignDocument(graph, node.id).children[0] as DesignElement).inlineStyle?.[
+        'background-image'
+      ]
+    ).not.toBe('linear-gradient(115deg, #FF0000 0%, #0000FF 100%)')
+  })
+})
