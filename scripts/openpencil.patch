index 0000000000000000000000000000000000000000..76db0118da6671d06b8f28c4b4f58edbaecd9960
--- /dev/null
+++ b/packages/dom-css/tests/export/projection/images.test.ts
@@ -0,0 +1,194 @@
+import { describe, expect, test } from 'bun:test'
+
+import { fromUint8Array } from 'js-base64'
+
+import {
+  sceneNodeToDesignDocument,
+  type DesignElement,
+  type DesignNode
+} from '@open-pencil/dom-css/export'
+import { SceneGraph, type Fill, type NodeType } from '@open-pencil/scene-graph'
+import { BLACK } from '@open-pencil/scene-graph/constants'
+
+const bytes = new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10])
+const image = (props: Partial<Fill> = {}): Fill => ({
+  type: 'IMAGE',
+  color: BLACK,
+  opacity: 1,
+  visible: true,
+  imageHash: 'original',
+  imageScaleMode: 'FILL',
+  ...props
+})
+
+function element(node: DesignNode | undefined): DesignElement {
+  if (node?.type !== 'element') throw new Error('Expected an element')
+  return node
+}
+
+function fixture(type: NodeType = 'FRAME', fill = image()) {
+  const graph = new SceneGraph()
+  graph.images.set('original', bytes)
+  const node = graph.createNode(type, graph.getPages()[0].id, {
+    name: 'Image surface',
+    width: 1920,
+    height: 1080,
+    fills: [fill]
+  })
+  const project = (background = true) =>
+    element(
+      sceneNodeToDesignDocument(graph, node.id, {
+        imageFrameFills: background ? 'background' : 'image'
+      }).children[0]
+    )
+  return { graph, node, project }
+}
+
+describe('frame image fill projection', () => {
+  for (const type of ['FRAME', 'COMPONENT', 'INSTANCE'] as const) {
+    test(`a native ${type} image fill is an original-byte CSS background`, () => {
+      const { project, graph } = fixture(type)
+      const result = project()
+      expect(result.tagName).toBe('div')
+      expect(result.attrs.src).toBeUndefined()
+      expect(result.inlineStyle).toMatchObject({
+        'background-image': `url("data:image/png;base64,${fromUint8Array(bytes)}")`,
+        'background-position': 'center',
+        'background-size': 'cover',
+        'background-repeat': 'no-repeat'
+      })
+      expect(result.inlineStyle?.['object-fit']).toBeUndefined()
+      expect(graph.images.get('original')).toBe(bytes)
+    })
+  }
+
+  test('an image-painted frame retains its content with either projection mode', () => {
+    const { graph, node, project } = fixture()
+    graph.createNode('TEXT', node.id, { text: 'Editable foreground', width: 200, height: 30 })
+    for (const background of [true, false]) {
+      const result = project(background)
+      expect(result.tagName).toBe('div')
+      expect(result.inlineStyle?.['background-image']).toStartWith('url("data:image/png;')
+      expect(element(result.children[0]).children).toEqual([
+        { type: 'text', text: 'Editable foreground' }
+      ])
+    }
+  })
+
+  test('FIT centers the unresampled image with contain sizing', () => {
+    const { project } = fixture('FRAME', image({ imageScaleMode: 'FIT' }))
+    expect(project().inlineStyle).toMatchObject({
+      'background-size': 'contain',
+      'background-position': 'center',
+      'background-repeat': 'no-repeat'
+    })
+  })
+
+  test('legacy leaf frames and ordinary rectangle images retain img semantics', () => {
+    const legacy = fixture().project(false)
+    const rectangle = fixture('RECTANGLE').project()
+    for (const result of [legacy, rectangle]) {
+      expect(result.tagName).toBe('img')
+      expect(result.attrs.src).toStartWith('data:image/png;base64,')
+      expect(result.inlineStyle?.['object-fit']).toBe('cover')
+      expect(result.inlineStyle?.['background-image']).toBeUndefined()
+    }
+  })
+
+  test('native crop matrices remain image geometry rather than becoming cover backgrounds', () => {
+    const matrix = { m00: 0.5, m01: 0, m02: 0.125, m10: 0, m11: 0.75, m12: 0.0625 }
+    const { node, project } = fixture(
+      'FRAME',
+      image({ imageScaleMode: 'CROP', imageTransform: matrix })
+    )
+    const result = project()
+    expect(result.tagName).toBe('img')
+    expect(result.attrs.src).toStartWith('data:image/png;base64,')
+    expect(result.inlineStyle?.['background-image']).toBeUndefined()
+    expect(node.fills[0].imageTransform).toEqual(matrix)
+  })
+
+  test('color overlays stay above the image rather than moving below it', () => {
+    const { graph, node, project } = fixture()
+    graph.updateNode(node.id, {
+      fills: [image(), { type: 'SOLID', color: BLACK, opacity: 0.5, visible: true }]
+    })
+    const style = project().inlineStyle
+    expect(style?.['background-color']).toBeUndefined()
+    expect(style?.['background-image']).toStartWith(
+      'linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('
+    )
+  })
+
+  test('TILE without a matrix repeats unscaled original pixels from the native origin', () => {
+    const { project } = fixture('FRAME', image({ imageScaleMode: 'TILE' }))
+    expect(project().inlineStyle).toMatchObject({
+      'background-size': 'auto',
+      'background-position': '0px 0px',
+      'background-repeat': 'repeat'
+    })
+  })
+
+  test('axis-aligned TILE matrices retain native size and phase beneath overlays', () => {
+    const { graph, node, project } = fixture(
+      'FRAME',
+      image({
+        imageScaleMode: 'TILE',
+        imageTransform: { m00: 15, m01: 0, m02: -7, m10: 0, m11: 8.4375, m12: -3.71875 }
+      })
+    )
+    expect(project().inlineStyle).toMatchObject({
+      'background-size': '128px 128px',
+      'background-position': '896px 476px',
+      'background-repeat': 'repeat'
+    })
+    graph.updateNode(node.id, {
+      fills: [...node.fills, { type: 'SOLID', color: BLACK, opacity: 0.5, visible: true }]
+    })
+    expect(project().inlineStyle).toMatchObject({
+      'background-size': 'auto, 128px 128px',
+      'background-position': 'center, 896px 476px',
+      'background-repeat': 'no-repeat, repeat'
+    })
+  })
+
+  test('TILE matrices may independently scale and offset both axes', () => {
+    const { project } = fixture(
+      'FRAME',
+      image({
+        imageScaleMode: 'TILE',
+        imageTransform: { m00: 10, m01: 0, m02: 0.5, m10: 0, m11: 5, m12: -0.5 }
+      })
+    )
+    expect(project().inlineStyle).toMatchObject({
+      'background-size': '192px 216px',
+      'background-position': '-96px 108px'
+    })
+  })
+
+  test('unsupported rotated, reflected, or singular TILE matrices fail explicitly', () => {
+    for (const matrix of [
+      { m00: 1, m01: 0.5, m02: 0, m10: 0, m11: 1, m12: 0 },
+      { m00: -1, m01: 0, m02: 0, m10: 0, m11: 1, m12: 0 },
+      { m00: 1, m01: 0, m02: 0, m10: 0, m11: 0, m12: 0 }
+    ])
+      expect(() =>
+        fixture(
+          'FRAME',
+          image({
+            imageScaleMode: 'TILE',
+            imageTransform: matrix
+          })
+        ).project()
+      ).toThrow('Unsupported transformed container TILE image fill')
+  })
+
+  test('unsupported cropped containers and paint modes fail explicitly', () => {
+    const cropped = fixture('FRAME', image({ imageScaleMode: 'CROP' }))
+    cropped.graph.createNode('TEXT', cropped.node.id, { text: 'Keep this content' })
+    expect(() => cropped.project()).toThrow('Unsupported container image fill mode CROP')
+    expect(() => fixture('FRAME', image({ opacity: 0.5 })).project()).toThrow(
+      'Unsupported container image paint opacity or blend'
+    )
+  })
+})
