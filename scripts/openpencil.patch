+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { FigmaAPI } from '#core/figma-api'
+import { renderNodesToHTML } from '#core/io/formats/html'
+
+const fill = {
+  type: 'SOLID' as const,
+  color: { r: 1, g: 0, b: 0, a: 1 },
+  opacity: 1,
+  visible: true
+}
+
+function drawing(type: 'FRAME' | 'COMPONENT' = 'FRAME') {
+  const graph = new SceneGraph()
+  const frame = graph.createNode(type, graph.getPages()[0].id, {
+    width: 25.125,
+    height: 25.234375,
+    fills: [],
+    clipsContent: false
+  })
+  graph.createNode('RECTANGLE', frame.id, {
+    x: 0.123456,
+    y: 1.234567,
+    width: 4.345678,
+    height: 3.456789,
+    fills: [fill]
+  })
+  graph.createNode('ELLIPSE', frame.id, {
+    x: 8.123456,
+    width: 8.246912,
+    height: 6.246912,
+    fills: [fill]
+  })
+  graph.createNode('LINE', frame.id, {
+    x: 20.123456,
+    y: 2.234567,
+    width: 4.234567,
+    height: 0,
+    fills: [],
+    strokes: [{ ...fill, weight: 1.234567, align: 'CENTER' }]
+  })
+  return { graph, frame }
+}
+
+test('standalone pure vector frames use one inline SVG viewport without rounding or path approximations', async () => {
+  const { graph, frame } = drawing()
+  const { html } = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+  expect(html.match(/<svg/g)).toHaveLength(1)
+  expect(html).toContain('viewBox="0 0 25.125 25.234375"')
+  expect(html).toContain('translate(0.123456, 1.234567)')
+  expect(html).toContain('<rect width="4.345678" height="3.456789"')
+  expect(html).toContain('<ellipse cx="4.123456"')
+  expect(html).toContain('<line x1="0" y1="0" x2="4.234567"')
+  expect(html).not.toContain('data:image/')
+  expect(graph.getChildren(frame.id)).toHaveLength(3)
+})
+
+test('mixed UI remains HTML and export presets do not change the vector drawing', async () => {
+  const { graph, frame } = drawing()
+  const label = graph.createNode('TEXT', frame.id, { width: 20, height: 10, text: 'Editable' })
+  const mixed = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+  expect(mixed.html).toContain('Editable')
+  expect(mixed.html).not.toContain('viewBox="0 0 25.125 25.234375"')
+  graph.deleteNode(label.id)
+  const original = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+  graph.updateNode(frame.id, { exportSettings: [{ format: 'svg', scale: 1 }] })
+  const asset = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+  expect(asset.html).toBe(original.html)
+  expect(asset.assets).toEqual(original.assets)
+  expect(asset.html).toContain('<svg')
+})
+
+test.each(['FRAME', 'COMPONENT', 'INSTANCE'] as const)(
+  'a pure %s keeps its vector viewport when its fixed constraint has no scrolling owner',
+  async (type) => {
+    const { graph, frame } = drawing(type === 'FRAME' ? 'FRAME' : 'COMPONENT')
+    let target = frame
+    if (type === 'INSTANCE') {
+      const main = new FigmaAPI(graph).getNodeById(frame.id)
+      if (!main || main.type !== 'COMPONENT') throw new Error('Missing public component')
+      const instance = main.createInstance()
+      const made = graph.getNode(instance.id)
+      if (!made) throw new Error('Missing native instance')
+      target = made
+    }
+    const before = await renderNodesToHTML(graph, [target.id], { html: 'standalone' })
+    graph.updateNode(target.id, { scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME' })
+    const { html } = await renderNodesToHTML(graph, [target.id], { html: 'standalone' })
+    expect(html).toContain(`<svg width="25.125" height="25.234375" viewBox="0 0 25.125 25.234375"`)
+    expect(html).toBe(before.html)
+  }
+)
+
+test.each(['scrolling', 'fixed child', 'mask'] as const)(
+  'a vector container preserves its %s semantics instead of flattening its children',
+  async (kind) => {
+    const { graph, frame } = drawing()
+    if (kind === 'scrolling') graph.updateNode(frame.id, { overflowDirection: 'HORIZONTAL' })
+    else {
+      const child = graph.getChildren(frame.id)[0]
+      if (!child) throw new Error('Missing native drawing child')
+      graph.updateNode(
+        child.id,
+        kind === 'mask'
+          ? { isMask: true, maskType: 'VECTOR' }
+          : { scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME' }
+      )
+    }
+    const { html } = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+    expect(html).toContain(`<div data-open-pencil-node-id="${frame.id}"`)
+    expect(html).not.toContain('viewBox="0 0 25.125 25.234375"')
+    if (kind === 'scrolling') expect(html).toContain('overflow-x: auto')
+  }
+)
+
+test.each([false, true])(
+  'a nested vector instance keeps its public identity (visible=%s)',
+  async (visible) => {
+    const { graph, frame } = drawing('COMPONENT')
+    const api = new FigmaAPI(graph)
+    const main = api.getNodeById(frame.id)
+    if (!main || main.type !== 'COMPONENT') throw new Error('Missing component')
+    const parent = api.createFrame()
+    parent.resize(400, 200)
+    const instance = main.createInstance()
+    parent.appendChild(instance)
+    instance.opacity = visible ? 1 : 0
+    const { html } = await renderNodesToHTML(graph, [parent.id], { html: 'standalone' })
+    expect(html).toContain(`data-open-pencil-node-id="${parent.id}"`)
+    expect(html).toContain(`data-open-pencil-node-id="${instance.id}"`)
+    expect(html).toContain('viewBox="0 0 25.125 25.234375"')
+    expect(html).toContain('translate(0.123456, 1.234567)')
+  }
+)
