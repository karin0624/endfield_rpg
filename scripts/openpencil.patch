index 0000000000000000000000000000000000000000..bbaddbe6ccf6ffd966c17c25682e141d76bfd13f
--- /dev/null
+++ b/packages/core/tests/io/formats/html/native-grayscale.test.ts
@@ -0,0 +1,177 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { toUint8Array } from 'js-base64'
+
+import { FigmaAPI, SceneGraph, exportFigFile, initCodec, parseFigFile } from '@open-pencil/core'
+import type { Fill, SceneNode } from '@open-pencil/scene-graph'
+
+import { renderNodesToHTML } from '#core/io/formats/html'
+
+beforeAll(initCodec)
+
+const image = toUint8Array(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/WioAAAAASUVORK5CYII='
+)
+const solid = (r: number, g: number, b: number): Fill => ({
+  type: 'SOLID',
+  color: { r, g, b, a: 1 },
+  opacity: 1,
+  visible: true
+})
+
+function fixture() {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const imageHash = api.createImage(image).hash
+  const root = api.createFrame()
+  root.name = 'Grayscale composition'
+  root.resize(80, 40)
+  root.fills = []
+  root.clipsContent = false
+  const rectangle = (parent: string, name: string, fill: Fill) =>
+    graph.createNode('RECTANGLE', parent, {
+      name,
+      width: 80,
+      height: 40,
+      fills: [fill]
+    })
+  rectangle(root.id, 'Black', solid(0, 0, 0))
+  const mask = api.createFrame()
+  mask.name = 'Original editable paints'
+  mask.resize(80, 40)
+  mask.fills = []
+  mask.clipsContent = false
+  root.appendChild(mask)
+  mask.isMask = true
+  mask.maskType = 'LUMINANCE'
+  rectangle(mask.id, 'Opaque background', solid(1, 0, 0))
+  graph.createNode('FRAME', mask.id, {
+    name: 'Original texture',
+    width: 80,
+    height: 40,
+    fills: [
+      {
+        ...solid(0, 0, 0),
+        type: 'IMAGE',
+        imageHash,
+        imageScaleMode: 'TILE',
+        imageTransform: { m00: 10, m01: 0, m02: 0, m10: 0, m11: 5, m12: 0 }
+      }
+    ]
+  })
+  rectangle(root.id, 'White', solid(1, 1, 1))
+  return { graph, root, imageHash }
+}
+
+function named(graph: SceneGraph, name: string): SceneNode {
+  const node = [...graph.nodes.values()].find((item) => item.name === name)
+  if (!node) throw new Error(`Missing native layer: ${name}`)
+  return node
+}
+
+test('ordinary luminance layers stay editable through two saves and export grayscale without resampling', async () => {
+  const initial = fixture()
+  let graph = initial.graph
+  for (let cycle = 0; cycle < 2; cycle++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const api = new FigmaAPI(graph)
+    const root = named(graph, 'Grayscale composition')
+    const mask = named(graph, 'Original editable paints')
+    const background = named(graph, 'Opaque background')
+    expect(mask.isMask).toBe(true)
+    expect(mask.maskType).toBe('LUMINANCE')
+    api.wrapNode(background.id).fills = [solid(0, 0, 1)]
+    const before = JSON.stringify([...graph.nodes.values()])
+    const { html } = await renderNodesToHTML(graph, [root.id], { html: 'standalone' })
+    expect(html).toContain('grayscale(1)')
+    expect(html).toContain('background-color: #0000FF')
+    expect(html).toContain('background-repeat: repeat')
+    expect(html).not.toContain('<mask')
+    expect(graph.images.get(initial.imageHash)).toEqual(image)
+    expect(JSON.stringify([...graph.nodes.values()])).toBe(before)
+    expect(graph.getChildren(root.id).map((node) => node.name)).toEqual([
+      'Black',
+      'Original editable paints',
+      'White'
+    ])
+  }
+})
+
+test('editing a bound white paint changes the native composition rather than keeping the grayscale reduction', async () => {
+  const { graph, root } = fixture()
+  const api = new FigmaAPI(graph)
+  const collection = api.createVariableCollection('Output palette')
+  const white = api.createVariable('Output', 'COLOR', collection.id, { r: 1, g: 1, b: 1, a: 1 })
+  api.bindVariable(named(graph, 'White').id, 'fills/0/color', white.id)
+  expect((await renderNodesToHTML(graph, [root.id], { html: 'standalone' })).html).toContain(
+    'grayscale(1)'
+  )
+  api.setVariableValue(white.id, collection.defaultModeId, { r: 0, g: 0, b: 1, a: 1 })
+  const { html } = await renderNodesToHTML(graph, [root.id], { html: 'standalone' })
+  expect(html).not.toContain('grayscale(1)')
+  expect(html).toContain('mask-type="luminance"')
+  expect(html).toContain('#0000FF')
+})
+
+test('an opaque background keeps its editable gradient layers through normal saves', async () => {
+  const initial = fixture()
+  const api = new FigmaAPI(initial.graph)
+  api.wrapNode(named(initial.graph, 'Opaque background').id).fills = [
+    solid(1, 0, 0),
+    {
+      ...solid(1, 1, 1),
+      type: 'GRADIENT_LINEAR',
+      opacity: 0.25,
+      gradientStops: [
+        { color: { r: 1, g: 1, b: 1, a: 1 }, position: 0 },
+        { color: { r: 0, g: 0, b: 1, a: 1 }, position: 1 }
+      ],
+      gradientTransform: { m00: 1, m01: 0, m02: 0, m10: 0, m11: 1, m12: 0 }
+    }
+  ]
+  let graph = initial.graph
+  for (let cycle = 0; cycle < 2; cycle++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const { html } = await renderNodesToHTML(graph, [named(graph, 'Grayscale composition').id], {
+      html: 'standalone'
+    })
+    expect(html).toContain('grayscale(1)')
+    expect(html).toContain('linear-gradient(')
+    expect(html).not.toContain('<mask')
+    expect(named(graph, 'Opaque background').fills).toHaveLength(2)
+    expect(graph.images.get(initial.imageHash)).toEqual(image)
+  }
+})
+
+test.each([
+  'translucent background',
+  'alpha mask',
+  'offset output',
+  'extra output',
+  'blended output'
+])('%s retains its own native mask semantics', async (change) => {
+  const { graph, root } = fixture()
+  const api = new FigmaAPI(graph)
+  if (change === 'translucent background')
+    api.wrapNode(named(graph, 'Opaque background').id).opacity = 0.5
+  if (change === 'alpha mask')
+    api.wrapNode(named(graph, 'Original editable paints').id).maskType = 'ALPHA'
+  if (change === 'offset output') api.wrapNode(named(graph, 'White').id).x = 1
+  if (change === 'extra output')
+    graph.createNode('RECTANGLE', root.id, { width: 10, height: 10, fills: [solid(0, 1, 0)] })
+  if (change === 'blended output')
+    api.wrapNode(named(graph, 'White').id).fills = [{ ...solid(1, 1, 1), blendMode: 'MULTIPLY' }]
+  const { html } = await renderNodesToHTML(graph, [root.id], { html: 'standalone' })
+  expect(html).not.toContain('grayscale(1)')
+  expect(html).toContain('<mask')
+})
+
+test('a geometric mask is never mistaken for the grayscale black underlay', async () => {
+  const { graph, root } = fixture()
+  const black = new FigmaAPI(graph).wrapNode(named(graph, 'Black').id)
+  black.isMask = true
+  black.maskType = 'VECTOR'
+  await expect(renderNodesToHTML(graph, [root.id], { html: 'standalone' })).rejects.toThrow(
+    'mixed vector/paint masks'
+  )
+})
