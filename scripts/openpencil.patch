+    if (occurrence?.type !== 'INSTANCE') throw new Error('Missing normal instance')
+    occurrence.resize(200, 100)
+    const vector = api.getNodeById(graph.getChildren(graph.getChildren(main.id)[0].id)[0].id)
+    if (vector?.type !== 'VECTOR') throw new Error('Missing editable vector')
+    const weight = vector.strokeWeight
+    vector.strokes = [solidStroke({ r: 1, g: 0, b: 0, a: 1 }, { weight, align: 'CENTER' })]
+    graph.syncInstances(main.id)
+    expect(occurrence.children[0].x).toBe(30)
+    expect(artifact(graph, named(graph, placed.name))).toContain('stroke="#FF0000"')
+  }
+})
+
+test('an unresized stroked SVG component keeps its own artifact identity inside a pure vector camera', async () => {
+  const { graph, api } = fixture()
+  const main = api.createComponent()
+  main.name = 'Small original SVG'
+  main.resize(10, 8)
+  main.fills = []
+  main.exportSettings = [{ format: 'SVG' }]
+  const svg = api.createNodeFromSvg(
+    '<svg width="10" height="8"><path d="M1 2L5 6L9 2" fill="none" stroke="#fff"/></svg>'
+  )
+  for (const child of svg.children) main.appendChild(child)
+  svg.remove()
+  const camera = api.createFrame()
+  camera.resize(1920, 1080)
+  camera.fills = []
+  const placed = main.createInstance()
+  placed.name = 'Preserved subject'
+  camera.appendChild(placed)
+  const html = await htmlFormat.exportContent?.(
+    { graph, target: { scope: 'node', nodeId: camera.id } },
+    { html: 'standalone' }
+  )
+  expect(html?.data).toContain(`data-open-pencil-node-id="${camera.id}"`)
+  expect(html?.data).toContain(`data-open-pencil-node-id="${placed.id}"`)
+  expect(artifact(graph, named(graph, main.name))).toContain('preserveAspectRatio="xMidYMid meet"')
+})
+
+test.each([
+  'two axes grow',
+  'shrink',
+  'unclipped viewport',
+  'rounded container',
+  'unsupported stroke',
+  'noncentral',
+  'paint',
+  'content geometry'
+] as const)('%s retains the ordinary editable vector occurrence', (kind) => {
+  const { graph, placed, main, viewport } = fixture()
+  if (kind === 'two axes grow') placed.resize(200, 120)
+  if (kind === 'shrink') placed.resize(120, 100)
+  if (kind === 'unclipped viewport') {
+    viewport.clipsContent = false
+    graph.syncInstances(main.id)
+  }
+  if (kind === 'rounded container') {
+    main.cornerRadius = 8
+    graph.syncInstances(main.id)
+  }
+  if (kind === 'unsupported stroke') {
+    const vector = graph.getNode(viewport.children[0].id)
+    if (!vector) throw new Error('Missing normal stroke artwork')
+    const strokes: SceneNode['strokes'] = vector.strokes.map((stroke) => ({
+      ...stroke,
+      type: 'NOISE'
+    }))
+    graph.updateNode(vector.id, { strokes })
+    graph.syncInstances(main.id)
+  }
+  if (kind === 'noncentral') {
+    main.primaryAxisAlignItems = 'MIN'
+    graph.syncInstances(main.id)
+  }
+  if (kind === 'paint') placed.children[0].opacity = 0.5
+  if (kind === 'content geometry') placed.children[0].resize(100, 100)
+  // Public geometry getters settle ordinary auto layout before the normal export.
+  expect(placed.width).toBeGreaterThan(0)
+  expect(svgAssetElement(graph, named(graph, placed.name))).toBeNull()
+})
+
+test('fresh public nested instances export their declared AUTO center without requiring a geometry read', async () => {
+  const made = fixture({ readGeometry: false })
+  const wrapper = made.api.createComponent()
+  wrapper.name = 'Ordinary artwork owner'
+  wrapper.resize(300, 180)
+  wrapper.fills = []
+  wrapper.appendChild(made.placed)
+  const copy = wrapper.createInstance()
+  copy.name = 'Fresh owner occurrence'
+  let graph = made.graph
+  for (let pass = 0; pass < 2; pass++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const owner = named(graph, copy.name)
+    const target = graph.getChildren(owner.id)[0]
+    const main = named(graph, made.main.name)
+    const expected = await svgFormat.exportContent?.(
+      { graph, target: { scope: 'node', nodeId: main.id } },
+      { precision: null, xmlDeclaration: false, preserveAspectRatio: 'xMidYMid meet' }
+    )
+    if (!expected || typeof expected.data !== 'string') throw new Error('Missing public SVG')
+    const before = structuredClone([...graph.nodes])
+    expect(artifact(graph, target)).toBe(expected.data)
+    const html = await htmlFormat.exportContent?.(
+      { graph, target: { scope: 'node', nodeId: owner.id } },
+      { html: 'standalone' }
+    )
+    expect(html?.data).toContain('<img ')
+    expect(html?.data).toContain(`data-open-pencil-node-id="${target.id}"`)
+    expect([...graph.nodes]).toEqual(before)
+  }
+})
+
+test.each(['absolute', 'grow', 'padding', 'gap', 'explicit position'] as const)(
+  'an unsettled %s viewport keeps ordinary native geometry',
+  (kind) => {
+    const { graph, main, placed, viewport } = fixture({ readGeometry: false })
+    if (kind === 'absolute') placed.children[0].layoutPositioning = 'ABSOLUTE'
+    if (kind === 'grow') placed.children[0].layoutGrow = 1
+    if (kind === 'explicit position') {
+      viewport.layoutPositioning = 'ABSOLUTE'
+      viewport.x = 2
+      graph.syncInstances(main.id)
+    }
+    if (kind === 'padding') main.paddingLeft = 1
+    if (kind === 'gap') main.itemSpacing = 1
+    if (kind === 'padding' || kind === 'gap') graph.syncInstances(main.id)
+    expect(svgAssetElement(graph, named(graph, placed.name))).toBeNull()
+  }
+)
+
+test('public occurrence edits cannot bypass a followed viewport position', () => {
+  const { graph, placed } = fixture({ readGeometry: false })
+  const before = structuredClone([...graph.nodes])
+  expect(() => {
+    placed.children[0].x = 2
+  }).toThrow('cannot be overridden')
+  expect([...graph.nodes]).toEqual(before)
+  expect(svgAssetElement(graph, named(graph, placed.name))?.tagName).toBe('img')
+})
