diff --git a/packages/core/tests/figma-api/create/defaults.test.ts b/packages/core/tests/figma-api/create/defaults.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4219e572d44f06a8f23dc2c96f567ec3686827d0
--- /dev/null
+++ b/packages/core/tests/figma-api/create/defaults.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, test } from 'bun:test'
+
+import { createEditor } from '@open-pencil/core/editor'
+import { FigmaAPI } from '@open-pencil/core/figma-api'
+import { SceneGraph } from '@open-pencil/scene-graph'
+import { expectFills } from '#core-tests/helpers/assert'
+
+// Recorded with the same script in Figma desktop 126: new layers from the plugin API and from the
+// drawing tools start alike.
+
+const WHITE = [1, 1, 1]
+const GREY = [0.85, 0.85, 0.85]
+const BLACK = [0, 0, 0]
+
+function solid(paints: readonly { type: string; color?: { r: number; g: number; b: number } }[]) {
+  return paints.map((paint) =>
+    paint.color
+      ? [paint.color.r, paint.color.g, paint.color.b].map((v) => Math.round(v * 100) / 100)
+      : paint.type
+  )
+}
+
+function api() {
+  return new FigmaAPI(new SceneGraph())
+}
+
+describe('new layer defaults', () => {
+  test('frames and components are white, and frames clip their content', () => {
+    const figma = api()
+    const frame = figma.createFrame()
+    const component = figma.createComponent()
+    expect(solid(expectFills(frame.fills))).toEqual([WHITE])
+    expect(frame.clipsContent).toBe(true)
+    expect(solid(expectFills(component.fills))).toEqual([WHITE])
+    expect(component.clipsContent).toBe(false)
+  })
+
+  test('shapes are light grey', () => {
+    const figma = api()
+    for (const shape of [
+      figma.createRectangle(),
+      figma.createEllipse(),
+      figma.createPolygon(),
+      figma.createStar()
+    ]) {
+      expect(solid(expectFills(shape.fills))).toEqual([GREY])
+      expect(shape.strokes).toEqual([])
+    }
+  })
+
+  test('lines and vectors have a black 1 px stroke, and a line has no height', () => {
+    const figma = api()
+    const line = figma.createLine()
+    const vector = figma.createVector()
+    expect([line.width, line.height]).toEqual([100, 0])
+    for (const node of [line, vector]) {
+      expect(node.fills).toEqual([])
+      expect(solid(node.strokes)).toEqual([BLACK])
+      expect(node.strokeWeight).toBe(1)
+    }
+  })
+
+  test('a stroke a script adds takes the 1 px default weight', () => {
+    const rect = api().createRectangle()
+    expect(rect.strokeWeight).toBe(1)
+    // Scripts pass Figma paints, which carry no weight.
+    Reflect.set(rect, 'strokes', [{ type: 'SOLID', color: { r: 1, g: 0, b: 0 } }])
+    expect(rect.strokeWeight).toBe(1)
+  })
+
+  test('sections are 496 square with a faint white outline, filled for the interface theme', () => {
+    const figma = api()
+    const light = figma.createSection()
+    expect([light.width, light.height, light.cornerRadius]).toEqual([496, 496, 2])
+    expect(solid(expectFills(light.fills))).toEqual([WHITE])
+    expect(solid(light.strokes)).toEqual([WHITE])
+    expect([light.strokes[0]?.opacity, light.strokeAlign]).toEqual([0.1, 'INSIDE'])
+    // Figma fills a section #444444 in its dark theme.
+    figma.theme = 'dark'
+    expect(solid(expectFills(figma.createSection().fills))).toEqual([[0.27, 0.27, 0.27]])
+  })
+
+  test('each layer gets its own copy of the default paints', () => {
+    const editor = createEditor()
+    try {
+      const page = editor.state.currentPageId
+      const first = editor.graph.getNode(editor.createShape('RECTANGLE', 0, 0, 10, 10, page))
+      const color = first?.fills[0]?.color
+      if (color) color.r = 1
+      const second = editor.graph.getNode(editor.createShape('RECTANGLE', 0, 0, 10, 10, page))
+      expect(solid(second?.fills ?? [])).toEqual([GREY])
+    } finally {
+      editor.dispose()
+    }
+  })
+
+  test('the drawing tools use the same defaults', () => {
+    const editor = createEditor()
+    try {
+      const page = editor.state.currentPageId
+      const frame = editor.graph.getNode(editor.createShape('FRAME', 0, 0, 100, 100, page))
+      const line = editor.graph.getNode(editor.createShape('LINE', 0, 0, 100, 0, page))
+      expect(frame?.clipsContent).toBe(true)
+      expect(solid(frame?.fills ?? [])).toEqual([WHITE])
+      expect(line?.fills).toEqual([])
+      expect(solid(line?.strokes ?? [])).toEqual([BLACK])
+      expect(line?.strokes[0]?.weight).toBe(1)
+    } finally {
+      editor.dispose()
+    }
+  })
+})
diff --git a/packages/core/tests/figma-api/create/instance-placement-constraints.test.ts b/packages/core/tests/figma-api/create/instance-placement-constraints.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3947099f007d85fde39e29579669ea09eee2665
--- /dev/null
+++ b/packages/core/tests/figma-api/create/instance-placement-constraints.test.ts
@@ -0,0 +1,106 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+import { asInstanceNode, createAPI } from '#core-tests/helpers/figma-api'
+
+import {
+  exportFigFile,
+  FigmaAPI,
+  type FigmaNodeProxy,
+  initCodec,
+  parseFigFile
+} from '@open-pencil/core'
+
+beforeAll(initCodec)
+
+const constraints = (value: 'MIN' | 'CENTER') => ({ horizontal: value, vertical: value })
+
+async function reopen(api: FigmaAPI): Promise<FigmaAPI> {
+  const bytes = await exportFigFile(api.graph)
+  return new FigmaAPI(await parseFigFile(bytes.slice().buffer, { populate: 'all' }))
+}
+
+function named(api: FigmaAPI, name: string): FigmaNodeProxy {
+  const node = expectDefined([...api.graph.getAllNodes()].find((entry) => entry.name === name))
+  return api.wrapNode(node.id)
+}
+
+for (const placement of ['MIN', 'CENTER'] as const) {
+  for (const nested of [false, true]) {
+    test(`${nested ? 'nested' : 'placed'} instance keeps ${placement} against its main through two cold saves and resize`, async () => {
+      let api = createAPI()
+      const basis = api.createComponent()
+      basis.name = 'Basis'
+      basis.resize(20, 10)
+      basis.constraints = constraints(placement === 'MIN' ? 'CENTER' : 'MIN')
+      const owner = nested ? api.createComponent() : api.createFrame()
+      owner.name = 'Owner'
+      owner.resize(100, 80)
+      const placed = basis.createInstance()
+      owner.appendChild(placed)
+      placed.name = 'Placement'
+      placed.x = 10.25
+      placed.y = 8.125
+      placed.constraints = constraints(placement)
+      if (nested) {
+        const usage = owner.createInstance()
+        usage.name = 'Usage'
+      }
+
+      for (let save = 0; save < 2; save++) {
+        api = await reopen(api)
+        expect(named(api, 'Owner').children[0]?.constraints).toEqual(constraints(placement))
+        expect(named(api, 'Basis').constraints).toEqual(
+          constraints(placement === 'MIN' ? 'CENTER' : 'MIN')
+        )
+        if (nested) {
+          const usage = asInstanceNode(named(api, 'Usage'))
+          expect(usage.children[0]?.constraints).toEqual(constraints(placement))
+        }
+      }
+
+      const resized = nested ? named(api, 'Usage') : named(api, 'Owner')
+      resized.resize(140, 100)
+      const child = expectDefined(resized.children[0])
+      expect(child.constraints).toEqual(constraints(placement))
+      expect({ x: child.x, y: child.y, width: child.width, height: child.height }).toEqual({
+        x: placement === 'MIN' ? 10.25 : 30.25,
+        y: placement === 'MIN' ? 8.125 : 18.125,
+        width: 20,
+        height: 10
+      })
+      api = await reopen(api)
+      const fresh = expectDefined(named(api, nested ? 'Usage' : 'Owner').children[0])
+      expect(fresh.constraints).toEqual(constraints(placement))
+      expect({ x: fresh.x, y: fresh.y }).toEqual({ x: child.x, y: child.y })
+    })
+  }
+}
+
+test('an unedited nested placement follows constraint edits to its owner component after cold saves', async () => {
+  let api = createAPI()
+  const basis = api.createComponent()
+  basis.resize(20, 10)
+  basis.constraints = constraints('CENTER')
+  const owner = api.createComponent()
+  owner.name = 'Owner'
+  owner.resize(100, 80)
+  const placed = basis.createInstance()
+  owner.appendChild(placed)
+  placed.name = 'Placement'
+  placed.constraints = constraints('MIN')
+  const usage = owner.createInstance()
+  usage.name = 'Usage'
+
+  for (const value of ['CENTER', 'MIN'] as const) {
+    expectDefined(named(api, 'Owner').children[0]).constraints = constraints(value)
+    api.graph.syncInstances(named(api, 'Owner').id)
+    expect(asInstanceNode(named(api, 'Usage')).children[0]?.constraints).toEqual(constraints(value))
+    api = await reopen(await reopen(api))
+    const inherited = expectDefined(asInstanceNode(named(api, 'Usage')).children[0])
+    expect(inherited.constraints).toEqual(constraints(value))
+    expect(() => (inherited.constraints = constraints(value === 'MIN' ? 'CENTER' : 'MIN'))).toThrow(
+      'This property cannot be overridden in an instance: vertical-constraint'
+    )
+  }
+})
