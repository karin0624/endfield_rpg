+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+test.each(['NONE', 'HEIGHT', 'WIDTH_AND_HEIGHT'] as const)(
+  'empty %s native text preserves an editable empty line in a baseline flow',
+  async (textAutoResize) => {
+    const graph = new SceneGraph()
+    const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 200,
+      height: 40,
+      layoutMode: 'HORIZONTAL',
+      counterAxisAlign: 'BASELINE'
+    })
+    graph.createNode('TEXT', root.id, {
+      text: '',
+      width: 80,
+      height: 24,
+      lineHeight: 24,
+      textAutoResize
+    })
+    const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, root.id), {
+      html: 'standalone'
+    })
+    expect(bundle.files[0].content).toContain('<br>')
+    expect(bundle.files[0].content).toContain('line-height: 24px')
+  }
+)
+
+test.each(['VERTICAL', 'HORIZONTAL'] as const)(
+  'native Fill children stretch across a %s Hug flow after edits',
+  async (layoutMode) => {
+    const graph = new SceneGraph()
+    const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 160,
+      height: 80,
+      layoutMode,
+      primaryAxisSizing: 'HUG'
+    })
+    const child = graph.createNode('FRAME', root.id, {
+      width: 90,
+      height: 30,
+      layoutAlignSelf: 'STRETCH'
+    })
+    const axis = layoutMode === 'VERTICAL' ? 'width' : 'height'
+    const render = async () =>
+      String(
+        (await exportHTMLBundle(sceneNodeToDesignDocument(graph, root.id), { html: 'standalone' }))
+          .files[0].content
+      )
+    expect(await render()).not.toContain(`${axis}: ${child[axis]}px`)
+    graph.updateNode(root.id, { [axis]: 240 })
+    expect(await render()).toContain(`${axis}: 240px`)
+    expect(await render()).not.toContain(`${axis}: ${child[axis]}px`)
+    graph.updateNode(child.id, { layoutAlignSelf: 'MIN' })
+    expect(await render()).toContain(`${axis}: ${child[axis]}px`)
+  }
+)
+
+test('fixed native auto-layout parents retain live Fill rather than cached child geometry', async () => {
+  const graph = new SceneGraph()
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 160,
+    height: 80,
+    layoutMode: 'VERTICAL'
+  })
+  graph.createNode('FRAME', root.id, { width: 90, height: 30, layoutAlignSelf: 'STRETCH' })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, root.id), {
+    html: 'standalone'
+  })
+  expect(bundle.files[0].content).not.toContain('width: 90px')
+  expect(bundle.files[0].content).toContain('align-self: stretch')
+})
+
+test('standalone auto-sizing text keeps its content width after an edit', async () => {
+  const graph = new SceneGraph()
+  const frame = graph.createNode('FRAME', graph.getPages()[0].id, { width: 400, height: 100 })
+  const text = graph.createNode('TEXT', frame.id, {
+    width: 20,
+    height: 16,
+    text: 'Before',
+    textAutoResize: 'WIDTH_AND_HEIGHT',
+    lineHeight: 24
+  })
+  graph.updateNode(text.id, { text: 'A much longer edited title' })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, frame.id), {
+    html: 'standalone'
+  })
+  const html = bundle.files[0].content
+  expect(html).toContain('A much longer edited title')
+  expect(html).toContain('width: max-content')
+  expect(html).not.toContain('width: 20px')
+  expect(html).not.toContain('height: 16px')
+  expect(html).toContain('line-height: 24px')
+})
+
+test('standalone text with auto height preserves its wrapping width', async () => {
+  const graph = new SceneGraph()
+  const text = graph.createNode('TEXT', graph.getPages()[0].id, {
+    width: 120,
+    height: 16,
+    text: 'Text that can wrap to multiple lines',
+    textAutoResize: 'HEIGHT'
+  })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, text.id), {
+    html: 'standalone'
+  })
+  expect(bundle.files[0].content).toContain('width: 120px')
+  expect(bundle.files[0].content).not.toContain('height: 16px')
+})
+
+test('hugging auto-layout frames keep content flow after native text edits', async () => {
+  const graph = new SceneGraph()
+  const frame = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 200,
+    height: 80,
+    layoutMode: 'VERTICAL',
+    primaryAxisSizing: 'HUG',
+    counterAxisSizing: 'HUG',
+    itemSpacing: 8,
+    maxWidth: 320
+  })
+  const title = graph.createNode('TEXT', frame.id, {
+    x: 31,
+    y: 27,
+    width: 20,
+    height: 16,
+    text: 'Before',
+    textAutoResize: 'WIDTH_AND_HEIGHT'
+  })
+  graph.updateNode(title.id, { text: 'An edited title' })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, frame.id), {
+    html: 'standalone'
+  })
+  const html = bundle.files[0].content
+  expect(html).toContain('width: max-content; height: max-content')
+  expect(html).toContain('max-width: 320px')
+  expect(html).toContain('gap: 8px')
+  expect(html).toContain('An edited title')
+  expect(html).not.toContain('left: 31px')
+  expect(html).not.toContain('top: 27px')
+})
diff --git a/packages/dom-css/tests/export/projection/gradients.test.ts b/packages/dom-css/tests/export/projection/gradients.test.ts
