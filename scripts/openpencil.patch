+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { FigmaAPI } from '#core/figma-api'
+import { svgFormat } from '#core/io/formats'
+import { exportFigFile } from '#core/io/formats/fig/export'
+import { parseFigFile } from '#core/io/formats/fig/read'
+import { parseSVGDocument } from '#core/io/formats/svg/document'
+
+function fixture() {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const art = graph.createNode('FRAME', graph.getPages()[0].id, {
+    name: 'Editable curves',
+    width: 100,
+    height: 80,
+    fills: [{ type: 'SOLID', color: { r: 1, g: 1, b: 1, a: 1 }, opacity: 1, visible: true }]
+  })
+  const group = graph.createNode('GROUP', art.id, {
+    name: 'Translated ink',
+    x: 12.25,
+    y: 7.5,
+    width: 20,
+    height: 20,
+    opacity: 0.5
+  })
+  const imported = api.createNodeFromSvg(
+    '<svg width="20" height="20"><path d="M0 0C3 0 3 10 10 10M2 4L8 4" fill="none" stroke="#f00" stroke-width=".7"/></svg>'
+  )
+  const paths = graph.getChildren(imported.id)
+  expect(paths).toHaveLength(1)
+  graph.reparentNode(paths[0].id, group.id)
+  graph.updateNode(paths[0].id, { x: 0, y: 0 })
+  graph.deleteNode(imported.id)
+  return { graph, art, group }
+}
+
+async function exported(graph: SceneGraph) {
+  const root = [...graph.getAllNodes()].find((node) => node.name === 'Editable curves')
+  if (!root || !svgFormat.exportContent) throw new Error('Missing editable artwork')
+  const result = await svgFormat.exportContent(
+    { graph, target: { scope: 'node', nodeId: root.id }, fileName: 'curves.svg' },
+    { precision: null }
+  )
+  if (typeof result.data !== 'string') throw new Error('Expected editable SVG')
+  const document = parseSVGDocument(result.data)
+  if (!document) throw new Error('Invalid SVG')
+  return { document, text: result.data }
+}
+
+test('translated native curves retain absolute endpoints, open contours and opacity through saving and editing', async () => {
+  let { graph } = fixture()
+  for (let cycle = 0; cycle < 2; cycle++) {
+    const bytes = await exportFigFile(graph)
+    graph = await parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate: 'all' })
+    const { document, text } = await exported(graph)
+    const paths = document.getElementsByTagName('path')
+    expect(paths.length).toBe(1)
+    expect(paths[0].getAttribute('d')).toBe(
+      cycle === 0
+        ? 'M12.25 7.5C15.25 7.5 15.25 17.5 22.25 17.5M14.25 11.5L20.25 11.5'
+        : 'M15.25 7.5C18.25 7.5 18.25 17.5 25.25 17.5M17.25 11.5L23.25 11.5'
+    )
+    expect(paths[0].getAttribute('d')).not.toContain('Z')
+    expect(paths[0].getAttribute('stroke')).toBe('#FF0000')
+    expect(text).toContain('opacity="0.5"')
+    expect(graph.images.size).toBe(0)
+    const group = [...graph.getAllNodes()].find((node) => node.name === 'Translated ink')
+    if (!group) throw new Error('Missing editable group')
+    new FigmaAPI(graph).wrapNode(group.id).x += 3
+  }
+})
+
+test('referenced gradient paints keep their native coordinate space', async () => {
+  const { graph, group } = fixture()
+  const path = graph.getChildren(group.id)[0]
+  graph.updateNode(path.id, {
+    strokes: [],
+    fills: [
+      {
+        type: 'GRADIENT_LINEAR',
+        color: { r: 0, g: 0, b: 0, a: 1 },
+        opacity: 1,
+        visible: true,
+        gradientTransform: { m00: 1, m01: 0, m02: 0, m10: 0, m11: 1, m12: 0 },
+        gradientStops: [
+          { position: 0, color: { r: 1, g: 0, b: 0, a: 1 } },
+          { position: 1, color: { r: 0, g: 0, b: 1, a: 1 } }
+        ]
+      }
+    ]
+  })
+  const { text } = await exported(graph)
+  expect(text).toContain('translate(12.25, 7.5)')
+  expect(text).toContain('fill="url(#grad')
+  expect(text).toContain('M0 0C3 0 3 10 10 10')
+})
+
+test('filters keep their translated group space and rotations retain their matrix', async () => {
+  const { graph, group } = fixture()
+  graph.updateNode(group.id, {
+    effects: [
+      {
+        type: 'DROP_SHADOW',
+        visible: true,
+        color: { r: 0, g: 0, b: 0, a: 0.5 },
+        offset: { x: 2, y: 3 },
+        radius: 4,
+        spread: 0
+      }
+    ]
+  })
+  const filtered = await exported(graph)
+  expect(filtered.text).toContain('translate(12.25, 7.5)')
+  expect(filtered.text).toContain('filter="url(#fx')
+  graph.updateNode(group.id, { effects: [], rotation: 30 })
+  expect((await exported(graph)).text).toContain('rotate(30, 10, 10)')
+})
