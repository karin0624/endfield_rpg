index 0000000000000000000000000000000000000000..441df00c8556ba307c87e946b6bafeff00aaac69
--- /dev/null
+++ b/packages/scene-graph/src/instances/swap-properties.ts
@@ -0,0 +1,82 @@
+import {
+  applyComponentPropertyValue,
+  componentPropertyDefinitions,
+  componentPropertyId
+} from '../components/properties'
+import type { SceneGraph } from '../index'
+import type { SceneNode } from '../types'
+
+const ASSIGNMENT_PREFIX = 'componentPropertyAssignments/'
+
+interface NestedAssignment {
+  path: Array<{ name: string; type: SceneNode['type'] }>
+  values: Array<[string, string]>
+}
+
+/** Only public assignments owned by this occurrence travel to another variant. */
+export function nestedAssignments(
+  graph: SceneGraph,
+  instance: SceneNode,
+  destination: SceneNode,
+  previous: SceneNode | undefined
+): NestedAssignment[] {
+  const set = previous?.parentId ? graph.getNode(previous.parentId) : undefined
+  if (
+    previous?.id !== destination.id &&
+    (set?.type !== 'COMPONENT_SET' || set.id !== destination.parentId)
+  )
+    return []
+  const result: NestedAssignment[] = []
+  const visit = (parent: SceneNode, owner: SceneNode, path: NestedAssignment['path']): void => {
+    const children = graph.getChildren(parent.id)
+    for (const child of children) {
+      // A path must identify one layer; an ambiguous same-name sibling cannot inherit an edit.
+      if (
+        children.filter((sibling) => sibling.name === child.name && sibling.type === child.type)
+          .length !== 1
+      )
+        continue
+      const next = [...path, { name: child.name, type: child.type }]
+      if (child.type === 'INSTANCE') {
+        const fields = owner.instanceOverrides.descendants.get(child.id)
+        const values = Object.entries(child.componentPropertyAssignments).filter(([id]) =>
+          fields?.has(`${ASSIGNMENT_PREFIX}${id}`)
+        )
+        if (values.length)
+          result.push({
+            path: next,
+            values: values.map(([id, value]) => [componentPropertyId(graph, child, id), value])
+          })
+      }
+      visit(child, child.type === 'INSTANCE' ? child : owner, next)
+    }
+  }
+  visit(instance, instance, [])
+  return result
+}
+
+export function restoreNestedAssignments(
+  graph: SceneGraph,
+  instance: SceneNode,
+  assignments: NestedAssignment[]
+): void {
+  for (const { path, values } of assignments) {
+    let target: SceneNode | undefined = instance
+    for (const segment of path) {
+      const matches: SceneNode[] = target
+        ? graph
+            .getChildren(target.id)
+            .filter((node) => node.name === segment.name && node.type === segment.type)
+        : []
+      target = matches.length === 1 ? matches[0] : undefined
+    }
+    if (target?.type !== 'INSTANCE') continue
+    const definitions = new Map(
+      componentPropertyDefinitions(graph, target).map((definition) => [definition.id, definition])
+    )
+    for (const [id, value] of values) {
+      const definition = definitions.get(id)
+      if (definition) applyComponentPropertyValue(graph, target.id, definition, value)
+    }
+  }
+}
