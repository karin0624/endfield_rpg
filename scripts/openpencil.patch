--- /dev/null
+++ b/packages/core/tests/io/formats/html/prototype.test.ts
@@ -0,0 +1,145 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, fontManager, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { FigmaAPI } from '@open-pencil/core/figma-api'
+
+import { htmlFormat } from '#core/io'
+
+beforeAll(async () => {
+  await initCodec()
+  const font = await fontManager.fetchBundledFont('/Inter-Regular.ttf')
+  if (!font) throw new Error('Missing bundled Inter')
+  fontManager.markLoaded('Inter', 'Regular', font)
+})
+
+test.each(['RECTANGLE', 'INSTANCE'] as const)(
+  'normal FIG %s triggers keep the overlay component editable and its saved click executable in HTML',
+  async (kind) => {
+    let graph = new SceneGraph()
+    let figma = new FigmaAPI(graph)
+    const screen = figma.createFrame()
+    screen.name = 'Start'
+    screen.resize(320, 200)
+    const triggerMain = figma.createComponent()
+    triggerMain.name = 'Trigger main'
+    triggerMain.resize(80, 32)
+    const trigger = kind === 'INSTANCE' ? triggerMain.createInstance() : figma.createRectangle()
+    trigger.name = 'Open'
+    trigger.resize(80, 32)
+    screen.appendChild(trigger)
+    const main = figma.createComponent()
+    main.name = 'Editable panel'
+    main.resize(120, 80)
+    const caption = figma.createText()
+    caption.name = 'Caption'
+    caption.characters = 'Original caption'
+    main.appendChild(caption)
+    const destination = figma.createFrame()
+    destination.name = 'Overlay destination'
+    destination.fills = []
+    destination.resize(120, 80)
+    const instance = main.createInstance()
+    instance.name = 'Panel'
+    destination.appendChild(instance)
+    instance.x = 0
+    instance.y = 0
+    graph.updateNode(destination.id, {
+      overlayPositionType: 'CENTER',
+      overlayBackgroundInteraction: 'CLOSE_ON_CLICK_OUTSIDE',
+      overlayBackground: { type: 'SOLID_COLOR', color: { r: 0, g: 0, b: 0 }, opacity: 0.6 }
+    })
+    await trigger.setReactionsAsync([
+      {
+        trigger: { type: 'ON_CLICK' },
+        actions: [
+          { type: 'NODE', destinationId: destination.id, navigation: 'OVERLAY', transition: null }
+        ]
+      }
+    ])
+
+    const named = (name: string) => {
+      const nodes = [...graph.getAllNodes()].filter((node) => node.name === name)
+      expect(nodes).toHaveLength(1)
+      return figma.wrapNode(nodes[0].id)
+    }
+    for (const value of ['Original caption', 'Edited native caption']) {
+      const editedMain = named('Editable panel')
+      if (editedMain.type !== 'COMPONENT') throw new Error('Main must remain native COMPONENT')
+      const text = editedMain.children.find((node) => node.name === 'Caption')
+      if (text?.type !== 'TEXT') throw new Error('Caption must remain native TEXT')
+      text.characters = value
+      graph.syncInstances(named('Editable panel').id)
+      graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+      figma = new FigmaAPI(graph)
+      const panel = named('Panel')
+      if (panel.type !== 'INSTANCE') throw new Error('Panel must remain native INSTANCE')
+      expect(panel.mainComponent?.id).toBe(named('Editable panel').id)
+      const open = named('Open')
+      expect(open.reactions[0].actions[0].destinationId).toBe(named('Overlay destination').id)
+      const exportHTML = htmlFormat.exportContent
+      if (!exportHTML) throw new Error('Missing public HTML adapter')
+      const result = await exportHTML(
+        { graph, target: { scope: 'node', nodeId: named('Start').id }, fileName: 'prototype.html' },
+        { html: 'standalone', fonts: 'assets' }
+      )
+      expect(result.data).toContain('<dialog ')
+      expect(result.data).toContain(value)
+      expect(result.data).toContain(`data-open-pencil-node-id="${open.id}"`)
+      expect(result.data).toContain('showModal()')
+      expect(result.data).not.toContain('<dialog open')
+    }
+  }
+)
+
+test('normal FIG vector-only destinations remain SVG inside the native top-layer surface', async () => {
+  let graph = new SceneGraph()
+  let figma = new FigmaAPI(graph)
+  const screen = figma.createFrame()
+  screen.name = 'Start'
+  screen.resize(320, 200)
+  const trigger = figma.createRectangle()
+  trigger.name = 'Open'
+  screen.appendChild(trigger)
+  const destination = figma.createFrame()
+  destination.name = 'Vector destination'
+  destination.resize(120, 80)
+  destination.fills = []
+  destination.clipsContent = false
+  const shape = figma.createRectangle()
+  shape.name = 'Editable vector shape'
+  destination.appendChild(shape)
+  graph.updateNode(destination.id, {
+    overlayPositionType: 'CENTER',
+    overlayBackground: { type: 'SOLID_COLOR', color: { r: 0, g: 0, b: 0 }, opacity: 0.5 }
+  })
+  await trigger.setReactionsAsync([
+    {
+      trigger: { type: 'ON_CLICK' },
+      actions: [
+        { type: 'NODE', destinationId: destination.id, navigation: 'OVERLAY', transition: null }
+      ]
+    }
+  ])
+  for (const width of [40, 64]) {
+    const nodes = [...graph.getAllNodes()]
+    const current = nodes.find((node) => node.name === 'Editable vector shape')
+    if (!current) throw new Error('Missing editable vector shape')
+    const proxy = figma.wrapNode(current.id)
+    if (proxy.type !== 'RECTANGLE') throw new Error('Shape must remain native RECTANGLE')
+    proxy.resize(width, 20)
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    figma = new FigmaAPI(graph)
+    const start = [...graph.getAllNodes()].find((node) => node.name === 'Start')
+    if (!start) throw new Error('Missing start frame')
+    const exportHTML = htmlFormat.exportContent
+    if (!exportHTML) throw new Error('Missing public HTML adapter')
+    const result = await exportHTML(
+      { graph, target: { scope: 'node', nodeId: start.id } },
+      { html: 'standalone' }
+    )
+    expect(result.data).toMatch(/<dialog\b[^>]*><svg\b[^>]*>/)
+    expect(result.data).toContain(`viewBox="0 0 120 80"`)
+    expect(result.data).toContain(`<rect width="${width}" height="20"`)
+    expect(result.data).not.toContain('data:image/')
+  }
+})
