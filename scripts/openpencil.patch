--- /dev/null
+++ b/packages/core/src/io/formats/html/prototype/animations.ts
@@ -0,0 +1,314 @@
+import type {
+  MotionEndpoint,
+  MotionFrame,
+  MotionLayer,
+  MotionSegment,
+  PrototypeAnimation
+} from '@open-pencil/dom-css/export'
+import type { PrototypeReaction, SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+import { startPendingLayout } from '#core/figma-api/pending-layout'
+import { extractPageContext, findPageId } from '#core/io/subgraph'
+
+import { assertCompatible, poseNodes, type PoseNode } from './poses'
+
+interface PreparedPrototypeAnimations {
+  graph: SceneGraph
+  nodeIds: string[]
+  animations: PrototypeAnimation[]
+}
+
+interface TimedEdge {
+  destinationId: string
+  delay: number
+  duration: number
+  easing: string
+  instant: boolean
+}
+
+function easing(value: {
+  type: string
+  easingFunctionCubicBezier?: { x1: number; y1: number; x2: number; y2: number }
+}): string {
+  const keywords: Record<string, string> = {
+    LINEAR: 'linear',
+    EASE_IN: 'ease-in',
+    EASE_OUT: 'ease-out',
+    EASE_IN_AND_OUT: 'ease-in-out'
+  }
+  if (keywords[value.type]) return keywords[value.type]
+  if (value.type === 'CUSTOM_CUBIC_BEZIER' && value.easingFunctionCubicBezier) {
+    const { x1, y1, x2, y2 } = value.easingFunctionCubicBezier
+    if ([x1, y1, x2, y2].every(Number.isFinite) && x1 >= 0 && x1 <= 1 && x2 >= 0 && x2 <= 1)
+      return `cubic-bezier(${x1}, ${y1}, ${x2}, ${y2})`
+  }
+  throw new Error('Unsupported HTML prototype easing')
+}
+
+function timedEdge(graph: SceneGraph, owner: SceneNode, activeChain = false): TimedEdge | null {
+  const reactions: { timeout: number; actions: PrototypeReaction['actions'] }[] = []
+  const otherTriggers: string[] = []
+  const visit = (node: SceneNode) => {
+    if (node.reactions === null)
+      throw new Error(`Unsupported imported prototype reaction: ${node.id}`)
+    for (const reaction of node.reactions) {
+      if (reaction.trigger.type === 'AFTER_TIMEOUT')
+        reactions.push({ timeout: reaction.trigger.timeout, actions: reaction.actions })
+      else otherTriggers.push(node.id)
+    }
+    for (const child of graph.getChildren(node.id)) if (child.type !== 'INSTANCE') visit(child)
+  }
+  visit(owner)
+  if (otherTriggers.length > 0 && (activeChain || reactions.length > 0))
+    throw new Error(
+      `HTML timed variant chains do not support concurrent click triggers: ${owner.id}`
+    )
+  if (!reactions.length) return null
+  if (reactions.length !== 1)
+    throw new Error(`HTML prototype requires one after-delay reaction per state: ${owner.id}`)
+  const reaction = reactions[0]
+  const action = reaction.actions.at(0)
+  if (reaction.actions.length !== 1 || action?.navigation !== 'CHANGE_TO')
+    throw new Error(`Unsupported timed HTML prototype action: ${owner.id}`)
+  const delay = reaction.timeout * 1000
+  const transition = action.transition
+  const duration = transition ? transition.duration * 1000 : 0
+  if (![delay, duration].every((value) => Number.isFinite(value) && value >= 0))
+    throw new Error(`Invalid timed HTML prototype transition: ${owner.id}`)
+  return {
+    destinationId: action.destinationId,
+    delay,
+    duration,
+    easing: transition ? easing(transition.easing) : 'steps(1, end)',
+    instant: transition === null
+  }
+}
+
+function variant(graph: SceneGraph, node: SceneNode): SceneNode {
+  const main = node.type === 'INSTANCE' ? graph.getMainComponent(node.id) : node
+  if (main?.type !== 'COMPONENT' || graph.getNode(main.parentId ?? '')?.type !== 'COMPONENT_SET')
+    throw new Error(`Timed HTML prototype requires a native variant: ${node.id}`)
+  return main
+}
+
+function appendFrames(
+  frames: Map<string, MotionFrame[]>,
+  nodes: Map<string, PoseNode>,
+  at: number,
+  ease: string
+) {
+  for (const [path, { pose }] of nodes) {
+    const values = frames.get(path) ?? []
+    values.push({ ...pose, at, easing: ease })
+    frames.set(path, values)
+  }
+}
+
+function occurrence(graph: SceneGraph, ownerId: string, pageId: string): SceneNode {
+  const owner = graph.getNode(ownerId)
+  if (!owner) throw new Error(`Missing cloned prototype owner: ${ownerId}`)
+  if (owner.type !== 'COMPONENT') return owner
+  const instance = graph.createInstance(owner.id, pageId, {
+    x: owner.x,
+    y: owner.y,
+    name: owner.name
+  })
+  if (!instance) throw new Error(`Cannot instantiate HTML prototype variant: ${ownerId}`)
+  return instance
+}
+
+function destinationVariant(graph: SceneGraph, id: string, setId: string | null): SceneNode {
+  const node = graph.getNode(id)
+  if (node?.type !== 'COMPONENT' || node.parentId !== setId)
+    throw new Error(`HTML prototype destination must be a variant in the same set: ${id}`)
+  return node
+}
+
+function motionLayers(
+  nodes: Map<string, PoseNode>,
+  frames: Map<string, MotionFrame[]>
+): MotionLayer[] {
+  const layers: MotionLayer[] = []
+  for (const [path, final] of nodes) {
+    const values = frames.get(path) ?? []
+    const initial = values.at(0)
+    if (!initial) throw new Error(`Missing initial prototype frame: ${path}`)
+    const transform = values.some(
+      (value) => value.x !== initial.x || value.y !== initial.y || value.scale !== initial.scale
+    )
+    const opacity = values.some((value) => value.opacity !== initial.opacity)
+    if (!transform && final.pose.scale !== 1)
+      throw new Error(
+        `Static scaled layers need ordinary HTML scale projection, not an identity animation: ${path}`
+      )
+    if (transform || opacity)
+      layers.push({ nodeId: final.id, basis: final.pose, frames: values, transform, opacity })
+  }
+  if (!layers.length)
+    throw new Error('A nonvisual variant chain does not require an identity animation')
+  return layers
+}
+
+function compileOwner(source: SceneGraph, ownerId: string) {
+  const pageId = findPageId(source, ownerId)
+  const original = source.getNode(ownerId)
+  if (!pageId || !original) throw new Error(`Missing prototype owner: ${ownerId}`)
+  const originalMain = variant(source, original)
+  const graph = extractPageContext(source, pageId, [originalMain.parentId ?? '', ownerId], {
+    componentSets: true,
+    shareTables: true
+  })
+  startPendingLayout(graph)
+  let owner = occurrence(graph, ownerId, pageId)
+  let main = variant(graph, owner)
+  let nodes = poseNodes(graph, owner.id)
+  const first = nodes
+  const frames = new Map<string, MotionFrame[]>()
+  const endpoints: MotionEndpoint[] = [{ variantId: main.id, at: 0 }]
+  const segments: MotionSegment[] = []
+  const seen = new Set([main.id])
+  let time = 0,
+    periodic = false,
+    allInstant = true
+  appendFrames(frames, nodes, time, 'linear')
+  for (;;) {
+    const edge = timedEdge(graph, owner, true)
+    if (!edge) break
+    const destination = destinationVariant(graph, edge.destinationId, originalMain.parentId)
+    allInstant &&= edge.instant
+    if (edge.delay) {
+      // The preceding state holds through its saved delay, with an instantaneous
+      // edge using a step at the end rather than a synthetic fade.
+      const previous = [...frames.values()]
+      for (const values of previous) values[values.length - 1].easing = 'steps(1, end)'
+      time += edge.delay
+      appendFrames(frames, nodes, time, edge.easing)
+    } else {
+      for (const values of frames.values()) values[values.length - 1].easing = edge.easing
+    }
+    const start = time
+    graph.swapInstanceComponent(owner.id, destination.id, { keepName: true })
+    owner = graph.getNode(owner.id) ?? owner
+    const next = poseNodes(graph, owner.id)
+    assertCompatible(first, next)
+    time += edge.duration
+    segments.push({ sourceId: main.id, destinationId: destination.id, start, end: time })
+    endpoints.push({ variantId: destination.id, at: time })
+    appendFrames(frames, next, time, 'linear')
+    if (seen.has(destination.id)) {
+      if (destination.id !== originalMain.id || !allInstant || time <= 0)
+        throw new Error('HTML prototype supports only positive-delay instantaneous closed cycles')
+      periodic = true
+      nodes = next
+      break
+    }
+    seen.add(destination.id)
+    nodes = next
+    main = destination
+  }
+  if (time <= 0) throw new Error('HTML prototype requires a positive total duration')
+  const layers = motionLayers(nodes, frames)
+  return {
+    graph,
+    owner,
+    finalMainId: variant(graph, owner).id,
+    layerPaths: new Map([...nodes].map(([path, node]) => [node.id, path])),
+    animation: {
+      ownerId: owner.id,
+      sourceOwnerId: ownerId,
+      duration: time,
+      periodic,
+      endpoints,
+      segments,
+      layers
+    }
+  }
+}
+
+/** Timed nested components own their own clocks, rather than their enclosing input. */
+export function prototypeAnimationOwners(graph: SceneGraph, nodeIds: string[]): string[] {
+  const owners: string[] = []
+  const visit = (id: string, animatedAncestor: boolean) => {
+    const node = graph.getNode(id)
+    if (!node) throw new Error(`Missing HTML export node: ${id}`)
+    if (!node.visible || node.internalOnly) return
+    const owns = ['COMPONENT', 'INSTANCE'].includes(node.type) && timedEdge(graph, node) !== null
+    if (owns) {
+      if (animatedAncestor)
+        throw new Error(
+          'Nested independently timed variant chains inside an animated owner are not supported'
+        )
+      owners.push(id)
+    }
+    for (const child of graph.getChildren(id)) visit(child.id, animatedAncestor || owns)
+  }
+  for (const id of nodeIds) visit(id, false)
+  return owners
+}
+
+function overlayClosure(graph: SceneGraph, roots: string[]): string[] {
+  const result = new Set(roots)
+  const visit = (id: string) => {
+    const node = graph.getNode(id)
+    if (!node || !node.visible || node.internalOnly) return
+    for (const reaction of node.reactions ?? [])
+      for (const action of reaction.actions) {
+        if (action.navigation !== 'OVERLAY' || result.has(action.destinationId)) continue
+        result.add(action.destinationId)
+        visit(action.destinationId)
+      }
+    for (const child of graph.getChildren(id)) visit(child.id)
+  }
+  for (const root of roots) visit(root)
+  return [...result]
+}
+
+/** The source graph is read only; all pose changes use native clone/swap. */
+export function preparePrototypeAnimations(
+  source: SceneGraph,
+  nodeIds: string[]
+): PreparedPrototypeAnimations {
+  const roots = overlayClosure(source, nodeIds)
+  const owners = prototypeAnimationOwners(source, roots)
+  if (!owners.length) return { graph: source, nodeIds, animations: [] }
+  const pageId = findPageId(source, nodeIds[0] ?? '')
+  if (!pageId) throw new Error('HTML prototype export requires a native page')
+  const sets = owners.map((id) => {
+    const node = source.getNode(id)
+    if (!node) throw new Error(`Missing prototype owner: ${id}`)
+    return variant(source, node).parentId ?? ''
+  })
+  const graph = extractPageContext(source, pageId, [...sets, ...roots], {
+    componentSets: true,
+    shareTables: true
+  })
+  startPendingLayout(graph)
+  const result: PreparedPrototypeAnimations = { graph, nodeIds: [...nodeIds], animations: [] }
+  for (const id of owners) {
+    const compiled = compileOwner(source, id)
+    let owner = graph.getNode(id)
+    if (!owner) throw new Error(`Missing cloned prototype owner: ${id}`)
+    if (owner.type === 'COMPONENT') {
+      const position = result.nodeIds.indexOf(id)
+      if (position === -1) throw new Error('An animated main component must be an export root')
+      const instance = graph.createInstance(owner.id, pageId, {
+        x: owner.x,
+        y: owner.y,
+        name: owner.name
+      })
+      if (!instance) throw new Error(`Cannot instantiate prototype export root: ${id}`)
+      owner = instance
+      result.nodeIds[position] = owner.id
+    }
+    graph.swapInstanceComponent(owner.id, compiled.finalMainId, { keepName: true })
+    const normalized = poseNodes(graph, owner.id)
+    const layers = compiled.animation.layers.map((layer) => {
+      const path = compiled.layerPaths.get(layer.nodeId)
+      const target = path === undefined ? undefined : normalized.get(path)
+      if (!target) throw new Error(`Lost native prototype layer: ${layer.nodeId}`)
+      return { ...layer, nodeId: target.id, basis: target.pose }
+    })
+    result.animations.push({ ...compiled.animation, ownerId: owner.id, layers })
+  }
+  return result
+}
