+++ b/packages/dom-css/tests/export/bundle/background.test.ts
@@ -0,0 +1,244 @@
+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+import { nativeFixedBackground } from '#dom-css/export/native/background'
+import { nativeStandaloneDocument } from '#dom-css/export/native/index'
+
+import {
+  recordInstanceOverride,
+  SceneGraph,
+  type Fill,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+const bytes = new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10])
+
+function fixture(type: 'RECTANGLE' | 'FRAME' | 'INSTANCE' = 'RECTANGLE') {
+  const graph = new SceneGraph()
+  graph.images.set('image', bytes)
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 320,
+    height: 180,
+    fills: [],
+    clipsContent: true
+  })
+  const fill: Fill = {
+    type: 'IMAGE',
+    color: { r: 0, g: 0, b: 0, a: 1 },
+    visible: true,
+    opacity: 1,
+    imageHash: 'image',
+    imageScaleMode: 'FILL'
+  }
+  const properties = {
+    width: 320,
+    height: 180,
+    fills: [fill],
+    scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME' as const
+  }
+  const background =
+    type === 'INSTANCE'
+      ? graph.createInstance(
+          graph.createNode('COMPONENT', graph.getPages()[0].id, properties).id,
+          root.id
+        )
+      : graph.createNode(type, root.id, properties)
+  if (!background) throw new Error('Missing normal background instance')
+  const foreground = graph.createNode('RECTANGLE', root.id, { width: 20, height: 20 })
+  const exportPage = (
+    info: { width?: number; height?: number; opaque?: boolean } = { opaque: true }
+  ) =>
+    exportHTMLBundle(sceneNodeToDesignDocument(graph, root.id, { imageFrameFills: 'background' }), {
+      html: 'standalone',
+      assets: 'external',
+      imageSize: () => ({ width: 1, height: 1, ...info })
+    })
+  return { graph, root, background, foreground, fill, exportPage }
+}
+
+test.each(['RECTANGLE', 'FRAME', 'INSTANCE'] as const)(
+  'a complete opaque fixed %s background shares its viewport without changing its image bytes',
+  async (type) => {
+    const { graph, root, background, foreground, exportPage } = fixture(type)
+    const before = structuredClone([...graph.nodes])
+    const bundle = await exportPage()
+    const html = String(bundle.files.find((file) => file.path === bundle.entrypoint)?.content)
+    const css = String(bundle.files.find((file) => file.path.endsWith('.css'))?.content)
+    expect(css).toContain('background-attachment: fixed')
+    expect(css).toContain('background-size: 320px 320px; background-position: 0px -70px')
+    expect(html).toContain(`data-open-pencil-node-id="${root.id}"`)
+    expect(html).toContain(`data-open-pencil-node-id="${foreground.id}"`)
+    expect(html).not.toContain(`data-open-pencil-node-id="${background.id}"`)
+    expect(
+      bundle.files.filter((file) => file.path.includes('/images/')).map((file) => file.content)
+    ).toEqual([bytes])
+    expect([...graph.nodes]).toEqual(before)
+    const fragment = await exportHTMLBundle(sceneNodeToDesignDocument(graph, root.id))
+    expect(fragment.files[0].content).not.toContain('background-attachment')
+    expect(fragment.files[0].content).toContain(`data-open-pencil-node-id="${background.id}"`)
+  }
+)
+
+test.each([false, undefined])(
+  'decoded image opacity %s retains the ordinary layer',
+  async (opaque) => {
+    const { background, exportPage } = fixture()
+    const bundle = await exportPage({ opaque })
+    expect(bundle.files[0].content).toContain(`data-open-pencil-node-id="${background.id}"`)
+    expect(
+      bundle.files.some((file) => String(file.content).includes('background-attachment: fixed'))
+    ).toBe(false)
+  }
+)
+
+test.each([
+  ['scrolling background', {}, { scrollBehavior: 'SCROLLS' }],
+  ['scrolling owner', { overflowDirection: 'VERTICAL' }, {}],
+  ['unclipped owner', { clipsContent: false }, {}],
+  ['rounded owner', { cornerRadius: 4 }, {}],
+  ['fractional placement', {}, { x: 0.125 }],
+  ['partial image', {}, { width: 319.5 }],
+  ['layer opacity', {}, { opacity: 0.5 }],
+  ['rotated image', {}, { rotation: 15 }],
+  ['interactive image', {}, { reactions: [{ trigger: { type: 'ON_CLICK' }, actions: [] }] }]
+] satisfies [string, Partial<SceneNode>, Partial<SceneNode>][])(
+  '%s retains ordinary fixed and scrolling semantics',
+  async (_name, ownerChange, childChange) => {
+    const { graph, root, background, exportPage } = fixture()
+    graph.updateNode(root.id, ownerChange)
+    graph.updateNode(background.id, childChange)
+    const bundle = await exportPage()
+    expect(bundle.files[0].content).toContain(`data-open-pencil-node-id="${background.id}"`)
+    expect(
+      bundle.files.some((file) => String(file.content).includes('background-attachment: fixed'))
+    ).toBe(false)
+  }
+)
+
+test('fit, crop and translucent paints retain their own native image projection', async () => {
+  for (const change of [
+    { imageScaleMode: 'FIT' },
+    { imageScaleMode: 'CROP' },
+    { opacity: 0.5 }
+  ] satisfies Partial<Fill>[]) {
+    const { graph, background, fill, exportPage } = fixture()
+    graph.updateNode(background.id, { fills: [{ ...fill, ...change }] })
+    const bundle = await exportPage()
+    expect(bundle.files[0].content).toContain(`data-open-pencil-node-id="${background.id}"`)
+    expect(
+      bundle.files.some((file) => String(file.content).includes('background-attachment: fixed'))
+    ).toBe(false)
+  }
+})
+
+test('backgrounds after foreground paint, nested viewports and painted content keep their nodes', async () => {
+  for (const kind of ['after foreground', 'nested', 'with content']) {
+    const { graph, root, background, foreground, exportPage } = fixture()
+    if (kind === 'nested') {
+      const owner = graph.createNode('FRAME', root.id, { width: 320, height: 180 })
+      graph.reparentNode(background.id, owner.id)
+    } else if (kind === 'with content')
