index 0000000000000000000000000000000000000000..b093e7124429249be684aac9ed7b8be593d26b90
--- /dev/null
+++ b/packages/dom-css/src/export/vectors.ts
@@ -0,0 +1,57 @@
+import { readIcon, type SceneGraph, type SceneNode } from '@open-pencil/scene-graph'
+
+import type { DesignElement, DesignStyleDeclaration } from '../types'
+
+/** A native engine supplies vector drawing without making dom-css depend on that engine. */
+export type VectorElementRenderer = (graph: SceneGraph, node: SceneNode) => DesignElement | null
+
+export interface VectorRenderers {
+  /** Vector, boolean, star, polygon, and icon layers as inline SVG; otherwise they are boxes. */
+  vectorElement?: VectorElementRenderer
+  /** Explicit SVG export assets for pure vector containers, supplied by the native engine. */
+  vectorAsset?: VectorElementRenderer
+  /** Pure vector frames and scaled instances keep their original drawing viewport. */
+  vectorGroup?: VectorElementRenderer
+}
+
+/** Layers whose shape only paths describe, which CSS boxes cannot draw. */
+const VECTOR_SHAPES = new Set<SceneNode['type']>(['VECTOR', 'BOOLEAN_OPERATION', 'STAR', 'POLYGON'])
+
+/** The SVG draws these paints in place of a CSS box. */
+const BOX_PAINT = /^(background|border|box-shadow|outline|filter)/
+
+export function vectorRendererForNode(options: VectorRenderers, node: SceneNode) {
+  if (options.vectorAsset && node.exportSettings.some((setting) => setting.format === 'svg'))
+    return options.vectorAsset
+  const paintMask =
+    node.isMask &&
+    node.maskType !== 'VECTOR' &&
+    ['RECTANGLE', 'ELLIPSE', 'LINE'].includes(node.type)
+  if (VECTOR_SHAPES.has(node.type) || readIcon(node) || paintMask) return options.vectorElement
+  if (['FRAME', 'COMPONENT', 'INSTANCE'].includes(node.type)) return options.vectorGroup
+  return undefined
+}
+
+/** Placement, opacity and transform stay on the HTML layer; the drawing owns its paint. */
+export function vectorDesignNode(
+  graph: SceneGraph,
+  node: SceneNode,
+  attrs: Record<string, string>,
+  style: DesignStyleDeclaration,
+  renderer: VectorElementRenderer
+): DesignElement | null {
+  const drawn = renderer(graph, node)
+  if (!drawn) return null
+  const placement = Object.fromEntries(
+    Object.entries(style).filter(([property]) => !BOX_PAINT.test(property))
+  )
+  // SVG paths use their viewport rather than an HTML containing block.
+  if (drawn.tagName === 'svg' && placement.position === 'relative') delete placement.position
+  return {
+    ...drawn,
+    attrs: { ...drawn.attrs, ...attrs },
+    inlineStyle: { ...drawn.inlineStyle, ...placement },
+    sourceSceneNodeId: node.id,
+    sourceSceneNode: node
+  }
+}
diff --git a/packages/dom-css/tests/export/bundle/assets.test.ts b/packages/dom-css/tests/export/bundle/assets.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2f0ebf23f2260d3733539f1c9f1675b121688554
--- /dev/null
+++ b/packages/dom-css/tests/export/bundle/assets.test.ts
@@ -0,0 +1,103 @@
+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle } from '#dom-css/export/index'
+import { fromUint8Array } from 'js-base64'
+
+test('external standalone images share the original bytes across HTML and SVG', async () => {
+  const bytes = new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10])
+  const data = `data:image/png;base64,${fromUint8Array(bytes)}`
+  const bundle = await exportHTMLBundle(
+    {
+      type: 'document',
+      children: [
+        {
+          type: 'element',
+          tagName: 'img',
+          attrs: { src: data, width: '10', height: '20' },
+          children: []
+        },
+        {
+          type: 'element',
+          tagName: 'svg',
+          attrs: { viewBox: '0 0 10 20' },
+          children: [
+            {
+              type: 'element',
+              tagName: 'image',
+              attrs: { href: data, width: '10', height: '20' },
+              children: []
+            },
+            { type: 'element', tagName: 'a', attrs: { href: data }, children: [] }
+          ]
+        }
+      ]
+    },
+    { html: 'standalone', assets: 'external' }
+  )
+  const files = bundle.files.filter((file) => file.path.startsWith('assets/images/'))
+  expect(files).toHaveLength(1)
+  expect(files[0].content).toEqual(bytes)
+  const html = bundle.files.find((file) => file.path === bundle.entrypoint)?.content
+  expect(html).toContain('src="assets/images/image-1.png"')
+  expect(html).toContain('<image href="assets/images/image-1.png" width="10" height="20">')
+  expect(html).toContain(`<a href="${data}">`)
+})
+
+test('inline standalone SVG image URLs remain self-contained', async () => {
+  const href = 'data:image/png;base64,iVBORw0KGgo='
+  const bundle = await exportHTMLBundle(
+    {
+      type: 'document',
+      children: [
+        {
+          type: 'element',
+          tagName: 'svg',
+          attrs: {},
+          children: [
+            {
+              type: 'element',
+              tagName: 'image',
+              attrs: { href },
+              children: []
+            }
+          ]
+        }
+      ]
+    },
+    { html: 'standalone', assets: 'inline' }
+  )
+  expect(bundle.files).toHaveLength(1)
+  expect(bundle.files[0].content).toContain(`<image href="${href}">`)
+})
+
+test('CSS image fills share original image files and retain stylesheet-relative URLs', async () => {
+  const bytes = new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10])
+  const data = `data:image/png;base64,${fromUint8Array(bytes)}`
+  const literal = '"url(data:image/png;base64,bm90LWFuLWltYWdl)"'
+  const bundle = await exportHTMLBundle(
+    {
+      type: 'document',
+      children: [
+        { type: 'element', tagName: 'img', attrs: { src: data }, children: [] },
+        {
+          type: 'element',
+          tagName: 'div',
+          attrs: {},
+          children: [],
+          inlineStyle: { 'background-image': `url("${data}")`, content: literal }
+        }
+      ]
+    },
+    { html: 'standalone', assets: 'external' }
+  )
+  const images = bundle.files.filter((file) => file.path.startsWith('assets/images/'))
+  expect(images).toHaveLength(1)
+  expect(images[0].content).toEqual(bytes)
+  expect(bundle.files.find((file) => file.path.endsWith('openpencil.css'))?.content).toContain(
+    'background-image: url("images/image-1.png")'
+  )
+  expect(bundle.files.find((file) => file.path.endsWith('openpencil.css'))?.content).toContain(
+    `content: ${literal}`
+  )
+  expect(bundle.files[0].content).toContain('src="assets/images/image-1.png"')
+})
