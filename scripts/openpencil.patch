+  instance.setProperties({ [property]: '新しい物語を始める' })
+  expect(child.styleRuns).toEqual([{ start: 0, length: '新しい物語を始める'.length, style }])
+  const main = instance.mainComponent
+  if (!main) throw new Error('Missing main component')
