+import { expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+
+import { createEditor } from '@open-pencil/core/editor'
+
+function fixture() {
+  const editor = createEditor(),
+    graph = editor.graph
+  const set = graph.createNode('COMPONENT_SET', editor.state.currentPageId, {
+    componentPropertyDefinitions: [{ id: 'root', name: 'HP', type: 'TEXT', defaultValue: '30' }]
+  })
+  const variants = [false, true].map((explicit) => {
+    const component = graph.createNode('COMPONENT', set.id, {
+      componentPropertyDefinitions: [
+        {
+          id: explicit ? 'zero' : 'inherited',
+          parentPropDefId: 'root',
+          name: 'HP',
+          type: 'TEXT',
+          defaultValue: explicit ? '0' : '30',
+          ...(explicit
+            ? {}
+            : {
+                inheritedFields: ['name', 'type', 'defaultValue'] as (
+                  | 'name'
+                  | 'type'
+                  | 'defaultValue'
+                )[]
+              })
+        }
+      ]
+    })
+    const text = graph.createNode('TEXT', component.id, {
+      text: explicit ? '0' : '30',
+      componentPropertyReferences: [{ propertyId: explicit ? 'zero' : 'inherited', field: 'TEXT' }]
+    })
+    const instance = expectDefined(graph.createInstance(component.id, editor.state.currentPageId))
+    return { component, text, instance }
+  })
+  return { editor, graph, set, variants }
+}
+
+test('GUI parent default edits inherit, preserve local defaults and instance edits, and undo', async () => {
+  const {
+    editor,
+    graph,
+    set,
+    variants: [inherited, zero]
+  } = fixture()
+  const edited = expectDefined(
+    graph.createInstance(inherited.component.id, editor.state.currentPageId)
+  )
+  editor.setInstanceComponentProperty(edited.id, 'root', '17')
+  await Promise.resolve()
+  editor.undo.clear()
+  expect(editor.setComponentPropertyDefault(set.id, 'root', '80')).toBe(true)
+  await Promise.resolve()
+  expect(inherited.text.text).toBe('80')
+  expect(graph.getChildren(inherited.instance.id)[0].text).toBe('80')
+  expect(graph.getChildren(edited.id)[0].text).toBe('17')
+  expect(zero.text.text).toBe('0')
+  expect(graph.getChildren(zero.instance.id)[0].text).toBe('0')
+  editor.undo.undo()
+  await Promise.resolve()
+  expect(inherited.text.text).toBe('30')
+  expect(zero.text.text).toBe('0')
+  editor.undo.redo()
+  await Promise.resolve()
+  expect(inherited.text.text).toBe('80')
+})
+
+test('GUI parent rename and bindings keep one public identity with local saved references', () => {
+  const {
+    editor,
+    set,
+    variants: [inherited, zero]
+  } = fixture()
+  expect(editor.renameComponentProperty(set.id, 'root', 'HP')).toBe(true)
+  expect(editor.renameComponentProperty(set.id, 'root', 'Health')).toBe(true)
+  expect(
+    editor.getInstanceComponentPropertyDefinitions(inherited.instance.id).map((d) => d.name)
+  ).toEqual(['Health'])
+  expect(editor.getComponentPropertyBindings(set.id, 'root')).toHaveLength(2)
+  expect(editor.bindComponentProperty(zero.text.id, 'TEXT', null)).toBe(true)
+  expect(zero.text.componentPropertyReferences).toEqual([])
+  expect(editor.bindComponentProperty(zero.text.id, 'TEXT', 'root')).toBe(true)
+  expect(zero.text.componentPropertyReferences).toEqual([{ propertyId: 'zero', field: 'TEXT' }])
+  expect(zero.text.text).toBe('0')
+  editor.undo.undo()
+  expect(zero.text.componentPropertyReferences).toEqual([])
+  editor.undo.undo()
+  expect(zero.text.componentPropertyReferences).toEqual([{ propertyId: 'zero', field: 'TEXT' }])
+})
+
+test('GUI parent deletion undo restores local definitions, references and edited assignments', () => {
+  const { editor, set, variants } = fixture()
+  editor.setInstanceComponentProperty(variants[0].instance.id, 'root', '17')
+  editor.undo.clear()
+  const before = variants.map(({ component, text, instance }) =>
+    structuredClone({
+      definitions: component.componentPropertyDefinitions,
+      references: text.componentPropertyReferences,
+      assignments: instance.componentPropertyAssignments
+    })
+  )
+  expect(editor.deleteComponentProperty(set.id, 'root')).toBe(true)
+  for (const { component, text, instance } of variants) {
+    expect(component.componentPropertyDefinitions).toEqual([])
+    expect(text.componentPropertyReferences).toEqual([])
+    expect(instance.componentPropertyAssignments).toEqual({})
+  }
+  editor.undo.undo()
+  expect(
+    variants.map(({ component, text, instance }) => ({
+      definitions: component.componentPropertyDefinitions,
+      references: text.componentPropertyReferences,
+      assignments: instance.componentPropertyAssignments
+    }))
+  ).toEqual(before)
+  editor.undo.redo()
+  expect(set.componentPropertyDefinitions).toEqual([])
+  expect(variants[0].text.componentPropertyReferences).toEqual([])
+})
+
+test('one shared GUI definition reads each variant default before multiselect edits', () => {
+  const {
+    editor,
+    variants: [inherited, zero]
+  } = fixture()
+  const definition = expectDefined(
+    editor.getInstanceComponentPropertyDefinitions(inherited.instance.id)[0]
+  )
+  expect(editor.getInstanceComponentPropertyValue(inherited.instance.id, definition)).toBe('30')
+  expect(editor.getInstanceComponentPropertyValue(zero.instance.id, definition)).toBe('0')
+  editor.setInstanceComponentProperty(zero.instance.id, definition.id, '30')
+  expect(editor.getInstanceComponentPropertyValue(zero.instance.id, definition)).toBe('30')
+})
