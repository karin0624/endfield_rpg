+      const text = [...graph.getAllNodes()].find((node) => node.name === 'Editable title')
+      if (!frame || !text) throw new Error('Missing reopened native layout')
+      const exporter = htmlFormat.exportContent
+      if (!exporter) throw new Error('Missing public HTML adapter')
+      const result = await exporter(
+        { graph, target: { scope: 'node', nodeId: frame.id }, fileName: 'article.html' },
+        { html: 'standalone' }
+      )
+      expect(result.data).toContain('flex-basis: 0px')
+      expect(result.data).not.toContain('height: 260px')
+      expect(result.data).not.toContain('left: 71px; top: 83px')
+      expect(result.data).toContain(round === 0 ? 'First title' : 'A longer changed title')
+      const editable = new FigmaAPI(graph).getNodeById(text.id)
+      if (!editable || editable.type !== 'TEXT') throw new Error('Missing public editable title')
+      editable.characters = 'A longer changed title'
+    }
+  }
+)
