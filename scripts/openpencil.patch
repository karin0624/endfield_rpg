--- /dev/null
+++ b/packages/core/tests/io/formats/html/slot-viewports.test.ts
@@ -0,0 +1,84 @@
+import { expect, test } from 'bun:test'
+
+import { exportFigFile, parseFigFile } from '@open-pencil/core'
+import { FigmaAPI } from '@open-pencil/core/figma-api'
+import { SceneGraph, slotPropertyId } from '@open-pencil/scene-graph'
+
+import { renderNodesToHTML } from '#core/io/formats/html'
+
+function drawingInSlot() {
+  const graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const component = api.createComponent()
+  component.resize(384, 43.1875)
+  component.fills = []
+  const slot = component.createSlot()
+  slot.resize(384, 43.1875)
+  slot.fills = []
+  slot.clipsContent = false
+  const artwork = api.createFrame()
+  artwork.name = 'Small drawing'
+  artwork.resize(8, 4)
+  artwork.fills = []
+  artwork.clipsContent = false
+  slot.appendChild(artwork)
+  artwork.x = 371
+  artwork.y = 19.59375
+  const rectangle = api.createRectangle()
+  rectangle.resize(8, 4)
+  const red = { r: 1, g: 0, b: 0, a: 1 }
+  rectangle.fills = [{ type: 'SOLID', color: red, opacity: 1, visible: true }]
+  artwork.appendChild(rectangle)
+  return { graph, api, component, slot, artwork }
+}
+
+test('a slot preserves its own container and its drawing viewport', async () => {
+  const { graph, component, slot, artwork } = drawingInSlot()
+  const { html } = await renderNodesToHTML(graph, [component.id], { html: 'standalone' })
+  expect(html).toContain(`<div data-open-pencil-node-id="${slot.id}"`)
+  expect(html).toContain(`data-open-pencil-node-id="${artwork.id}"`)
+  expect(html).toContain('viewBox="0 0 8 4"')
+  expect(html).not.toContain('viewBox="0 0 384 43.1875"')
+})
+
+test('a paintless vector ancestor cannot flatten a slot into its viewport', async () => {
+  const { graph, api, component, slot } = drawingInSlot()
+  const wrapper = api.createFrame()
+  wrapper.resize(384, 43.1875)
+  wrapper.fills = []
+  component.appendChild(wrapper)
+  wrapper.appendChild(slot)
+  const { html } = await renderNodesToHTML(graph, [component.id], { html: 'standalone' })
+  expect(html).toContain(`<div data-open-pencil-node-id="${wrapper.id}"`)
+  expect(html).toContain(`<div data-open-pencil-node-id="${slot.id}"`)
+  expect(html).toContain('viewBox="0 0 8 4"')
+})
+
+test('owned slot drawing positions and viewports survive normal FIG save and read', async () => {
+  const { graph, component } = drawingInSlot()
+  const instance = component.createInstance()
+  instance.name = 'Owned select'
+  const slot = instance.children.find((child) => child.type === 'SLOT')
+  if (!slot) throw new Error('Missing instance slot')
+  slot.children[0].y = 18.8125
+  const bytes = await exportFigFile(graph)
+  const fresh = await parseFigFile(bytes.slice().buffer, { populate: 'all' })
+  const reopened = [...fresh.nodes.values()].find(
+    (node) => node.type === 'INSTANCE' && node.name === instance.name
+  )
+  if (!reopened) throw new Error('Missing reopened instance')
+  const reopenedSlot = fresh.getChildren(reopened.id).find(slotPropertyId)
+  if (!reopenedSlot) throw new Error('Missing reopened slot')
+  expect(fresh.getChildren(reopenedSlot.id)[0].y).toBe(18.8125)
+  const { html } = await renderNodesToHTML(fresh, [reopened.id], { html: 'standalone' })
+  expect(html).toContain(`<div data-open-pencil-node-id="${reopenedSlot.id}"`)
+  expect(html).toContain('viewBox="0 0 8 4"')
+  expect(html).not.toContain('viewBox="0 0 384 43.1875"')
+})
+
+test('ordinary paintless vector frames retain compound SVG projection', async () => {
+  const { graph, artwork } = drawingInSlot()
+  const { html } = await renderNodesToHTML(graph, [artwork.id], { html: 'standalone' })
+  expect(html.match(/<svg/g)).toHaveLength(1)
+  expect(html).toContain('viewBox="0 0 8 4"')
+})
