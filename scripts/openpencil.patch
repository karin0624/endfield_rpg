--- /dev/null
+++ b/packages/core/tests/figma-api/prototype-animation.test.ts
@@ -0,0 +1,342 @@
+import { describe, expect, test } from 'bun:test'
+
+import { asInstanceNode } from '#core-tests/helpers/figma-api'
+
+import { exportFigFile, parseFigFile } from '@open-pencil/core'
+import { FigmaAPI, type FigmaReaction } from '@open-pencil/core/figma-api'
+import { parseFigBuffer } from '@open-pencil/fig'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+function setup() {
+  const graph = new SceneGraph(),
+    api = new FigmaAPI(graph)
+  const labels: ReturnType<FigmaAPI['createText']>[] = []
+  const start = api.createComponent()
+  start.name = 'state=start'
+  const end = api.createComponent()
+  end.name = 'state=end'
+  for (const [component, y, opacity] of [
+    [start, 12, 0],
+    [end, 0, 1]
+  ] as const) {
+    component.resize(180, 70)
+    component.fills = []
+    const body = api.createFrame()
+    body.name = 'An editable surface'
+    body.resize(148, 38)
+    component.appendChild(body)
+    body.y = y
+    body.opacity = opacity
+    const label = api.createText()
+    label.name = 'Label'
+    label.characters = 'Editable value'
+    body.appendChild(label)
+    labels.push(label)
+  }
+  const set = api.combineAsVariants([start, end], api.currentPage)
+  set.name = 'An arbitrary interaction'
+  const labelProperty = set.addComponentProperty('Label', 'TEXT', 'Editable value')
+  for (const label of labels) label.componentPropertyReferences = { characters: labelProperty }
+  return { graph, api, start, end, set, labelProperty }
+}
+
+const reaction = (destinationId: string, duration = 0.12): FigmaReaction => ({
+  trigger: { type: 'AFTER_TIMEOUT', timeout: 0 },
+  actions: [
+    {
+      type: 'NODE',
+      navigation: 'CHANGE_TO',
+      destinationId,
+      transition: { type: 'SMART_ANIMATE', duration, easing: { type: 'EASE_OUT' } }
+    }
+  ]
+})
+
+function named(graph: SceneGraph, name: string) {
+  const nodes = [...graph.getAllNodes()].filter((node) => node.name === name)
+  expect(nodes).toHaveLength(1)
+  const node = nodes[0]
+  if (!node) throw new Error('Missing saved prototype node')
+  return node
+}
+
+async function reopen(graph: SceneGraph) {
+  const bytes = await exportFigFile(graph)
+  return { graph: await parseFigFile(bytes.slice().buffer, { populate: 'all' }), bytes }
+}
+
+describe('standard interactive component transitions', () => {
+  test('a finite three-variant chain retains each interval and destination after ordinary saves', async () => {
+    const initial = setup()
+    const peak = initial.end.clone()
+    peak.name = 'state=peak'
+    initial.set.appendChild(peak)
+    await initial.start.setReactionsAsync([reaction(peak.id, 0.1216)])
+    await peak.setReactionsAsync([reaction(initial.end.id, 0.2584)])
+    let graph = initial.graph
+    for (let pass = 0; pass < 2; pass++) {
+      graph = (await reopen(graph)).graph
+      const api = new FigmaAPI(graph)
+      const start = api.wrapNode(named(graph, 'state=start').id)
+      const middle = api.wrapNode(named(graph, 'state=peak').id)
+      const end = api.wrapNode(named(graph, 'state=end').id)
+      const first = start.reactions[0]?.actions[0]
+      const second = middle.reactions[0]?.actions[0]
+      expect(first?.destinationId).toBe(middle.id)
+      expect(second?.destinationId).toBe(end.id)
+      expect(first?.transition?.duration).toBeCloseTo(0.1216, 6)
+      expect(second?.transition?.duration).toBeCloseTo(0.2584, 6)
+      expect(end.reactions).toEqual([])
+    }
+  })
+
+  test('ordinary FIG saves retain instantaneous after-delay cycles without synthetic easing', async () => {
+    const initial = setup()
+    const blink = (destinationId: string): FigmaReaction => ({
+      trigger: { type: 'AFTER_TIMEOUT', timeout: 0.5 },
+      actions: [{ type: 'NODE', navigation: 'CHANGE_TO', destinationId, transition: null }]
+    })
+    await initial.start.setReactionsAsync([blink(initial.end.id)])
+    await initial.end.setReactionsAsync([blink(initial.start.id)])
+    let graph = initial.graph
+    for (let pass = 0; pass < 2; pass++) {
+      graph = (await reopen(graph)).graph
+      const api = new FigmaAPI(graph)
+      const start = api.wrapNode(named(graph, 'state=start').id)
+      const end = api.wrapNode(named(graph, 'state=end').id)
+      expect(start.reactions).toEqual([blink(end.id)])
+      expect(end.reactions).toEqual([blink(start.id)])
+    }
+  })
+
+  test('ordinary FIG saves retain editable delays, smart easing, durations and variant destinations', async () => {
+    const initial = setup()
+    let graph = initial.graph
+    await initial.start.setReactionsAsync([reaction(initial.end.id)])
+    for (let pass = 0; pass < 2; pass++) {
+      const saved = await reopen(graph)
+      graph = saved.graph
+      const api = new FigmaAPI(graph)
+      const start = api.wrapNode(named(graph, 'state=start').id)
+      const end = api.wrapNode(named(graph, 'state=end').id)
+      const current = start.reactions[0]
+      expect(current?.trigger).toEqual({ type: 'AFTER_TIMEOUT', timeout: pass === 0 ? 0 : 0.25 })
+      const action = current?.actions[0]
+      if (!action || action.navigation !== 'CHANGE_TO' || !action.transition)
+        throw new Error('Missing saved transition')
+      expect(action.destinationId).toBe(end.id)
+      expect(action.transition.type).toBe('SMART_ANIMATE')
+      expect(action.transition.duration).toBeCloseTo(pass === 0 ? 0.12 : 0.16, 6)
+      expect(action.transition.easing).toEqual({ type: pass === 0 ? 'EASE_OUT' : 'EASE_IN' })
+      const wire = parseFigBuffer(saved.bytes.slice().buffer).nodeChanges.find(
+        (node) => node.name === 'state=start'
+      )
+      expect(wire?.prototypeInteractions).toMatchObject([
+        {
+          event: { interactionType: 'AFTER_TIMEOUT', transitionTimeout: pass === 0 ? 0 : 0.25 },
+          actions: [
+            {
+              navigationType: 'SWAP_STATE',
+              transitionType: 'SMART_ANIMATE',
+              easingType: pass === 0 ? 'OUT_CUBIC' : 'IN_CUBIC'
+            }
+          ]
+        }
+      ])
+      await start.setReactionsAsync([
+        {
+          trigger: { type: 'AFTER_TIMEOUT', timeout: 0.25 },
+          actions: [
+            {
+              type: 'NODE',
+              navigation: 'CHANGE_TO',
+              destinationId: end.id,
+              transition: { type: 'SMART_ANIMATE', duration: 0.16, easing: { type: 'EASE_IN' } }
+            }
+          ]
+        }
+      ])
+      const surface = end.children?.[0]
+      if (!surface) throw new Error('Missing editable destination geometry')
+      surface.y = -8
+      surface.opacity = 0
+    }
+    const end = named(graph, 'state=end')
+    expect(graph.getChildren(end.id)[0]?.y).toBe(-8)
+  })
+
+  test('cloned component sets redirect internal transition destinations without mutating the original', async () => {
+    const initial = setup()
+    await initial.start.setReactionsAsync([reaction(initial.end.id)])
+    const copied = initial.set.clone()
+    copied.name = 'Copied interaction'
+    const start = copied.children.find((node) => node.name === 'state=start')
+    const end = copied.children.find((node) => node.name === 'state=end')
+    if (!start || !end) throw new Error('Missing cloned variants')
+    expect(start.reactions[0]?.actions[0]?.destinationId).toBe(end.id)
+    expect(initial.start.reactions[0]?.actions[0]?.destinationId).toBe(initial.end.id)
+    start.name = 'Copied start'
+    end.name = 'Copied end'
+    const saved = await reopen(initial.graph)
+    const api = new FigmaAPI(saved.graph)
+    expect(
+      api.wrapNode(named(saved.graph, 'Copied start').id).reactions[0]?.actions[0]?.destinationId
+    ).toBe(named(saved.graph, 'Copied end').id)
+  })
+
+  test('instance transition overrides survive two saves and remain independent of their main', async () => {
+    const initial = setup()
+    await initial.start.setReactionsAsync([reaction(initial.end.id)])
+    const instance = initial.start.createInstance()
+    instance.name = 'Placed interaction'
+    instance.setProperties({ [initial.labelProperty]: 'A value edited on the instance' })
+    await instance.setReactionsAsync([reaction(initial.end.id, 0.25)])
+    let graph = initial.graph
+    for (let pass = 0; pass < 2; pass++) {
+      graph = (await reopen(graph)).graph
+      const api = new FigmaAPI(graph)
+      const placed = asInstanceNode(api.wrapNode(named(graph, instance.name).id))
+      const main = api.wrapNode(named(graph, 'state=start').id)
+      expect(
+        Object.values(placed.componentProperties).find((property) => property.type === 'TEXT')
+          ?.value
+      ).toBe('A value edited on the instance')
+      expect(placed.reactions[0]?.actions[0]?.transition?.duration).toBe(0.25)
+      expect(main.reactions[0]?.actions[0]?.transition?.duration).toBeCloseTo(0.12, 6)
+      const copy = placed.clone()
+      expect(copy.reactions).toEqual(placed.reactions)
+      copy.remove()
+    }
+  })
+
+  test('an explicit empty instance override never re-inherits its main reaction after saves and clones', async () => {
+    const initial = setup()
+    await initial.start.setReactionsAsync([reaction(initial.end.id)])
+    const instance = initial.start.createInstance()
+    instance.name = 'Explicitly static instance'
+    await instance.setReactionsAsync([])
+    let graph = initial.graph
+    for (let pass = 0; pass < 2; pass++) {
+      graph = (await reopen(graph)).graph
+      const api = new FigmaAPI(graph)
+      const placed = api.wrapNode(named(graph, instance.name).id)
+      expect(placed.reactions).toEqual([])
+      expect(api.wrapNode(named(graph, 'state=start').id).reactions).toHaveLength(1)
+      const copy = placed.clone()
+      expect(copy.reactions).toEqual([])
+      copy.remove()
+    }
+  })
+
+  test('invalid transitions reject atomically while supported custom cubic curves retain their values', async () => {
+    const initial = setup()
+    const original = reaction(initial.end.id)
+    await initial.start.setReactionsAsync([original])
+    const other = initial.api.createComponent()
+    for (const invalid of [
+      reaction(other.id),
+      reaction('missing'),
+      reaction(initial.end.id, Number.NaN),
+      { ...original, trigger: { type: 'AFTER_TIMEOUT' as const, timeout: -1 } },
+      {
+        ...original,
+        trigger: { type: 'AFTER_TIMEOUT' as const, timeout: Number.POSITIVE_INFINITY }
+      }
+    ])
+      await expect(
+        initial.api.wrapNode(initial.start.id).setReactionsAsync([invalid])
+      ).rejects.toThrow()
+    expect(initial.api.wrapNode(initial.start.id).reactions).toEqual([original])
+    await initial.start.setReactionsAsync([
+      {
+        trigger: { type: 'ON_CLICK' },
+        actions: [
+          {
+            type: 'NODE',
+            navigation: 'CHANGE_TO',
+            destinationId: initial.end.id,
+            transition: {
+              type: 'SMART_ANIMATE',
+              duration: 0.5,
+              easing: {
+                type: 'CUSTOM_CUBIC_BEZIER',
+                easingFunctionCubicBezier: { x1: 0.25, y1: -0.5, x2: 0.75, y2: 1.5 }
+              }
+            }
+          }
+        ]
+      }
+    ])
+    const saved = await reopen(initial.graph)
+    expect(
+      new FigmaAPI(saved.graph).wrapNode(named(saved.graph, 'state=start').id).reactions
+    ).toEqual([
+      {
+        trigger: { type: 'ON_CLICK' },
+        actions: [
+          {
+            type: 'NODE',
+            navigation: 'CHANGE_TO',
+            destinationId: named(saved.graph, 'state=end').id,
+            transition: {
+              type: 'SMART_ANIMATE',
+              duration: 0.5,
+              easing: {
+                type: 'CUSTOM_CUBIC_BEZIER',
+                easingFunctionCubicBezier: { x1: 0.25, y1: -0.5, x2: 0.75, y2: 1.5 }
+              }
+            }
+          }
+        ]
+      }
+    ])
+  })
+
+  test('unsupported imported interpolation stays intact through ordinary geometry edits and saves', async () => {
+    const initial = setup()
+    const bytes = await exportFigFile(initial.graph)
+    const source = await parseFigFile(bytes.slice().buffer, { populate: 'all' })
+    const start = named(source, 'state=start')
+    const destination = parseFigBuffer(bytes.slice().buffer).nodeChanges.find(
+      (node) => node.name === 'state=end'
+    )?.guid
+    if (!destination) throw new Error('Missing ordinary destination file identity')
+    const raw = [
+      {
+        event: { interactionType: 'AFTER_TIMEOUT', transitionTimeout: 0 },
+        actions: [
+          {
+            connectionType: 'INTERNAL_NODE',
+            navigationType: 'SWAP_STATE',
+            transitionNodeID: destination,
+            transitionType: 'SMART_ANIMATE',
+            transitionDuration: 0.25,
+            easingType: 'SPRING'
+          }
+        ]
+      }
+    ]
+    source.updateNode(start.id, {
+      reactions: null,
+      source: {
+        ...start.source,
+        fig: {
+          ...start.source.fig,
+          rawNodeFields: { ...start.source.fig.rawNodeFields, prototypeInteractions: raw }
