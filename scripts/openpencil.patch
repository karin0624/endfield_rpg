@@ -0,0 +1,93 @@
+import { expect, test } from 'bun:test'
+
+import { toUint8Array } from 'js-base64'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { FigmaAPI } from '#core/figma-api'
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { renderNodesToSVG } from '#core/io/formats/svg/export'
+import { createSVGNodes } from '#core/io/formats/svg/import'
+
+test('SVG file presets leave ordinary vector HTML unchanged, with native edits and bound colors', async () => {
+  const graph = new SceneGraph()
+  const main = createSVGNodes(
+    graph,
+    graph.getPages()[0].id,
+    '<svg width="40" height="24"><rect width="40" height="24" fill="#00ff00"/></svg>'
+  )
+  if (!main) throw new Error('Native SVG import failed')
+  graph.updateNode(main.id, { fills: [] })
+  const shape = graph.getChildren(main.id)[0]
+  if (!shape) throw new Error('Missing native artwork shape')
+  const originalType = shape.type
+  const api = new FigmaAPI(graph)
+  const collection = api.createVariableCollection('Artwork')
+  const color = api.createVariable('Ink', 'COLOR', collection.id, { r: 1, g: 0, b: 0, a: 1 })
+  api.bindVariable(shape.id, 'fills/0/color', color.id)
+  const exportDrawing = async () => {
+    const before = await renderNodesToHTML(graph, [main.id], {
+      html: 'standalone',
+      assets: 'external'
+    })
+    const node = api.getNodeById(main.id)
+    if (!node || node.type !== 'FRAME') throw new Error('Missing public artwork frame')
+    node.exportSettings = [{ format: 'SVG' }]
+    const after = await renderNodesToHTML(graph, [main.id], {
+      html: 'standalone',
+      assets: 'external'
+    })
+    expect(after).toEqual(before)
+    expect(after.html).toContain('<svg ')
+    expect(after.html).not.toContain('data:image/')
+    expect(node.exportSettings).toEqual([{ format: 'SVG' }])
+    return renderNodesToSVG(graph, main.parentId ?? '', [main.id], { precision: null })
+  }
+  expect(await exportDrawing()).toContain('fill="#FF0000"')
+  api.setVariableValue(color.id, collection.defaultModeId, { r: 0, g: 0, b: 1, a: 1 })
+  expect(await exportDrawing()).toContain('fill="#0000FF"')
+  expect(graph.getNode(shape.id)?.type).toBe(originalType)
+  expect(graph.getChildren(main.id).map((node) => node.id)).toEqual([shape.id])
+  const fragment = await renderNodesToHTML(graph, [main.id])
+  expect(fragment.html).toContain('<svg ')
+})
+
+test('SVG presets do not flatten or reject ordinary UI text or images', async () => {
+  for (const kind of ['TEXT', 'IMAGE']) {
+    const graph = new SceneGraph()
+    const main = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 100,
+      height: 60,
+      fills: []
+    })
+    const imageHash = new FigmaAPI(graph).createImage(
+      toUint8Array(
+        'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/WioAAAAASUVORK5CYII='
+      )
+    ).hash
+    graph.createNode(kind === 'TEXT' ? 'TEXT' : 'RECTANGLE', main.id, {
+      width: 40,
+      height: 24,
+      text: 'Editable UI',
+      ...(kind === 'IMAGE'
+        ? {
+            fills: [
+              {
+                type: 'IMAGE',
+                color: { r: 0, g: 0, b: 0, a: 1 },
+                opacity: 1,
+                visible: true,
+                imageHash
+              }
+            ]
+          }
+        : {})
+    })
+    const before = await renderNodesToHTML(graph, [main.id], { html: 'standalone' })
+    graph.updateNode(main.id, { exportSettings: [{ format: 'svg', scale: 1 }] })
+    const after = await renderNodesToHTML(graph, [main.id], { html: 'standalone' })
+    expect(after).toEqual(before)
+    if (kind === 'TEXT') expect(after.html).toContain('Editable UI')
+    else expect(after.html).toContain('<img ')
+  }
+})
