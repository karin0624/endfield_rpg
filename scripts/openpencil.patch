+            x: String(x),
+            y: String(y),
+            width: String(right - x),
+            height: String(bottom - y)
+          })
+        ])
+      )
+      result.push(
+        element(
+          'svg',
+          {
+            width: String(node.width),
+            height: String(node.height),
+            viewBox: `0 0 ${node.width} ${node.height}`
+          },
+          [
+            definitions,
+            element('g', { 'clip-path': `url(#${boundsId})` }, [
+              element('g', { 'clip-path': `url(#${id})` }, svgContent)
+            ])
+          ],
+          {
+            position: 'absolute',
+            left: '0',
+            top: '0',
+            width: `${node.width}px`,
+            height: `${node.height}px`
+          }
+        )
+      )
+    } else {
+      result.push(
+        element('svg', { width: '0', height: '0', 'aria-hidden': 'true' }, [definitions], {
+          position: 'absolute',
+          width: '0',
+          height: '0'
+        }),
+        element('div', {}, content, {
+          position: 'absolute',
+          left: '0',
+          top: '0',
+          width: `${node.width}px`,
+          height: `${node.height}px`,
+          'clip-path': `url(#${id})`
+        })
+      )
+    }
+  }
+  projected.children = result
+}
+
+/**
+ * Paint native geometry for a fixed-size standalone export. Responsive fragments keep their
+ * existing auto layout projection; this snapshot uses the graph's measured sizes and positions.
+ */
+export function nativeStandaloneDocument(
+  document: DesignDocument,
+  imageSize: ImageSizeResolver
+): DesignDocument {
+  const graph = document.sourceGraph
+  if (!graph) return document
+  const roots = new Set(
+    document.children.flatMap((node) =>
+      node.type === 'element' && node.sourceSceneNode ? [node.sourceSceneNode.id] : []
+    )
+  )
+  const result = { ...document, children: document.children.map(clone) }
+  const visit = (projected: DesignNode) => {
+    if (projected.type !== 'element') return
+    projected.children.forEach(visit)
+    const node = projected.sourceSceneNode
+    if (!node) return
+    const style = (projected.inlineStyle ??= {})
+    style.width ??= `${node.width}px`
+    style.height ??= `${node.height}px`
+    if (node.type === 'TEXT') {
+      if (node.fontFeatures.length)
+        style['font-feature-settings'] = node.fontFeatures
+          .map((feature) => `"${feature.tag.toLowerCase()}" ${feature.enabled ? 1 : 0}`)
+          .join(', ')
+      if (node.textAlignVertical !== 'TOP') {
+        Object.assign(style, {
+          display: 'flex',
+          'flex-direction': 'column',
+          'justify-content': node.textAlignVertical === 'CENTER' ? 'center' : 'flex-end'
+        })
+        projected.children = [
+          element('span', {}, projected.children, { display: 'block', width: '100%' })
+        ]
+      }
+    }
+    const fill = node.fills.find((paint) => paint.visible)
+    if (fill?.type === 'IMAGE') cropImage(projected, node, fill, imageSize)
+    const parent = node.parentId ? graph.getNode(node.parentId) : undefined
+    // A full-parent image can be composited independently without changing native geometry.
+    if (
+      parent &&
+      fill?.type === 'IMAGE' &&
+      node.x === 0 &&
+      node.y === 0 &&
+      node.width === parent.width &&
+      node.height === parent.height &&
+      parent.childIds[0] === node.id &&
+      projected.tagName === 'img'
+    )
+      style['will-change'] = 'transform'
+    if (node.blendMode === 'NORMAL' && node.childIds.length) style.isolation = 'isolate'
+    if (projected.tagName === 'svg' && node.type === 'VECTOR' && !node.isMask) {
+      let x = node.x,
+        y = node.y,
+        ancestor = parent
+      let unrotated = node.rotation === 0
+      while (ancestor && !roots.has(ancestor.id)) {
+        unrotated &&= ancestor.rotation === 0
+        x += ancestor.x
+        y += ancestor.y
+        ancestor = ancestor.parentId ? graph.getNode(ancestor.parentId) : undefined
+      }
+      if (unrotated) {
+        // An integer SVG viewport preserves fractional path geometry instead of letting Blink
+        // pixel-snap a tight fractional SVG box and scale the drawing inside it.
+        const fx = x - Math.floor(x),
+          fy = y - Math.floor(y)
+        const width = Math.ceil(node.width + fx),
+          height = Math.ceil(node.height + fy)
+        Object.assign(projected.attrs, {
+          width: String(width),
+          height: String(height),
+          viewBox: `${-fx} ${-fy} ${width} ${height}`
+        })
+        Object.assign(style, {
+          width: `${width}px`,
+          height: `${height}px`,
+          'margin-left': `${-fx}px`,
+          'margin-top': `${-fy}px`
+        })
+      }
+    }
+    if (projected.tagName !== 'svg' && node.strokeAlign === 'INSIDE' && style.border) {
+      const stroke = node.strokes.find((paint) => paint.visible)
+      if (stroke && !node.independentStrokeWeights && node.dashPattern.length === 0) {
+        const variable = document.tokens?.names.get(node.boundVariables['strokes/0/color'])
+        const color = variable
+          ? `var(--${variable})`
+          : cssColor({ ...stroke.color, a: stroke.opacity })
+        const shadow = `inset 0 0 0 ${stroke.weight}px ${color}`
+        style['box-shadow'] = style['box-shadow'] ? `${style['box-shadow']},${shadow}` : shadow
+        delete style.border
+        delete style['border-color']
+      }
+    }
+    if (node.clipsContent) {
+      style.overflow = 'visible'
+      const radius = style['border-radius']
+      style['clip-path'] = radius ? `inset(0 round ${radius})` : 'inset(0)'
+    }
+    clipChildren(projected, node)
+  }
+  result.children.forEach(visit)
+  return result
+}
