+  })
+  const document = sceneNodeToDesignDocument(graph, frame.id)
+  const standalone = await exportHTMLBundle(document, { html: 'standalone' })
+  expect(standalone.files[0].content).toContain('filter: blur(2.5px)')
+  expect(standalone.files[0].content).toContain('backdrop-filter: blur(6px)')
+  const fragment = await exportHTMLBundle(document)
+  expect(fragment.files[0].content).toContain('filter: blur(5px)')
+  expect(fragment.files[0].content).toContain('backdrop-filter: blur(12px)')
+})
+
+test('image paint opacity precedes native effects while layer opacity remains outside them', async () => {
+  const graph = new SceneGraph()
+  graph.images.set('original', new Uint8Array([137, 80, 78, 71, 13, 10, 26, 10]))
+  const image = graph.createNode('RECTANGLE', graph.getPages()[0].id, {
+    width: 40,
+    height: 60,
+    opacity: 0.5,
+    effects: [
+      { ...shadow, type: 'LAYER_BLUR', radius: 5 },
+      { ...shadow, radius: 20 }
+    ],
+    fills: [
+      {
+        type: 'IMAGE',
+        imageHash: 'original',
+        imageScaleMode: 'FIT',
+        color: { r: 0, g: 0, b: 0, a: 1 },
+        opacity: 0.62,
+        visible: true
+      }
+    ]
+  })
+  const render = () =>
+    exportHTMLBundle(sceneNodeToDesignDocument(graph, image.id), { html: 'standalone' })
+  const first = await render()
+  expect(first.files[0].content).toContain(
+    'filter: opacity(0.62) blur(2.5px) drop-shadow(0px 5px 10px rgba(0, 0, 0, 0.4))'
+  )
+  expect(first.files[0].content).toContain('opacity: 0.5')
+  graph.updateNode(image.id, { fills: [{ ...image.fills[0], opacity: 0.4 }] })
+  const edited = await render()
+  expect(edited.files[0].content).toContain('filter: opacity(0.4) blur(2.5px) drop-shadow(')
