@@ -0,0 +1,55 @@
+import type { Color, Vector } from './primitives'
+
+export type OverlayPositionType =
+  | 'CENTER'
+  | 'TOP_LEFT'
+  | 'TOP_CENTER'
+  | 'TOP_RIGHT'
+  | 'BOTTOM_LEFT'
+  | 'BOTTOM_CENTER'
+  | 'BOTTOM_RIGHT'
+  | 'MANUAL'
+export type OverlayBackgroundInteraction = 'NONE' | 'CLOSE_ON_CLICK_OUTSIDE'
+export type OverlayBackground =
+  | { type: 'NONE' }
+  | { type: 'SOLID_COLOR'; color: Pick<Color, 'r' | 'g' | 'b'>; opacity: number }
+
+export type PrototypeEasing =
+  | { type: 'LINEAR' | 'EASE_IN' | 'EASE_OUT' | 'EASE_IN_AND_OUT' }
+  | {
+      type: 'CUSTOM_CUBIC_BEZIER'
+      easingFunctionCubicBezier: { x1: number; y1: number; x2: number; y2: number }
+    }
+
+export interface PrototypeSmartTransition {
+  type: 'SMART_ANIMATE'
+  /** Figma prototype durations and delays use seconds. */
+  duration: number
+  easing: PrototypeEasing
+}
+
+export interface PrototypeOverlayAction {
+  type: 'NODE'
+  destinationId: string
+  navigation: 'OVERLAY'
+  transition: null
+  overlayRelativePosition?: Vector
+}
+
+export interface PrototypeChangeAction {
+  type: 'NODE'
+  destinationId: string
+  navigation: 'CHANGE_TO'
+  transition: PrototypeSmartTransition | null
+  overlayRelativePosition?: never
+}
+
+/** Other imported actions remain intact in the original source payload. */
+export type PrototypeNodeAction = PrototypeOverlayAction | PrototypeChangeAction
+
+export interface PrototypeReaction {
+  /** Original interaction identity, not part of Figma's public Reaction object. */
+  id?: string
+  trigger: { type: 'ON_CLICK' } | { type: 'AFTER_TIMEOUT'; timeout: number }
+  actions: PrototypeNodeAction[]
+}
diff --git a/packages/scene-graph/src/text/line-height.ts b/packages/scene-graph/src/text/line-height.ts
