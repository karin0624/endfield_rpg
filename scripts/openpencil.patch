+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+import { FigmaAPI } from '#core/figma-api'
+import { svgFormat } from '#core/io/formats'
+import { exportFigFile } from '#core/io/formats/fig/export'
+import { parseFigFile } from '#core/io/formats/fig/read'
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { parseSVGDocument } from '#core/io/formats/svg/document'
+
+test('public SVG exports native unit-axis skew with transformed bounds after normal FIG edits', async () => {
+  let graph = new SceneGraph()
+  let api = new FigmaAPI(graph)
+  const rectangle = api.createRectangle()
+  rectangle.name = 'Editable skew artwork'
+  rectangle.resize(100, 50)
+  rectangle.relativeTransform = [
+    [1, 0.6, 10],
+    [0, 0.8, 20]
+  ]
+  for (let cycle = 0; cycle < 2; cycle++) {
+    const bytes = await exportFigFile(graph)
+    graph = await parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate: 'all' })
+    api = new FigmaAPI(graph)
+    const native = [...graph.getAllNodes()].find((node) => node.name === rectangle.name)
+    if (!native || !svgFormat.exportContent) throw new Error('Missing public artwork export')
+    const artifact = await svgFormat.exportContent(
+      { graph, target: { scope: 'node', nodeId: native.id }, fileName: 'skew.svg' },
+      { precision: null }
+    )
+    if (typeof artifact.data !== 'string') throw new Error('Expected editable SVG')
+    const document = parseSVGDocument(artifact.data)
+    if (!document?.documentElement) throw new Error('Invalid exported SVG')
+    const size = document.documentElement.getAttribute('viewBox')?.split(' ').map(Number)
+    expect(size?.[2]).toBeCloseTo(130, 4)
+    expect(size?.[3]).toBeCloseTo(40, 4)
+    const transform = document.getElementsByTagName('g')[0].getAttribute('transform')
+    const numbers = transform?.slice(7, -1).split(' ').map(Number)
+    expect(numbers?.[0]).toBeCloseTo(1, 7)
+    expect(numbers?.[1]).toBeCloseTo(0, 7)
+    expect(numbers?.[2]).toBeCloseTo(0.6, 6)
+    expect(numbers?.[3]).toBeCloseTo(0.8, 6)
+    expect(numbers?.[4]).toBeCloseTo(0, 6)
+    expect(numbers?.[5]).toBeCloseTo(0, 6)
+    const html = await renderNodesToHTML(graph, [native.id], { html: 'standalone' })
+    expect(html.html).toContain('transform: matrix(')
+    expect(html.html).toContain('transform-origin: 0 0')
+    expect(graph.images.size).toBe(0)
+    const edited = api.wrapNode(native.id)
+    edited.fills = [
+      { type: 'SOLID', color: { r: 0.2 * cycle, g: 0.4, b: 0.7, a: 1 }, opacity: 1, visible: true }
+    ]
+  }
+})
+
+test('open and closed contours of one stroke-only VECTOR share one paint operation', async () => {
+  const graph = new SceneGraph(),
+    api = new FigmaAPI(graph)
+  const artwork = api.createNodeFromSvg(
+    '<svg width="40" height="30"><path d="M5 5L25 5L15 25ZM0 15H30" fill="none" stroke="#f00" stroke-opacity=".5"/></svg>'
+  )
+  artwork.name = 'Mixed-contour artwork'
+  const bytes = await exportFigFile(graph)
+  const fresh = await parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate: 'all' })
+  const node = [...fresh.getAllNodes()].find((node) => node.name === artwork.name)
+  if (!node || !svgFormat.exportContent) throw new Error('Missing public artwork export')
+  const artifact = await svgFormat.exportContent(
+    { graph: fresh, target: { scope: 'node', nodeId: node.id }, fileName: 'contours.svg' },
+    { precision: null }
+  )
+  if (typeof artifact.data !== 'string') throw new Error('Expected editable SVG')
+  const document = parseSVGDocument(artifact.data)
+  if (!document) throw new Error('Invalid exported SVG')
+  const paths = document.getElementsByTagName('path')
+  expect(paths.length).toBe(1)
+  expect(paths[0].getAttribute('fill')).toBe('none')
+  expect(paths[0].getAttribute('stroke-opacity')).toBe('0.5')
+  expect(paths[0].getAttribute('d')?.match(/M/g)).toHaveLength(2)
+  expect([...fresh.getAllNodes()].filter((node) => node.type === 'VECTOR')).toHaveLength(1)
+})
