+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { createSVGNodes } from '#core/io/formats/svg/import'
+
+beforeAll(initCodec)
+
+const drawing =
+  '<svg width="32" height="32" viewBox="0 0 32 32"><path d="M4 30L25 5" fill="none" stroke="#eee" stroke-width="1.65"/></svg>'
+
+function styles(html: string, id: string) {
+  const className = html.match(
+    new RegExp(`data-open-pencil-node-id="${id}"[^>]*class="([^"]+)"`)
+  )?.[1]
+  if (!className) throw new Error(`Missing exported native element ${id}`)
+  return html.match(new RegExp(`\\.${className}\\{([^}]+)\\}`))?.[1] ?? ''
+}
+
+test.each(['HORIZONTAL', 'VERTICAL'] as const)(
+  'ordinary FIG saves and text edits keep a %s flow SVG in its intrinsic coordinate system',
+  async (layoutMode) => {
+    let graph = new SceneGraph()
+    const frame = graph.createNode('COMPONENT', graph.getPages()[0].id, {
+      name: 'Editable icon control',
+      width: 200,
+      height: 80,
+      layoutMode,
+      primaryAxisSizing: 'HUG',
+      counterAxisSizing: 'HUG'
+    })
+    const icon = createSVGNodes(graph, frame.id, drawing)
+    if (!icon) throw new Error('Missing editable SVG import')
+    graph.updateNode(icon.id, { name: 'Editable icon', fills: [] })
+    graph.createNode('TEXT', frame.id, {
+      name: 'Editable label',
+      width: 80,
+      height: 25.2,
+      text: 'First label',
+      textAutoResize: 'HEIGHT',
+      lineHeight: 140,
+      lineHeightUnit: 'PERCENT'
+    })
+    for (let round = 0; round < 2; round++) {
+      graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+      const component = [...graph.getAllNodes()].find((node) => node.name === frame.name)
+      const reopenedIcon = [...graph.getAllNodes()].find((node) => node.name === 'Editable icon')
