+++ b/packages/core/src/io/formats/html/prototype/poses.ts
@@ -0,0 +1,167 @@
+import type { MotionPose } from '@open-pencil/dom-css/export'
+import {
+  INSTANCE_SYNC_TEXT_PROPS,
+  rescaleNodeTree,
+  type SceneGraph,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+import { flushPendingLayout, startPendingLayout } from '#core/figma-api/pending-layout'
+
+export interface PoseNode {
+  id: string
+  pose: MotionPose
+  signature: Map<string, string | undefined>
+}
+
+// These fields describe authoring identity, provenance or component linkage. All
+// remaining fields must agree after restoring a scaled instance's native basis.
+const NON_VISUAL = new Set([
+  'id',
+  'parentId',
+  'childIds',
+  'name',
+  'source',
+  'derivedLayout',
+  'x',
+  'y',
+  'opacity',
+  'componentScale',
+  'componentId',
+  'componentKey',
+  'sourceLibraryKey',
+  'publishId',
+  'overrideKey',
+  'sharedSymbolVersion',
+  'publishedVersion',
+  'librarySource',
+  'isPublishable',
+  'isSymbolPublishable',
+  'symbolDescription',
+  'symbolLinks',
+  'variantPropSpecs',
+  'instanceOverrides',
+  'componentPropertyDefinitions',
+  'componentPropertyReferences',
+  'componentPropertyAssignments',
+  'componentPropertyValues',
+  'isExposedInstance',
+  'variableAssignmentScales',
+  'reactions',
+  'expanded',
+  'locked',
+  'autoRename',
+  'pluginData',
+  'pluginRelaunchData',
+  'textPicture',
+  'derivedTextGlyphs'
+])
+
+function signature(node: SceneNode, root: boolean): Map<string, string | undefined> {
+  const textFields = new Set<string>(INSTANCE_SYNC_TEXT_PROPS)
+  // The browser measures auto-sizing native TEXT from its unchanged font and
+  // characters. Its cached box is not a fixed constraint for Smart Animate.
+  const intrinsic = (key: string) =>
+    node.type === 'TEXT' &&
+    !node.textPathData &&
+    ((key === 'width' && node.textAutoResize === 'WIDTH_AND_HEIGHT') ||
+      (key === 'height' && ['WIDTH_AND_HEIGHT', 'HEIGHT'].includes(node.textAutoResize)))
+  return new Map(
+    Object.entries(node)
+      .filter(
+        ([key]) =>
+          !NON_VISUAL.has(key) &&
+          !(root && key === 'type') &&
+          !intrinsic(key) &&
+          (node.type === 'TEXT' || !textFields.has(key))
+      )
+      .sort(([a], [b]) => a.localeCompare(b))
+      .map(([key, value]) => [key, JSON.stringify(value)])
+  )
+}
+
+function posePosition(graph: SceneGraph, node: SceneNode): Pick<MotionPose, 'x' | 'y'> {
+  const parent = node.parentId ? graph.getNode(node.parentId) : undefined
+  // Flex/grid positions come from auto layout, not the item's cached x/y.
+  // A later native swap may refresh that cache without authoring any motion.
+  return parent !== undefined && parent.layoutMode !== 'NONE' && node.layoutPositioning === 'AUTO'
+    ? { x: 0, y: 0 }
+    : { x: node.x, y: node.y }
+}
+
+/** Normalize uniform Scale-tool instances through the existing native engine. */
+export function poseNodes(graph: SceneGraph, rootId: string): Map<string, PoseNode> {
+  startPendingLayout(graph)
+  flushPendingLayout(graph)
+  const nodes = new Map<string, PoseNode>()
+  const visit = (id: string, path: string[], root: boolean) => {
+    let node = graph.getNode(id)
+    if (!node) throw new Error(`Missing prototype layer: ${id}`)
+    if (node.rotation !== 0 || node.skew !== 0)
+      throw new Error(`Animated HTML layers currently require unrotated native geometry: ${id}`)
+    let scale = 1
+    if (node.type === 'INSTANCE') {
+      const main = graph.getMainComponent(id)
+      if (!main || main.width <= 0 || main.height <= 0)
+        throw new Error(`Missing prototype component basis: ${id}`)
+      scale = node.componentScale / main.componentScale
+      const matches = (actual: number, basis: number) =>
+        actual === basis * scale || actual === Math.fround(basis * scale)
+      if (
+        !Number.isFinite(scale) ||
+        scale <= 0 ||
+        !matches(node.width, main.width) ||
+        !matches(node.height, main.height)
+      )
+        throw new Error(`Animated HTML requires uniform native component scaling: ${id}`)
+      if (scale !== 1) {
+        const { x, y, width, height } = node
+        rescaleNodeTree(graph, id, 1 / scale)
+        graph.updateNode(id, { componentScale: main.componentScale })
+        // A nested occurrence can point at its authored INSTANCE rather than
+        // directly at the main. A normal swap resolves that link while keeping
+        // public overrides; syncInstance alone accepts direct COMPONENT links.
+        if (node.componentId === main.id) graph.syncInstance(id)
+        else graph.swapInstanceComponent(id, main.id, { keepName: true })
+        flushPendingLayout(graph)
+        node = graph.getNode(id)
+        if (!node) throw new Error(`Lost normalized prototype layer: ${id}`)
+        // CSS scales around the centre; native rescale scales from the top left.
+        graph.updateNode(id, {
+          x: x + (width - node.width) / 2,
+          y: y + (height - node.height) / 2
+        })
+      }
+    }
+    const key = JSON.stringify(path)
+    nodes.set(key, {
+      id,
+      pose: { ...posePosition(graph, node), opacity: node.opacity, scale },
+      signature: signature(node, root)
+    })
+    const names = new Set<string>()
+    for (const child of graph.getChildren(id)) {
+      const name = JSON.stringify([child.name, child.type])
+      if (names.has(name))
+        throw new Error(`Prototype layer names and types must be unique: ${id}/${child.name}`)
+      names.add(name)
+      visit(child.id, [...path, name], false)
+    }
+  }
+  visit(rootId, [], true)
+  return nodes
+}
+
+export function assertCompatible(start: Map<string, PoseNode>, next: Map<string, PoseNode>): void {
+  if (start.size !== next.size || [...start.keys()].some((key) => !next.has(key)))
+    throw new Error('HTML Smart Animate requires matching layer names, types and hierarchy')
+  for (const [path, layer] of start) {
+    const other = next.get(path)
+    if (!other) throw new Error(`Missing corresponding prototype layer: ${path}`)
+    const changed = [...layer.signature].find(([key, value]) => value !== other.signature.get(key))
+    if (layer.signature.size !== other.signature.size || changed)
+      throw new Error(
+        `HTML Smart Animate supports only position, opacity and uniform scale changes: ${path}/${changed?.[0]}`
+      )
+  }
+}
