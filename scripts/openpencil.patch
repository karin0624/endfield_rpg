+++ b/packages/core/tests/io/formats/html/vector/viewports.test.ts
@@ -0,0 +1,103 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { renderVectorElement } from '#core/io/formats/html/vectors'
+import { renderNodesToSVG } from '#core/io/formats/svg/export'
+import { createSVGNodes } from '#core/io/formats/svg/import'
+
+beforeAll(initCodec)
+
+const artwork =
+  '<svg width="33.78125" height="33.78125" viewBox="0 0 32 32"><path d="M4 30L25 5" fill="none" stroke="#eee" stroke-width="1.65"/></svg>'
+
+test.each([false, true])(
+  'native vector viewports preserve clipping=%s through ordinary FIG save and reopen',
+  async (clipsContent) => {
+    const initial = new SceneGraph()
+    const imported = createSVGNodes(initial, initial.getPages()[0].id, artwork)
+    if (!imported) throw new Error('Missing imported native artwork')
+    initial.updateNode(imported.id, { name: 'Editable strokes', fills: [], clipsContent })
+    const graph = await parseFigFile((await exportFigFile(initial)).slice().buffer, {
+      populate: 'all'
+    })
+    const frame = [...graph.getAllNodes()].find((node) => node.name === 'Editable strokes')
+    if (!frame) throw new Error('Missing reopened native artwork')
+    const { html } = await renderNodesToHTML(graph, [frame.id], { html: 'standalone' })
+    expect(html).toContain(`overflow: ${clipsContent ? 'hidden' : 'visible'}`)
+    expect(html).not.toContain('<clipPath')
+    expect(html).toContain('stroke="#EEEEEE"')
+    expect(frame.width).toBe(33.78125)
+    expect(frame.clipsContent).toBe(clipsContent)
+    const svg = renderNodesToSVG(graph, frame.parentId ?? '', [frame.id], { precision: null })
+    if (clipsContent) expect(svg).toContain('<clipPath')
+    else expect(svg).not.toContain('<clipPath')
+  }
+)
+
+test('native vector viewports retain nested clipping and rounded-root geometry', async () => {
+  const graph = new SceneGraph()
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 60,
+    height: 50,
+    fills: [],
+    clipsContent: true
+  })
+  const child = createSVGNodes(graph, root.id, artwork)
+  if (!child) throw new Error('Missing native child artwork')
+  graph.updateNode(child.id, { fills: [], clipsContent: true, x: 12, y: 8 })
+  const nested = await renderNodesToHTML(graph, [root.id], { html: 'standalone' })
+  expect(nested.html.match(/<clipPath/g)).toHaveLength(1)
+  expect(nested.html).toContain('overflow: hidden')
+  graph.updateNode(root.id, { cornerRadius: 5 })
+  const rounded = await renderNodesToHTML(graph, [root.id], { html: 'standalone' })
+  expect(rounded.html.match(/<clipPath/g)).toHaveLength(2)
+})
+
+for (const type of ['COMPONENT', 'INSTANCE'] as const) {
+  test.each(['rectangle', 'rounded', 'independent', 'unclipped'] as const)(
+    `${type} SVG viewports preserve %s clipping through two normal FIG saves`,
+    async (kind) => {
+      let graph = new SceneGraph()
+      const api = new FigmaAPI(graph)
+      const main = api.createComponent()
+      main.name = 'Native viewport component'
+      main.resize(32, 32)
+      main.fills = []
+      main.clipsContent = kind !== 'unclipped'
+      if (kind === 'rounded') main.cornerRadius = 5
+      if (kind === 'independent') main.topLeftRadius = 3
+      const imported = api.createNodeFromSvg(
+        '<svg width="32" height="32"><path d="M4 30L25 5" fill="none" stroke="#eee" stroke-width="1.65"/></svg>'
+      )
+      for (const child of imported.children) main.appendChild(child)
+      imported.remove()
+      const target = type === 'COMPONENT' ? main : main.createInstance()
+      if (type === 'INSTANCE') {
+        target.rescale(1.25)
+      }
+      target.name = 'Native viewport target'
+      for (let round = 0; round < 2; round++) {
+        graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, {
+          populate: 'all'
+        })
+        const node = [...graph.getAllNodes()].find((node) => node.name === target.name)
+        if (!node) throw new Error('Missing saved native viewport')
+        expect(node.type).toBe(type)
+        expect(node.clipsContent).toBe(kind !== 'unclipped')
+        const drawn = renderVectorElement(graph, node, null)
+        expect(drawn?.inlineStyle?.overflow).toBe(kind === 'rectangle' ? 'hidden' : 'visible')
+        const svg = renderNodesToSVG(graph, node.parentId ?? '', [node.id], { precision: null })
+        if (kind === 'unclipped') expect(svg).not.toContain('<clipPath')
+        else expect(svg).toContain('<clipPath')
+        if (type === 'INSTANCE') {
+          const { html } = await renderNodesToHTML(graph, [node.id], { html: 'standalone' })
+          expect(html).toContain('viewBox="0 0 32 32"')
+          if (kind === 'rectangle' || kind === 'unclipped') expect(html).not.toContain('<clipPath')
+          else expect(html).toContain('<clipPath')
+        }
+      }
+    }
+  )
+}
