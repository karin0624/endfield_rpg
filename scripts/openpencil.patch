diff --git a/packages/core/src/figma-api/accessors/export-settings.ts b/packages/core/src/figma-api/accessors/export-settings.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7db5ec0682a1886d96bec7ecd5d86586293cf119
--- /dev/null
+++ b/packages/core/src/figma-api/accessors/export-settings.ts
@@ -0,0 +1,73 @@
+import * as v from 'valibot'
+
+import { isValidExportScale, type ExportSetting } from '@open-pencil/scene-graph'
+
+import {
+  raw,
+  updateNode,
+  type NodeProxyInternals,
+  type ProxyThis
+} from '#core/figma-api/accessor-utils'
+
+const exportSettingsSchema = v.array(
+  v.union([
+    v.strictObject({ format: v.picklist(['SVG', 'PDF']) }),
+    v.strictObject({
+      format: v.picklist(['PNG', 'JPG']),
+      constraint: v.optional(
+        v.strictObject({
+          type: v.literal('SCALE'),
+          value: v.pipe(v.number(), v.check(isValidExportScale))
+        })
+      )
+    })
+  ])
+)
+
+function publicSetting(setting: ExportSetting): ExportSettings {
+  switch (setting.format) {
+    case 'svg':
+      return { format: 'SVG' }
+    case 'pdf':
+      return { format: 'PDF' }
+    case 'png':
+    case 'jpg':
+      return {
+        format: setting.format === 'png' ? 'PNG' : 'JPG',
+        constraint: { type: 'SCALE', value: setting.scale }
+      }
+    default:
+      throw new Error(`Unsupported Figma export settings format: ${setting.format}`)
+  }
+}
+
+/** Figma's stored export rows, limited to the formats and scale constraint Core supports. */
+export function installExportSettingsAccessors(
+  prototype: object,
+  internals: NodeProxyInternals
+): void {
+  Object.defineProperty(prototype, 'exportSettings', {
+    get(this: ProxyThis): ReadonlyArray<ExportSettings> {
+      return Object.freeze(raw(this, internals).exportSettings.map(publicSetting))
+    },
+    set(this: ProxyThis, value: ReadonlyArray<ExportSettings>) {
+      const parsed = v.safeParse(exportSettingsSchema, value)
+      if (!parsed.success)
+        throw new Error('Unsupported export settings: use PNG/JPG SCALE, SVG, or PDF format rows')
+      const settings = parsed.output.map((setting): ExportSetting => {
+        switch (setting.format) {
+          case 'SVG':
+            return { format: 'svg', scale: 1 }
+          case 'PDF':
+            return { format: 'pdf', scale: 1 }
+          default:
+            return {
+              format: setting.format === 'PNG' ? 'png' : 'jpg',
+              scale: setting.constraint?.value ?? 1
+            }
+        }
+      })
+      updateNode(this, internals, { exportSettings: settings })
+    }
+  })
+}
diff --git a/packages/core/src/figma-api/component-property-inheritance.ts b/packages/core/src/figma-api/component-property-inheritance.ts
new file mode 100644
index 0000000000000000000000000000000000000000..642e811b305b3d675e14dd2ab7d86c9a08bac887
--- /dev/null
+++ b/packages/core/src/figma-api/component-property-inheritance.ts
@@ -0,0 +1,111 @@
+import {
+  componentPropertyDefinitions,
+  componentPropertyId,
+  componentPropertyLocalId,
+  resolveComponentPropertyValue,
+  styleRunsForReplacement,
+  type ComponentPropertyDefinition,
+  type ComponentPropertyReferenceField,
+  type SceneGraph,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+import { textAutoResizeChanges } from '#core/layout/text-auto-resize'
+
+export function propertyName(definition: ComponentPropertyDefinition): string {
+  return definition.type === 'VARIANT'
+    ? definition.name
+    : `${definition.name}#${definition.parentPropDefId ?? definition.id}`
+}
+
+function referenceOwner(graph: SceneGraph, node: SceneNode): SceneNode | undefined {
+  return node.parentId
+    ? graph.closest(
+        node.parentId,
+        (owner) => owner.type === 'INSTANCE' || owner.type === 'COMPONENT'
+      )
+    : undefined
+}
+
+function referenceField(field: string): ComponentPropertyReferenceField {
+  if (field === 'mainComponent') return 'INSTANCE_SWAP'
+  if (field === 'slotContentId') return 'SLOT_CONTENT'
+  return field === 'characters' ? 'TEXT' : 'VISIBLE'
+}
+
+function referenceName(field: ComponentPropertyReferenceField): string {
+  if (field === 'INSTANCE_SWAP') return 'mainComponent'
+  if (field === 'SLOT_CONTENT') return 'slotContentId'
+  return field === 'TEXT' ? 'characters' : 'visible'
+}
+
+export function getPropertyReferences(graph: SceneGraph, node: SceneNode): Record<string, string> {
+  const owner = referenceOwner(graph, node)
+  const definitions = owner ? componentPropertyDefinitions(graph, owner) : []
+  return Object.fromEntries(
+    node.componentPropertyReferences.map((reference) => {
+      const id = owner
+        ? componentPropertyId(graph, owner, reference.propertyId)
+        : reference.propertyId
+      const definition = definitions.find((item) => item.id === id)
+      return [
+        referenceName(reference.field),
+        definition ? propertyName(definition) : reference.propertyId
+      ]
+    })
+  )
+}
+
+export function propertyReferences(
+  graph: SceneGraph,
+  node: SceneNode,
+  values: Record<string, string>
+) {
+  const owner = referenceOwner(graph, node)
+  const definitions = owner ? componentPropertyDefinitions(graph, owner) : []
+  return Object.entries(values).map(([field, key]) => {
+    const definition = definitions.find((item) => propertyName(item) === key)
+    return {
+      propertyId: definition && owner ? componentPropertyLocalId(graph, owner, definition.id) : key,
+      field: referenceField(field)
+    }
+  })
+}
+
+/** A set default changes inheriting templates, never a local default or an instance edit. */
+export function inheritedPropertyDefaults(
+  graph: SceneGraph,
+  owner: SceneNode,
+  propertyId: string
+): void {
+  if (owner.type !== 'COMPONENT_SET') return
+  for (const component of graph.getChildren(owner.id)) {
+    if (component.type !== 'COMPONENT') continue
+    const local = component.componentPropertyDefinitions.find(
+      (definition) =>
+        definition.parentPropDefId &&
+        componentPropertyId(graph, component, definition.id) === propertyId
+    )
+    if (local && !local.inheritedFields?.includes('defaultValue')) continue
+    const definition = componentPropertyDefinitions(graph, component).find(
+      (item) => item.id === propertyId
+    )
+    if (!definition) continue
+    for (const { node } of graph.flattenTree(component.id)) {
+      for (const reference of node.componentPropertyReferences) {
+        if (reference.propertyId !== local?.id && reference.propertyId !== propertyId) continue
+        const value = definition.defaultValue
+        if (reference.field === 'TEXT' && node.type === 'TEXT' && node.text !== value) {
+          const changes = { text: value, styleRuns: styleRunsForReplacement(node, value) }
+          graph.updateNode(node.id, { ...changes, ...textAutoResizeChanges(node, changes) })
+        } else if (reference.field === 'VISIBLE')
+          graph.updateNode(node.id, { visible: value === 'true' })
+        else if (reference.field === 'INSTANCE_SWAP' && node.type === 'INSTANCE') {
+          const target = resolveComponentPropertyValue(graph, value)
+          if (target) graph.swapInstanceComponent(node.id, target.id)
+        }
+      }
+    }
+    graph.syncInstances(component.id)
+  }
+}
diff --git a/packages/core/src/figma-api/reactions.ts b/packages/core/src/figma-api/reactions.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a89b21ff53916be78f703af3bbda9505debb29c7
--- /dev/null
+++ b/packages/core/src/figma-api/reactions.ts
@@ -0,0 +1,170 @@
+/// <reference types="@figma/plugin-typings" />
+import type {
+  PrototypeEasing,
+  PrototypeNodeAction,
+  PrototypeOverlayAction,
+  PrototypeReaction,
+  PrototypeSmartTransition,
+  SceneGraph,
+  SceneNode
+} from '@open-pencil/scene-graph'
+import { getMainComponent, recordInstanceOverride } from '@open-pencil/scene-graph/instances'
+
+import { assertNodeEditable } from '#core/editor/capabilities'
+
+const object = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === 'object' && !Array.isArray(value)
+const keys = (value: Record<string, unknown>, allowed: string[]) =>
+  Object.keys(value).every((key) => allowed.includes(key))
+const finite = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value)
+
+export type FigmaReaction = Omit<PrototypeReaction, 'id'>
+
+/** The public API never exposes or mutates file interaction identities. */
+export function getReactions(node: SceneNode): readonly FigmaReaction[] {
+  if (node.reactions === null)
+    throw new Error('This node contains an unsupported prototype reaction')
+  return node.reactions.map(({ trigger, actions }) => ({
+    trigger: { ...trigger },
+    actions: structuredClone(actions)
+  }))
+}
+
+function overlayAction(graph: SceneGraph, action: Record<string, unknown>): PrototypeOverlayAction {
+  if (
+    !keys(action, [
+      'type',
+      'destinationId',
+      'navigation',
+      'transition',
+      'overlayRelativePosition'
+    ]) ||
+    action.transition !== null ||
+    typeof action.destinationId !== 'string'
+  )
+    throw new Error('Unsupported prototype action: expected an instant NODE OVERLAY')
+  const destination = graph.getNode(action.destinationId)
+  if (!destination || !['FRAME', 'COMPONENT', 'INSTANCE'].includes(destination.type))
+    throw new Error(`Missing prototype overlay frame: ${action.destinationId}`)
+  const position = action.overlayRelativePosition
+  if (
+    position !== undefined &&
+    (!object(position) || !keys(position, ['x', 'y']) || !finite(position.x) || !finite(position.y))
+  )
+    throw new Error('Invalid prototype overlay position')
+  return {
+    type: 'NODE',
+    destinationId: action.destinationId,
+    navigation: 'OVERLAY',
+    transition: null,
+    ...(object(position)
+      ? { overlayRelativePosition: { x: position.x as number, y: position.y as number } }
+      : {})
+  }
+}
+
+function easing(value: unknown): PrototypeEasing {
+  if (object(value) && keys(value, ['type'])) {
+    for (const type of ['LINEAR', 'EASE_IN', 'EASE_OUT', 'EASE_IN_AND_OUT'] as const)
+      if (value.type === type) return { type }
+  }
+  if (
+    object(value) &&
+    keys(value, ['type', 'easingFunctionCubicBezier']) &&
+    value.type === 'CUSTOM_CUBIC_BEZIER' &&
+    object(value.easingFunctionCubicBezier)
+  ) {
+    const curve = value.easingFunctionCubicBezier
+    if (
+      keys(curve, ['x1', 'y1', 'x2', 'y2']) &&
+      finite(curve.x1) &&
+      finite(curve.y1) &&
+      finite(curve.x2) &&
+      finite(curve.y2) &&
+      curve.x1 >= 0 &&
+      curve.x1 <= 1 &&
+      curve.x2 >= 0 &&
+      curve.x2 <= 1
+    )
+      return {
+        type: 'CUSTOM_CUBIC_BEZIER',
+        easingFunctionCubicBezier: { x1: curve.x1, y1: curve.y1, x2: curve.x2, y2: curve.y2 }
+      }
+  }
+  throw new Error('Unsupported prototype transition easing')
+}
+
+function smartTransition(value: unknown): PrototypeSmartTransition | null {
+  if (value === null) return null
+  if (
+    !object(value) ||
+    !keys(value, ['type', 'duration', 'easing']) ||
+    value.type !== 'SMART_ANIMATE' ||
+    !finite(value.duration) ||
+    value.duration < 0
+  )
+    throw new Error('Unsupported prototype transition: expected SMART_ANIMATE')
+  return { type: 'SMART_ANIMATE', duration: value.duration, easing: easing(value.easing) }
+}
+
+function variantSet(graph: SceneGraph, id: string): string | undefined {
+  let node = graph.getNode(id)
+  while (node) {
+    const main = node.type === 'INSTANCE' ? getMainComponent(graph, node.id) : node
+    const parent = main?.parentId ? graph.getNode(main.parentId) : undefined
+    if (main?.type === 'COMPONENT' && parent?.type === 'COMPONENT_SET') return parent.id
+    node = node.parentId ? graph.getNode(node.parentId) : undefined
+  }
+  return undefined
+}
+
+function nodeAction(graph: SceneGraph, ownerId: string, value: unknown): PrototypeNodeAction {
+  if (!object(value) || value.type !== 'NODE') throw new Error('Unsupported prototype action')
+  if (value.navigation === 'OVERLAY') return overlayAction(graph, value)
+  if (
+    value.navigation !== 'CHANGE_TO' ||
+    !keys(value, ['type', 'destinationId', 'navigation', 'transition']) ||
+    typeof value.destinationId !== 'string'
+  )
+    throw new Error('Unsupported prototype action')
+  const destination = graph.getNode(value.destinationId)
+  const sourceSet = variantSet(graph, ownerId)
+  if (!sourceSet || destination?.type !== 'COMPONENT' || destination.parentId !== sourceSet)
+    throw new Error('CHANGE_TO requires a destination variant in the same component set')
+  return {
+    type: 'NODE',
+    destinationId: destination.id,
+    navigation: 'CHANGE_TO',
+    transition: smartTransition(value.transition)
+  }
+}
+
+function trigger(value: unknown): PrototypeReaction['trigger'] {
+  if (object(value) && keys(value, ['type']) && value.type === 'ON_CLICK')
+    return { type: 'ON_CLICK' }
+  if (
+    object(value) &&
+    keys(value, ['type', 'timeout']) &&
+    value.type === 'AFTER_TIMEOUT' &&
+    finite(value.timeout) &&
+    value.timeout >= 0
+  )
+    return { type: 'AFTER_TIMEOUT', timeout: value.timeout }
+  throw new Error('Unsupported prototype reaction trigger')
+}
+
+export function setReactions(graph: SceneGraph, id: string, values: readonly unknown[]): void {
+  if (!Array.isArray(values)) throw new Error('setReactionsAsync expects an array')
+  const reactions: PrototypeReaction[] = values.map((value) => {
+    if (!object(value) || !keys(value, ['trigger', 'actions']) || !Array.isArray(value.actions))
+      throw new Error('Unsupported prototype reaction: expected a trigger with actions')
+    return {
+      trigger: trigger(value.trigger),
+      actions: value.actions.map((action) => nodeAction(graph, id, action))
+    }
+  })
+  assertNodeEditable(graph, id)
+  graph.updateNode(id, { reactions })
+  recordInstanceOverride(graph, id, ['reactions'])
+}
