+import { expect, test } from 'bun:test'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+import { parseColor } from '@open-pencil/scene-graph/color'
+
+import { svgFormat } from '#core/io/formats'
+import { exportFigFile } from '#core/io/formats/fig/export'
+import { parseFigFile } from '#core/io/formats/fig/read'
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { parseSVGDocument } from '#core/io/formats/svg/document'
+
+test('ordinary FIG, CSS and SVG exports preserve fractional opaque RGB paint channels', async () => {
+  for (const channels of [
+    [69.4894, 69.4894, 69.4894],
+    [17.25, 34.5, 51.75],
+    [17, 34, 51]
+  ]) {
+    let graph = new SceneGraph()
+    const color = { r: channels[0] / 255, g: channels[1] / 255, b: channels[2] / 255, a: 1 }
+    graph.createNode('RECTANGLE', graph.getPages()[0].id, {
+      name: 'Editable paint',
+      width: 80,
+      height: 40,
+      fills: [{ type: 'SOLID', visible: true, opacity: 1, color }]
+    })
+    for (let cycle = 0; cycle < 2; cycle++) {
+      const bytes = await exportFigFile(graph)
+      graph = await parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate: 'all' })
+      const rectangle = [...graph.getAllNodes()].find((node) => node.name === 'Editable paint')
+      if (!rectangle || !svgFormat.exportContent) throw new Error('Missing native paint')
+      const exported = await svgFormat.exportContent(
+        { graph, target: { scope: 'node', nodeId: rectangle.id }, fileName: 'paint.svg' },
+        { precision: null }
+      )
+      if (typeof exported.data !== 'string') throw new Error('Expected SVG')
+      const svg = parseSVGDocument(exported.data)
+      const svgColor = svg?.getElementsByTagName('rect')[0]?.getAttribute('fill')
+      const html = await renderNodesToHTML(graph, [rectangle.id], { html: 'standalone' })
+      const cssColor = /background-color:\s*([^;"}]+)/.exec(html.html)?.[1]
+      if (!svgColor || !cssColor) throw new Error('Missing exported paint color')
+      for (const paint of [svgColor, cssColor]) {
+        const parsed = parseColor(paint)
+        expect([parsed.r, parsed.g, parsed.b].map(Math.fround)).toEqual(
+          [color.r, color.g, color.b].map(Math.fround)
+        )
+      }
+      if (channels.every(Number.isInteger)) expect(svgColor).toBe('#112233')
+    }
+  }
+})
diff --git a/packages/core/tests/io/formats/svg/precision.test.ts b/packages/core/tests/io/formats/svg/precision.test.ts
