--- /dev/null
+++ b/packages/scene-graph/src/text/line-height.ts
@@ -0,0 +1,16 @@
+import type { CharacterStyleOverride, SceneNode } from '../types'
+
+type LineHeightStyle = Pick<SceneNode, 'fontSize' | 'lineHeight'> &
+  Partial<Pick<SceneNode, 'lineHeightUnit'>>
+
+/** Resolve a native line-height unit only when a renderer needs a pixel distance. */
+export function lineHeightInPixels(
+  style: LineHeightStyle,
+  override: CharacterStyleOverride = {}
+): number | null {
+  const explicit = override.lineHeight !== undefined
+  const height = explicit ? override.lineHeight : style.lineHeight
+  if (height == null) return null
+  const unit = override.lineHeightUnit ?? (explicit ? 'PIXELS' : style.lineHeightUnit)
+  return unit === 'PERCENT' ? (height / 100) * (override.fontSize ?? style.fontSize) : height
+}
