+++ b/packages/core/tests/figma-api/nested-variant-properties.test.ts
@@ -0,0 +1,183 @@
+import { expect, test } from 'bun:test'
+
+import { expectDefined, expectFills } from '#core-tests/helpers/assert'
+import { uint8ArrayToArrayBuffer } from '#core-tests/helpers/fig/fixtures'
+import { asInstanceNode, createAPI, solidFill, solidStroke } from '#core-tests/helpers/figma-api'
+
+import { FigmaAPI, exportFigFile, parseFigFile } from '@open-pencil/core'
+import type { Color, SceneGraph } from '@open-pencil/scene-graph'
+
+function setup(actionName?: string) {
+  const api = createAPI()
+  const enabled = api.createComponent()
+  enabled.name = 'state=default'
+  const disabled = api.createComponent()
+  disabled.name = 'state=disabled'
+  api.combineAsVariants([enabled, disabled], api.currentPage)
+  const owner = api.createComponent()
+  owner.name = 'Owner'
+  const action = enabled.createInstance()
+  if (actionName) action.name = actionName
+  owner.appendChild(action)
+  action.isExposedInstance = true
+  const instance = owner.createInstance()
+  instance.name = 'Usage'
+  return { api, enabled, disabled, owner, action, instance }
+}
+
+function syncComponents(graph: SceneGraph) {
+  for (const node of graph.getAllNodes()) {
+    if (node.type === 'COMPONENT') graph.syncInstances(node.id)
+  }
+}
+
+function expectRootPaint(instance: InstanceNode, color: Color): void {
+  const paints = [expectFills(instance.fills)[0], instance.strokes[0]]
+  for (const paint of paints) {
+    if (paint?.type !== 'SOLID') throw new Error('Expected solid root paint')
+    expect(paint.color).toEqual(color)
+  }
+}
+
+test('setProperties resolves a copied nested instance before finding its variant set', () => {
+  const { api, enabled, disabled, owner, action, instance } = setup()
+  const nested = expectDefined(instance.exposedInstances[0])
+  expect(api.graph.getNode(nested.id)?.componentId).toBe(action.id)
+  expect(nested.mainComponent?.id).toBe(enabled.id)
+
+  nested.setProperties({ state: 'default' })
+  expect(api.graph.getNode(nested.id)?.componentId).toBe(action.id)
+  nested.setProperties({ state: 'disabled' })
+  expect(nested.mainComponent?.id).toBe(disabled.id)
+  expect(nested.name).toBe(disabled.name)
+  expect(nested.componentProperties.state?.value).toBe('disabled')
+  syncComponents(api.graph)
+  expect(instance.exposedInstances[0]?.mainComponent?.id).toBe(disabled.id)
+  expect(instance.exposedInstances[0]?.componentProperties.state?.value).toBe('disabled')
+  expect(api.graph.getChildren(owner.id)[0]?.componentId).toBe(enabled.id)
+})
+
+test('nested variant properties survive fig save, fresh reopen, edits, and component sync', async () => {
+  const { api, instance } = setup()
+  expectDefined(instance.exposedInstances[0]).setProperties({ state: 'disabled' })
+  const bytes = await exportFigFile(api.graph)
+  const graph = await parseFigFile(uint8ArrayToArrayBuffer(bytes), { populate: 'all' })
+  const reopened = new FigmaAPI(graph)
+  const usage = expectDefined(
+    [...graph.getAllNodes()].find((node) => node.type === 'INSTANCE' && node.name === 'Usage')
+  )
+  const copy = asInstanceNode(reopened.wrapNode(usage.id))
+  expect(copy.exposedInstances[0]?.componentProperties.state?.value).toBe('disabled')
+  syncComponents(graph)
+  expect(copy.exposedInstances[0]?.componentProperties.state?.value).toBe('disabled')
+  expectDefined(copy.exposedInstances[0]).setProperties({ state: 'default' })
+  syncComponents(graph)
+  expect(copy.exposedInstances[0]?.componentProperties.state?.value).toBe('default')
+  expectDefined(copy.exposedInstances[0]).setProperties({ state: 'disabled' })
+  syncComponents(graph)
+  expect(copy.exposedInstances[0]?.componentProperties.state?.value).toBe('disabled')
+})
+
+test('variant edits preserve copied custom layer names through sync and repeated saves', async () => {
+  const initial = setup('title')
+  let api = initial.api
+  let usage = initial.instance
+  for (let pass = 0; pass < 2; pass++) {
+    for (const state of ['disabled', 'default']) {
+      const nested = expectDefined(usage.exposedInstances[0])
+      expect(nested.name).toBe('title')
+      nested.setProperties({ state })
+      expect(nested.name).toBe('title')
+      expect(nested.componentProperties.state?.value).toBe(state)
+      syncComponents(api.graph)
+      expect(usage.exposedInstances[0]?.name).toBe('title')
+      expect(usage.exposedInstances[0]?.componentProperties.state?.value).toBe(state)
+    }
+    const bytes = await exportFigFile(api.graph)
+    const graph = await parseFigFile(uint8ArrayToArrayBuffer(bytes), { populate: 'all' })
+    api = new FigmaAPI(graph)
+    const saved = expectDefined(
+      [...graph.getAllNodes()].find((node) => node.type === 'INSTANCE' && node.name === 'Usage')
+    )
+    usage = asInstanceNode(api.wrapNode(saved.id))
+    expect(usage.exposedInstances[0]?.name).toBe('title')
+    expect(usage.exposedInstances[0]?.componentProperties.state?.value).toBe('default')
+  }
+  expect(initial.action.name).toBe('title')
+  expect(initial.action.mainComponent?.id).toBe(initial.enabled.id)
+})
+
+for (const override of ['inherited', 'binding', 'paint'] as const) {
+  test(`nested variant ${override} root paint survives normal saves and subsequent edits`, async () => {
+    const initial = setup('cancel')
+    let api = initial.api
+    const red = { r: 1, g: 0, b: 0, a: 1 }
+    const blue = { r: 0, g: 0, b: 1, a: 1 }
+    const yellow = { r: 1, g: 1, b: 0, a: 1 }
+    const collection = api.createVariableCollection('Theme')
+    const normal = api.createVariable('Default', 'COLOR', collection.id, red)
+    const changed = api.createVariable('Disabled', 'COLOR', collection.id, blue)
+    initial.enabled.fills = [solidFill(red)]
+    initial.disabled.fills = [solidFill(blue)]
+    initial.enabled.strokes = [solidStroke(red, { weight: 2, align: 'INSIDE' })]
+    initial.disabled.strokes = [solidStroke(blue, { weight: 2, align: 'INSIDE' })]
+    api.bindVariable(initial.enabled.id, 'fills/0/color', normal.id)
+    api.bindVariable(initial.disabled.id, 'fills/0/color', changed.id)
+    api.bindVariable(initial.enabled.id, 'strokes/0/color', normal.id)
+    api.bindVariable(initial.disabled.id, 'strokes/0/color', changed.id)
+    syncComponents(api.graph)
+    initial.action.resize(286, 48)
+    if (override === 'binding') {
+      api.bindVariable(initial.action.id, 'fills/0/color', normal.id)
+      api.bindVariable(initial.action.id, 'strokes/0/color', normal.id)
+    }
+    if (override === 'paint') {
+      api.unbindVariable(initial.action.id, 'fills/0/color')
+      api.unbindVariable(initial.action.id, 'strokes/0/color')
+      initial.action.fills = [solidFill(yellow)]
+      initial.action.strokes = [solidStroke(yellow, { weight: 2, align: 'INSIDE' })]
+    }
+    syncComponents(api.graph)
+
+    const firstSave = await exportFigFile(api.graph)
+    api = new FigmaAPI(await parseFigFile(uint8ArrayToArrayBuffer(firstSave), { populate: 'all' }))
+    const owner = api.currentPage.findOne(
+      (node) => node.type === 'COMPONENT' && node.name === 'Owner'
+    )
+    if (!owner) throw new Error('Saved owner must exist')
+    let usage = asInstanceNode(owner.createInstance())
+    usage.name = 'Paint usage'
+    for (const state of ['disabled', 'default', 'disabled']) {
+      const nested = usage.exposedInstances[0]
+      if (!nested) throw new Error('Exposed action must exist')
+      nested.setProperties({ state })
+      syncComponents(api.graph)
+      const expected = { inherited: state === 'default' ? red : blue, binding: red, paint: yellow }[
+        override
+      ]
+      expectRootPaint(nested, expected)
+      expect([nested.width, nested.height, nested.name]).toEqual([286, 48, 'cancel'])
+      const bytes = await exportFigFile(api.graph)
+      api = new FigmaAPI(await parseFigFile(uint8ArrayToArrayBuffer(bytes), { populate: 'all' }))
+      const saved = api.currentPage.findOne(
+        (node) => node.type === 'INSTANCE' && node.name === 'Paint usage'
+      )
+      if (!saved) throw new Error('Saved usage must exist')
+      usage = asInstanceNode(saved)
+      const restored = expectDefined(usage.exposedInstances[0])
+      expect(restored.componentProperties.state?.value).toBe(state)
+      expectRootPaint(restored, expected)
+      expect([restored.width, restored.height, restored.name]).toEqual([286, 48, 'cancel'])
+      for (const field of ['fills/0/color', 'strokes/0/color']) {
+        const id = expectDefined(api.graph.getNode(restored.id)).boundVariables[field]
+        expect(id ? api.graph.variables.get(id)?.name : undefined).toBe(
+          {
+            inherited: state === 'default' ? 'Default' : 'Disabled',
+            binding: 'Default',
+            paint: undefined
+          }[override]
+        )
+      }
+    }
+  })
+}
