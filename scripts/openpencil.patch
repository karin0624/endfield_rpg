+
+test('horizontal prototype content pans in its own layer while fixed and contained groups stay put', async () => {
+  for (const direction of ['NONE', 'VERTICAL', 'HORIZONTAL', 'BOTH'] as const) {
+    const graph = new SceneGraph()
