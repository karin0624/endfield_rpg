+import { afterEach, expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+import { FIXTURES } from '#core-tests/helpers/fig/fixtures'
+import { createAPI, asComponentNode, asInstanceNode } from '#core-tests/helpers/figma-api'
+
+import { exportFigFile, FigmaAPI, parseFigFile, setTextMeasurer } from '@open-pencil/core'
+import type { FigmaNodeProxy, FigmaSlotNode } from '@open-pencil/core/figma-api'
+import { parseFigBuffer, materializeDocument } from '@open-pencil/fig'
+import type { NodeChange } from '@open-pencil/kiwi/fig/codec'
+
+afterEach(() => setTextMeasurer(null))
+function fixture() {
+  const api = createAPI(),
+    graph = api.graph,
+    page = graph.getPages()[0]
+  const set = graph.createNode('COMPONENT_SET', page.id, {
+    name: 'Card',
+    componentPropertyDefinitions: [
+      { id: 'prop:state', name: 'state', type: 'VARIANT', defaultValue: 'active' },
+      { id: 'prop:hp', name: 'HP', type: 'TEXT', defaultValue: '30' }
+    ]
