+import { expect, test } from 'bun:test'
+
+import { FontManager } from '#core/text/fonts'
+
+test('project physical faces load and appear in the font catalog without online providers', async () => {
+  const manager = new FontManager()
+  manager.setOnlineFontProviders({
+    google: false,
+    fontsource: false,
+    bunny: false,
+    fontshare: false
+  })
+  const faces = [
+    ['Liberation Sans', 'Bold'],
+    ['Liberation Serif', 'Regular'],
+    ['WenQuanYi Zen Hei', 'Regular'],
+    ['WenQuanYi Zen Hei Mono', 'Regular'],
+    ['Noto Serif JP', 'Medium']
+  ] as const
+  for (const [family, style] of faces) {
+    const bytes = await manager.loadFont(family, style)
+    expect(bytes?.byteLength).toBeGreaterThan(1000)
+    expect(manager.loadedFontSource(family, style)).toBe('bundled')
+  }
+  const catalog = await manager.listFamilyOptions()
+  for (const [family] of faces) expect(catalog).toContainEqual({ family, source: 'bundled' })
+})
diff --git a/packages/dom-css/src/export/images.ts b/packages/dom-css/src/export/images.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8c0e530291fe939e8b705ac9399eeb5e3f4d7a34
--- /dev/null
+++ b/packages/dom-css/src/export/images.ts
@@ -0,0 +1,123 @@
+import { fromUint8Array } from 'js-base64'
+
+import {
+  imageMimeType,
+  shaderOfPaint,
+  type SceneGraph,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+import type { DesignStyleDeclaration } from '../types'
+
+export type ImageFrameFills = 'background' | 'image'
+
+const DOM_CSS_PLUGIN_ID = 'open-pencil-dom-css'
+const IMAGE_SOURCE_URL_KEY = 'image-source-url'
+const IMAGE_FRAME_TYPES = new Set<SceneNode['type']>(['FRAME', 'COMPONENT', 'INSTANCE'])
+
+/** Image bytes as a data URL of the type they are encoded in. */
+export function imageDataURL(bytes: Uint8Array): string {
+  return `data:${imageMimeType(bytes)};base64,${fromUint8Array(bytes)}`
+}
+
+/** A container's native image fill stays behind its content, including an empty native frame. */
+export function imageFrameBackground(node: SceneNode, mode: ImageFrameFills | undefined): boolean {
+  const fill = node.fills.at(0)
+  if (
+    !IMAGE_FRAME_TYPES.has(node.type) ||
+    fill?.type !== 'IMAGE' ||
+    !fill.visible ||
+    shaderOfPaint(node, fill)
+  )
+    return false
+  if (node.childIds.length === 0 && mode !== 'background') return false
+  // Cropped leaf images keep the native matrix projection. A cropped container needs a
+  // background crop layer rather than turning its children into an SVG image's children.
+  if (fill.imageScaleMode === 'CROP' && node.childIds.length === 0) return false
+  if (fill.imageScaleMode && !['FILL', 'FIT', 'TILE'].includes(fill.imageScaleMode))
+    throw new Error(`Unsupported container image fill mode ${fill.imageScaleMode}: ${node.id}`)
+  if (fill.opacity !== 1 || (fill.blendMode && fill.blendMode !== 'NORMAL'))
+    throw new Error(`Unsupported container image paint opacity or blend: ${node.id}`)
+  if (node.fills.slice(1).some((paint) => paint.type === 'IMAGE' && paint.visible))
+    throw new Error(`Multiple container image fills are not supported: ${node.id}`)
+  return true
+}
+
+/** Native TILE matrices map original image coordinates to repeated frame-local CSS tiles. */
+export function addImageFrameStyle(
+  style: DesignStyleDeclaration,
+  node: SceneNode,
+  backgroundLayerCount: number
+): void {
+  const fill = node.fills[0]
+  const mode = fill.imageScaleMode ?? 'FILL'
+  let size = mode === 'FIT' ? 'contain' : 'cover'
+  let position = 'center'
+  let repeat = 'no-repeat'
+  if (mode === 'TILE') {
+    size = 'auto'
+    position = '0px 0px'
+    repeat = 'repeat'
+    const t = fill.imageTransform
+    if (t) {
+      if (
+        t.m01 !== 0 ||
+        t.m10 !== 0 ||
+        t.m00 <= 0 ||
+        t.m11 <= 0 ||
+        !Object.values(t).every(Number.isFinite)
+      )
+        throw new Error(`Unsupported transformed container TILE image fill: ${node.id}`)
+      size = `${node.width / t.m00}px ${node.height / t.m11}px`
+      position = `${(-node.width * t.m02) / t.m00}px ${(-node.height * t.m12) / t.m11}px`
+    }
+  }
+  // Native paints draw bottom to top: the original image is the last CSS layer.
+  const layers = (upper: string, image: string) =>
+    [...Array.from({ length: Math.max(0, backgroundLayerCount - 1) }, () => upper), image].join(
+      ', '
+    )
+  style['background-size'] = layers('auto', size)
+  style['background-position'] = layers('center', position)
+  style['background-repeat'] = layers('no-repeat', repeat)
+}
+
+export function addImageStyle(style: DesignStyleDeclaration, node: SceneNode): void {
+  const fill = node.fills.at(0)
+  if (fill?.type !== 'IMAGE' || !fill.visible || shaderOfPaint(node, fill)) return
+  if (node.width > 0 && node.height > 0) style['aspect-ratio'] = `${node.width} / ${node.height}`
+  if (fill.imageScaleMode === 'FIT') style['object-fit'] = 'contain'
+  if (fill.imageScaleMode === 'FILL') style['object-fit'] = 'cover'
+}
+
+function imageSourceURL(node: SceneNode): string | undefined {
+  return node.pluginData.find(
+    (entry) => entry.pluginId === DOM_CSS_PLUGIN_ID && entry.key === IMAGE_SOURCE_URL_KEY
+  )?.value
+}
+
+export function attrsForNode(
+  graph: SceneGraph,
+  node: SceneNode,
+  includeSourceIds: boolean
+): Record<string, string> {
+  const attrs: Record<string, string> = includeSourceIds
+    ? { 'data-open-pencil-node-id': node.id }
+    : {}
+  const sourceURL = imageSourceURL(node)
+  if (sourceURL) attrs.src = sourceURL
+  const fill = node.fills.at(0)
+  if (fill?.type !== 'IMAGE' || !fill.imageHash || shaderOfPaint(node, fill)) return attrs
+  const bytes = graph.images.get(fill.imageHash)
+  if (!bytes) return attrs
+  return { ...attrs, src: imageDataURL(bytes) }
+}
+
+export function tagNameForNode(node: SceneNode, backgroundImage: boolean): string {
+  if (backgroundImage) return 'div'
+  if (node.type === 'SECTION') return 'section'
+  const fill = node.fills.at(0)
+  const image = fill?.type === 'IMAGE' && !shaderOfPaint(node, fill)
+  if ((image || imageSourceURL(node)) && node.childIds.length === 0) return 'img'
+  return 'div'
+}
diff --git a/packages/dom-css/src/export/native/background.ts b/packages/dom-css/src/export/native/background.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ad17bf7c014ed77cef13726c80d88e4890d5c0aa
--- /dev/null
+++ b/packages/dom-css/src/export/native/background.ts
@@ -0,0 +1,210 @@
+import type { DesignDocument, DesignElement } from '#dom-css/types'
+
+import { getWorldMatrix, type SceneGraph, type SceneNode } from '@open-pencil/scene-graph'
+
+import { imageDataURL } from '../images'
+import { isPrototypeAnimated } from '../prototype-animate'
+import type { ImageSizeResolver } from './index'
+
+const PLACEMENT = new Set([
+  'name',
+  'locked',
+  'expanded',
+  'sourceComponentId',
+  'x',
+  'y',
+  'width',
+  'height',
+  'rotation',
+  'skew',
+  'flipX',
+  'flipY',
+  'horizontalConstraint',
+  'verticalConstraint',
+  'layoutPositioning',
+  'layoutGrow',
+  'layoutAlignSelf',
+  'scrollBehavior'
+])
+
+function unitAxes(graph: SceneGraph, node: SceneNode): boolean {
+  const matrix = getWorldMatrix(node, graph)
+  return matrix[0] === 1 && matrix[1] === 0 && matrix[3] === 0 && matrix[4] === 1
+}
+
+function staticBox(node: SceneNode): boolean {
+  return (
+    node.visible &&
+    !node.internalOnly &&
+    !node.isMask &&
+    node.opacity === 1 &&
+    (node.blendMode === 'NORMAL' || node.blendMode === 'PASS_THROUGH') &&
+    node.rotation === 0 &&
+    node.skew === 0 &&
+    !node.flipX &&
+    !node.flipY &&
+    node.cornerRadius === 0 &&
+    !node.independentCorners &&
+    node.cornerSmoothing === 0 &&
+    node.layoutMode === 'NONE' &&
+    node.overflowDirection === 'NONE' &&
+    node.reactions !== null &&
+    node.reactions.length === 0 &&
+    Object.keys(node.boundVariables).length === 0 &&
+    !node.effects.some((effect) => effect.visible) &&
+    !node.strokes.some((stroke) => stroke.visible)
+  )
+}
+
+/** A normal occurrence can name, resize and place its background, but cannot change its paint. */
+function placementOnly(graph: SceneGraph, node: SceneNode): boolean {
+  const visited = new Set<string>()
+  for (let current: SceneNode | undefined = node; current;) {
+    if (visited.has(current.id)) return false
+    visited.add(current.id)
+    if (
+      [...current.instanceOverrides.self.keys()].some((field) => !PLACEMENT.has(field)) ||
+      [...current.instanceOverrides.descendants.values()].some((fields) =>
+        [...fields.keys()].some((field) => !PLACEMENT.has(field))
+      )
+    )
+      return false
+    for (
+      let owner: SceneNode | undefined = current;
+      owner;
+      owner = owner.parentId ? graph.getNode(owner.parentId) : undefined
+    ) {
+      const fields = owner.instanceOverrides.descendants.get(current.id)
+      if (fields && [...fields.keys()].some((field) => !PLACEMENT.has(field))) return false
+    }
+    current = current.componentId ? graph.getNode(current.componentId) : undefined
+  }
+  return true
+}
+
+function viewport(root: DesignElement, graph: SceneGraph): SceneNode | undefined {
+  const frame = root.sourceSceneNode
+  const style = root.inlineStyle
+  if (
+    frame?.type !== 'FRAME' ||
+    !staticBox(frame) ||
+    !unitAxes(graph, frame) ||
+    frame.primaryAxisSizing === 'HUG' ||
+    frame.counterAxisSizing === 'HUG' ||
+    !frame.clipsContent ||
+    frame.fills.some((fill) => fill.visible) ||
+    !Number.isFinite(frame.width) ||
+    !Number.isFinite(frame.height) ||
+    frame.width <= 0 ||
+    frame.height <= 0 ||
+    style?.left !== '0px' ||
+    style.top !== '0px' ||
+    style.transform ||
+    root.shader
+  )
+    return undefined
+  return frame
+}
+
+function completeLeaf(node: SceneNode, frame: SceneNode): boolean {
+  return (
+    ['RECTANGLE', 'FRAME', 'COMPONENT', 'INSTANCE'].includes(node.type) &&
+    frame.childIds[0] === node.id &&
+    node.scrollBehavior === 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME' &&
+    node.childIds.length === 0 &&
+    node.fillGeometry.length === 0 &&
+    node.componentPropertyReferences.length === 0 &&
+    Object.keys(node.componentPropertyAssignments).length === 0 &&
+    Object.keys(node.componentPropertyValues).length === 0 &&
+    node.x === 0 &&
+    node.y === 0 &&
+    node.width === frame.width &&
+    node.height === frame.height &&
+    node.componentScale === 1 &&
+    node.fills.length === 1
+  )
+}
+
+function imageSource(
+  graph: SceneGraph,
+  node: SceneNode,
+  imageSize: ImageSizeResolver
+): { source: string; size: NonNullable<ReturnType<ImageSizeResolver>> } | undefined {
+  const fill = node.fills[0]
+  if (
+    fill.type !== 'IMAGE' ||
+    !fill.visible ||
+    fill.opacity !== 1 ||
+    (fill.blendMode && fill.blendMode !== 'NORMAL') ||
+    fill.imageScaleMode !== 'FILL' ||
+    fill.imageTransform ||
+    !fill.imageHash
+  )
+    return undefined
+  const size = imageSize(fill.imageHash)
+  if (
+    size?.opaque !== true ||
+    !Number.isFinite(size.width) ||
+    !Number.isFinite(size.height) ||
+    size.width <= 0 ||
+    size.height <= 0
+  )
+    return undefined
+  const bytes = graph.images.get(fill.imageHash)
+  return bytes ? { source: imageDataURL(bytes), size } : undefined
+}
+
+function originalProjection(child: DesignElement, source: string): boolean {
+  const image = `url(${JSON.stringify(source)})`
+  const childStyle = child.inlineStyle
+  // Preserve authored external image URLs and custom projections through the ordinary path.
+  if (
+    Object.keys(child.attrs).some(
+      (key) => !['data-open-pencil-node-id', 'src', 'width', 'height'].includes(key)
+    ) ||
+    (child.tagName === 'img'
+      ? child.attrs.src !== source
+      : child.tagName !== 'div' ||
+        (childStyle?.background !== image && childStyle?.['background-image'] !== image))
+  )
+    return false
+  return true
+}
+
+/**
+ * A standalone viewport's opaque fixed background is one CSS background, behind its content.
+ * Folding only this complete, static first layer preserves the frame's native clipping and
+ * avoids a separate image surface. The graph and its original image bytes stay unchanged.
+ */
+export function nativeFixedBackground(
+  document: DesignDocument,
+  imageSize: ImageSizeResolver
+): void {
+  const graph = document.sourceGraph
+  const root = document.children.at(0)
+  if (!graph || document.children.length !== 1 || root?.type !== 'element') return
+  const frame = viewport(root, graph)
+  if (!frame || isPrototypeAnimated(graph, frame, document.prototypeAnimations ?? [])) return
+  const child = root.children.at(0)
+  if (child?.type !== 'element' || child.shader) return
+  const background = child.sourceSceneNode
+  if (!background || !completeLeaf(background, frame) || !staticBox(background)) return
+  if (!unitAxes(graph, background) || !placementOnly(graph, background)) return
+  if (isPrototypeAnimated(graph, background, document.prototypeAnimations ?? [])) return
+  const image = imageSource(graph, background, imageSize)
+  if (!image || !originalProjection(child, image.source)) return
+  // A fixed CSS background uses the browser viewport as its positioning area. Native FILL
+  // instead covers the saved image frame, whose dimensions stay fixed when that viewport changes.
+  const scale = Math.max(frame.width / image.size.width, frame.height / image.size.height)
+  const width = image.size.width * scale
+  const height = image.size.height * scale
+  root.inlineStyle = {
+    ...root.inlineStyle,
+    'background-image': `url(${JSON.stringify(image.source)})`,
+    'background-size': `${width}px ${height}px`,
+    'background-position': `${(frame.width - width) / 2}px ${(frame.height - height) / 2}px`,
+    'background-repeat': 'no-repeat',
+    'background-attachment': 'fixed'
+  }
+  root.children = root.children.slice(1)
+}
diff --git a/packages/dom-css/src/export/native/constraints.ts b/packages/dom-css/src/export/native/constraints.ts
new file mode 100644
index 0000000000000000000000000000000000000000..10e53227d2f8de19f9b2695de6461141a2d63017
--- /dev/null
+++ b/packages/dom-css/src/export/native/constraints.ts
@@ -0,0 +1,129 @@
+import type { DesignElement, DesignStyleDeclaration } from '#dom-css/types'
+
+import type { SceneNode, Vector } from '@open-pencil/scene-graph'
+
+import { hugs } from '../projection'
+
+function containsRasterImage(node: DesignElement): boolean {
+  return (
+    node.tagName === 'image' ||
+    node.children.some((child) => child.type === 'element' && containsRasterImage(child))
+  )
+}
+
+/** Paintless wrappers keep the drawing's viewport; HTML content keeps normal layout. */
+function drawsSVGViewport(node: DesignElement): boolean {
+  if (node.tagName === 'svg') return !containsRasterImage(node)
+  const source = node.sourceSceneNode
+  if (
+    !source ||
+    !['FRAME', 'GROUP', 'COMPONENT', 'INSTANCE'].includes(source.type) ||
+    source.layoutMode !== 'NONE' ||
+    [...source.fills, ...source.strokes].some((paint) => paint.visible) ||
+    source.effects.some((effect) => effect.visible)
+  )
+    return false
+  return (
+    node.children.length > 0 &&
+    node.children.every((child) => child.type === 'element' && drawsSVGViewport(child))
+  )
+}
+
+/** A native trailing constraint keeps its edge anchored as Hug content changes size. */
+export function nativeTrailingConstraints(
+  style: DesignStyleDeclaration,
+  source: SceneNode,
+  owner: SceneNode,
+  border: Vector
+) {
+  if (owner.layoutMode !== 'NONE' && source.layoutPositioning !== 'ABSOLUTE') return
+  const translate = { x: '0px', y: '0px' }
+  let anchored = false
+  for (const axis of ['x', 'y'] as const) {
+    const constraint = axis === 'x' ? source.horizontalConstraint : source.verticalConstraint
+    const size = axis === 'x' ? 'width' : 'height'
+    if (constraint !== 'MAX' || !hugs(source, size)) continue
+    const position = axis === 'x' ? 'left' : 'top'
+    const renderedSize = Number.parseFloat(style[size] ?? '') || source[size]
+    const point = source[axis] + renderedSize - border[axis]
+    const offset = point - (owner[size] - border[axis] * 2)
+    style[position] = offset === 0 ? '100%' : `calc(100% + ${offset}px)`
+    // As with Center, restore only the fraction the layout position cannot
+    // represent; a live Hug owner must keep its percentage anchor dynamic.
+    const residual = hugs(owner, size) ? 0 : point - Math.trunc(point * 64) / 64
+    translate[axis] = residual === 0 ? '-100%' : `calc(-100% + ${residual}px)`
+    anchored = true
+  }
+  if (anchored)
+    style.transform = `translate(${translate.x}, ${translate.y})${style.transform ? ` ${style.transform}` : ''}`
+}
+
+/** Both pinned edges follow the live containing block, including inside a Fill chain. */
+export function nativeStretchedConstraints(
+  style: DesignStyleDeclaration,
+  source: SceneNode,
+  owner: SceneNode,
+  border: { left: number; top: number; right: number; bottom: number },
+  projected: DesignElement
+) {
+  if (owner.layoutMode !== 'NONE' && source.layoutPositioning !== 'ABSOLUTE') return
+  for (const axis of ['x', 'y'] as const) {
+    const size = axis === 'x' ? 'width' : 'height'
+    const constraint = axis === 'x' ? source.horizontalConstraint : source.verticalConstraint
+    if (constraint !== 'STRETCH' || hugs(source, size)) continue
+    const leading = axis === 'x' ? 'left' : 'top'
+    const trailing = axis === 'x' ? 'right' : 'bottom'
+    const leadingInset = source[axis] - border[leading]
+    const trailingInset = owner[size] - source[axis] - source[size] - border[trailing]
+    style[leading] = `${leadingInset}px`
+    style[trailing] = `${trailingInset}px`
+    // Replaced elements keep their intrinsic size when both insets are set.
+    // Give them the same live available size that an ordinary CSS box receives.
+    if (
+      ['img', 'svg', 'video', 'canvas', 'iframe', 'object', 'embed'].includes(projected.tagName)
+    ) {
+      const inset = leadingInset + trailingInset
+      style[size] = inset === 0 ? '100%' : `calc(100% - ${inset}px)`
+    } else if (axis === 'x') delete style.width
+    else delete style.height
+  }
+}
+
+export function nativeCenteredConstraints(
+  style: DesignStyleDeclaration,
+  source: SceneNode,
+  owner: SceneNode,
+  projected: DesignElement
+) {
+  if (owner.layoutMode !== 'NONE' && source.layoutPositioning !== 'ABSOLUTE') return
+  const centerX = source.horizontalConstraint === 'CENTER'
+  const centerY = source.verticalConstraint === 'CENTER'
+  if (!centerX && !centerY) return
+  // An SVG may enclose its native bounds in a larger integer viewport.
+  const width = Number.parseFloat(style.width) || source.width
+  const height = Number.parseFloat(style.height) || source.height
+  // SVG viewports pixel-snap before their transform. Keep their fractional affine
+  // placement in that transform, including through a paintless native wrapper.
+  const layoutUnits = drawsSVGViewport(projected) ? 1 : 64
+  const translate = (
+    centered: boolean,
+    position: number,
+    size: number,
+    parentSize: number,
+    flexible: boolean,
+    property: 'left' | 'top'
+  ) => {
+    if (!centered) return '0px'
+    // Keep the representable position in layout and its remaining precision in
+    // the transform, preserving the native geometry and the live center anchor.
+    // A Hug parent's live size is determined by its content, not this snapshot.
+    const offset = position + size / 2 - parentSize / 2
+    const layoutOffset = Math.trunc(offset * layoutUnits) / layoutUnits
+    style[property] = layoutOffset === 0 ? '50%' : `calc(50% + ${layoutOffset}px)`
+    const point = parentSize / 2 + layoutOffset
+    const residual = flexible ? 0 : point - Math.trunc(point * 64) / 64
+    const fraction = offset - layoutOffset + residual
+    return fraction === 0 ? '-50%' : `calc(-50% + ${fraction}px)`
+  }
+  style.transform = `translate(${translate(centerX, source.x, width, owner.width, hugs(owner, 'width'), 'left')}, ${translate(centerY, source.y, height, owner.height, hugs(owner, 'height'), 'top')})${style.transform ? ` ${style.transform}` : ''}`
+}
diff --git a/packages/dom-css/src/export/native/index.ts b/packages/dom-css/src/export/native/index.ts
