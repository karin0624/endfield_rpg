+test('Center constraints retain layout and fractional offsets after ordinary FIG saves and parent resizing', async () => {
+  let graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const frame = api.createFrame()
+  frame.name = 'Responsive region'
+  frame.resize(1920, 1080)
+  const surface = api.createRectangle()
+  frame.appendChild(surface)
+  surface.name = 'An arbitrary centered surface'
+  surface.resize(147.734375, 37.1875)
+  surface.x = 286.1328125
+  surface.y = 577.40625
+  surface.constraints = { horizontal: 'CENTER', vertical: 'CENTER' }
+  const fractional = api.createRectangle()
+  frame.appendChild(fractional)
+  fractional.name = 'A fractional centered surface'
+  fractional.resize(18, 18)
+  fractional.x = 4.125
+  fractional.y = 1.875
+  fractional.constraints = { horizontal: 'CENTER', vertical: 'CENTER' }
+
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const reopened = [...graph.getAllNodes()].find((node) => node.name === frame.name)
+    const child = [...graph.getAllNodes()].find((node) => node.name === surface.name)
+    if (!reopened || !child) throw new Error('Missing saved centered surface')
+    expect(child.horizontalConstraint).toBe('CENTER')
+    expect(child.verticalConstraint).toBe('CENTER')
+    expect(child.x).toBe(round === 0 ? 286.1328125 : 406.1328125)
+    expect(child.y).toBe(round === 0 ? 577.40625 : 637.40625)
+    const exporter = htmlFormat.exportContent
+    if (!exporter) throw new Error('Missing public HTML exporter')
+    const exported = await exporter(
+      { graph, target: { scope: 'node', nodeId: reopened.id }, fileName: 'center.html' },
+      { html: 'standalone' }
+    )
+    expect(exported.data).toContain('left: calc(50% + -600px); top: calc(50% + 56px)')
+    expect(exported.data).toContain('transform: translate(-50%, -50%)')
+    expect(exported.data).toContain('left: calc(50% + -946.875px); top: calc(50% + -529.125px)')
+    const editable = new FigmaAPI(graph).getNodeById(reopened.id)
+    if (!editable || editable.type !== 'FRAME') throw new Error('Missing public responsive frame')
+    editable.resize(2160, 1200)
+  }
+})
+
+test('editable SVG viewport wrappers retain affine precision while mixed content keeps HTML layout', async () => {
+  let graph = new SceneGraph()
+  const api = new FigmaAPI(graph)
+  const frame = api.createFrame()
+  frame.name = 'An arbitrary region'
+  frame.resize(24, 24)
+  const wrapper = api.createComponent()
+  frame.appendChild(wrapper)
+  wrapper.name = 'An editable drawing'
+  wrapper.resize(18, 18)
+  wrapper.fills = []
+  wrapper.x = 4.125
+  wrapper.y = 4.125
+  wrapper.constraints = { horizontal: 'CENTER', vertical: 'CENTER' }
+  const viewport = api.createFrame()
+  wrapper.appendChild(viewport)
+  viewport.resize(18, 18)
+  viewport.fills = []
+  const shape = api.createStar()
+  viewport.appendChild(shape)
+  shape.resize(18, 18)
+
+  for (let round = 0; round < 2; round++) {
+    graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+    const reopened = [...graph.getAllNodes()].find((node) => node.name === frame.name)
+    const child = [...graph.getAllNodes()].find((node) => node.name === wrapper.name)
+    if (!reopened || !child) throw new Error('Missing saved editable drawing')
+    expect(child.x).toBe(round === 0 ? 4.125 : 12.125)
+    const exporter = htmlFormat.exportContent
+    if (!exporter) throw new Error('Missing public HTML exporter')
+    const exported = await exporter(
+      { graph, target: { scope: 'node', nodeId: reopened.id }, fileName: 'drawing.html' },
+      { html: 'standalone' }
+    )
+    expect(exported.data).toContain('<svg ')
+    expect(exported.data).toContain(
+      round === 0
+        ? 'left: calc(50% + 1px); top: calc(50% + 1px)'
+        : 'left: calc(50% + 1.125px); top: calc(50% + 1.125px)'
+    )
+    if (round === 0)
+      expect(exported.data).toContain('translate(calc(-50% + 0.125px), calc(-50% + 0.125px))')
+    else {
+      expect(exported.data).toContain('A mixed label')
+      expect(exported.data).toContain('transform: translate(-50%, -50%)')
+    }
