+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+import { colorToFill, parseColor } from '@open-pencil/scene-graph/color'
+
+async function render(graph: SceneGraph, rootId: string) {
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, rootId), {
+    html: 'standalone'
+  })
+  const html = String(bundle.files[0].content)
+  return (id: string) => {
+    const className = html.match(
+      new RegExp(`data-open-pencil-node-id="${id}"[^>]*class="([^"]+)"`)
+    )?.[1]
+    if (!className) throw new Error(`Missing exported element ${id}`)
+    return html.match(new RegExp(`\\.${className}\\{([^}]+)\\}`))?.[1] ?? ''
+  }
+}
+
+test.each([
+  ['VERTICAL', 'HUG'],
+  ['HORIZONTAL', 'HUG'],
+  ['VERTICAL', 'FIXED'],
+  ['HORIZONTAL', 'FIXED']
+] as const)(
+  'live %s Fill chains retain native flow in a %s owner',
+  async (layoutMode, primaryAxisSizing) => {
+    const graph = new SceneGraph()
+    const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 400,
+      height: 300,
+      layoutMode,
+      primaryAxisSizing,
+      minHeight: 300
+    })
+    const area = graph.createNode('FRAME', root.id, {
+      x: 37,
+      y: 41,
+      width: 380,
+      height: 260,
+      layoutMode,
+      layoutGrow: 1,
+      layoutAlignSelf: 'STRETCH'
+    })
+    const inner = graph.createNode('FRAME', area.id, {
+      x: 17,
+      y: 29,
+      width: 300,
+      height: 200,
+      layoutMode,
+      layoutGrow: 1,
+      layoutAlignSelf: 'STRETCH'
+    })
+    const text = graph.createNode('TEXT', inner.id, {
+      x: 71,
+      y: 83,
+      width: 80,
+      height: 24,
+      text: 'Editable',
+      textAutoResize: 'WIDTH_AND_HEIGHT'
+    })
+    const styles = await render(graph, root.id)
+    for (const layer of [area, inner]) {
+      expect(styles(layer.id)).not.toContain('position: absolute')
+      expect(styles(layer.id)).toContain('flex-basis: 0px')
+      expect(styles(layer.id)).not.toContain(`width: ${layer.width}px`)
+      expect(styles(layer.id)).not.toContain(`height: ${layer.height}px`)
+    }
+    expect(styles(text.id)).not.toContain('left: 71px')
+    graph.updateNode(text.id, { text: 'A much longer edited caption' })
+    expect((await render(graph, root.id))(text.id)).toContain('width: max-content')
+  }
+)
+
+test.each(['fixed', 'no-layout', 'absolute'] as const)(
+  'an auto-layout frame keeps its own flow across a %s parent boundary',
+  async (boundary) => {
+    const graph = new SceneGraph()
+    const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 400,
+      height: 300,
+      layoutMode: boundary === 'no-layout' ? 'NONE' : 'VERTICAL',
+      primaryAxisSizing: boundary === 'fixed' ? 'FIXED' : 'HUG'
+    })
+    const area = graph.createNode('FRAME', root.id, {
+      x: 37,
+      y: 41,
+      width: 380,
+      height: 260,
+      layoutMode: 'VERTICAL',
+      layoutGrow: boundary === 'fixed' ? 0 : 1,
+      layoutAlignSelf: 'STRETCH',
+      layoutPositioning: boundary === 'absolute' ? 'ABSOLUTE' : 'AUTO'
+    })
+    const text = graph.createNode('TEXT', area.id, {
+      x: 71,
+      y: 83,
+      width: 80,
+      height: 24,
+      text: 'Flow caption'
+    })
+    const absolute = graph.createNode('TEXT', area.id, {
+      x: 11,
+      y: 13,
+      width: 80,
+      height: 24,
+      text: 'Absolute caption',
+      layoutPositioning: 'ABSOLUTE'
+    })
+    const styles = await render(graph, root.id)
+    if (boundary === 'fixed') {
+      expect(styles(area.id)).toContain('align-self: stretch')
+      expect(styles(area.id)).not.toContain('width: 380px')
+      expect(styles(area.id)).not.toContain('position: absolute')
+    } else {
+      expect(styles(area.id)).toContain('width: 380px')
+      expect(styles(area.id)).toContain('position: absolute; left: 37px; top: 41px')
+    }
+    expect(styles(area.id)).toContain('height: 260px')
+    expect(styles(area.id)).not.toContain('flex-basis: 0px')
+    expect(styles(text.id)).not.toContain('position: absolute')
+    expect(styles(text.id)).not.toContain('left: 71px')
+    expect(styles(text.id)).not.toContain('top: 83px')
+    expect(styles(absolute.id)).toContain('position: absolute; left: 11px; top: 13px')
+  }
+)
+
+test('native flow preserves layer order above painted absolute siblings without promoting empty siblings', async () => {
+  const graph = new SceneGraph()
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 400,
+    height: 300,
+    layoutMode: 'VERTICAL',
+    primaryAxisSizing: 'HUG',
+    fills: []
+  })
+  const backdrop = graph.createNode('RECTANGLE', root.id, {
+    width: 400,
+    height: 300,
+    layoutPositioning: 'ABSOLUTE',
+    fills: [colorToFill(parseColor('#ff0000'))]
+  })
+  const caption = graph.createNode('TEXT', root.id, {
+    width: 80,
+    height: 24,
+    text: 'Above the backdrop'
+  })
+  expect((await render(graph, root.id))(caption.id)).toContain('position: relative')
+  graph.updateNode(backdrop.id, { fills: [] })
+  expect((await render(graph, root.id))(caption.id)).not.toContain('position: relative')
+})
+
+test.each([{ visible: false }, { internalOnly: true }])(
+  'a nonparticipating Fill child %j leaves the caption in auto-layout flow',
+  async (omitted) => {
+    const graph = new SceneGraph()
+    const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+      width: 400,
+      height: 300,
+      layoutMode: 'VERTICAL'
+    })
+    const hidden = graph.createNode('FRAME', root.id, {
+      width: 400,
+      height: 260,
+      layoutGrow: 1,
+      ...omitted
+    })
+    const caption = graph.createNode('TEXT', root.id, {
+      x: 71,
+      y: 83,
+      width: 80,
+      height: 24,
+      text: 'Flow caption'
+    })
+    const styles = await render(graph, root.id)
+    expect(() => styles(hidden.id)).toThrow(`Missing exported element ${hidden.id}`)
+    expect(styles(caption.id)).toContain('height: 24px')
+    expect(styles(caption.id)).not.toContain('position: absolute')
+    expect(styles(caption.id)).not.toContain('left: 71px')
+    expect(styles(caption.id)).not.toContain('top: 83px')
+  }
+)
