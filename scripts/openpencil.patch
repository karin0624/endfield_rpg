index 0000000000000000000000000000000000000000..cc34943fab9bec4680ac5c3f8be5df88c3ca3157
--- /dev/null
+++ b/packages/dom-css/src/export/native/index.ts
@@ -0,0 +1,576 @@
+import type {
+  DesignDocument,
+  DesignElement,
+  DesignNode,
+  DesignStyleDeclaration
+} from '#dom-css/types'
+import { compact } from 'es-toolkit/array'
+import { omit } from 'es-toolkit/object'
+
+import type { Fill, SceneGraph, SceneNode } from '@open-pencil/scene-graph'
+
+import { cssColor, effectsToCSS } from '../css'
+import { hugs } from '../projection'
+import { nativeSize } from './layout'
+import { nativeSurfaceOutline } from './outline'
+import { nativeScrollingContent } from './scroll'
+import { nativeText } from './text'
+
+/** Original image dimensions and optional decoded opacity; unknown opacity keeps ordinary layers. */
+export type ImageSizeResolver = (
+  hash: string
+) => { width: number; height: number; opaque?: boolean } | undefined
+
+function element(
+  tagName: string,
+  attrs: Record<string, string> = {},
+  children: DesignNode[] = [],
+  inlineStyle?: DesignStyleDeclaration
+): DesignElement {
+  return { type: 'element', tagName, attrs, children, inlineStyle }
+}
+
+function absoluteBox(node: SceneNode): DesignStyleDeclaration {
+  return {
+    position: 'absolute',
+    left: '0',
+    top: '0',
+    width: `${node.width}px`,
+    height: `${node.height}px`
+  }
+}
+
+function constrainedContent(
+  node: SceneNode,
+  definitions: DesignElement,
+  content: DesignNode[],
+  property: 'mask' | 'clip-path',
+  id: string
+): DesignElement[] {
+  return [
+    element('svg', { width: '0', height: '0', 'aria-hidden': 'true' }, [definitions], {
+      position: 'absolute',
+      width: '0',
+      height: '0'
+    }),
+    element('div', {}, content, { ...absoluteBox(node), [property]: `url(#${id})` })
+  ]
+}
+
+function clone(node: DesignNode): DesignNode {
+  return node.type === 'text'
+    ? { ...node }
+    : {
+        ...node,
+        attrs: { ...node.attrs },
+        inlineStyle: { ...node.inlineStyle },
+        children: node.children.map(clone)
+      }
+}
+
+function nativeNode(item: DesignElement): SceneNode {
+  if (!item.sourceSceneNode) throw new Error('HTML mask content requires a native scene node')
+  return item.sourceSceneNode
+}
+
+function placedSVG(item: DesignElement): DesignElement {
+  const native = nativeNode(item)
+  return {
+    ...item,
+    sourceSceneNode: undefined,
+    attrs: { ...item.attrs, x: String(native.x), y: String(native.y) },
+    inlineStyle: omit(item.inlineStyle ?? {}, [
+      'position',
+      'left',
+      'top',
+      'margin-left',
+      'margin-top'
+    ])
+  }
+}
+
+function coverPosition(node: SceneNode, fill: Fill, iw: number, ih: number): string | undefined {
+  const t = fill.imageTransform
+  if (t?.m01 !== 0 || t.m10 !== 0 || t.m00 <= 0 || t.m11 <= 0) return undefined
+  const { m00: a, m11: d, m02: e, m12: f } = t
+  const scale = Math.max(node.width / iw, node.height / ih)
+  // Kiwi stores paint matrices as float32. Recognize that exact wire representation
+  // as well as an in-memory double, without changing arbitrary authored crops.
+  const same = (actual: number, expected: number) =>
+    actual === expected || actual === Math.fround(expected)
+  if (!same(a, node.width / scale / iw) || !same(d, node.height / scale / ih)) return undefined
+  if ((a === 1 && e !== 0) || (d === 1 && f !== 0)) return undefined
+  return `${a === 1 ? 50 : (100 * e) / (1 - a)}% ${d === 1 ? 50 : (100 * f) / (1 - d)}%`
+}
+
+function cropImage(
+  projected: DesignElement,
+  node: SceneNode,
+  fill: Fill,
+  imageSize: ImageSizeResolver
+) {
+  if (fill.imageScaleMode !== 'CROP' || !fill.imageTransform) return
+  const { m00: a, m01: c, m02: e, m10: b, m11: d, m12: f } = fill.imageTransform
+  const style = (projected.inlineStyle ??= {})
+  if (a === 1 && d === 1 && b === 0 && c === 0 && e === 0 && f === 0) {
+    style['object-fit'] = 'fill'
+    return
+  }
+  const size = fill.imageHash && imageSize(fill.imageHash)
+  if (!size) throw new Error(`Cannot export image crop without image dimensions: ${node.id}`)
+  const { width: iw, height: ih } = size
+  const position = coverPosition(node, fill, iw, ih)
+  if (position) {
+    style['object-fit'] = 'cover'
+    style['object-position'] = position
+    return
+  }
+  const href = projected.attrs.src
+  projected.tagName = 'svg'
+  delete projected.attrs.src
+  delete style['object-fit']
+  delete style['aspect-ratio']
+  Object.assign(projected.attrs, {
+    xmlns: 'http://www.w3.org/2000/svg',
+    width: String(node.width),
+    height: String(node.height),
+    preserveAspectRatio: 'none'
+  })
+  if (b === 0 && c === 0 && a > 0 && d > 0) {
+    projected.attrs.viewBox = `0 0 ${iw * a} ${ih * d}`
+    projected.children = [
+      element('image', {
+        href,
+        x: String(-iw * e),
+        y: String(-ih * f),
+        width: String(iw),
+        height: String(ih),
+        preserveAspectRatio: 'none'
+      })
+    ]
+  } else {
+    const det = a * d - b * c
+    if (det === 0) throw new Error(`Singular image crop transform: ${node.id}`)
+    const matrix = [
+      (node.width * d) / det / iw,
+      (-node.height * b) / det / iw,
+      (-node.width * c) / det / ih,
+      (node.height * a) / det / ih,
+      (node.width * (c * f - d * e)) / det,
+      (node.height * (b * e - a * f)) / det
+    ]
+    projected.attrs.viewBox = `0 0 ${node.width} ${node.height}`
+    projected.children = [
+      element('image', {
+        href,
+        width: String(iw),
+        height: String(ih),
+        transform: `matrix(${matrix.join(' ')})`,
+        preserveAspectRatio: 'none'
+      })
+    ]
+  }
+}
+
+function paintedMasks(
+  masks: DesignElement[],
+  content: DesignNode[],
+  node: SceneNode,
+  id: string
+): DesignElement[] {
+  const types = new Set(masks.map((mask) => nativeNode(mask).maskType))
+  if (types.size !== 1 || types.has('VECTOR'))
+    throw new Error(`HTML export does not support mixed vector/paint masks: ${node.id}`)
+  const type = nativeNode(masks[0]).maskType
+  if (type === 'LUMINANCE' && masks.length > 1)
+    throw new Error(`HTML export requires one luminance mask per mask group: ${node.id}`)
+  const definitions: DesignNode[] = []
+  const place = (item: DesignElement): DesignElement => {
+    const native = nativeNode(item)
+    if (item.tagName !== 'svg' || native.rotation !== 0 || native.skew !== 0)
+      throw new Error(`HTML export requires an unrotated SVG paint mask: ${native.id}`)
+    const children = item.children.filter((child) => {
+      if (child.type !== 'element' || child.tagName !== 'defs') return true
+      definitions.push(...child.children)
+      return false
+    })
+    return {
+      ...placedSVG(item),
+      children
+    }
+  }
+  const paints = masks.map(place)
+  const region = {
+    x: '0',
+    y: '0',
+    width: String(node.width),
+    height: String(node.height),
+    maskUnits: 'userSpaceOnUse',
+    maskContentUnits: 'userSpaceOnUse'
+  }
+  if (type === 'LUMINANCE') {
+    // Figma luminance masks multiply luminance by the painted alpha twice.
+    // An SVG luminance mask supplies the first multiplication; its alpha mask supplies the other.
+    const alphaId = `${id}-alpha`
+    definitions.push(
+      element('mask', { id: alphaId, ...region, 'mask-type': 'alpha' }, paints.map(clone))
+    )
+    definitions.push(
+      element('mask', { id, ...region, 'mask-type': 'luminance' }, [
+        element('g', { mask: `url(#${alphaId})` }, paints)
+      ])
+    )
+  } else definitions.push(element('mask', { id, ...region, 'mask-type': 'alpha' }, paints))
+  const defs = element('defs', {}, definitions)
+  if (
+    content.every(
+      (item): item is DesignElement => item.type === 'element' && item.tagName === 'svg'
+    )
+  ) {
+    const children = content.map(placedSVG)
+    return [
+      element(
+        'svg',
+        {
+          width: String(node.width),
+          height: String(node.height),
+          viewBox: `0 0 ${node.width} ${node.height}`
+        },
+        [defs, element('g', { mask: `url(#${id})` }, children)],
+        absoluteBox(node)
+      )
+    ]
+  }
+  return constrainedContent(node, defs, content, 'mask', id)
+}
+
+function maskGeometry(mask: DesignElement, native: SceneNode): DesignElement[] {
+  if (mask.tagName === 'svg')
+    return mask.children.filter((shape): shape is DesignElement => shape.type === 'element')
+  if (native.type === 'ELLIPSE')
+    return [
+      element('ellipse', {
+        cx: String(native.width / 2),
+        cy: String(native.height / 2),
+        rx: String(native.width / 2),
+        ry: String(native.height / 2)
+      })
+    ]
+  if (native.type === 'RECTANGLE' && !native.independentCorners)
+    return [
+      element('rect', {
+        width: String(native.width),
+        height: String(native.height),
+        rx: String(native.cornerRadius),
+        ry: String(native.cornerRadius)
+      })
+    ]
+  throw new Error(`HTML export requires SVG mask geometry: ${native.id}`)
+}
+
+/** Keep native masks as editable SVG clipping or paint geometry, not images. */
+function clipChildren(projected: DesignElement, node: SceneNode) {
+  const children = projected.children
+  const result: DesignNode[] = []
+  for (let i = 0; i < children.length; i++) {
+    const child = children[i]
+    if (child.type !== 'element' || !child.sourceSceneNode?.isMask) {
+      result.push(child)
+      continue
+    }
+    const masks: DesignElement[] = []
+    while (i < children.length) {
+      const mask = children[i]
+      if (mask.type !== 'element' || !mask.sourceSceneNode?.isMask) break
+      masks.push(mask)
+      i++
+    }
+    const content: DesignNode[] = []
+    while (i < children.length) {
+      const next = children[i]
+      if (next.type === 'element' && next.sourceSceneNode?.isMask) break
+      content.push(next)
+      i++
+    }
+    i--
+    if (!content.length) continue
+    const id = `op-mask-${node.id.replace(/[^A-Za-z0-9-]/gu, (char) => `_${char.codePointAt(0)?.toString(16)}_`)}-${result.length}`
+    if (masks.some((mask) => nativeNode(mask).maskType !== 'VECTOR')) {
+      result.push(...paintedMasks(masks, content, node, id))
+      continue
+    }
+    const shapes = masks.flatMap((mask) => {
+      const native = nativeNode(mask)
+      if (native.maskType !== 'VECTOR' || native.rotation !== 0 || native.skew !== 0)
+        throw new Error(`HTML export requires an unrotated vector mask: ${native.id}`)
+      return maskGeometry(mask, native).map((shape) => ({
+        ...shape,
+        attrs: {
+          ...shape.attrs,
+          transform: `translate(${native.x} ${native.y})${shape.attrs.transform ? ` ${shape.attrs.transform}` : ''}`
+        }
+      }))
+    })
+    const definitions = element('defs', {}, [
+      element('clipPath', { id, clipPathUnits: 'userSpaceOnUse' }, shapes)
+    ])
+    if (
+      content.every(
+        (item): item is DesignElement => item.type === 'element' && item.tagName === 'svg'
+      )
+    ) {
+      const svgContent = content.map(placedSVG)
+      const nativeMasks = masks.map(nativeNode)
+      const x = Math.min(...nativeMasks.map((mask) => mask.x)),
+        y = Math.min(...nativeMasks.map((mask) => mask.y))
+      const right = Math.max(...nativeMasks.map((mask) => mask.x + mask.width)),
+        bottom = Math.max(...nativeMasks.map((mask) => mask.y + mask.height))
+      const boundsId = `${id}-bounds`
+      // Blink represents a path clip together with its precise antialiased bounds.
+      definitions.children.push(
+        element('clipPath', { id: boundsId, clipPathUnits: 'userSpaceOnUse' }, [
+          element('rect', {
+            x: String(x),
+            y: String(y),
+            width: String(right - x),
+            height: String(bottom - y)
+          })
+        ])
+      )
+      result.push(
+        element(
+          'svg',
+          {
+            width: String(node.width),
+            height: String(node.height),
+            viewBox: `0 0 ${node.width} ${node.height}`
+          },
+          [
+            definitions,
+            element('g', { 'clip-path': `url(#${boundsId})` }, [
+              element('g', { 'clip-path': `url(#${id})` }, svgContent)
+            ])
+          ],
+          absoluteBox(node)
+        )
+      )
+    } else {
+      result.push(...constrainedContent(node, definitions, content, 'clip-path', id))
+    }
+  }
+  projected.children = result
+}
+
+function nativeBlur(style: DesignStyleDeclaration, node: SceneNode) {
+  const blur = node.effects.findLast(
+    (effect) =>
+      effect.visible && (effect.type === 'LAYER_BLUR' || effect.type === 'FOREGROUND_BLUR')
+  )
+  if (blur && style.filter)
+    style.filter = style.filter.replace(`blur(${blur.radius}px)`, `blur(${blur.radius / 2}px)`)
+  const backdrop = node.effects.findLast(
+    (effect) => effect.visible && effect.type === 'BACKGROUND_BLUR'
+  )
+  if (backdrop && style['backdrop-filter'])
+    style['backdrop-filter'] = `blur(${backdrop.radius / 2}px)`
+}
+
+function nativeFrame(
+  projected: DesignElement,
+  node: SceneNode,
+  graph: SceneGraph,
+  fill: Fill | undefined,
+  viewport: boolean
+) {
+  const style = (projected.inlineStyle ??= {})
+  nativeScrollingContent(style, node, graph)
+  if (
+    projected.tagName === 'img' &&
+    fill?.type === 'IMAGE' &&
+    node.scrollBehavior === 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME'
+  )
+    style['will-change'] = 'transform'
+  // A fixed layer stays anchored to its native frame, rather than to the exported page.
+  if (
+    !viewport &&
+    node.childIds.some(
+      (id) => graph.getNode(id)?.scrollBehavior === 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME'
+    )
+  )
+    style.contain = 'layout'
+  if (node.blendMode === 'NORMAL' && node.childIds.length) style.isolation = 'isolate'
+}
+
+function nativeVector(
+  projected: DesignElement,
+  node: SceneNode,
+  graph: SceneGraph,
+  roots: ReadonlySet<string>
+) {
+  if (projected.tagName !== 'svg' || node.type !== 'VECTOR' || node.isMask) return
+  let x = node.x,
+    y = node.y
+  let ancestor = node.parentId ? graph.getNode(node.parentId) : undefined
+  let unrotated = node.rotation === 0 && node.skew === 0
+  while (ancestor && !roots.has(ancestor.id)) {
+    unrotated &&= ancestor.rotation === 0 && ancestor.skew === 0
+    x += ancestor.x
+    y += ancestor.y
+    ancestor = ancestor.parentId ? graph.getNode(ancestor.parentId) : undefined
+  }
+  if (!unrotated) return
+  // An integer SVG viewport preserves fractional path geometry instead of letting Blink
+  // pixel-snap a tight fractional SVG box and scale the drawing inside it.
+  const fx = x - Math.floor(x),
+    fy = y - Math.floor(y)
+  const width = Math.ceil(node.width + fx),
+    height = Math.ceil(node.height + fy)
+  Object.assign(projected.attrs, {
+    width: String(width),
+    height: String(height),
+    viewBox: `${-fx} ${-fy} ${width} ${height}`
+  })
+  Object.assign((projected.inlineStyle ??= {}), {
+    width: `${width}px`,
+    height: `${height}px`,
+    'margin-left': `${-fx}px`,
+    'margin-top': `${-fy}px`
+  })
+}
+
+function paintsSurface(node: SceneNode): boolean {
+  return (
+    node.fills.some(
+      (paint) => paint.visible && paint.opacity > 0 && (paint.type !== 'SOLID' || paint.color.a > 0)
+    ) || node.strokes.some((paint) => paint.visible && paint.opacity > 0)
+  )
+}
+
+function nativeShadows(projected: DesignElement, node: SceneNode, fill: Fill | undefined) {
+  const shadows = node.effects.filter((effect) => effect.visible && effect.type === 'DROP_SHADOW')
+  if (!shadows.length || (fill?.type !== 'IMAGE' && (paintsSurface(node) || !node.childIds.length)))
+    return
+  if (shadows.some((effect) => effect.spread !== 0))
+    throw new Error(`HTML alpha-shaped shadows do not support spread: ${node.id}`)
+  const style = (projected.inlineStyle ??= {})
+  const remaining = effectsToCSS(node.effects.filter((effect) => effect.type !== 'DROP_SHADOW'))
+  if (remaining['box-shadow']) style['box-shadow'] = remaining['box-shadow']
+  else delete style['box-shadow']
+  const filters = shadows.map(
+    (effect) =>
+      `drop-shadow(${effect.offset.x}px ${effect.offset.y}px ${effect.radius / 2}px ${cssColor(effect.color)})`
+  )
+  style.filter = compact([style.filter, ...filters]).join(' ')
+}
+
+function strokeInset(node: SceneNode, weight: number): number {
+  if (node.strokeAlign === 'INSIDE') return weight
+  return node.strokeAlign === 'CENTER' ? weight / 2 : 0
+}
+
+export function nativeInsideBorder(
+  parent: DesignElement | undefined,
+  side: 'left' | 'top' | 'right' | 'bottom'
+): number {
+  const owner = parent?.sourceSceneNode
+  const style = parent?.inlineStyle
+  if (owner?.strokeAlign !== 'INSIDE' || (!style?.border && !style?.['border-style'])) return 0
+  if (!owner.independentStrokeWeights)
+    return owner.strokes.find((paint) => paint.visible)?.weight ?? 0
+  return {
+    left: owner.borderLeftWeight,
+    top: owner.borderTopWeight,
+    right: owner.borderRightWeight,
+    bottom: owner.borderBottomWeight
+  }[side]
+}
+
+function nativeStroke(projected: DesignElement, node: SceneNode, tokens: DesignDocument['tokens']) {
+  const style = (projected.inlineStyle ??= {})
+  if (projected.tagName === 'svg' || !style.border || node.independentStrokeWeights) return
+  const stroke = node.strokes.find((paint) => paint.visible)
+  if (!stroke) return
+  const variable = tokens?.names.get(node.boundVariables['strokes/0/color'])
+  const color = variable ? `var(--${variable})` : cssColor({ ...stroke.color, a: stroke.opacity })
+  const dashed =
+    node.dashPattern.length === 2 &&
+    node.dashPattern[0] === stroke.weight * 3 &&
+    node.dashPattern[1] === stroke.weight * 2
+  const border = `${stroke.weight}px ${dashed ? 'dashed' : 'solid'} ${color}`
+  if (node.strokeAlign === 'INSIDE' && !dashed && projected.tagName !== 'img') {
+    style.border = border
+  } else if (node.strokeAlign === 'INSIDE' && !dashed) {
+    const shadow = `inset 0 0 0 ${stroke.weight}px ${color}`
+    style['box-shadow'] = style['box-shadow'] ? `${style['box-shadow']},${shadow}` : shadow
+    delete style.border
+  } else {
+    style.outline = border
+    style['outline-offset'] = `${-strokeInset(node, stroke.weight)}px`
+    delete style.border
+  }
+  delete style['border-color']
+  delete style['border-style']
+}
+
+function nativeOverflow(style: DesignStyleDeclaration, node: SceneNode) {
+  if (node.overflowDirection === 'NONE') return
+  const horizontal = node.overflowDirection === 'HORIZONTAL' || node.overflowDirection === 'BOTH'
+  const vertical = node.overflowDirection === 'VERTICAL' || node.overflowDirection === 'BOTH'
+  const fallback = node.clipsContent ? 'hidden' : 'visible'
+  delete style.overflow
+  style['overflow-x'] = horizontal ? 'auto' : fallback
+  style['overflow-y'] = vertical ? 'auto' : fallback
+}
+
+/**
+ * Paint native geometry for a standalone export. Fixed layers use measured geometry;
+ * native HUG and scrolling auto layout retain content flow.
+ */
+export function nativeStandaloneDocument(
+  document: DesignDocument,
+  imageSize: ImageSizeResolver
+): DesignDocument {
+  const graph = document.sourceGraph
+  if (!graph) return document
+  const roots = new Set(
+    document.children.flatMap((node) =>
+      node.type === 'element' && node.sourceSceneNode ? [node.sourceSceneNode.id] : []
+    )
+  )
+  const result = { ...document, children: document.children.map(clone) }
+  const visit = (projected: DesignNode) => {
+    if (projected.type !== 'element') return
+    projected.children.forEach(visit)
+    const node = projected.sourceSceneNode
+    if (!node) return
+    const style = (projected.inlineStyle ??= {})
+    if (node.blendMode !== 'NORMAL' && node.blendMode !== 'PASS_THROUGH')
+      style['mix-blend-mode'] = node.blendMode.toLowerCase().replaceAll('_', '-')
+    nativeBlur(style, node)
+    nativeSize(style, node, graph)
+    nativeText(projected, node)
+    const fill = node.fills.find((paint) => paint.visible)
+    if (fill?.type === 'IMAGE') {
+      cropImage(projected, node, fill, imageSize)
+      // Paint alpha enters the effect stack; layer opacity is applied after its effects.
+      if (fill.opacity !== 1)
+        style.filter = `opacity(${fill.opacity})${style.filter ? ` ${style.filter}` : ''}`
+    }
+    const viewport =
+      roots.size === 1 &&
+      roots.has(node.id) &&
+      node.type === 'FRAME' &&
+      node.overflowDirection === 'NONE' &&
+      !hugs(node, 'width') &&
+      !hugs(node, 'height')
+    nativeFrame(projected, node, graph, fill, viewport)
+    nativeVector(projected, node, graph, roots)
+    nativeShadows(projected, node, fill)
+    nativeStroke(projected, node, document.tokens)
+    nativeOverflow(style, node)
+    clipChildren(projected, node)
+    nativeSurfaceOutline(projected, document)
+  }
+  result.children.forEach(visit)
+  return result
+}
