index 0000000000000000000000000000000000000000..a5675eac46eb499ab201cf3e899551116d944cc2
--- /dev/null
+++ b/packages/core/tests/canvas/gradient-degenerate.test.ts
@@ -0,0 +1,171 @@
+import { expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+import type { Fill } from '@open-pencil/scene-graph'
+
+import { SkiaRenderer } from '#core/canvas/renderer'
+import { getCanvasKit } from '#core/canvaskit'
+
+const gradient: Fill = {
+  type: 'GRADIENT_LINEAR',
+  color: { r: 0, g: 0, b: 0, a: 1 },
+  opacity: 1,
+  visible: true,
+  gradientStops: [
+    { position: 0, color: { r: 1, g: 0, b: 0, a: 1 } },
+    { position: 1, color: { r: 0, g: 0, b: 1, a: 1 } }
+  ],
+  gradientTransform: { m00: 1, m01: 0, m02: 0, m10: 0, m11: 1, m12: 0 }
+}
+
+for (const [width, height] of [
+  [0, 6],
+  [6, 0],
+  [0, 0]
+]) {
+  test(`a ${width} × ${height} gradient rectangle paints no area and allows subsequent fills`, async () => {
+    const ck = await getCanvasKit()
+    const surface = expectDefined(ck.MakeSurface(32, 32), 'surface')
+    const renderer = new SkiaRenderer(ck, surface)
+    const graph = new SceneGraph()
+    const page = expectDefined(graph.getPages()[0], 'page')
+    const node = graph.createNode('RECTANGLE', page.id, {
+      width,
+      height,
+      fills: [gradient]
+    })
+    try {
+      const canvas = surface.getCanvas()
+      canvas.clear(ck.TRANSPARENT)
+      renderer.renderShapeUncached(canvas, node, graph)
+      surface.flush()
+      const image = surface.makeImageSnapshot()
+      try {
+        const pixels = expectDefined(
+          image.readPixels(0, 0, {
+            width: 32,
+            height: 32,
+            colorType: ck.ColorType.RGBA_8888,
+            alphaType: ck.AlphaType.Unpremul,
+            colorSpace: ck.ColorSpace.SRGB
+          }),
+          'pixels'
+        )
+        expect(pixels.every((value) => value === 0)).toBe(true)
+      } finally {
+        image.delete()
+      }
+      node.width = 32
+      node.height = 32
+      renderer.renderShapeUncached(canvas, node, graph)
+      surface.flush()
+      const filled = surface.makeImageSnapshot()
+      try {
+        const pixels = expectDefined(
+          filled.readPixels(0, 0, {
+            width: 32,
+            height: 32,
+            colorType: ck.ColorType.RGBA_8888,
+            alphaType: ck.AlphaType.Unpremul,
+            colorSpace: ck.ColorSpace.SRGB
+          }),
+          'pixels'
+        )
+        expect(pixels[3]).toBe(255)
+        expect(pixels[0]).toBeGreaterThan(240)
+        expect(pixels[31 * 4 + 2]).toBeGreaterThan(240)
+      } finally {
+        filled.delete()
+      }
+    } finally {
+      renderer.destroy()
+    }
+  })
+}
+
+for (const vertical of [false, true]) {
+  test(`a ${vertical ? 'vertical' : 'horizontal'} gradient line retains its visible stroke`, async () => {
+    const ck = await getCanvasKit()
+    const surface = expectDefined(ck.MakeSurface(32, 32), 'surface')
+    const renderer = new SkiaRenderer(ck, surface)
+    const graph = new SceneGraph()
+    const page = expectDefined(graph.getPages()[0], 'page')
+    const fill: Fill = vertical
+      ? {
+          ...gradient,
+          gradientTransform: {
+            m00: 0,
+            m01: 1,
+            m02: 0,
+            m10: -1,
+            m11: 0,
+            m12: 1
+          }
+        }
+      : gradient
+    const node = graph.createNode('LINE', page.id, {
+      width: vertical ? 0 : 32,
+      height: vertical ? 32 : 0,
+      fills: [],
+      strokes: [{ ...fill, weight: 4, align: 'CENTER' }]
+    })
+    try {
+      const canvas = surface.getCanvas()
+      canvas.clear(ck.TRANSPARENT)
+      canvas.translate(vertical ? 16 : 0, vertical ? 0 : 16)
+      renderer.renderShapeUncached(canvas, node, graph)
+      surface.flush()
+      const image = surface.makeImageSnapshot()
+      try {
+        const pixels = expectDefined(
+          image.readPixels(0, 0, {
+            width: 32,
+            height: 32,
+            colorType: ck.ColorType.RGBA_8888,
+            alphaType: ck.AlphaType.Unpremul,
+            colorSpace: ck.ColorSpace.SRGB
+          }),
+          'pixels'
+        )
+        const start = (vertical ? 16 : 16 * 32) * 4
+        const end = (vertical ? 31 * 32 + 16 : 16 * 32 + 31) * 4
+        expect(pixels[start + 3]).toBe(255)
+        expect(pixels[start]).toBeGreaterThan(240)
+        expect(pixels[end + 2]).toBeGreaterThan(240)
+      } finally {
+        image.delete()
+      }
+    } finally {
+      renderer.destroy()
+    }
+  })
+}
+
+test('CanvasKit rejects only singular dimension matrices at the collapsed-axis boundary', async () => {
+  const ck = await getCanvasKit()
+  const colors = [ck.Color4f(1, 0, 0, 1), ck.Color4f(0, 0, 1, 1)]
+  for (const [width, height] of [
+    [0, 6],
+    [6, 0],
+    [0, 0],
+    [0.25, 6],
+    [6, 0.25],
+    [6, 6]
+  ]) {
+    const shader = ck.Shader.MakeLinearGradient(
+      [0, 0.5],
+      [1, 0.5],
+      colors,
+      [0, 1],
+      ck.TileMode.Clamp,
+      ck.Matrix.scaled(width, height)
+    )
+    try {
+      expect(Boolean(shader)).toBe(width !== 0 && height !== 0)
+    } finally {
+      shader?.delete()
+    }
+  }
+})
