+test('switching outer variants retains explicit nested properties and follows unedited defaults', async () => {
+  const initial = setup()
+  initial.owner.name = 'state=first'
+  const second = initial.api.createComponent()
+  second.name = 'state=second'
+  const secondInput = initial.input.createInstance()
+  secondInput.name = initial.source.name
+  second.appendChild(secondInput)
+  secondInput.isExposedInstance = true
+  secondInput.setProperties({ [initial.labelProperty]: 'Second default' })
+  initial.api.combineAsVariants([initial.owner, second], initial.api.currentPage)
+  const untouched = initial.owner.createInstance()
+  untouched.name = 'Untouched'
+  const outside = initial.api.createComponent()
+  outside.name = 'Outside variant set'
+  const outsideInput = initial.input.createInstance()
+  outsideInput.name = initial.source.name
+  outside.appendChild(outsideInput)
+  outsideInput.isExposedInstance = true
+  outsideInput.setProperties({ [initial.labelProperty]: 'Outside default' })
+  const edited = exposedInput(initial.instance)
+  edited.setProperties({
+    [initial.labelProperty]: 'Edited target',
+    [initial.focusProperty]: true
+  })
+  initial.instance.setProperties({ state: 'second' })
+  expectValues(initial.instance, 'Edited target', true)
+  initial.instance.setProperties({ state: 'first' })
+  let api = initial.api
+  let instance = initial.instance
+  for (let pass = 0; pass < 2; pass++) {
+    const fresh = await reopen(api)
+    api = fresh.api
+    instance = fresh.instance
+    expectValues(instance, 'Edited target', true)
+    instance.setProperties({ state: 'second' })
+    expectValues(instance, 'Edited target', true)
+    syncComponents(api)
+    expectValues(instance, 'Edited target', true)
+    instance.setProperties({ state: 'first' })
+    expectValues(instance, 'Edited target', true)
+  }
+  const unedited = [...api.graph.getAllNodes()].find((node) => node.name === 'Untouched')
+  if (!unedited) throw new Error('Missing untouched instance')
+  const uneditedProxy = asInstanceNode(api.wrapNode(unedited.id))
+  uneditedProxy.setProperties({ state: 'second' })
+  expectValues(uneditedProxy, 'Second default', false)
+  const destination = [...api.graph.getAllNodes()].find((node) => node.name === outside.name)
+  if (!destination) throw new Error('Missing outside component')
+  api.graph.swapInstanceComponent(instance.id, destination.id)
+  expectValues(instance, 'Outside default', false)
+})
