@@ -0,0 +1,191 @@
+import { describe, expect, test } from 'bun:test'
+
+import { exportFigFile, parseFigFile } from '@open-pencil/core'
+import { FigmaAPI, type FigmaReaction } from '@open-pencil/core/figma-api'
+import { parseFigBuffer } from '@open-pencil/fig'
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+function setup() {
+  const graph = new SceneGraph(),
+    figma = new FigmaAPI(graph)
+  const screen = figma.createFrame()
+  screen.name = 'Screen'
+  const trigger = figma.wrapNode(figma.createRectangle().id)
+  trigger.name = 'Trigger'
+  screen.appendChild(trigger)
+  const overlay = figma.createFrame()
+  overlay.name = 'Overlay'
+  screen.appendChild(overlay)
+  graph.updateNode(overlay.id, {
+    overlayPositionType: 'MANUAL',
+    overlayBackgroundInteraction: 'CLOSE_ON_CLICK_OUTSIDE',
+    overlayBackground: { type: 'SOLID_COLOR', color: { r: 0.25, g: 0.5, b: 0.75 }, opacity: 0.5 }
+  })
+  return { graph, figma, screen, trigger, overlay }
+}
+const reaction = (destinationId: string): FigmaReaction => ({
+  trigger: { type: 'ON_CLICK' },
+  actions: [
+    {
+      type: 'NODE',
+      destinationId,
+      navigation: 'OVERLAY',
+      transition: null,
+      overlayRelativePosition: { x: 115, y: 428 }
+    }
+  ]
+})
+const named = (graph: SceneGraph, name: string) => {
+  const matches = [...graph.getAllNodes()].filter((node) => node.name === name)
+  expect(matches).toHaveLength(1)
+  return matches[0]
+}
+const reopen = async (graph: SceneGraph) => {
+  const bytes = await exportFigFile(graph)
+  return { graph: await parseFigFile(bytes.buffer as ArrayBuffer, { populate: 'all' }), bytes }
+}
+
+describe('standard prototype overlays', () => {
+  test('normal saves and geometry edits preserve public overlay data and ordinary destinations', async () => {
+    const { trigger, overlay, graph: initial } = setup()
+    let graph = initial
+    await trigger.setReactionsAsync([reaction(overlay.id)])
+    expect(Reflect.set(overlay, 'overlayPositionType', 'CENTER')).toBe(false)
+    for (let cycle = 0; cycle < 3; cycle++) {
+      const result = await reopen(graph)
+      graph = result.graph
+      const figma = new FigmaAPI(graph)
+      const trigger = figma.wrapNode(named(graph, 'Trigger').id),
+        overlay = figma.wrapNode(named(graph, 'Overlay').id)
+      expect(trigger.reactions).toEqual([reaction(overlay.id)])
+      expect(overlay.overlayPositionType).toBe('MANUAL')
+      expect(overlay.overlayBackgroundInteraction).toBe('CLOSE_ON_CLICK_OUTSIDE')
+      expect(overlay.overlayBackground).toEqual({
+        type: 'SOLID_COLOR',
+        color: { r: 0.25, g: 0.5, b: 0.75 },
+        opacity: 0.5
+      })
+      const wire = parseFigBuffer(new Uint8Array(result.bytes).buffer).nodeChanges.find(
+        (node) => node.name === 'Overlay'
+      )
+      expect(wire?.overlayPositionType).toBe('MANUAL')
+      expect(wire?.overlayBackgroundInteraction).toBe('CLOSE_ON_CLICK_OUTSIDE')
+      overlay.resize(100 + cycle, 40)
+    }
+  })
+
+  test('composed frame cloning redirects only internal destinations to the copied frame', async () => {
+    const { screen, trigger, overlay, graph: initial } = setup()
+    let graph = initial
+    await trigger.setReactionsAsync([reaction(overlay.id)])
+    const clone = screen.clone()
+    clone.name = 'Screen copy'
+    const copiedTrigger = clone.children.find((child) => child.name === 'Trigger')
+    const copiedOverlay = clone.children.find((child) => child.name === 'Overlay')
+    if (!copiedTrigger || !copiedOverlay) throw new Error('Missing cloned nodes')
+    expect(copiedTrigger.reactions).toEqual([reaction(copiedOverlay.id)])
+    expect(trigger.reactions).toEqual([reaction(overlay.id)])
+    copiedOverlay.name = 'Overlay copy'
+    copiedTrigger.name = 'Trigger copy'
+    graph = (await reopen(graph)).graph
+    const figma = new FigmaAPI(graph)
+    expect(figma.wrapNode(named(graph, 'Trigger copy').id).reactions).toEqual([
+      reaction(named(graph, 'Overlay copy').id)
+    ])
+    expect(figma.wrapNode(named(graph, 'Overlay copy').id).overlayPositionType).toBe('MANUAL')
+  })
+
+  test('instance and nested-node reactions override the main through normal saves and screen cloning', async () => {
+    let { graph, figma, screen, overlay } = setup()
+    const button = figma.createComponent()
+    button.name = 'Button main'
+    const label = figma.wrapNode(figma.createRectangle().id)
+    label.name = 'Label'
+    button.appendChild(label)
+    const placed = button.createInstance()
+    placed.name = 'Placed button'
+    screen.appendChild(placed)
+    const child = placed.children[0]
+    if (!child) throw new Error('Missing instance child')
+    await figma.wrapNode(placed.id).setReactionsAsync([reaction(overlay.id)])
+    await figma.wrapNode(child.id).setReactionsAsync([reaction(overlay.id)])
+    for (let cycle = 0; cycle < 3; cycle++) {
+      graph = (await reopen(graph)).graph
+      figma = new FigmaAPI(graph)
+      const current = figma.wrapNode(named(graph, 'Placed button').id)
+      const nested = current.children?.[0]
+      overlay = figma.wrapNode(named(graph, 'Overlay').id) as typeof overlay
+      expect(current.reactions).toEqual([reaction(overlay.id)])
+      expect(nested?.reactions).toEqual([reaction(overlay.id)])
+      expect(figma.wrapNode(named(graph, 'Button main').id).reactions).toEqual([])
+      const mainChild = graph.getChildren(named(graph, 'Button main').id)[0]
+      expect(figma.wrapNode(mainChild.id).reactions).toEqual([])
+      screen = figma.wrapNode(named(graph, 'Screen').id) as typeof screen
+      const clone = screen.clone()
+      const copiedButton = clone.children.find((node) => node.name === 'Placed button')
+      const copiedOverlay = clone.children.find((node) => node.name === 'Overlay')
+      if (!copiedButton || !copiedOverlay) throw new Error('Missing copied prototype nodes')
+      expect(copiedButton.reactions).toEqual([reaction(copiedOverlay.id)])
+      const copiedChildren = figma.wrapNode(copiedButton.id).children
+      expect(copiedChildren?.[0]?.reactions).toEqual([reaction(copiedOverlay.id)])
+      clone.remove()
+    }
+  })
+
+  test('unsupported edits reject atomically and getters return independent values', async () => {
+    const { trigger, overlay } = setup()
+    await trigger.setReactionsAsync([reaction(overlay.id)])
+    const read = trigger.reactions
+    const firstAction = read[0].actions[0]
+    if (!firstAction) throw new Error('Missing action')
+    firstAction.destinationId = 'unrelated'
+    expect(trigger.reactions).toEqual([reaction(overlay.id)])
+    await expect(
+      trigger.setReactionsAsync([{ trigger: { type: 'ON_HOVER' }, actions: [] }])
+    ).rejects.toThrow('Unsupported prototype reaction')
+    await expect(trigger.setReactionsAsync([reaction('missing')])).rejects.toThrow(
+      'Missing prototype overlay frame'
+    )
+    const invalid = reaction(overlay.id)
+    const invalidAction = invalid.actions[0]
+    if (!invalidAction?.overlayRelativePosition) throw new Error('Missing position')
+    invalidAction.overlayRelativePosition.x = Number.NaN
+    await expect(trigger.setReactionsAsync([invalid])).rejects.toThrow(
+      'Invalid prototype overlay position'
+    )
+    expect(trigger.reactions).toEqual([reaction(overlay.id)])
+  })
+
+  test('unsupported imported actions survive normal edits and saves until explicitly replaced', async () => {
+    let { graph, trigger } = setup()
+    const raw = [
+      {
+        event: { interactionType: 'AFTER_TIMEOUT', transitionTimeout: 2 },
+        actions: [{ connectionType: 'URL', connectionURL: 'https://example.com/' }]
+      }
+    ]
+    const node = graph.getNode(trigger.id)
+    if (!node) throw new Error('Missing trigger')
+    graph.updateNode(node.id, {
+      reactions: null,
+      source: {
+        ...node.source,
+        fig: {
+          ...node.source.fig,
+          rawNodeFields: { ...node.source.fig.rawNodeFields, prototypeInteractions: raw }
+        }
+      }
+    })
+    for (let cycle = 0; cycle < 2; cycle++) {
+      graph = (await reopen(graph)).graph
+      const current = new FigmaAPI(graph).wrapNode(named(graph, 'Trigger').id)
+      trigger = current as typeof trigger
+      expect(() => current.reactions).toThrow('unsupported prototype reaction')
+      expect(graph.getNode(trigger.id)?.source.fig.rawNodeFields.prototypeInteractions).toEqual(raw)
+      trigger.resize(100 + cycle, 30)
+    }
+    await trigger.setReactionsAsync([])
+    graph = (await reopen(graph)).graph
+    expect(new FigmaAPI(graph).wrapNode(named(graph, 'Trigger').id).reactions).toEqual([])
+  })
+})
