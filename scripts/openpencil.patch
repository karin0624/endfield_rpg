+import { expect, test } from 'bun:test'
+
+import { fontFaceStylesheet } from '#dom-css/export/bundle'
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+import type { WebFontFaceAsset } from '#dom-css/export/index'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+const assets: WebFontFaceAsset[] = ['Physical Serif', 'Physical Sans'].map((family, index) => ({
+  family,
+  weight: 400,
+  style: 'normal',
+  format: 'truetype',
+  path: `assets/fonts/face-${index}.ttf`,
+  content: new Uint8Array([0, 1, 0, 0])
+}))
+
+test('standalone font files preserve installed faces and ship separate embedded fallbacks', async () => {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  if (!page) throw new Error('Missing document page')
+  const frame = graph.createNode('FRAME', page.id, { width: 200, height: 80 })
+  const text = graph.createNode('TEXT', frame.id, {
+    text: 'English日本語',
+    fontFamily: 'Physical Serif',
+    fontWeight: 400,
+    width: 200,
+    height: 40,
+    styleRuns: [{ start: 7, length: 3, style: { fontFamily: 'Physical Sans' } }]
+  })
+  for (const mode of ['inline', 'external'] as const) {
+    const result = await exportHTMLBundle(sceneNodeToDesignDocument(graph, frame.id), {
+      html: 'standalone',
+      assets: mode,
+      fonts: async () => assets
+    })
+    const output = result.files
+      .filter((file) => typeof file.content === 'string')
+      .map((file) => file.content)
+      .join('')
+    expect(output).toContain('"Physical Serif","__open-pencil-embedded__Physical Serif"')
+    expect(output).toContain('"__open-pencil-embedded__Physical Sans","Physical Sans"')
+    expect(output).toMatch(
+      /@font-face\s*\{\s*font-family: "__open-pencil-embedded__Physical Serif";/
+    )
+    expect(output).not.toMatch(/@font-face\s*\{\s*font-family: "Physical Serif";/)
+    if (mode === 'external') {
+      expect(result.files.find((file) => file.path === assets[0].path)?.content).toEqual(
+        assets[0].content
+      )
+    } else {
+      expect(result.files).toHaveLength(1)
+      expect(output).toContain('data:font/ttf;base64,AAEAAA==')
+    }
+  }
+  expect(text.fontFamily).toBe('Physical Serif')
+  expect(text.styleRuns[0]?.style.fontFamily).toBe('Physical Sans')
+})
+
+test('standalone fonts none and public font stylesheet keep their existing contract', async () => {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  if (!page) throw new Error('Missing document page')
+  const text = graph.createNode('TEXT', page.id, {
+    text: 'Text',
+    fontFamily: 'Physical Serif'
+  })
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, text.id), {
+    html: 'standalone',
+    fonts: 'none'
+  })
+  expect(String(bundle.files[0]?.content)).not.toContain('__open-pencil-embedded__')
+  const css = await fontFaceStylesheet(assets, { from: 'assets' })
+  expect(css).toContain('font-family: "Physical Serif"')
+  expect(css).not.toContain('__open-pencil-embedded__')
+})
