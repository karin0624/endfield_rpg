+import { beforeAll, expect, test } from 'bun:test'
+
+import { exportFigFile, FigmaAPI, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { parseColor } from '@open-pencil/scene-graph/color'
+
+import { renderNodesToHTML } from '#core/io/formats/html'
+import { preparePrototypeAnimations } from '#core/io/formats/html/prototype/animations'
+import { createSVGNodes } from '#core/io/formats/svg/import'
+
+beforeAll(initCodec)
+
+function fixture(mixed = false) {
+  const graph = new SceneGraph()
+  const main = graph.createNode('COMPONENT', graph.getPages()[0].id, {
+    name: 'Editable artwork',
+    width: 100,
+    height: 100,
+    fills: []
+  })
+  const art = createSVGNodes(
+    graph,
+    main.id,
+    '<svg width="100" height="100"><path d="M5 90L50 5L95 90Z" fill="#eee" stroke="#f20" stroke-width="1.65"/></svg>'
+  )
+  if (!art) throw new Error('Missing native artwork')
+  graph.updateNode(art.id, { name: 'Vector viewport', fills: [], clipsContent: false })
+  if (mixed) graph.createNode('TEXT', main.id, { text: 'Editable text', width: 70, height: 20 })
+  const instance = new FigmaAPI(graph).getNodeById(main.id)
+  if (!instance || instance.type !== 'COMPONENT') throw new Error('Missing public component')
+  const copy = instance.createInstance()
+  copy.name = 'Scaled artwork'
+  return { graph, copy, main: instance }
+}
+
+test.each([0.85, 1.25])(
+  'ordinary FIG scaled vectors retain their %s coordinate basis, overrides and later edits',
+  async (scale) => {
+    const made = fixture()
+    made.copy.rescale(scale)
+    let graph = made.graph
+    for (let round = 0; round < 2; round++) {
+      graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, { populate: 'all' })
+      const instance = [...graph.getAllNodes()].find((node) => node.name === 'Scaled artwork')
+      if (!instance) throw new Error('Missing reopened instance')
+      const raw = structuredClone(instance)
+      const { html } = await renderNodesToHTML(graph, [instance.id], { html: 'standalone' })
+      const currentScale = round === 0 ? scale : scale * 2
+      expect(html).not.toContain('scale3d(')
+      expect(html).toContain(`width="${100 * currentScale}"`)
+      expect(html).toContain('viewBox="0 0 100 100"')
+      expect(html).toContain(round === 0 ? 'stroke="#FF2200"' : 'stroke="#0033CC"')
+      expect(instance).toEqual(raw)
+      expect(instance.width).toBe(100 * currentScale)
+      const viewport = graph.getChildren(instance.id)[0]
+      const vector = viewport && graph.getChildren(viewport.id)[0]
+      if (!vector) throw new Error('Missing editable vector')
+      const publicVector = new FigmaAPI(graph).getNodeById(vector.id)
+      const publicInstance = new FigmaAPI(graph).getNodeById(instance.id)
+      if (!publicVector || publicVector.type !== 'VECTOR' || publicInstance?.type !== 'INSTANCE')
+        throw new Error('Missing public editable artwork')
+      const nextStroke = {
+        type: 'SOLID' as const,
+        color: parseColor('#0033cc'),
+        opacity: 1,
+        visible: true,
+        weight: vector.strokeWeight,
+        align: 'CENTER' as const
+      }
+      publicVector.strokes = [nextStroke]
+      publicInstance.rescale(2)
+    }
+  }
+)
+
+test.each(['unscaled', 'mixed', 'nonuniform'] as const)(
+  'keeps the existing standalone projection for %s instances',
+  async (kind) => {
+    const { graph, copy } = fixture(kind === 'mixed')
+    if (kind !== 'unscaled') copy.rescale(0.85)
+    if (kind === 'nonuniform') copy.resize(92, 85)
+    const { html } = await renderNodesToHTML(graph, [copy.id], { html: 'standalone' })
+    expect(html).not.toContain('scale3d(')
+    if (kind === 'mixed') expect(html).toContain('Editable text')
+    if (kind === 'nonuniform') expect(html).toContain('width: 92px')
+  }
+)
+
+test('keeps the regular fragment contract for a uniformly scaled vector instance', async () => {
+  const { graph, copy } = fixture()
+  copy.rescale(0.85)
+  const { html } = await renderNodesToHTML(graph, [copy.id])
+  expect(html).not.toContain('scale3d(')
+})
+
+test('SVG presets do not alter a uniformly scaled native artwork viewport', async () => {
+  const { graph, copy } = fixture()
+  copy.rescale(0.85)
+  const before = await renderNodesToHTML(graph, [copy.id], {
+    html: 'standalone',
+    assets: 'external'
+  })
+  graph.updateNode(copy.id, { exportSettings: [{ format: 'svg', scale: 1 }] })
+  const { html, assets } = await renderNodesToHTML(graph, [copy.id], {
+    html: 'standalone',
+    assets: 'external'
+  })
