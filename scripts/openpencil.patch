+++ b/packages/core/tests/io/formats/fig/export/component-child-replacement.test.ts
@@ -0,0 +1,72 @@
+import { expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+
+import {
+  exportFigFile,
+  FigmaAPI,
+  parseFigFile,
+  SceneGraph,
+  type FigmaNodeProxy
+} from '@open-pencil/core'
+
+function artwork(api: FigmaAPI, parent: FigmaNodeProxy, name: string, width: number) {
+  const frame = api.createFrame()
+  frame.name = name
+  frame.resize(100, 100)
+  const vector = api.createVector()
+  vector.name = `Artwork ${width}`
+  vector.vectorPaths = [{ windingRule: 'NONZERO', data: `M0 0 L${width} 0 L${width} 30 L0 30 Z` }]
+  vector.resize(width, 30)
+  frame.appendChild(vector)
+  parent.appendChild(frame)
+  return frame
+}
+
+async function reopen(api: FigmaAPI): Promise<FigmaAPI> {
+  const bytes = await exportFigFile(api.graph)
+  return new FigmaAPI(await parseFigFile(bytes.slice().buffer, { populate: 'all' }))
+}
+
+for (const sameName of [true, false]) {
+  test(`replacing a saved component child ${sameName ? 'with the same name' : 'with a new name'} syncs and saves nested copies`, async () => {
+    let api = new FigmaAPI(new SceneGraph())
+    const leaf = api.createComponent()
+    leaf.name = 'Leaf'
+    artwork(api, leaf, 'Artwork', 40)
+    const outer = api.createComponent()
+    outer.name = 'Outer'
+    outer.appendChild(leaf.createInstance())
+    const screen = api.createFrame()
+    screen.name = 'Screen'
+    screen.appendChild(outer.createInstance())
+    api = await reopen(api)
+
+    for (const width of [60, 70]) {
+      const main = expectDefined(
+        api.currentPage.findOne((node) => node.type === 'COMPONENT' && node.name === 'Leaf')
+      )
+      expectDefined(main.children[0]).remove()
+      const replacementName = sameName ? 'Artwork' : `Artwork frame ${width}`
+      artwork(api, main, replacementName, width)
+      api.graph.syncInstances(main.id)
+      api = await reopen(api)
+
+      const copies = api.currentPage.findAll(
+        (node) => node.type === 'INSTANCE' && node.name === 'Leaf'
+      )
+      expect(copies).toHaveLength(2)
+      for (const copy of copies) {
+        expect(copy.children).toHaveLength(1)
+        expect(copy.children[0].name).toBe(replacementName)
+        const paths = copy.findAll((node) => node.type === 'VECTOR')
+        expect(paths).toHaveLength(1)
+        expect([paths[0].name, paths[0].width, paths[0].height]).toEqual([
+          `Artwork ${width}`,
+          width,
+          30
+        ])
+      }
+    }
+  })
+}
diff --git a/packages/core/tests/io/formats/fig/import/preferred-components.test.ts b/packages/core/tests/io/formats/fig/import/preferred-components.test.ts
new file mode 100644
