index 0000000000000000000000000000000000000000..25ac925d4942bd13c6e02f42401a3e6dfc72bdd6
--- /dev/null
+++ b/packages/core/tests/io/formats/fig/roundtrip/scroll-overrides.test.ts
@@ -0,0 +1,68 @@
+import { beforeAll, expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+
+import { exportFigFile, initCodec, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { recordInstanceOverride, type SceneNode } from '@open-pencil/scene-graph'
+
+beforeAll(async () => {
+  await initCodec()
+})
+
+type Scroll = Pick<SceneNode, 'scrollBehavior' | 'overflowDirection'>
+
+const scrolling: Scroll = { scrollBehavior: 'SCROLLS', overflowDirection: 'NONE' }
+const fixed: Scroll = {
+  scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME',
+  overflowDirection: 'VERTICAL'
+}
+
+function named(graph: SceneGraph, name: string): SceneNode {
+  const matches = [...graph.getAllNodes()].filter((node) => node.name === name)
+  expect(matches).toHaveLength(1)
+  return expectDefined(matches[0])
+}
+
+function target(graph: SceneGraph, instance: SceneNode, nested: boolean): SceneNode {
+  return nested ? expectDefined(graph.getChildren(instance.id)[0]) : instance
+}
+
+for (const nested of [false, true]) {
+  for (const clear of [false, true]) {
+    test(`${nested ? 'descendant' : 'root'} scroll overrides ${clear ? 'clear' : 'set'} component values through saved edits`, async () => {
+      let graph = new SceneGraph()
+      const page = graph.getPages()[0].id
+      const main = graph.createNode('COMPONENT', page, { name: 'Main' })
+      const source = nested ? graph.createNode('FRAME', main.id, { name: 'Region' }) : main
+      graph.updateNode(source.id, clear ? fixed : scrolling)
+      const custom = expectDefined(graph.createInstance(main.id, page, { name: 'Custom' }))
+      expectDefined(graph.createInstance(main.id, page, { name: 'Inherited' }))
+      const subject = target(graph, custom, nested)
+      const explicit: Scroll = clear
+        ? scrolling
+        : { scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME', overflowDirection: 'BOTH' }
+      graph.updateNode(subject.id, explicit)
+      recordInstanceOverride(graph, subject.id, ['scrollBehavior', 'overflowDirection'])
+      let followed = clear ? fixed : scrolling
+
+      for (let round = 0; round < 3; round++) {
+        graph = await parseFigFile((await exportFigFile(graph)).slice().buffer, {
+          populate: 'all'
+        })
+        expect(target(graph, named(graph, 'Custom'), nested)).toMatchObject(explicit)
+        expect(target(graph, named(graph, 'Inherited'), nested)).toMatchObject(followed)
+
+        const component = named(graph, 'Main')
+        followed = {
+          scrollBehavior:
+            round % 2 === 0 ? 'STICKY_SCROLLS' : 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME',
+          overflowDirection: round % 2 === 0 ? 'HORIZONTAL' : 'VERTICAL'
+        }
+        graph.updateNode(target(graph, component, nested).id, followed)
+        graph.syncInstances(component.id)
+        expect(target(graph, named(graph, 'Custom'), nested)).toMatchObject(explicit)
+        expect(target(graph, named(graph, 'Inherited'), nested)).toMatchObject(followed)
+      }
+    })
+  }
+}
diff --git a/packages/core/tests/io/formats/fig/roundtrip/text/line-height-units.test.ts b/packages/core/tests/io/formats/fig/roundtrip/text/line-height-units.test.ts
