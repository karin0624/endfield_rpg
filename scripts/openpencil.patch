@@ -0,0 +1,67 @@
+import { expect, test } from 'bun:test'
+
+import {
+  sceneNodeToDesignDocument,
+  serializeHTML,
+  type FontGlyphCoverageResolver
+} from '#dom-css/export/index'
+
+import { SceneGraph, type SceneNode, type CharacterStyleOverride } from '@open-pencil/scene-graph'
+
+const coverage: FontGlyphCoverageResolver = (font, character) => {
+  if (character === 'A') return 'has'
+  return font.fontFamily === 'Primary face' ? 'missing' : 'has'
+}
+
+function render(
+  fields: Partial<SceneNode> = {},
+  override: CharacterStyleOverride = {},
+  resolve: FontGlyphCoverageResolver | undefined = coverage
+) {
+  const graph = new SceneGraph()
+  const node = graph.createNode('TEXT', graph.getPages()[0].id, {
+    text: '文字',
+    fontFamily: 'Primary face',
+    fontSize: 16,
+    lineHeight: 140,
+    lineHeightUnit: 'PERCENT',
+    styleRuns: [{ start: 0, length: 2, style: { fontFamily: 'Fallback face', ...override } }],
+    ...fields
+  })
+  return serializeHTML(sceneNodeToDesignDocument(graph, node.id, { fontGlyphCoverage: resolve }))
+}
+
+test('known fallback glyphs retain their face and the paragraph strut', () => {
+  const html = render()
+  expect(html).toContain('line-height: 1.4')
+  expect(html).toContain('<span style="font-family: Fallback face; line-height: 0">文字</span>')
+  expect(render({ lineHeight: 22.4, lineHeightUnit: 'PIXELS' })).toContain('line-height: 22.4px')
+})
+
+test.each([
+  ['automatic paragraph', { lineHeight: null }, {}],
+  ['automatic run', {}, { lineHeight: null }],
+  ['explicit relative run', {}, { lineHeight: 160, lineHeightUnit: 'PERCENT' }],
+  ['explicit matching run', {}, { lineHeight: 140, lineHeightUnit: 'PERCENT' }],
+  ['explicit pixel run', {}, { lineHeight: 22.4 }],
+  ['larger run', {}, { fontSize: 20 }],
+  ['different weight', {}, { fontWeight: 700 }],
+  ['different slant', {}, { italic: true }],
+  ['mixed coverage', { text: '文A' }, {}]
+] as const)('keeps %s line box semantics', (_name, fields, override) => {
+  expect(render(fields, override)).not.toContain('line-height: 0')
+})
+
+test('unknown or unavailable coverage and ordinary projection keep their run layout', () => {
+  expect(render({}, {}, () => 'unknown')).not.toContain('line-height: 0')
+  expect(render({}, {}, () => 'missing')).not.toContain('line-height: 0')
+  expect(render({}, {}, () => 'has')).not.toContain('line-height: 0')
+  const graph = new SceneGraph()
+  const node = graph.createNode('TEXT', graph.getPages()[0].id, {
+    text: '文字',
+    fontFamily: 'Primary face',
+    lineHeight: 24,
+    styleRuns: [{ start: 0, length: 2, style: { fontFamily: 'Fallback face' } }]
+  })
+  expect(serializeHTML(sceneNodeToDesignDocument(graph, node.id))).not.toContain('line-height: 0')
+})
