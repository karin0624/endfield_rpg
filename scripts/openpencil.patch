--- /dev/null
+++ b/packages/fig/src/node-change/export/settings.ts
@@ -0,0 +1,38 @@
+import { readEffectiveFigmaRawField } from '#fig/source-metadata'
+
+import {
+  hasPluginData,
+  OPEN_PENCIL_PLUGIN_DATA,
+  type ExportFormatId,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+const IMAGE_TYPES: Partial<Record<ExportFormatId, string>> = {
+  png: 'PNG',
+  jpg: 'JPEG',
+  svg: 'SVG',
+  pdf: 'PDF'
+}
+
+export function isNativeExportFormat(format: ExportFormatId): boolean {
+  return IMAGE_TYPES[format] !== undefined
+}
+
+/** Native format and scale rows use Kiwi's export settings, without plugin data. */
+export function serializeNativeExportSettings(
+  node: Pick<SceneNode, 'exportSettings' | 'pluginData' | 'source'>
+): unknown[] | undefined {
+  if (
+    Array.isArray(readEffectiveFigmaRawField(node, 'exportSettings')) &&
+    !hasPluginData(node.pluginData, OPEN_PENCIL_PLUGIN_DATA.exportSettings)
+  )
+    return undefined
+
+  const settings = node.exportSettings.flatMap((setting) => {
+    const imageType = IMAGE_TYPES[setting.format]
+    return imageType
+      ? [{ imageType, constraint: { type: 'CONTENT_SCALE', value: setting.scale } }]
+      : []
+  })
+  return settings.length > 0 ? settings : undefined
+}
diff --git a/packages/fig/src/node-change/prototype.ts b/packages/fig/src/node-change/prototype.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5a660a45f088d347141f35bb363fb3368648a574
--- /dev/null
+++ b/packages/fig/src/node-change/prototype.ts
@@ -0,0 +1,251 @@
+import type { NodeChange } from '@open-pencil/kiwi/fig/codec'
+import { guidToString } from '@open-pencil/kiwi/fig/guid'
+import type {
+  PrototypeEasing,
+  PrototypeNodeAction,
+  PrototypeReaction,
+  PrototypeSmartTransition,
+  SceneNode
+} from '@open-pencil/scene-graph'
+import type { GUID } from '@open-pencil/scene-graph/primitives'
+
+const object = (value: unknown): value is Record<string, unknown> =>
+  value !== null && typeof value === 'object' && !Array.isArray(value)
+const keys = (value: Record<string, unknown>, allowed: string[]) =>
+  Object.keys(value).every((key) => allowed.includes(key))
+const guid = (value: unknown): value is GUID =>
+  object(value) && Number.isInteger(value.sessionID) && Number.isInteger(value.localID)
+const finite = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value)
+
+const EASING = {
+  LINEAR: { wire: 'LINEAR', curve: [0, 0, 1, 1] },
+  EASE_IN: { wire: 'IN_CUBIC', curve: [0.42, 0, 1, 1] },
+  EASE_OUT: { wire: 'OUT_CUBIC', curve: [0, 0, 0.58, 1] },
+  EASE_IN_AND_OUT: { wire: 'INOUT_CUBIC', curve: [0.42, 0, 0.58, 1] }
+}
+
+function readEasing(action: Record<string, unknown>): PrototypeEasing | undefined {
+  for (const type of ['LINEAR', 'EASE_IN', 'EASE_OUT', 'EASE_IN_AND_OUT'] as const) {
+    if (action.easingType !== EASING[type].wire) continue
+    const curve = action.easingFunction
+    if (
+      curve !== undefined &&
+      (!Array.isArray(curve) ||
+        curve.length !== 4 ||
+        !curve.every(
+          (value, index) =>
+            value === EASING[type].curve[index] || value === Math.fround(EASING[type].curve[index])
+        ))
+    )
+      return undefined
+    return { type }
+  }
+  if (action.easingType === 'CUSTOM_CUBIC') {
+    const curve = action.easingFunction
+    if (
+      !Array.isArray(curve) ||
+      curve.length !== 4 ||
+      !curve.every(finite) ||
+      curve[0] < 0 ||
+      curve[0] > 1 ||
+      curve[2] < 0 ||
+      curve[2] > 1
+    )
+      return undefined
+    return {
+      type: 'CUSTOM_CUBIC_BEZIER',
+      easingFunctionCubicBezier: {
+        x1: curve[0],
+        y1: curve[1],
+        x2: curve[2],
+        y2: curve[3]
+      }
+    }
+  }
+  return undefined
+}
+
+function readTransition(
+  action: Record<string, unknown>
+): PrototypeSmartTransition | null | undefined {
+  if (action.transitionType === undefined || action.transitionType === 'INSTANT_TRANSITION')
+    return action.transitionDuration === undefined ? null : undefined
+  if (
+    action.transitionType !== 'SMART_ANIMATE' ||
+    !finite(action.transitionDuration) ||
+    action.transitionDuration < 0
+  )
+    return undefined
+  const easing = readEasing(action)
+  return easing ? { type: 'SMART_ANIMATE', duration: action.transitionDuration, easing } : undefined
+}
+
+function readAction(
+  action: unknown,
+  resolve: (sourceId: string) => string | undefined
+): PrototypeNodeAction | null {
+  if (
+    !object(action) ||
+    !keys(action, [
+      'transitionNodeID',
+      'connectionType',
+      'navigationType',
+      'overlayRelativePosition',
+      'transitionType',
+      'transitionDuration',
+      'easingType',
+      'easingFunction',
+      'transitionResetVideoPosition'
+    ]) ||
+    action.connectionType !== 'INTERNAL_NODE' ||
+    !guid(action.transitionNodeID) ||
+    (action.transitionResetVideoPosition !== undefined &&
+      action.transitionResetVideoPosition !== false)
+  )
+    return null
+  const destinationId = resolve(guidToString(action.transitionNodeID))
+  if (!destinationId) return null
+  const transition = readTransition(action)
+  if (transition === undefined) return null
+  if (action.navigationType === 'SWAP_STATE') {
+    if (action.overlayRelativePosition !== undefined) return null
+    return { type: 'NODE', navigation: 'CHANGE_TO', destinationId, transition }
+  }
+  if (action.navigationType !== 'OVERLAY' || transition !== null) return null
+  const position = action.overlayRelativePosition
+  if (
+    position !== undefined &&
+    (!object(position) || !keys(position, ['x', 'y']) || !finite(position.x) || !finite(position.y))
+  )
+    return null
+  return {
+    type: 'NODE',
+    destinationId,
+    navigation: 'OVERLAY',
+    transition: null,
+    ...(object(position)
+      ? { overlayRelativePosition: { x: position.x as number, y: position.y as number } }
+      : {})
+  }
+}
+
+function readTrigger(event: unknown): PrototypeReaction['trigger'] | null {
+  if (!object(event)) return null
+  if (keys(event, ['interactionType']) && event.interactionType === 'ON_CLICK')
+    return { type: 'ON_CLICK' }
+  if (
+    keys(event, ['interactionType', 'transitionTimeout']) &&
+    event.interactionType === 'AFTER_TIMEOUT' &&
+    finite(event.transitionTimeout) &&
+    event.transitionTimeout >= 0
+  )
+    return { type: 'AFTER_TIMEOUT', timeout: event.transitionTimeout }
+  return null
+}
+
+/** Unknown interactions stay byte-preserved, rather than partially decoded. */
+export function readPrototypeReactions(
+  raw: unknown[],
+  resolve: (sourceId: string) => string | undefined
+): PrototypeReaction[] | null {
+  const reactions: PrototypeReaction[] = []
+  for (const value of raw) {
+    if (
+      !object(value) ||
+      !keys(value, ['id', 'event', 'actions', 'isDeleted', 'stateManagementVersion']) ||
+      (value.id !== undefined && !guid(value.id)) ||
+      (value.isDeleted !== undefined && value.isDeleted !== false) ||
+      (value.stateManagementVersion !== undefined && value.stateManagementVersion !== 1) ||
+      !Array.isArray(value.actions)
+    )
+      return null
+    const trigger = readTrigger(value.event)
+    if (!trigger) return null
+    const actions = value.actions.map((action) => readAction(action, resolve))
+    if (actions.some((action) => action === null)) return null
+    reactions.push({
+      ...(guid(value.id) ? { id: guidToString(value.id) } : {}),
+      trigger,
+      actions: actions.filter((action): action is PrototypeNodeAction => action !== null)
+    })
+  }
+  return reactions
+}
+
+export function readPrototypeProps(
+  nc: NodeChange
+): Pick<
+  SceneNode,
+  'reactions' | 'overlayPositionType' | 'overlayBackground' | 'overlayBackgroundInteraction'
+> {
+  const appearance = nc.overlayBackgroundAppearance
+  const color = appearance?.backgroundColor
+  return {
+    reactions: nc.prototypeInteractions ? null : [],
+    overlayPositionType: nc.overlayPositionType ?? 'CENTER',
+    overlayBackgroundInteraction: nc.overlayBackgroundInteraction ?? 'NONE',
+    overlayBackground:
+      appearance?.backgroundType === 'SOLID_COLOR' && color
+        ? { type: 'SOLID_COLOR', color: { r: color.r, g: color.g, b: color.b }, opacity: color.a }
+        : { type: 'NONE' }
+  }
+}
+
+function writeTransition(transition: PrototypeSmartTransition | null): Record<string, unknown> {
+  if (transition === null) return {}
+  const easing = transition.easing
+  let wire: string, curve: number[]
+  if (easing.type === 'CUSTOM_CUBIC_BEZIER') {
+    const value = easing.easingFunctionCubicBezier
+    wire = 'CUSTOM_CUBIC'
+    curve = [value.x1, value.y1, value.x2, value.y2]
+  } else {
+    wire = EASING[easing.type].wire
+    curve = EASING[easing.type].curve
+  }
+  return {
+    transitionType: 'SMART_ANIMATE',
+    transitionDuration: transition.duration,
+    easingType: wire,
+    easingFunction: curve
+  }
+}
+
+export function writePrototypeProps(
+  node: SceneNode,
+  nc: NodeChange,
+  destination: (id: string) => GUID,
+  interaction: (index: number, sourceId?: string) => GUID
+): void {
+  const raw = node.source.fig.rawNodeFields
+  if (node.reactions !== null && (node.reactions.length || 'prototypeInteractions' in raw))
+    nc.prototypeInteractions = node.reactions.map((reaction, index) => ({
+      id: interaction(index, reaction.id),
+      event:
+        reaction.trigger.type === 'AFTER_TIMEOUT'
+          ? { interactionType: 'AFTER_TIMEOUT', transitionTimeout: reaction.trigger.timeout }
+          : { interactionType: 'ON_CLICK' },
+      actions: reaction.actions.map((action) => ({
+        connectionType: 'INTERNAL_NODE',
+        transitionNodeID: destination(action.destinationId),
+        navigationType: action.navigation === 'CHANGE_TO' ? 'SWAP_STATE' : 'OVERLAY',
+        ...writeTransition(action.transition),
+        ...(action.overlayRelativePosition
+          ? { overlayRelativePosition: { ...action.overlayRelativePosition } }
+          : {})
+      }))
+    }))
+  if (node.overlayPositionType !== 'CENTER' || 'overlayPositionType' in raw)
+    nc.overlayPositionType = node.overlayPositionType
+  if (node.overlayBackgroundInteraction !== 'NONE' || 'overlayBackgroundInteraction' in raw)
+    nc.overlayBackgroundInteraction = node.overlayBackgroundInteraction
+  if (node.overlayBackground.type !== 'NONE' || 'overlayBackgroundAppearance' in raw)
+    nc.overlayBackgroundAppearance =
+      node.overlayBackground.type === 'SOLID_COLOR'
+        ? {
+            backgroundType: 'SOLID_COLOR',
+            backgroundColor: { ...node.overlayBackground.color, a: node.overlayBackground.opacity }
+          }
+        : { backgroundType: 'NONE' }
+}
diff --git a/packages/fig/tests/node-change/export/scroll.test.ts b/packages/fig/tests/node-change/export/scroll.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e56d30c548e35552e08beb6a67c87f4b7fcef37b
--- /dev/null
+++ b/packages/fig/tests/node-change/export/scroll.test.ts
@@ -0,0 +1,110 @@
+import { describe, expect, test } from 'bun:test'
+
+import { expectDefined } from '#fig-tests/helpers/assert'
+import { writeFigArchive } from '#fig/archive'
+import { materializeFigArchive } from '#fig/document/materialize'
+import { nodeChangeToProps, sceneNodeToKiwi } from '#fig/node-change/index'
+import { effectiveFigmaRawNodeFields } from '#fig/source-metadata'
+import { deflateSync } from 'fflate'
+
+import {
+  createNodeChangesMessage,
+  encodeMessage,
+  getSchemaBytes,
+  initCodec,
+  type NodeChange
+} from '@open-pencil/kiwi/fig/codec'
+import { SceneGraph, type SceneNode } from '@open-pencil/scene-graph'
+
+const behaviors = ['SCROLLS', 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME', 'STICKY_SCROLLS'] as const
+const directions = ['NONE', 'HORIZONTAL', 'VERTICAL', 'BOTH'] as const
+const guid = (localID: number) => ({ sessionID: 1, localID })
+
+function serialize(graph: SceneGraph, node: SceneNode) {
+  return sceneNodeToKiwi(node, guid(1), 0, { value: 2 }, graph, [])[0]
+}
+
+async function readSavedNode(record: NodeChange) {
+  await initCodec()
+  const records: NodeChange[] = [
+    { guid: guid(0), type: 'DOCUMENT', phase: 'CREATED' },
+    {
+      guid: guid(1),
+      type: 'CANVAS',
+      phase: 'CREATED',
+      name: 'Page',
+      parentIndex: { guid: guid(0), position: '!' }
+    },
+    record
+  ]
+  const bytes = writeFigArchive({
+    schemaDeflated: deflateSync(getSchemaBytes()),
+    kiwiData: encodeMessage(createNodeChangesMessage(0, 0, records)),
+    thumbnailPNG: new Uint8Array(),
+    metaJSON: '{}'
+  })
+  const { graph } = materializeFigArchive(bytes.slice().buffer)
+  const node = [...graph.getAllNodes()].find((candidate) => candidate.name === 'Scrollable')
+  return expectDefined(node, 'saved scrolling layer')
+}
+
+describe('native Figma scroll fields', () => {
+  test('layers default to scrolling with their parent and no overflow', () => {
+    const graph = new SceneGraph()
+    const node = graph.createNode('FRAME', graph.getPages()[0].id)
+    expect(node.scrollBehavior).toBe('SCROLLS')
+    expect(node.overflowDirection).toBe('NONE')
+    expect(nodeChangeToProps({ type: 'FRAME' }, [])).toMatchObject({
+      scrollBehavior: 'SCROLLS',
+      overflowDirection: 'NONE'
+    })
+    expect(serialize(graph, node).scrollBehavior).toBeUndefined()
+    expect(serialize(graph, node).scrollDirection).toBeUndefined()
+  })
+
+  for (const scrollBehavior of behaviors) {
+    for (const overflowDirection of directions) {
+      test(`${scrollBehavior}/${overflowDirection} survives a standard .fig archive`, async () => {
+        const graph = new SceneGraph()
+        const node = graph.createNode('FRAME', graph.getPages()[0].id, {
+          ...nodeChangeToProps(
+            { type: 'FRAME', scrollBehavior, scrollDirection: overflowDirection },
+            []
+          ),
+          name: 'Scrollable'
+        })
+        expect(node.scrollBehavior).toBe(scrollBehavior)
+        expect(node.overflowDirection).toBe(overflowDirection)
+        const saved = await readSavedNode(serialize(graph, node))
+        expect(saved.scrollBehavior).toBe(scrollBehavior)
+        expect(saved.overflowDirection).toBe(overflowDirection)
+      })
+    }
+  }
+
+  test('changing imported fixed and overflowing layers to defaults clears their old wire values', async () => {
+    const graph = new SceneGraph()
+    const node = graph.createNode('FRAME', graph.getPages()[0].id, {
+      ...nodeChangeToProps(
+        {
+          type: 'FRAME',
+          scrollBehavior: 'FIXED_WHEN_CHILD_OF_SCROLLING_FRAME',
+          scrollDirection: 'VERTICAL'
+        },
+        []
+      ),
+      name: 'Scrollable'
+    })
+    node.source.fig.rawNodeFields.description = 'Retained provenance'
+    graph.updateNode(node.id, { scrollBehavior: 'SCROLLS', overflowDirection: 'NONE' })
+    expect(effectiveFigmaRawNodeFields(node)).not.toHaveProperty('scrollBehavior')
+    expect(effectiveFigmaRawNodeFields(node)).not.toHaveProperty('scrollDirection')
+    expect(effectiveFigmaRawNodeFields(node).description).toBe('Retained provenance')
+    const record = serialize(graph, node)
+    expect(record.scrollBehavior).toBeUndefined()
+    expect(record.scrollDirection).toBeUndefined()
+    const saved = await readSavedNode(record)
+    expect(saved.scrollBehavior).toBe('SCROLLS')
+    expect(saved.overflowDirection).toBe('NONE')
+  })
+})
