@@ -0,0 +1,380 @@
+import { isEqual } from 'es-toolkit'
+import { encode } from 'js-base64'
+
+import {
+  isPrototypeAnimated,
+  type DesignElement,
+  type PrototypeAnimation
+} from '@open-pencil/dom-css/export'
+import {
+  getWorldMatrix,
+  INSTANCE_SYNC_FIELDS,
+  resolvedPaintBindings,
+  slotPropertyId,
+  type SceneGraph,
+  type SceneNode
+} from '@open-pencil/scene-graph'
+
+import { computeContentBounds } from '#core/io/formats/raster'
+import { renderNodesToSVG } from '#core/io/formats/svg/export'
+import { findPageId } from '#core/io/subgraph'
+
+type ArtifactMode = 'stretch' | 'viewport'
+
+const ARTWORK_TYPES = new Set<SceneNode['type']>([
+  'COMPONENT',
+  'FRAME',
+  'GROUP',
+  'VECTOR',
+  'RECTANGLE',
+  'ELLIPSE',
+  'LINE',
+  'STAR',
+  'POLYGON',
+  'BOOLEAN_OPERATION'
+])
+const NON_VISUAL = new Set(['name', 'locked', 'expanded'])
+const SVG_PAINTS = new Set(['SOLID', 'GRADIENT_LINEAR', 'GRADIENT_RADIAL'])
+const PLACEMENT = new Set([
+  'x',
+  'y',
+  'width',
+  'height',
+  'rotation',
+  'skew',
+  'flipX',
+  'flipY',
+  'horizontalConstraint',
+  'verticalConstraint',
+  'layoutPositioning',
+  'layoutGrow',
+  'layoutAlignSelf'
+])
+
+function axisAligned(node: SceneNode): boolean {
+  return node.rotation === 0 && node.skew === 0 && !node.flipX && !node.flipY
+}
+
+function simpleResize(node: SceneNode, root: boolean): boolean {
+  const corners = [
+    node.cornerRadius,
+    node.topLeftRadius,
+    node.topRightRadius,
+    node.bottomLeftRadius,
+    node.bottomRightRadius,
+    node.cornerSmoothing
+  ]
+  return (
+    axisAligned(node) &&
+    corners.every((value) => value === 0) &&
+    (root || (node.horizontalConstraint === 'SCALE' && node.verticalConstraint === 'SCALE'))
+  )
+}
+
+function parameterized(node: SceneNode): boolean {
+  return (
+    node.componentPropertyDefinitions.length > 0 ||
+    node.componentPropertyReferences.length > 0 ||
+    Object.keys(node.componentPropertyAssignments).length > 0 ||
+    Object.keys(node.componentPropertyValues).length > 0
+  )
+}
+
+function staticVector(node: SceneNode, mode: ArtifactMode): boolean {
+  const paints = [
+    ...node.fills,
+    ...node.strokes,
+    ...node.fillGeometry.flatMap((path) => path.fills ?? [])
+  ]
+  return (
+    ARTWORK_TYPES.has(node.type) &&
+    !slotPropertyId(node) &&
+    (node.layoutMode === 'NONE' ||
+      (mode === 'viewport' &&
+        (node.layoutMode === 'HORIZONTAL' || node.layoutMode === 'VERTICAL') &&
+        node.primaryAxisSizing === 'FIXED' &&
+        node.counterAxisSizing === 'FIXED')) &&
+    node.scrollBehavior === 'SCROLLS' &&
+    node.overflowDirection === 'NONE' &&
+    node.reactions !== null &&
+    node.reactions.length === 0 &&
+    !parameterized(node) &&
+    Object.keys(node.boundVariables).every((field) =>
+      /^(fills|strokes)\/\d+\/color$/.test(field)
+    ) &&
+    !node.effects.some((effect) => effect.visible) &&
+    (mode === 'viewport' || !node.strokes.some((stroke) => stroke.visible)) &&
+    !paints.some((paint) => paint.visible && !SVG_PAINTS.has(paint.type))
+  )
+}
+
+function artwork(
+  graph: SceneGraph,
+  node: SceneNode,
+  resized: boolean,
+  mode: ArtifactMode,
+  root = true
+): boolean {
+  if (!staticVector(node, mode)) return false
+  if (
+    root &&
+    (node.isMask ||
+      node.opacity !== 1 ||
+      !axisAligned(node) ||
+      (node.blendMode !== 'NORMAL' && node.blendMode !== 'PASS_THROUGH'))
+  )
+    return false
+  if (mode === 'stretch' && resized && !simpleResize(node, root)) return false
+  return graph.getChildren(node.id).every((child) => artwork(graph, child, resized, mode, false))
+}
+
+/** The source SVG remains one fixed, clipped viewport inside its surrounding component. */
+function originalViewport(node: SceneNode, main: SceneNode): boolean {
+  return (
+    node.clipsContent &&
+    !node.isMask &&
+    node.x === 0 &&
+    node.y === 0 &&
+    node.width === main.width &&
+    node.height === main.height
+  )
+}
+
+function fixedCenteredFlow(owner: SceneNode, child: SceneNode): boolean {
+  return (
+    owner.layoutMode === 'HORIZONTAL' &&
+    owner.layoutWrap === 'NO_WRAP' &&
+    owner.primaryAxisAlign === 'CENTER' &&
+    owner.counterAxisAlign === 'CENTER' &&
+    owner.primaryAxisSizing === 'FIXED' &&
+    owner.counterAxisSizing === 'FIXED' &&
+    [
+      owner.paddingTop,
+      owner.paddingRight,
+      owner.paddingBottom,
+      owner.paddingLeft,
+      owner.itemSpacing,
+      owner.counterAxisSpacing
+    ].every((value) => value === 0) &&
+    child.layoutPositioning === 'AUTO' &&
+    child.layoutGrow === 0 &&
+    child.layoutAlignSelf === 'AUTO' &&
+    child.layoutMode === 'NONE' &&
+    child.primaryAxisSizing === 'FIXED' &&
+    child.counterAxisSizing === 'FIXED' &&
+    [child.minWidth, child.maxWidth, child.minHeight, child.maxHeight].every(
+      (value) => value === null
+    )
+  )
+}
+
+/** A larger container can center an original SVG viewport without scaling its strokes. */
+function centeredViewport(graph: SceneGraph, node: SceneNode, main: SceneNode): boolean {
+  if (node.width === main.width && node.height === main.height) return true
+  const paints = [...main.fills, ...main.strokes]
+  if (
+    node.width < main.width ||
+    node.height < main.height ||
+    (node.width !== main.width && node.height !== main.height) ||
+    paints.some((paint) => paint.visible) ||
+    main.cornerRadius !== 0 ||
+    main.independentCorners ||
+    main.cornerSmoothing !== 0 ||
+    main.childIds.length !== 1
+  )
+    return false
+  const viewport = graph.getChildren(main.id).at(0)
+  const actual = graph.getChildren(node.id).at(0)
+  if (!viewport || !actual || !originalViewport(viewport, main)) return false
+  // AUTO coordinates are layout results, not authored translations. Fresh instance copies
+  // can still carry the main's coordinates until layout is read; the declared fixed center
+  // determines this viewport's placement. Descendant geometry and explicit edits stay checked.
+  const derivedPosition = fixedCenteredFlow(node, actual) && fixedCenteredFlow(main, viewport)
+  const sameGeometry = (copy: SceneNode, source: SceneNode, dx = 0, dy = 0): boolean => {
+    const positioned =
+      (copy === actual && derivedPosition) || (copy.x === source.x + dx && copy.y === source.y + dy)
+    if (!positioned || copy.width !== source.width || copy.height !== source.height) return false
+    const children = graph.getChildren(copy.id)
+    const sources = graph.getChildren(source.id)
+    return (
+      children.length === sources.length &&
+      children.every((child, index) => sameGeometry(child, sources[index]))
+    )
+  }
+  return sameGeometry(
+    actual,
+    viewport,
+    (node.width - main.width) / 2,
+    (node.height - main.height) / 2
+  )
+}
+
+function inheritedLayer(
+  graph: SceneGraph,
+  actual: SceneNode,
+  source: SceneNode,
+  root: boolean
+): boolean {
+  if (
+    root &&
+    (actual.componentScale !== source.componentScale ||
+      actual.opacity !== 1 ||
+      Object.keys(actual.componentPropertyAssignments).length ||
+      Object.keys(actual.componentPropertyValues).length ||
+      [...actual.instanceOverrides.descendants.values()].some((fields) =>
+        [...fields.keys()].some((key) => key !== 'sourceComponentId' && !NON_VISUAL.has(key))
+      ))
+  )
+    return false
+  if (
+    !root &&
+    (!axisAligned(actual) ||
+      actual.horizontalConstraint !== source.horizontalConstraint ||
+      actual.verticalConstraint !== source.verticalConstraint)
+  )
+    return false
+  if (
+    INSTANCE_SYNC_FIELDS.some(
+      (key) => !NON_VISUAL.has(key) && !PLACEMENT.has(key) && !isEqual(actual[key], source[key])
+    )
+  )
+    return false
+  if (!isEqual(resolvedPaintBindings(graph, actual), resolvedPaintBindings(graph, source)))
+    return false
+  const safe = (fields: Iterable<string>) =>
+    [...fields].every(
+      (key) => NON_VISUAL.has(key) || key === 'sourceComponentId' || (root && PLACEMENT.has(key))
+    )
+  if (!safe(actual.instanceOverrides.self.keys())) return false
+  for (
+    let owner: SceneNode | undefined = actual;
+    owner;
+    owner = owner.parentId ? graph.getNode(owner.parentId) : undefined
+  ) {
+    const fields = owner.instanceOverrides.descendants.get(actual.id)
+    if (fields && !safe(fields.keys())) return false
+  }
+  return true
+}
+
+function inherited(graph: SceneGraph, node: SceneNode, main: SceneNode): boolean {
+  // Native override provenance distinguishes ordinary resize from authored edits. Reuse
+  // the original main, without reconstructing it from a copy's rounded derived geometry.
+  // Nested copies can point to an intermediate occurrence. Check every inherited tree,
+  // including its overrides, before using the original component's SVG artifact.
+  const active = new Set<string>()
+  const visit = (actual: SceneNode, source: SceneNode, root: boolean): boolean => {
+    if (actual === source) return true
+    if (active.has(actual.id) || (root ? actual.type !== 'INSTANCE' : actual.type !== source.type))
+      return false
+    active.add(actual.id)
+    try {
+      const previous = actual.componentId ? graph.getNode(actual.componentId) : undefined
+      if (!previous || !visit(previous, source, root)) return false
+      if (!inheritedLayer(graph, actual, source, root)) return false
+      const children = graph.getChildren(actual.id)
+      const originals = graph.getChildren(source.id)
+      return (
+        children.length === originals.length &&
+        children.every((child, index) => visit(child, originals[index], false))
+      )
+    } finally {
+      active.delete(actual.id)
+    }
+  }
+  return visit(node, main, true)
+}
+
+function artifactMain(
+  graph: SceneGraph,
+  node: SceneNode,
+  animations: PrototypeAnimation[]
+): { main: SceneNode; mode: ArtifactMode } | null {
+  if (
+    (node.type !== 'COMPONENT' && node.type !== 'INSTANCE') ||
+    isPrototypeAnimated(graph, node, animations)
+  )
+    return null
+  // A native mask consumes its children's geometry, not an HTML image reference.
+  for (
+    let parent = node.parentId ? graph.getNode(node.parentId) : undefined;
+    parent;
+    parent = parent.parentId ? graph.getNode(parent.parentId) : undefined
+  )
+    if (parent.isMask) return null
+  const main = node.type === 'COMPONENT' ? node : graph.getMainComponent(node.id)
+  if (
+    main?.type !== 'COMPONENT' ||
+    !main.exportSettings.some((preset) => preset.format === 'svg') ||
+    !main.childIds.length ||
+    ![main.width, main.height, node.width, node.height].every(
+      (size) => Number.isFinite(size) && size > 0
+    )
+  )
+    return null
+  const resized = node.width !== main.width || node.height !== main.height
+  if (node !== main && !inherited(graph, node, main)) return null
+  if (artwork(graph, main, resized, 'stretch')) return { main, mode: 'stretch' }
+  if (artwork(graph, main, resized, 'viewport') && centeredViewport(graph, node, main))
+    return { main, mode: 'viewport' }
+  return null
+}
+
+function naturalViewport(graph: SceneGraph, main: SceneNode): boolean {
+  const matrix = getWorldMatrix(main, graph)
+  if (matrix[0] !== 1 || matrix[1] !== 0 || matrix[3] !== 0 || matrix[4] !== 1) return false
+  const bounds = computeContentBounds(graph, [main.id])
+  return (
+    bounds !== null &&
+    bounds.maxX - bounds.minX === main.width &&
+    bounds.maxY - bounds.minY === main.height
+  )
+}
+
+/** Real SVG export presets on vector artwork components produce reusable SVG artifacts. */
+export function svgAssetElement(
+  graph: SceneGraph,
+  node: SceneNode,
+  animations: PrototypeAnimation[] = []
+): DesignElement | null {
+  const artifact = artifactMain(graph, node, animations)
+  if (!artifact || !naturalViewport(graph, artifact.main)) return null
+  const { main, mode } = artifact
+  const data = renderNodesToSVG(graph, findPageId(graph, main.id) ?? '', [main.id], {
+    precision: null,
+    xmlDeclaration: false,
+    preserveAspectRatio: mode === 'stretch' ? 'none' : 'xMidYMid meet'
+  })
+  if (!data) return null
+  return {
+    type: 'element',
+    tagName: 'img',
+    attrs: {
+      src: `data:image/svg+xml;base64,${encode(data)}`,
+      alt: '',
+      width: String(node.width),
+      height: String(node.height)
+    },
+    inlineStyle: { display: 'block', 'object-fit': 'fill' },
+    children: []
+  }
+}
+
+/** Keep an artwork reference's viewport when a paintless parent would merge its vectors. */
+export function svgAssetRenderer(graph: SceneGraph, animations: PrototypeAnimation[]) {
+  const drawings = new Map<string, DesignElement | null>()
+  const descendants = new Map<string, boolean>()
+  const element = (node: SceneNode) => {
+    if (!drawings.has(node.id)) drawings.set(node.id, svgAssetElement(graph, node, animations))
+    return drawings.get(node.id) ?? null
+  }
+  const contains = (node: SceneNode): boolean => {
+    if (!descendants.has(node.id))
+      descendants.set(
+        node.id,
+        graph.getChildren(node.id).some((child) => element(child) !== null || contains(child))
+      )
+    return descendants.get(node.id) ?? false
+  }
+  return { element, contains }
+}
diff --git a/packages/core/src/io/formats/html/vector-scale.ts b/packages/core/src/io/formats/html/vector-scale.ts
