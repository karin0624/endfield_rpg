--- /dev/null
+++ b/packages/core/tests/io/formats/fig/import/preferred-components.test.ts
@@ -0,0 +1,73 @@
+import { expect, test } from 'bun:test'
+
+import { asComponentNode, asInstanceNode } from '#core-tests/helpers/figma-api'
+
+import { exportFigFile, FigmaAPI, parseFigFile, SceneGraph } from '@open-pencil/core'
+import { populateFigPage } from '@open-pencil/core/io/formats/fig'
+
+function named(graph: SceneGraph, name: string) {
+  const node = [...graph.getAllNodes()].find((node) => node.name === name)
+  if (!node) throw new Error(`Missing ${name}`)
+  return node
+}
+
+function choices(graph: SceneGraph) {
+  const api = new FigmaAPI(graph)
+  const definitions = asComponentNode(
+    api.wrapNode(named(graph, 'Button').id)
+  ).componentPropertyDefinitions
+  const definition = Object.values(definitions).find(
+    (definition) => definition.type === 'INSTANCE_SWAP'
+  )
+  if (!definition) throw new Error('Missing picture property')
+  expect(graph.getNode(String(definition.defaultValue))?.name).toBe('Choice/Default')
+  return (definition.preferredValues ?? []).map((value) => graph.getNode(value.key)?.name).sort()
+}
+
+for (const populate of ['all', 'first-page', 'none'] as const) {
+  test(`local preferred components on another page survive ${populate} import and save`, async () => {
+    const source = new SceneGraph()
+    const library = source.getPages()[0]
+    const local = source.addPage('Local')
+    const targets = ['Default', 'Unused', 'Alternate'].map((name) =>
+      source.createNode('COMPONENT', local.id, { name: `Choice/${name}`, width: 16, height: 16 })
+    )
+    const button = source.createNode('COMPONENT', library.id, {
+      name: 'Button',
+      width: 64,
+      height: 24
+    })
+    const api = new FigmaAPI(source)
+    const property = asComponentNode(api.wrapNode(button.id)).addComponentProperty(
+      'picture',
+      'INSTANCE_SWAP',
+      targets[0].id,
+      { preferredValues: targets.map((target) => ({ type: 'COMPONENT', key: target.id })) }
+    )
+    const slot = source.createInstance(targets[0].id, button.id)
+    if (!slot) throw new Error('Missing picture slot')
+    asInstanceNode(api.wrapNode(slot.id)).componentPropertyReferences = { mainComponent: property }
+    source.createInstance(button.id, library.id, { name: 'Button use' })
+    const bytes = await exportFigFile(source)
+    const graph = await parseFigFile(bytes.slice().buffer as ArrayBuffer, { populate })
+    if (populate === 'none') populateFigPage(graph, graph.getPages()[0].id)
+
+    // Two choices are not currently instanced: the picker must still contain all three
+    // before their own page is visited, and after an ordinary property edit/save/reload.
+    const expected = ['Choice/Alternate', 'Choice/Default', 'Choice/Unused']
+    expect(choices(graph)).toEqual(expected)
+    const edit = new FigmaAPI(graph)
+    const use = asInstanceNode(edit.wrapNode(named(graph, 'Button use').id))
+    const picture = Object.keys(use.componentProperties).find((key) => key.startsWith('picture#'))
+    if (!picture) throw new Error('Missing exposed picture property')
+    use.setProperties({ [picture]: named(graph, 'Choice/Unused').id })
+    const saved = await exportFigFile(graph)
+    const reloaded = await parseFigFile(saved.slice().buffer as ArrayBuffer, { populate: 'all' })
+    expect(choices(reloaded)).toEqual(expected)
+    const fresh = asInstanceNode(new FigmaAPI(reloaded).wrapNode(named(reloaded, 'Button use').id))
+    expect(reloaded.getNode(String(fresh.componentProperties[picture].value))?.name).toBe(
+      'Choice/Unused'
+    )
+    expect([...reloaded.getAllNodes()].filter((node) => node.type === 'COMPONENT')).toHaveLength(4)
+  })
+}
diff --git a/packages/core/tests/io/formats/fig/patch/detach-instance.test.ts b/packages/core/tests/io/formats/fig/patch/detach-instance.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cb6deb917cf5f4a1776ca4bf3588e1307095e492
--- /dev/null
+++ b/packages/core/tests/io/formats/fig/patch/detach-instance.test.ts
@@ -0,0 +1,95 @@
+import { expect, test } from 'bun:test'
+
+import { expectDefined } from '#core-tests/helpers/assert'
+
+import { FigmaAPI, SceneGraph } from '@open-pencil/core'
+import { exportFigFile, parseFigFile } from '@open-pencil/core/io'
+
+async function open(bytes: Uint8Array) {
+  return parseFigFile(Uint8Array.from(bytes).buffer, { populate: 'all' })
+}
+
+for (const withNestedInstance of [false, true]) {
+  test(`detaching an imported instance preserves its ${withNestedInstance ? 'nested instance and ' : ''}content after deleting its main and saving`, async () => {
+    const source = new SceneGraph()
+    const page = source.getPages()[0]
+    const fill = {
+      type: 'SOLID' as const,
+      blendMode: 'NORMAL' as const,
+      color: { r: 1, g: 0, b: 0, a: 1 },
+      opacity: 1,
+      visible: true
+    }
+    const main = source.createNode('COMPONENT', page.id, {
+      name: 'Main',
+      width: 120,
+      height: 40,
+      fills: [fill]
+    })
+    source.createNode('RECTANGLE', main.id, {
+      name: 'Child',
+      x: 8,
+      y: 6,
+      width: 24,
+      height: 12,
+      fills: [fill]
+    })
+    if (withNestedInstance) {
+      const nestedMain = source.createNode('COMPONENT', page.id, {
+        name: 'Nested main',
+        width: 16,
+        height: 16,
+        fills: [fill]
+      })
+      const nested = expectDefined(source.createInstance(nestedMain.id, main.id), 'nested instance')
+      source.updateNode(nested.id, { name: 'Nested occurrence', x: 40, y: 8 })
+    }
+    const occurrence = expectDefined(source.createInstance(main.id, page.id), 'instance')
+    source.updateNode(occurrence.id, { name: 'Occurrence', x: 160 })
+
+    const imported = await open(await exportFigFile(source))
+    const instance = expectDefined(
+      [...imported.getAllNodes()].find((node) => node.name === 'Occurrence'),
+      'imported instance'
+    )
+    const definition = expectDefined(
+      [...imported.getAllNodes()].find((node) => node.name === 'Main'),
+      'imported main'
+    )
+    expect(instance.type).toBe('INSTANCE')
+    const api = new FigmaAPI(imported)
+    api.wrapNode(instance.id).detachInstance()
+    expect(instance.type).toBe('FRAME')
+    expect(instance.componentId).toBeNull()
+    expect(imported.getInstances(definition.id)).toEqual([])
+    imported.deleteNode(definition.id)
+
+    const reopened = await open(await exportFigFile(imported))
+    const detached = expectDefined(
+      [...reopened.getAllNodes()].find((node) => node.name === 'Occurrence'),
+      'detached frame'
+    )
+    expect(detached.type).toBe('FRAME')
+    expect(detached.componentId).toBeFalsy()
+    expect(detached.fills).toEqual([fill])
+    const children = reopened.getChildren(detached.id)
+    expect(children).toHaveLength(withNestedInstance ? 2 : 1)
+    expect(children[0].name).toBe('Child')
+    expect([children[0].x, children[0].y, children[0].width, children[0].height]).toEqual([
+      8, 6, 24, 12
+    ])
+    expect(children[0].fills).toEqual([fill])
+    const components = [...reopened.getAllNodes()].filter((node) => node.type === 'COMPONENT')
+    const instances = [...reopened.getAllNodes()].filter((node) => node.type === 'INSTANCE')
+    expect(components.map((node) => node.name)).toEqual(withNestedInstance ? ['Nested main'] : [])
+    expect(instances.map((node) => node.name)).toEqual(
+      withNestedInstance ? ['Nested occurrence'] : []
+    )
+    if (withNestedInstance) {
+      expect(instances[0].componentId).toBe(components[0].id)
+      expect(instances[0].parentId).toBe(detached.id)
+      expect(instances[0].fills).toEqual([fill])
+    }
+    expect([...reopened.getAllNodes()].some((node) => node.name === 'Main')).toBe(false)
+  })
+}
diff --git a/packages/core/tests/io/formats/fig/roundtrip/scroll-overrides.test.ts b/packages/core/tests/io/formats/fig/roundtrip/scroll-overrides.test.ts
