+import { expect, test } from 'bun:test'
+
+import { lint, ruleDiagnostics } from './helpers/lint.ts'
+
+const rule = 'no-hand-rolled-color'
+const rules = { [`open-pencil/${rule}`]: 'error' }
+
+test('literal CSS is not a color conversion', async () => {
+  const source = 'const expected = `:root { --color: rgb(204, 214.2, 224.4); }`'
+  expect(ruleDiagnostics(await lint(source, rules), rule)).toHaveLength(0)
+})
+
+test('interpolating RGB channels still requires the color helper', async () => {
+  const source = `const converted = \`rgb(\${r}, \${g}, \${b})\``
+  expect(ruleDiagnostics(await lint(source, rules), rule)).toHaveLength(1)
+})
