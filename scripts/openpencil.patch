diff --git a/packages/dom-css/tests/export/bundle/outlines.test.ts b/packages/dom-css/tests/export/bundle/outlines.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c3828da275f645a88e7454efacc2179a2837c5a7
--- /dev/null
+++ b/packages/dom-css/tests/export/bundle/outlines.test.ts
@@ -0,0 +1,202 @@
+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph, type SceneNode } from '@open-pencil/scene-graph'
+
+const fill = {
+  type: 'SOLID' as const,
+  color: { r: 1, g: 1, b: 1, a: 1 },
+  opacity: 1,
+  visible: true
+}
+
+function setup(sibling = false) {
+  const graph = new SceneGraph()
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 160,
+    height: 80,
+    fills: [],
+    layoutMode: 'VERTICAL',
+    primaryAxisSizing: 'HUG'
+  })
+  const owner = graph.createNode('FRAME', root.id, {
+    width: 160,
+    height: 80,
+    fills: [fill],
+    cornerRadius: 8,
+    layoutMode: 'VERTICAL',
+    primaryAxisSizing: 'HUG',
+    clipsContent: sibling,
+    overflowDirection: sibling ? 'VERTICAL' : 'NONE'
+  })
+  const group = graph.createNode('FRAME', sibling ? root.id : owner.id, {
+    width: 160,
+    height: 80,
+    fills: [],
+    layoutPositioning: 'ABSOLUTE',
+    horizontalConstraint: 'STRETCH',
+    verticalConstraint: 'STRETCH'
+  })
+  const indicator = graph.createNode('RECTANGLE', group.id, {
+    x: -2,
+    y: -2,
+    width: 164,
+    height: 84,
+    cornerRadius: 10,
+    fills: [],
+    strokes: [{ ...fill, weight: 2, align: 'OUTSIDE' }],
+    strokeWeight: 2,
+    strokeAlign: 'OUTSIDE',
+    horizontalConstraint: 'STRETCH',
+    verticalConstraint: 'STRETCH'
+  })
+  const text = graph.createNode('TEXT', owner.id, {
+    text: 'Editable label',
+    width: 120,
+    height: 24
+  })
+  const render = async () => {
+    const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, root.id), {
+      html: 'standalone'
+    })
+    return String(bundle.files[0].content)
+  }
+  return { graph, root, owner, group, indicator, text, render }
+}
+
+function present(html: string, node: SceneNode) {
+  return html.includes(`data-open-pencil-node-id="${node.id}"`)
+}
+
+test('a stretching outside outline belongs to its painted auto-layout surface', async () => {
+  const { graph, owner, group, indicator, text, render } = setup()
+  const html = await render()
+  expect(html).toContain('outline: 2px solid #FFFFFF')
+  expect(html).toContain('outline-offset: 2px')
+  expect(present(html, owner)).toBe(true)
+  expect(present(html, text)).toBe(true)
+  expect(present(html, group)).toBe(false)
+  expect(present(html, indicator)).toBe(false)
+  expect(html).not.toContain('position: relative')
+  expect(graph.getNode(indicator.id)?.x).toBe(-2)
+  expect(graph.getNode(group.id)?.childIds).toEqual([indicator.id])
+})
+
+test('a scroll surface owns a coextensive sibling outline without moving its node identity', async () => {
+  const { owner, group, render } = setup(true)
+  const html = await render()
+  expect(present(html, owner)).toBe(true)
+  expect(present(html, group)).toBe(false)
+  expect(html).toContain('outline-offset: 2px')
+  expect(html).toContain('overflow-y: auto')
+})
+
+test.each([false, true])(
+  'square outlines retain square corners with sibling=%s',
+  async (sibling) => {
+    const { graph, owner, group, indicator, render } = setup(sibling)
+    graph.updateNode(owner.id, { cornerRadius: 0 })
+    graph.updateNode(indicator.id, { cornerRadius: 0 })
+    const square = await render()
+    expect(square).toContain('outline-offset: 2px')
+    expect(present(square, group)).toBe(false)
+    expect(graph.getNode(indicator.id)?.cornerRadius).toBe(0)
+    graph.updateNode(indicator.id, { cornerRadius: 2 })
+    const rounded = await render()
+    expect(present(rounded, group)).toBe(true)
+    expect(present(rounded, indicator)).toBe(true)
+    expect(graph.getNode(indicator.id)?.cornerRadius).toBe(2)
+  }
+)
+
+test('independent sharp and rounded corners keep their individual outline shapes', async () => {
+  const { graph, owner, group, indicator, render } = setup()
+  graph.updateNode(owner.id, {
+    independentCorners: true,
+    topLeftRadius: 0,
+    topRightRadius: 8,
+    bottomRightRadius: 0,
+    bottomLeftRadius: 8
+  })
+  graph.updateNode(indicator.id, {
+    independentCorners: true,
+    topLeftRadius: 0,
+    topRightRadius: 10,
+    bottomRightRadius: 0,
+    bottomLeftRadius: 10
+  })
+  expect(present(await render(), group)).toBe(false)
+  graph.updateNode(indicator.id, { bottomRightRadius: 2 })
+  expect(present(await render(), group)).toBe(true)
+})
+
+test('a transparent text control owns its outline without adding a background paint', async () => {
+  const { graph, owner, group, text, render } = setup()
+  graph.updateNode(owner.id, { fills: [] })
+  const html = await render()
+  expect(html).toContain('outline-offset: 2px')
+  expect(present(html, group)).toBe(false)
+  expect(present(html, text)).toBe(true)
+  expect(html).not.toContain('background-color:')
+})
+
+test('outline geometry and resize constraints must match the surface', async () => {
+  const { graph, group, indicator, render } = setup()
+  graph.updateNode(indicator.id, { horizontalConstraint: 'MIN' })
+  expect(present(await render(), group)).toBe(true)
+  graph.updateNode(indicator.id, { horizontalConstraint: 'STRETCH', width: 165 })
+  expect(present(await render(), group)).toBe(true)
+  graph.updateNode(indicator.id, { width: 164, cornerRadius: 9 })
+  expect(present(await render(), group)).toBe(true)
+  graph.updateNode(indicator.id, {
+    cornerRadius: 10,
+    strokes: [{ ...indicator.strokes[0], blendMode: 'MULTIPLY' }]
+  })
+  expect(present(await render(), group)).toBe(true)
+})
+
+test('opacity and exterior content retain separate paint', async () => {
+  const { graph, owner, group, indicator, render } = setup()
+  graph.updateNode(owner.id, { opacity: 0.5 })
+  expect(present(await render(), group)).toBe(true)
+  graph.updateNode(owner.id, { opacity: 1 })
+  graph.createNode('RECTANGLE', owner.id, { width: 10, height: 10, x: -5 })
+  expect(present(await render(), group)).toBe(true)
+  graph.updateNode(indicator.id, { opacity: 0.5 })
+  expect(present(await render(), indicator)).toBe(true)
+})
+
+test('a filtered surface and multiple outlines retain their separate effects and layers', async () => {
+  const { graph, owner, group, indicator, render } = setup()
+  graph.updateNode(owner.id, {
+    effects: [
+      {
+        type: 'LAYER_BLUR',
+        radius: 4,
+        spread: 0,
+        offset: { x: 0, y: 0 },
+        color: fill.color,
+        visible: true
+      }
+    ]
+  })
+  expect(present(await render(), group)).toBe(true)
+  graph.updateNode(owner.id, { effects: [] })
+  const other = graph.createNode('RECTANGLE', owner.id, {
+    x: -2,
+    y: -2,
+    width: 164,
+    height: 84,
+    cornerRadius: 10,
+    fills: [],
+    strokes: indicator.strokes,
+    strokeWeight: 2,
+    strokeAlign: 'OUTSIDE',
+    horizontalConstraint: 'STRETCH',
+    verticalConstraint: 'STRETCH'
+  })
+  const html = await render()
+  expect(present(html, group)).toBe(true)
+  expect(present(html, other)).toBe(true)
+})
