+import { expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+async function styles(graph: SceneGraph, rootId: string) {
+  const bundle = await exportHTMLBundle(sceneNodeToDesignDocument(graph, rootId), {
+    html: 'standalone'
+  })
+  const html = String(bundle.files[0].content)
+  return (id: string) => {
+    const className = html.match(
+      new RegExp(`data-open-pencil-node-id="${id}"[^>]*class="([^"]+)"`)
+    )?.[1]
+    if (!className) throw new Error(`Missing exported element ${id}`)
+    return html.match(new RegExp(`\\.${className}\\{([^}]+)\\}`))?.[1] ?? ''
+  }
+}
+
+test('both pinned native edges follow a live Fill parent rather than its cached width', async () => {
+  const graph = new SceneGraph()
+  const root = graph.createNode('FRAME', graph.getPages()[0].id, {
+    width: 530,
+    height: 80,
+    layoutMode: 'VERTICAL',
+    primaryAxisSizing: 'HUG'
+  })
+  const row = graph.createNode('FRAME', root.id, {
+    width: 310,
+    height: 40,
+    layoutAlignSelf: 'STRETCH'
+  })
+  const surface = graph.createNode('RECTANGLE', row.id, {
+    x: 7,
+    y: 3,
+    width: 290,
+    height: 32,
+    horizontalConstraint: 'STRETCH',
+    verticalConstraint: 'STRETCH'
+  })
+  const css = await styles(graph, root.id)
+  expect(css(row.id)).toContain('align-self: stretch')
+  expect(css(row.id)).not.toContain('width:')
+  expect(css(surface.id)).toContain('left: 7px; top: 3px')
+  expect(css(surface.id)).toContain('right: 13px; bottom: 5px')
+  expect(css(surface.id)).not.toMatch(/(?:^|; )(?:width|height):/)
+  expect(surface.width).toBe(290)
+  expect(row.width).toBe(310)
+})
+
+test('native Stretch subtracts the corresponding independent inside border on each edge', async () => {
