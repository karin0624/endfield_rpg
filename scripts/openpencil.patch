@@ -0,0 +1,146 @@
+import { describe, expect, test } from 'bun:test'
+
+import { exportHTMLBundle, sceneNodeToDesignDocument } from '#dom-css/export/index'
+
+import { SceneGraph } from '@open-pencil/scene-graph'
+
+function fixture() {
+  const graph = new SceneGraph()
+  const page = graph.getPages()[0]
+  const screen = graph.createNode('FRAME', page.id, { width: 320, height: 200 })
+  const trigger = graph.createNode('RECTANGLE', screen.id, { width: 60, height: 32 })
+  const overlay = graph.createNode('FRAME', page.id, {
+    x: 1000,
+    y: 800,
+    width: 120,
+    height: 80,
+    overlayPositionType: 'CENTER',
+    overlayBackgroundInteraction: 'CLOSE_ON_CLICK_OUTSIDE',
+    overlayBackground: { type: 'SOLID_COLOR', color: { r: 0, g: 0, b: 0 }, opacity: 0.6 }
+  })
+  graph.createNode('TEXT', overlay.id, {
+    width: 100,
+    height: 24,
+    text: 'Editable overlay',
+    fontFamily: 'Overlay Face'
+  })
+  graph.updateNode(trigger.id, {
+    reactions: [
+      {
+        trigger: { type: 'ON_CLICK' },
+        actions: [
+          { type: 'NODE', destinationId: overlay.id, navigation: 'OVERLAY', transition: null }
+        ]
+      }
+    ]
+  })
+  const design = () => sceneNodeToDesignDocument(graph, screen.id)
+  return { graph, screen, trigger, overlay, design }
+}
+
+describe('native prototype HTML', () => {
+  test('timed variants need the native engine rather than silently becoming a static fragment', async () => {
+    const graph = new SceneGraph(),
+      page = graph.getPages()[0]
+    if (!page) throw new Error('Missing native page')
+    const set = graph.createNode('COMPONENT_SET', page.id)
+    const start = graph.createNode('COMPONENT', set.id)
+    const end = graph.createNode('COMPONENT', set.id)
+    graph.updateNode(start.id, {
+      reactions: [
+        {
+          trigger: { type: 'AFTER_TIMEOUT', timeout: 0.5 },
+          actions: [
+            { type: 'NODE', navigation: 'CHANGE_TO', destinationId: end.id, transition: null }
+          ]
+        }
+      ]
+    })
+    await expect(
+      exportHTMLBundle(sceneNodeToDesignDocument(graph, start.id), {
+        html: 'standalone'
+      })
+    ).rejects.toThrow('native engine animation preparation')
+  })
+  test('a related overlay is initially closed and ships its text and fonts without expanding the screen', async () => {
+    const { graph, screen, overlay, design } = fixture()
+    const unrelated = graph.createNode('FRAME', graph.getPages()[0].id, { name: 'Unrelated' })
+    const requested: string[] = []
+    const bundle = await exportHTMLBundle(design(), {
+      html: 'standalone',
+      fonts: async (fonts) => {
+        requested.push(...fonts.map((font) => font.family))
+        return []
+      }
+    })
+    const html = String(bundle.files[0].content)
+    expect(html).toContain('width:320px;height:200px')
+    expect(html).toContain(`<dialog data-open-pencil-node-id="${overlay.id}"`)
+    expect(html).toContain('Editable overlay')
+    expect(html).not.toContain(`data-open-pencil-node-id="${unrelated.id}"`)
+    expect(html).not.toContain('<dialog open')
+    expect(requested).toContain('Overlay Face')
+    expect(graph.getChildren(screen.id)).toHaveLength(1)
+    expect(overlay.x).toBe(1000)
+  })
+
+  test('destinations inside the initial subtree are not also drawn in the starting screen', async () => {
+    const { graph, screen, overlay, design } = fixture()
+    graph.reparentNode(overlay.id, screen.id)
+    const bundle = await exportHTMLBundle(design(), { html: 'standalone' })
+    const html = String(bundle.files[0].content)
+    expect(html.split(`data-open-pencil-node-id="${overlay.id}"`)).toHaveLength(2)
+    expect(graph.getChildren(screen.id)).toHaveLength(2)
+  })
+
+  test('manual overlays with no background use a top-layer popover and retain relative position', async () => {
+    const { graph, trigger, overlay, design } = fixture()
+    graph.updateNode(overlay.id, {
+      overlayPositionType: 'MANUAL',
+      overlayBackground: { type: 'NONE' }
+    })
+    const reaction = trigger.reactions?.[0]
+    if (!reaction) throw new Error('Missing reaction')
+    graph.updateNode(trigger.id, {
+      reactions: [
+        {
+          ...reaction,
+          actions: reaction.actions.map((action) =>
+            action.navigation === 'OVERLAY'
+              ? { ...action, overlayRelativePosition: { x: 24.5, y: 38 } }
+              : action
+          )
+        }
+      ]
+    })
+    const bundle = await exportHTMLBundle(design(), { html: 'standalone', assets: 'external' })
+    const html = String(bundle.files[0].content)
+    expect(html).toContain('popover="manual"')
+    expect(html).toContain('role="dialog"')
+    expect(html).not.toContain('<dialog ')
+    expect(html).toContain('x: 24.5')
+    expect(bundle.files.map((file) => file.path)).toContain('assets/openpencil.css')
+  })
+
+  test('unsupported imported reactions and missing destinations fail explicitly', async () => {
+    const { graph, trigger, overlay, design } = fixture()
+    graph.deleteNode(overlay.id)
+    await expect(exportHTMLBundle(design(), { html: 'standalone' })).rejects.toThrow(
+      'Missing visible HTML prototype destination'
+    )
+    graph.updateNode(trigger.id, { reactions: null })
+    await expect(exportHTMLBundle(design(), { html: 'standalone' })).rejects.toThrow(
+      'does not support this imported prototype reaction'
+    )
+  })
+
+  test('a non-interactive standalone and a static fragment need no prototype script', async () => {
+    const { graph, trigger, design } = fixture()
+    const fragment = await exportHTMLBundle(design())
+    expect(fragment.files[0].content).not.toContain('Editable overlay')
+    expect(fragment.files[0].content).not.toContain('<script')
+    graph.updateNode(trigger.id, { reactions: [] })
+    const standalone = await exportHTMLBundle(design(), { html: 'standalone' })
+    expect(standalone.files[0].content).not.toContain('<script')
+  })
+})
